@model GESTION_COLEGIAL.Business.Models.FormaPagoFindViewModel
@{
    ViewBag.Title = "Formas de Pago";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="#">Financiero</a></li>
            <li class="breadcrumb-item active" aria-current="page">Formas de Pago</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Formas de pago</h4>
        <p class="text-muted mb-0">Administre los métodos de pago disponibles en el sistema</p>
    </div>
    <div class="mt-2 mt-md-0">
        <button type="button" class="btn btn-primary" id="add-btn-header" data-toggle="modal" data-target="#edit-modal">
            <i class="bi bi-plus-lg mr-1"></i> Nueva forma de pago
        </button>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="row"><div class="col-12"><h4>Listado de formas de pago</h4></div></div>
    </div>
    <div class="widget-content widget-content-area">
        <div class="table-responsive">
            <table class="table table-hover nowrap" id="datatable">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Descripción</th>
                        <th>Activo</th>
                        <th>Cant. Pagos</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal crear / editar -->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            @using (Ajax.BeginForm("CreateAsync", "FormasPago", new AjaxOptions
            {
                HttpMethod = "Post",
                OnBegin = "Catalogs.begin",
                OnComplete = "Catalogs.complete",
                OnFailure = "Catalogs.failure",
                OnSuccess = "Catalogs.success"
            }))
            {
                @Html.HiddenFor(model => model.FormaPagoId, new { @id = "item-id" })
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Nueva forma de pago</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label for="Descripcion">Descripción <span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.Descripcion, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej: Efectivo, Tarjeta, Transferencia" } })
                        @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger small" })
                        <small class="form-text text-muted">Método de pago que desea registrar en el sistema.</small>
                    </div>
                    <div class="custom-control custom-checkbox mb-2">
                        @Html.CheckBoxFor(model => model.EsActivo, new { @class = "custom-control-input", @checked = "checked" })
                        @Html.LabelFor(model => model.EsActivo, "Forma de pago activa", htmlAttributes: new { @class = "custom-control-label" })
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 mr-1"></i> Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal eliminar -->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        @using (Ajax.BeginForm("DeleteAsync", "FormasPago", new AjaxOptions
        {
            HttpMethod = "Post",
            OnBegin = "Catalogs.begin",
            OnComplete = "Catalogs.complete",
            OnFailure = "Catalogs.failure",
            OnSuccess = "Catalogs.success"
        }))
        {
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalTitle">Eliminar forma de pago</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    @Html.HiddenFor(model => model.FormaPagoId, new { @id = "delete-item-id" })
                    <p class="mb-3">¿Está seguro de que desea eliminar la forma de pago <strong id="delete-item-name"></strong>?</p>
                    <div class="alert alert-light-danger mb-0" role="alert">
                        <i class="fas fa-exclamation-triangle mr-1"></i>
                        <strong>Esta acción no se puede deshacer.</strong> El registro será eliminado permanentemente del sistema.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash mr-1"></i> Eliminar</button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal detalle -->
<div class="modal fade" id="detail-modal" tabindex="-1" role="dialog" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailModalLabel"><i class="fas fa-file-alt mr-1"></i> Detalle de la forma de pago</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">ID</p>
                        <p class="font-weight-bold mb-0" id="detail-fpa-id"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Descripción</p>
                        <p class="font-weight-bold mb-0" id="detail-fpa-descripcion"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Activo</p>
                        <p class="font-weight-bold mb-0" id="detail-fpa_esactivo"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Cantidad de pagos</p>
                        <p class="font-weight-bold mb-0" id="detail-cantidadpagos"></p>
                    </div>
                </div>
                <h6 class="border-top pt-3 mb-3"><i class="fas fa-history mr-1"></i> Información de auditoría</h6>
                <div class="form-row">
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Creado por</p>
                        <p class="font-weight-bold mb-0" id="detail-nombrecompletousuarioregistra"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Fecha de creación</p>
                        <p class="font-weight-bold mb-0" id="detail-fpa-fecharegistra"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Modificado por</p>
                        <p class="font-weight-bold mb-0" id="detail-nombrecompletousuariomodifica"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Fecha de modificación</p>
                        <p class="font-weight-bold mb-0" id="detail-fpa-fechamodifica"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/formaspago.js"></script>
    <script>
        FormasPago.datatableCatalogs({
            urlList: "@Url.Action("ListAsync")",
            urlDetail: "@Url.Action("DetailAsync")"
        });
    </script>
    <script>
        Catalogs.configure({
            displayName: "forma de pago",
            urlUpdate: "@Url.Action("FindAsync")"
        });
        CatalogsCfg.configure({
            displayName: "forma de pago",
            getUrl: "@Url.Action("DetailAsync")"
        });
    </script>
    @if (ViewBag.JavaScriptFunction != null)
    {
        <script type="text/javascript">
        @Html.Raw(ViewBag.JavaScriptFunction);
        </script>
    }
}
