@{
    ViewBag.Title = "Dashboard de Aulas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/pages/dashboard-aulas.css">

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Dashboard de Aulas</li>
        </ol>
    </nav>
</div>

<div class="dashboard-aulas">
    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
        <div class="mr-3">
            <h4 class="mb-1">Dashboard de Aulas</h4>
            <p class="text-muted mb-0">Vista general de rendimiento, asistencia y deudas por sección</p>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center mb-2" id="da-filters">
        <button class="filter-btn btn btn-sm btn-rounded btn-primary active mr-1 mb-1" data-filter="all" type="button">Todas</button>
        <button class="filter-btn btn btn-sm btn-rounded btn-outline-primary mr-1 mb-1" data-filter="danger" type="button"><i class="fas fa-triangle-exclamation mr-1"></i>Críticas</button>
    </div>

    <div class="d-flex flex-wrap align-items-center mb-4" id="da-filters-jornada">
        <span class="small font-weight-bold text-muted text-uppercase mr-2 mb-1">Jornada:</span>
        <button class="filter-btn btn btn-sm btn-rounded btn-outline-primary mr-1 mb-1" data-jornada="all" type="button">Todas</button>
    </div>

    <div class="row" id="da-summary"></div>

    <h6 class="text-muted text-uppercase small font-weight-bold mt-2 mb-3">Vista por aulas</h6>
    <div class="aulas-grid" id="da-grid">
        <div class="p-4 text-center text-muted small" id="da-loading">Cargando datos…</div>
    </div>

    <div class="detail-panel statbox widget box box-shadow mb-4" id="da-detail">
        <button type="button" class="close" id="da-detail-close" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
        <div id="da-detail-content"></div>
    </div>

    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Comparativo general</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="chart-legend">
                <span><span class="leg-sq fill-orange"></span>Alumnos</span>
                <span><span class="leg-sq fill-red"></span>Bajo rendimiento</span>
                <span><span class="leg-sq fill-blue"></span>Con deuda</span>
                <span><span class="leg-sq fill-green"></span>Asistencia %</span>
            </div>
            <div class="chart-wrap">
                <canvas id="da-chart" role="img" aria-label="Gráfico de barras comparando alumnos, bajo rendimiento y deudas por aula"></canvas>
            </div>
            <p class="small text-muted mt-2 mb-0" id="da-note"></p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/pages/dashboardaulas.js"></script>
    <script>
        DashboardAulas.init('@Url.Action("AulasAsync")');
    </script>
}
