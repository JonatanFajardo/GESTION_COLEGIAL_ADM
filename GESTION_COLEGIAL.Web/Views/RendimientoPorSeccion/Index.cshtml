@{
    ViewBag.Title = "Rendimiento por Sección";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Rendimiento por Sección</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Rendimiento por Sección</h4>
        <p class="text-muted mb-0">Promedio y totales de alumnos por sección y parcial</p>
    </div>
</div>

<div class="fluid-container">

    <!-- Filtros -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="form-row align-items-end">
                <div class="col-md-3 form-group mb-md-0">
                    <label for="filtro-anio"><i class="fa-solid fa-calendar mr-1"></i> Año académico</label>
                    <input type="number" id="filtro-anio" class="form-control" min="2000" max="2099" />
                </div>
                <div class="col-md-4 form-group mb-md-0">
                    <label for="filtro-parcial"><i class="fa-solid fa-list-check mr-1"></i> Parcial</label>
                    <select id="filtro-parcial" class="custom-select">
                        <option value="">-- Seleccione --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button id="btn-filtrar" class="btn btn-primary w-100">
                        <i class="fa-solid fa-magnifying-glass mr-1"></i> Consultar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- KPIs -->
    <div id="rps-kpis" class="row" style="display:none">
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-promedio">—</h6>
                            <p>Promedio General</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-chart-line"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-alumnos">—</h6>
                            <p>Total Alumnos</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-user-graduate"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-secciones">—</h6>
                            <p>Secciones</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-layer-group"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-cursos">—</h6>
                            <p>Cursos evaluados</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-book"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Container -->
    <div id="rendimiento-container">
        <div id="rendimiento-inicial">
            <div class="statbox widget box box-shadow">
                <div class="widget-content widget-content-area text-center text-muted py-5">
                    <i class="fa-solid fa-chart-column fa-3x mb-3"></i>
                    <h5>Sin consulta activa</h5>
                    <p class="mb-0">Selecciona el año y parcial para ver el rendimiento de cada sección.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/rendimientoporseccion.js"></script>
    <script>
        RendimientoPorSeccion.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("DropdownsAsync")"
        );
    </script>
}
