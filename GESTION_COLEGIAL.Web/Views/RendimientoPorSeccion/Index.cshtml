@{
    ViewBag.Title = "Rendimiento por Sección";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/rendimientoporseccion.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Rendimiento por Sección</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-chart-column rps-header-icon"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Rendimiento por Sección</h1>
                <p>Promedio y totales de alumnos por sección y parcial</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">

    <!-- Filtros -->
    <div class="rps-filter-card">
        <div class="rps-filter-grid">
            <div class="rps-filter-item">
                <label for="filtro-anio"><i class="fa-solid fa-calendar"></i> Año académico</label>
                <input type="number" id="filtro-anio" min="2000" max="2099" />
            </div>
            <div class="rps-filter-item">
                <label for="filtro-parcial"><i class="fa-solid fa-list-check"></i> Parcial</label>
                <select id="filtro-parcial">
                    <option value="">-- Seleccione --</option>
                </select>
            </div>
            <div class="rps-filter-item rps-filter-action">
                <button id="btn-filtrar" class="rps-btn-consultar">
                    <i class="fa-solid fa-magnifying-glass"></i> Consultar
                </button>
            </div>
        </div>
    </div>

    <!-- KPIs -->
    <div id="rps-kpis" class="rps-kpis" style="display:none">
        <div class="rps-kpi">
            <div class="rps-kpi-icon rps-kpi-icon-amber"><i class="fa-solid fa-chart-line"></i></div>
            <div class="rps-kpi-body">
                <div class="rps-kpi-label">Promedio General</div>
                <div class="rps-kpi-value" id="kpi-promedio">—</div>
            </div>
        </div>
        <div class="rps-kpi">
            <div class="rps-kpi-icon rps-kpi-icon-blue"><i class="fa-solid fa-user-graduate"></i></div>
            <div class="rps-kpi-body">
                <div class="rps-kpi-label">Total Alumnos</div>
                <div class="rps-kpi-value" id="kpi-alumnos">—</div>
            </div>
        </div>
        <div class="rps-kpi">
            <div class="rps-kpi-icon rps-kpi-icon-violet"><i class="fa-solid fa-layer-group"></i></div>
            <div class="rps-kpi-body">
                <div class="rps-kpi-label">Secciones</div>
                <div class="rps-kpi-value" id="kpi-secciones">—</div>
            </div>
        </div>
        <div class="rps-kpi">
            <div class="rps-kpi-icon rps-kpi-icon-green"><i class="fa-solid fa-book"></i></div>
            <div class="rps-kpi-body">
                <div class="rps-kpi-label">Cursos evaluados</div>
                <div class="rps-kpi-value" id="kpi-cursos">—</div>
            </div>
        </div>
    </div>

    <!-- Container -->
    <div id="rendimiento-container">
        <div id="rendimiento-inicial" class="rps-empty-state">
            <i class="fa-solid fa-chart-column"></i>
            <h3>Sin consulta activa</h3>
            <p>Selecciona el año y parcial para ver el rendimiento de cada sección.</p>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/rendimientoporseccion.js"></script>
    <script>
        RendimientoPorSeccion.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("DropdownsAsync")"
        );
    </script>
}
