@model GESTION_COLEGIAL.UI.Models.CalendarioDiaViewModel
@using GESTION_COLEGIAL.Business.Models
@using GESTION_COLEGIAL.UI.Models
@{
    var M = Model;
    var e = M.Evento;
    var cultura = CalendarioMesViewModel.Cultura;
    ViewBag.Title = M.EsNuevo ? "Agregar un día" : e.Eve_Titulo;
    string mesVolver = CalendarioMesViewModel.Clave(e.Eve_Inicio);
    string fmt = e.Eve_TodoElDia ? "yyyy-MM-dd" : "yyyy-MM-ddTHH:mm";
    var secSel = new HashSet<int>(M.Ids("seccion"));
    var rolSel = new HashSet<int>(M.Ids("rol"));
    var personas = M.Audiencia.Where(a => a.Eva_Tipo == "empleado" || a.Eva_Tipo == "alumno").ToList();
    var niveles = M.Secciones.GroupBy(s => s.Niv_Descripcion ?? "Sin nivel").ToList();
    int anioSecciones = M.AnioSecciones;
    string cuando = e.Eve_TodoElDia
        ? (e.VariosDias
            ? e.Eve_Inicio.ToString("dddd d 'de' MMMM", cultura) + " al " + e.Eve_Fin.ToString("dddd d 'de' MMMM 'de' yyyy", cultura)
            : e.Eve_Inicio.ToString("dddd d 'de' MMMM 'de' yyyy", cultura)) + " · todo el día"
        : e.Eve_Inicio.ToString("dddd d 'de' MMMM 'de' yyyy, HH:mm", cultura) + " a "
          + (e.VariosDias ? e.Eve_Fin.ToString("dddd d 'de' MMMM, HH:mm", cultura) : e.Eve_Fin.ToString("HH:mm"));
}

@section Styles{
    <link href="~/css/pages/calendario-escolar.css" rel="stylesheet" asp-append-version="true" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", new { mes = mesVolver })">Calendario escolar</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(M.EsNuevo ? "Agregar un día" : e.Eve_Titulo)</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">@(M.EsNuevo ? "Agregar un día" : e.Eve_Titulo)</h4>
        <p class="text-muted mb-0">
            @if (M.EsNuevo)
            {
                @:Se guarda como borrador. Publíquelo cuando esté listo para que el colegio lo vea.
            }
            else
            {
                @cuando
            }
        </p>
    </div>
    <div class="mt-2 mt-md-0">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", new { mes = mesVolver })"><i class="bi bi-arrow-left mr-1"></i> Volver al calendario</a>
    </div>
</div>

<div class="fluid-container cal-page">
    @Html.AntiForgeryToken()

    @if (!string.IsNullOrEmpty(M.Aviso))
    {
        <div class="alert alert-light-success mb-4" role="status">
            <i class="bi bi-check-circle mr-1" aria-hidden="true"></i> <strong>@M.Aviso</strong>
        </div>
    }

    <div class="row">
    <div class="col-xl-9">
    @if (!M.PuedeEditar)
    {
        @* ── Ficha de solo lectura ── *@
        <section class="statbox widget box box-shadow mb-4" aria-label="@e.Eve_Titulo">
            <div class="widget-content widget-content-area">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Tipo</dt>
                    <dd class="col-sm-9">
                        <span class="cal-tipo @e.Tipo.Clase"><i class="bi @e.Tipo.Icono" aria-hidden="true"></i> @e.Tipo.Etiqueta</span>
                        @if (e.Eve_CierraColegio)
                        {
                            <span class="text-danger small font-weight-bold ml-2"><i class="bi bi-lock-fill mr-1" aria-hidden="true"></i>@(e.EsParaTodos ? "El colegio cierra" : "Cierra para esas secciones")</span>
                        }
                    </dd>
                    <dt class="col-sm-3 text-muted">Cuándo</dt>
                    <dd class="col-sm-9">@cuando</dd>
                    @if (!string.IsNullOrWhiteSpace(e.Eve_Lugar))
                    {
                        <dt class="col-sm-3 text-muted">Dónde</dt>
                        <dd class="col-sm-9">@e.Eve_Lugar</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(e.Eve_Descripcion))
                    {
                        <dt class="col-sm-3 text-muted">Qué es</dt>
                        <dd class="col-sm-9 cal-ficha"><span class="d-block cal-ficha-texto">@e.Eve_Descripcion</span></dd>
                    }
                    <dt class="col-sm-3 text-muted">Para quién</dt>
                    <dd class="col-sm-9 mb-0">@(e.EsParaTodos ? "Todo el colegio" : e.Audiencia)</dd>
                </dl>
            </div>
        </section>
    }
    else
    {
        @if (!M.EsNuevo)
        {
            <div class="statbox widget box box-shadow mb-4" id="eve-estado">
                <div class="widget-content widget-content-area d-flex flex-wrap align-items-center justify-content-between">
                    <p class="mb-0 mr-3">
                        <strong id="eve-estado-texto">@(e.Eve_EsPublicado ? "En el calendario" : "Borrador")</strong>
                        <span class="text-muted" id="eve-estado-detalle">
                            · @(e.Eve_EsPublicado ? "" : "al publicarlo, ")@(e.Eve_CierraColegio ? (e.EsParaTodos ? "el colegio cierra" : "cierra para esas secciones") : "el colegio da clases")
                        </span>
                    </p>
                    <div class="d-flex align-items-center">
                        <button type="button" class="btn btn-primary mr-1" id="eve-publicar" @(e.Eve_EsPublicado ? "hidden" : "")>
                            <i class="bi bi-send mr-1"></i> Publicar
                        </button>
                        <div class="dropdown">
                            <button type="button" class="btn btn-outline-secondary" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Más opciones para @e.Eve_Titulo">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right">
                                <button type="button" class="dropdown-item" id="eve-despublicar" @(e.Eve_EsPublicado ? "" : "hidden")>
                                    <i class="bi bi-eye-slash mr-2"></i>Volver a borrador
                                </button>
                                <button type="button" class="dropdown-item text-danger" id="eve-quitar">
                                    <i class="bi bi-trash mr-2"></i>Quitar del calendario
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <form class="statbox widget box box-shadow mb-4" id="eve-form" novalidate aria-label="@(M.EsNuevo ? "Agregar un día" : "Cambiar " + e.Eve_Titulo)">
            <input type="hidden" id="eve-id" value="@e.Eve_Id" />

            <section class="widget-content widget-content-area" aria-label="Qué hay">
                <div class="form-group">
                    <label for="eve-titulo">Título</label>
                    <input class="form-control" id="eve-titulo" maxlength="150" required value="@e.Eve_Titulo"
                           placeholder="Título, p. ej. Vacaciones de medio año" autocomplete="off" />
                </div>

                <div class="form-row">
                    <div class="col-md-6 form-group">
                        <label for="eve-tipo">Tipo de día</label>
                        <select class="custom-select" id="eve-tipo">
                            @foreach (var t in TipoDiaCalendario.Todos)
                            {
                                <option value="@t.Codigo" data-cierra="@(t.CierraColegio ? "1" : "0")" selected="@(e.Eve_Tipo == t.Codigo)">
                                    @t.Etiqueta@(t.CierraColegio ? " — el colegio cierra" : "")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 form-group">
                        <label for="eve-lugar">Dónde (opcional)</label>
                        <input class="form-control" id="eve-lugar" maxlength="150" value="@e.Eve_Lugar" placeholder="Dónde (opcional)" autocomplete="off" />
                    </div>
                </div>

                <div class="alert alert-light-danger" id="eve-nota-cierre" role="note" @(e.Tipo.CierraColegio ? "" : "hidden")>
                    <i class="bi bi-lock-fill mr-1" aria-hidden="true"></i>
                    Una vez publicado, esos días no tienen pase de lista. Un feriado o cierre es de día completo.
                </div>

                <div class="form-group">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="eve-todo-dia" checked="@(e.Eve_TodoElDia || e.Tipo.CierraColegio)" disabled="@e.Tipo.CierraColegio" />
                        <label class="custom-control-label" for="eve-todo-dia">Todo el día</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="col-md-6 form-group">
                        <label for="eve-inicio">Empieza</label>
                        <input class="form-control" id="eve-inicio" type="@(e.Eve_TodoElDia ? "date" : "datetime-local")" required value="@e.Eve_Inicio.ToString(fmt)" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label for="eve-fin">Termina</label>
                        <input class="form-control" id="eve-fin" type="@(e.Eve_TodoElDia ? "date" : "datetime-local")" required value="@e.Eve_Fin.ToString(fmt)" />
                    </div>
                </div>

                <div class="form-group mb-0">
                    <label for="eve-descripcion">Qué es (opcional)</label>
                    <textarea class="form-control" id="eve-descripcion" rows="3" maxlength="2000" placeholder="Qué es (opcional)">@e.Eve_Descripcion</textarea>
                </div>
            </section>

            <section class="widget-content widget-content-area border-top" aria-labelledby="eve-para-quien">
                <h5 id="eve-para-quien">Para quién</h5>
                <p class="text-muted">Si no elige a nadie, es para todo el colegio.</p>

                <div class="form-group">
                    <label>Secciones del año <span id="eve-anio-secciones">@anioSecciones</span></label>
                    <div id="eve-secciones">
                        @if (M.Secciones.Count == 0)
                        {
                            <p class="text-muted">No hay secciones en este año lectivo.</p>
                        }
                        @foreach (var g in niveles)
                        {
                            <div class="mb-3 eve-grupo-nivel">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="font-weight-bold small text-uppercase">@g.Key</span>
                                    <button type="button" class="btn btn-sm btn-link eve-todo-nivel">Todo el nivel</button>
                                </div>
                                <div role="group" aria-label="@g.Key">
                                    @foreach (var s in g)
                                    {
                                        <div class="custom-control custom-checkbox custom-control-inline mb-1">
                                            <input type="checkbox" class="custom-control-input" id="eve-sec-@s.Sea_Id" name="eve-sec" value="@s.Sea_Id" checked="@secSel.Contains(s.Sea_Id)" />
                                            <label class="custom-control-label" for="eve-sec-@s.Sea_Id">@s.Sea_Nombre@(s.Ani_Anio != anioSecciones ? " (" + s.Ani_Anio + ")" : "")</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <p class="text-muted" id="eve-nota-dirigido" @(e.Tipo.CierraColegio ? "" : "hidden")>
                    Un feriado o cierre es para todo el colegio o para algunas secciones: no se dirige a roles ni a personas.
                </p>

                <div class="form-group" id="eve-campo-roles" @(e.Tipo.CierraColegio ? "hidden" : "")>
                    <label>Roles</label>
                    <div role="group" aria-label="Roles">
                        @foreach (var r in M.Roles)
                        {
                            <div class="custom-control custom-checkbox custom-control-inline mb-1">
                                <input type="checkbox" class="custom-control-input" id="eve-rol-@r.Rol_Id" name="eve-rol" value="@r.Rol_Id" checked="@rolSel.Contains(r.Rol_Id)" />
                                <label class="custom-control-label" for="eve-rol-@r.Rol_Id">@r.Rol_Etiqueta</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="form-group mb-0" id="eve-campo-personas" @(e.Tipo.CierraColegio ? "hidden" : "")>
                    <label for="eve-persona">Nombrar a una persona</label>
                    <div class="mb-2" id="eve-personas" aria-label="Personas nombradas">
                        @foreach (var p in personas)
                        {
                            <span class="badge outline-badge-primary mr-1 mb-1 eve-persona-chip" data-tipo="@p.Eva_Tipo" data-id="@p.Eva_RefId">
                                @p.Eva_Nombre <small>@p.Eva_Detalle</small>
                                <button type="button" class="btn btn-link btn-sm p-0 ml-1 eve-quitar-persona" aria-label="Quitar a @p.Eva_Nombre"><i class="bi bi-x"></i></button>
                            </span>
                        }
                    </div>
                    <input class="form-control" id="eve-persona" type="search" autocomplete="off"
                           placeholder="Escriba un nombre, p. ej. para una cita" />
                    <ul class="list-group mt-1" id="eve-resultados" hidden></ul>
                </div>
            </section>

            <div class="widget-content widget-content-area border-top">
                <div class="alert alert-light-danger" id="eve-error" role="alert" hidden></div>

                <div class="d-flex justify-content-end">
                    <a class="btn mr-2" href="@Url.Action("Index", new { mes = mesVolver })">Cancelar</a>
                    <button type="submit" class="btn @(M.EsNuevo || e.Eve_EsPublicado ? "btn-primary" : "btn-outline-primary")" id="eve-guardar">
                        @(M.EsNuevo ? "Guardar como borrador" : "Guardar")
                    </button>
                </div>
            </div>
        </form>

        @if (!M.EsNuevo)
        {
            <div class="modal fade" id="eve-modal-quitar" tabindex="-1" role="dialog" aria-labelledby="eve-quitar-titulo" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="eve-quitar-titulo">¿Quitar «@e.Eve_Titulo» del calendario?</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <div class="modal-body">
                            @if (e.Eve_EsPublicado && e.Eve_CierraColegio)
                            {
                                <p class="mb-0">Es un día en que el colegio cierra: al quitarlo, ese día vuelve a tener pase de lista.</p>
                            }
                            else
                            {
                                <p class="mb-0">Deja de aparecer en el calendario y en los paneles de inicio.</p>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn btn-danger" id="eve-confirmar-quitar"><i class="bi bi-trash mr-1"></i> Quitar</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/calendarioescolar.js" asp-append-version="true"></script>
    <script>
        CalendarioEscolar.initDia({
            puedeEditar: @(M.PuedeEditar ? "true" : "false"),
            esNuevo: @(M.EsNuevo ? "true" : "false"),
            id: @e.Eve_Id,
            titulo: @Json.Serialize(e.Eve_Titulo ?? ""),
            publicado: @(e.Eve_EsPublicado ? "true" : "false"),
            anioSecciones: @anioSecciones,
            urlGuardar: "@Url.Action("GuardarAsync")",
            urlPublicar: "@Url.Action("PublicarAsync")",
            urlQuitar: "@Url.Action("EliminarAsync")",
            urlSecciones: "@Url.Action("SeccionesAsync")",
            urlPersonas: "@Url.Action("BuscarPersonasAsync")"
        });
    </script>
}
