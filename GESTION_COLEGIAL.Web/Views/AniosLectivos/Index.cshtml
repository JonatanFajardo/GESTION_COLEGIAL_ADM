@model GESTION_COLEGIAL.Business.Models.AnioLectivoViewModel

@{
    ViewBag.Title = "Años Lectivos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Años Lectivos</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Años lectivos</h4>
        <p class="text-muted mb-0">Administre los años lectivos del colegio y seleccione el año de trabajo activo</p>
    </div>
    <div class="mt-2 mt-md-0">
        <a class="btn btn-primary" href="@Url.Action("Setup")">
            <i class="bi bi-plus-lg mr-1"></i> Nuevo año lectivo
        </a>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="row"><div class="col-12"><h4>Listado de años lectivos</h4></div></div>
    </div>
    <div class="widget-content widget-content-area">
        <div class="table-responsive">
            <table class="table table-hover nowrap" id="datatable" style="width:100%">
                <thead>
                    <tr>
                        <th>Año</th><th>Nombre</th><th>Inicio</th><th>Fin</th>
                        <th>Estado</th><th>Año activo</th><th>Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal eliminar -->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        @using (Ajax.BeginForm("DeleteAsync", "AniosLectivos", new AjaxOptions
        {
            HttpMethod = "Post",
            OnSuccess = "AniosLectivos.onDeleteSuccess",
            OnFailure = "AniosLectivos.onError"
        }, new { id = "form-delete" }))
        {
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalTitle">Eliminar año lectivo</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Ani_Id" id="delete-item-id" />
                    <p class="mb-3">¿Está seguro de eliminar el año <strong id="delete-item-name"></strong>?</p>
                    <div class="alert alert-light-danger mb-0" role="alert">
                        <i class="fas fa-exclamation-triangle mr-1"></i>
                        Esta acción es una baja lógica; el registro deja de listarse.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash mr-1"></i> Eliminar</button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal arrastrar estructura -->
<div class="modal fade" id="rollover-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="rolloverModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rolloverModalTitle"><i class="fas fa-copy mr-1"></i> Arrastrar estructura de otro año</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Copia períodos, secciones y asignaturas al año <strong id="rollover-destino-nombre" class="text-primary"></strong> como <b>borrador</b>. No arrastra alumnos ni docentes. Puede repetirse: omite lo que ya exista.</p>
                <input type="hidden" id="rollover-destino" />
                <div class="form-group mb-0">
                    <label for="rollover-origen">Año origen</label>
                    <select id="rollover-origen" class="custom-select"></select>
                </div>
                <div id="rollover-result" class="alert alert-light-success mt-3 mb-0" role="alert" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
                <button type="button" id="rollover-confirm" class="btn btn-primary">Arrastrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        var AniosLectivos = (function () {
            var table;
            // 1 Borrador · 2 Programado · 3 Abierto · 4 Cerrando · 5 Cerrado · 6 Archivado
            var estadoBadge = { 1: "badge-secondary", 2: "badge-info", 3: "badge-success", 4: "badge-warning", 5: "badge-danger", 6: "badge-dark" };
            var urls = {
                list: "@Url.Action("ListAsync")",
                setup: "@Url.Action("Setup")",
                setActivo: "@Url.Action("SetActivoAsync")",
                rollforward: "@Url.Action("RollForwardAsync", "Rollover")",
                cierre: "@Url.Action("Index", "CierreAnio")"
            };

            function notify(type, msg) {
                if (!msg) msg = (type === "error" ? "Ocurrió un error." : "Operación exitosa.");
                try { if (window.toastr) { toastr[type === "error" ? "error" : "success"](msg); return; } } catch (e) {}
                try { if (window.Swal) { Swal.fire({ icon: type === "error" ? "error" : "success", title: msg, timer: 2000, showConfirmButton: false }); return; } } catch (e) {}
            }
            function fdate(v) { return v ? String(v).substring(0, 10) : "—"; }
            function reload() { if (table) table.ajax.reload(null, false); }

            function init() {
                table = $("#datatable").DataTable({
                    ajax: { url: urls.list, dataSrc: "data" },
                    language: { url: "https://cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json" },
                    order: [[0, "desc"]],
                    columns: [
                        { data: "Ani_Anio" },
                        { data: "Ani_Nombre" },
                        { data: "Ani_FechaInicio", render: fdate },
                        { data: "Ani_FechaFin", render: fdate },
                        { data: null, orderable: false, render: function (r) { return '<span class="badge ' + (estadoBadge[r.Ani_Estado] || "badge-secondary") + '">' + (r.Ani_EstadoDescripcion || "") + '</span>'; } },
                        { data: null, orderable: false, render: function (r) { return r.Ani_EsActual ? '<span class="badge badge-primary"><i class="fas fa-check mr-1"></i>Activo</span>' : r.Ani_Estado === 6 ? '<span class="text-muted small">Archivado</span>' : '<button type="button" class="btn btn-sm btn-outline-primary btn-activar" data-id="' + r.Ani_Id + '">Marcar activo</button>'; } },
                        { data: null, orderable: false, render: function (r) {
                            // Año abierto, en cierre, cerrado o archivado: entra al asistente de cierre del año.
                            var cierre = r.Ani_Estado >= 3
                                ? '<a class="btn btn-sm btn-link text-warning btn-accion" href="' + urls.cierre + '?id=' + r.Ani_Id + '" title="' + (r.Ani_Estado === 3 ? 'Cerrar el año' : 'Cierre del año') + '"><i class="fas fa-flag-checkered"></i></a>'
                                : '';
                            return cierre + '<button type="button" class="btn btn-sm btn-link text-info btn-accion edit" data-id="' + r.Ani_Id + '" title="Configurar / editar"><i class="fas fa-pen"></i></button>' +
                                   '<button type="button" class="btn btn-sm btn-link text-primary btn-accion roll" data-anio="' + r.Ani_Anio + '" data-name="' + r.Ani_Nombre + '" title="Arrastrar estructura de otro año"><i class="fas fa-copy"></i></button>' +
                                   '<button type="button" class="btn btn-sm btn-link text-danger btn-accion del" data-id="' + r.Ani_Id + '" data-name="' + r.Ani_Nombre + '" title="Eliminar"><i class="fas fa-trash"></i></button>';
                        } }
                    ]
                });

                $("#datatable tbody").on("click", ".btn-activar", function () { setActivo($(this).data("id")); });
                $("#datatable tbody").on("click", ".btn-accion.edit", function () { window.location.href = urls.setup + "?id=" + $(this).data("id"); });
                $("#datatable tbody").on("click", ".btn-accion.roll", function () { openRollover($(this).data("anio"), $(this).data("name")); });
                $("#rollover-confirm").on("click", confirmRollover);
                $("#datatable tbody").on("click", ".btn-accion.del", function () {
                    $("#delete-item-id").val($(this).data("id"));
                    $("#delete-item-name").text($(this).data("name"));
                    $("#delete-modal").modal("show");
                });
            }

            function openRollover(destinoAnio, destinoNombre) {
                $("#rollover-destino").val(destinoAnio);
                $("#rollover-destino-nombre").text(destinoNombre || destinoAnio);
                $("#rollover-result").hide().empty();
                var $sel = $("#rollover-origen").empty();
                table.rows().data().each(function (r) {
                    if (parseInt(r.Ani_Anio, 10) !== parseInt(destinoAnio, 10)) {
                        $sel.append('<option value="' + r.Ani_Anio + '">' + r.Ani_Nombre + '</option>');
                    }
                });
                if ($sel.children().length === 0) $sel.append('<option value="">(no hay otro año)</option>');
                $("#rollover-modal").modal("show");
            }

            function confirmRollover() {
                var origen = $("#rollover-origen").val(), destino = $("#rollover-destino").val();
                if (!origen || !destino) { notify("error", "Seleccione un año origen válido."); return; }
                var $btn = $("#rollover-confirm").prop("disabled", true).text("Arrastrando…");
                $.post(urls.rollforward, { origen: origen, destino: destino })
                    .done(function (resp) {
                        var it = resp && resp.item ? resp.item : null;
                        if (!it) { notify("error", "No se pudo arrastrar la estructura."); return; }
                        $("#rollover-result").html('<b>Copiado:</b> ' + it.PeriodosCopiados + ' período(s), ' + it.SeccionesCopiadas + ' sección(es), ' + it.OfertasCopiadas + ' asignatura(s).').show();
                        notify("success", "Estructura arrastrada como borrador.");
                        reload();
                    })
                    .fail(function () { notify("error"); })
                    .always(function () { $btn.prop("disabled", false).text("Arrastrar"); });
            }

            function setActivo(id) {
                $.post(urls.setActivo, { id: id })
                    .done(function (resp) { notify(resp && resp.success === false ? "error" : "success", resp && resp.message); reload(); })
                    .fail(function () { notify("error"); });
            }
            function onDeleteSuccess(resp) {
                if (resp && resp.success === false) { notify("error", resp.message); return; }
                $("#delete-modal").modal("hide"); notify("success", resp && resp.message); reload();
            }
            function onError() { notify("error"); }

            return { init: init, onDeleteSuccess: onDeleteSuccess, onError: onError };
        })();

        $(function () { AniosLectivos.init(); });
    </script>
}
