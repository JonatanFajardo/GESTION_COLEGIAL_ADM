@model GESTION_COLEGIAL.Business.Models.AnioLectivoViewModel
@{
    ViewBag.Title = "Configurar Año Lectivo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int step = (int)(ViewBag.Step ?? 1);
    int id = Model != null ? Model.Ani_Id : 0;
    string[] titulos = { "Fechas y períodos", "Enfoque de enseñanza", "Clases y profesores", "Asignaturas para este año", "Revisar y publicar" };
    string fIni = Model != null && Model.Ani_FechaInicio.HasValue ? Model.Ani_FechaInicio.Value.ToString("yyyy-MM-dd") : "";
    string fFin = Model != null && Model.Ani_FechaFin.HasValue ? Model.Ani_FechaFin.Value.ToString("yyyy-MM-dd") : "";
}

<div class="row">
<div class="col-xl-10 mx-auto">
    <div class="breadcrumb-wrapper-content">
        <nav class="breadcrumb-style-one" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">Años Lectivos</a></li>
                <li class="breadcrumb-item active">Configurar</li>
            </ol>
        </nav>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
        <div class="mr-3">
            <h4 class="mb-1">Configurar un año lectivo</h4>
            <p class="text-muted mb-0">Paso @step de 5 · @titulos[step - 1]</p>
        </div>
        <span class="text-muted small">@DateTime.Now.ToString("ddd, dd MMM yyyy")</span>
    </div>

    <!-- Stepper -->
    <div class="d-flex justify-content-between mb-4">
        @for (int i = 1; i <= 5; i++)
        {
            string cls = i < step ? "badge-primary" : (i == step ? "outline-badge-primary" : "outline-badge-secondary");
            <div class="flex-fill text-center px-1">
                <span class="badge badge-pill @cls px-3 py-2 mb-2">@(i < step ? "✓" : i.ToString())</span>
                <div class="small @(i <= step ? "font-weight-bold" : "text-muted")">@titulos[i - 1]</div>
            </div>
        }
    </div>

    <div class="statbox widget box box-shadow mb-4">
      <div class="widget-content widget-content-area">
        @switch (step)
        {
            case 1:
                <h4 class="mb-1">Fechas y períodos</h4>
                <p class="text-muted mb-4">Define el rango del ciclo escolar y su estructura de reporte.</p>
                using (Html.BeginForm("SetupStep1", "AniosLectivos", FormMethod.Post))
                {
                    @Html.Hidden("Ani_Id", id)
                    @Html.Hidden("Ani_Estado", (int)(Model != null ? Model.Ani_Estado : (byte)1))
                    <div class="form-row">
                        <div class="col-md-4 form-group">
                            <label for="Ani_Anio">Año <span class="text-danger">*</span></label>
                            <input type="number" name="Ani_Anio" id="Ani_Anio" class="form-control" min="1900" max="2100" required
                                   value="@(Model != null && Model.Ani_Anio > 0 ? Model.Ani_Anio.ToString() : "")" placeholder="2027" />
                        </div>
                        <div class="col-md-8 form-group">
                            <label for="Ani_Nombre">Nombre <span class="text-danger">*</span></label>
                            <input type="text" name="Ani_Nombre" id="Ani_Nombre" class="form-control" maxlength="20" required
                                   value="@(Model != null ? Model.Ani_Nombre : "")" placeholder="Ej: 2027 o 2027-2028" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-md-6 form-group">
                            <label for="Ani_FechaInicio">Fecha de inicio</label>
                            <input type="date" name="Ani_FechaInicio" id="Ani_FechaInicio" class="form-control" value="@fIni" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label for="Ani_FechaFin">Fecha de fin</label>
                            <input type="date" name="Ani_FechaFin" id="Ani_FechaFin" class="form-control" value="@fFin" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-md-12 form-group">
                            <label for="estructura">Estructura de reporte</label>
                            <select class="custom-select" id="estructura" disabled>
                                <option>2 semestres</option>
                                <option selected>3 trimestres</option>
                                <option>4 parciales</option>
                                <option>Personalizado</option>
                            </select>
                        </div>
                    </div>
                    <div class="alert alert-light-warning mt-3" role="alert"><i class="fas fa-info-circle mr-1"></i> El detalle de los <strong>períodos de reporte</strong> (parciales/semestres con sus fechas) se configura en la siguiente fase. Por ahora el paso 1 guarda el año, nombre y fechas como <strong>borrador</strong>.</div>
                    <div class="d-flex flex-wrap align-items-center justify-content-between mt-4">
                        <a href="@Url.Action("Index")" class="btn">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            @(id == 0 ? "Crear borrador y continuar" : "Guardar y continuar") <i class="bi bi-arrow-right ml-1"></i>
                        </button>
                    </div>
                }

                <div class="border-top pt-4 mt-4">
                    <h5 class="mb-1">Períodos de reporte</h5>
                    <p class="text-muted mb-4">Parciales / semestres del año con sus fechas.</p>
                    @if (id == 0)
                    {
                        <div class="alert alert-light-warning mt-3" role="alert"><i class="fas fa-info-circle mr-1"></i> Guarda el año (botón de arriba) para poder definir sus períodos.</div>
                    }
                    else
                    {
                        <table class="table table-sm table-hover" id="tblPeriodos">
                            <thead><tr><th>Nombre</th><th>Tipo</th><th>Inicio</th><th>Fin</th><th></th></tr></thead>
                            <tbody></tbody>
                        </table>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddPeriodo"><i class="bi bi-plus-lg mr-1"></i> Agregar período</button>
                        <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            var aniId = @id;
                            var urlList = '@Url.Action("ListAsync","PeriodosAnio")';
                            var urlCreate = '@Url.Action("CreateAsync","PeriodosAnio")';
                            var urlDelete = '@Url.Action("DeleteAsync","PeriodosAnio")';
                            var $b = $('#tblPeriodos tbody');
                            function rowHtml(p){ p=p||{};
                                return '<tr data-id="'+(p.Pan_Id||0)+'">'
                                 +'<td><input class="form-control form-control-sm p-nom" maxlength="40" value="'+(p.Pan_Nombre||'')+'" placeholder="I Parcial"></td>'
                                 +'<td><select class="custom-select custom-select-sm p-tipo">'
                                   +['parcial','bimestre','trimestre','semestre','otro'].map(function(t){return '<option'+((p.Pan_Tipo===t)?' selected':'')+'>'+t+'</option>';}).join('')
                                 +'</select></td>'
                                 +'<td><input type="date" class="form-control form-control-sm p-ini" value="'+(p.Pan_FechaInicio?p.Pan_FechaInicio.substring(0,10):'')+'"></td>'
                                 +'<td><input type="date" class="form-control form-control-sm p-fin" value="'+(p.Pan_FechaFin?p.Pan_FechaFin.substring(0,10):'')+'"></td>'
                                 +'<td class="text-nowrap"><button type="button" class="btn btn-sm btn-success p-save" title="Guardar"><i class="fas fa-check"></i></button> '
                                   +'<button type="button" class="btn btn-sm btn-danger p-del" title="Quitar"><i class="fas fa-trash"></i></button></td></tr>';
                            }
                            function load(){ $.getJSON(urlList,{anioId:aniId},function(res){ var d=(res&&res.data)?res.data:(res||[]); $b.empty(); d.forEach(function(p){$b.append(rowHtml(p));}); }); }
                            $('#btnAddPeriodo').on('click',function(){ $b.append(rowHtml({})); });
                            $b.on('click','.p-save',function(){ var $r=$(this).closest('tr');
                                var m={Pan_Id:parseInt($r.data('id'),10)||0,Ani_Id:aniId,Pan_Nombre:$r.find('.p-nom').val().trim(),Pan_Tipo:$r.find('.p-tipo').val(),Pan_Orden:$r.index()+1,Pan_FechaInicio:$r.find('.p-ini').val()||null,Pan_FechaFin:$r.find('.p-fin').val()||null,Pan_Estado:1};
                                if(!m.Pan_Nombre){alert('El nombre es requerido.');return;}
                                $.post(urlCreate,m,function(){load();}); });
                            $b.on('click','.p-del',function(){ var $r=$(this).closest('tr'); var id=parseInt($r.data('id'),10)||0; if(!id){$r.remove();return;} if(!confirm('¿Quitar período?'))return; $.post(urlDelete,{Pan_Id:id},function(){load();}); });
                            load();
                        });
                        </script>
                    }
                </div>
                break;

            case 2:
                <h4 class="mb-1">Elige el enfoque de enseñanza</h4>
                <p class="text-muted mb-4">Establece la agrupación predeterminada para los grupos de este año.</p>
                <div class="custom-control custom-radio border rounded py-3 pr-3 pl-5 mb-2"><input type="radio" class="custom-control-input" id="enf-grupo_fijo" name="Enf_Modelo" value="grupo_fijo" checked /><label class="custom-control-label" for="enf-grupo_fijo"><strong>Un mismo grupo todo el día</strong> — el alumno permanece con su sección (homeroom).</label></div>
                <div class="custom-control custom-radio border rounded py-3 pr-3 pl-5 mb-2"><input type="radio" class="custom-control-input" id="enf-hibrido" name="Enf_Modelo" value="hibrido" /><label class="custom-control-label" for="enf-hibrido"><strong>Un grupo, con excepciones</strong> — híbrido (base fija + bloques por materia).</label></div>
                <div class="custom-control custom-radio border rounded py-3 pr-3 pl-5 mb-2"><input type="radio" class="custom-control-input" id="enf-horario_materias" name="Enf_Modelo" value="horario_materias" /><label class="custom-control-label" for="enf-horario_materias"><strong>Horario de materias separadas</strong> — cada materia tiene su propio bloque.</label></div>
                <label for="Enf_Razon" class="mt-3">Razón (opcional)</label>
                <textarea id="Enf_Razon" class="form-control" rows="3" maxlength="500" placeholder="¿Por qué este enfoque para el año?"></textarea>
                <div class="d-flex flex-wrap align-items-center justify-content-between mt-4">
                    <a href="@Url.Action("Setup", new { id = id, step = 1 })" class="btn"><i class="bi bi-arrow-left mr-1"></i> Atrás</a>
                    <button type="button" class="btn btn-primary" onclick="guardarEnfoque(@id)">Guardar y continuar <i class="bi bi-arrow-right ml-1"></i></button>
                </div>
                <script>
                    function guardarEnfoque(aniId){
                        var m=document.querySelector('input[name="Enf_Modelo"]:checked');
                        if(!m){alert('Selecciona un enfoque.');return;}
                        fetch('@Url.Action("SetupStep2","AniosLectivos")',{method:'POST',headers:{'Content-Type':'application/json'},
                            body:JSON.stringify({Ani_Id:aniId,Enf_Modelo:m.value,Enf_Razon:document.getElementById('Enf_Razon').value})})
                        .then(function(r){return r.json();})
                        .then(function(res){ if(res&&res.success!==false){ window.location='@Url.Action("Setup","AniosLectivos")'+'?id='+aniId+'&step=3'; } else { alert('No se pudo guardar el enfoque.'); } })
                        .catch(function(){alert('Error de red.');});
                    }
                </script>
                break;

            case 3:
                <h4 class="mb-1">Clases y profesores</h4>
                <p class="text-muted mb-4">Crea las secciones del año y asigna el docente guía (homeroom).</p>
                @if (id == 0)
                {
                    <div class="alert alert-light-warning" role="alert">Primero crea el borrador (paso 1) para agregar secciones.</div>
                }
                else
                {
                    <div class="form-row">
                        <div class="col-md-3"><label for="f4Nivel">Nivel</label><select id="f4Nivel" class="custom-select"><option value="">Seleccione…</option></select></div>
                        <div class="col-md-3"><label for="f4Grado">Grado</label><select id="f4Grado" class="custom-select" disabled><option value="">Seleccione…</option></select></div>
                        <div class="col-md-2"><label for="f4Seccion">Sección</label><select id="f4Seccion" class="custom-select" disabled><option value="">Seleccione…</option></select></div>
                        <div class="col-md-2"><label for="f4Mod">Modalidad</label><select id="f4Mod" class="custom-select" disabled><option value="">—</option></select></div>
                        <div class="col-md-2"><label for="f4Cupo">Cupo</label><input type="number" id="f4Cupo" class="form-control" min="1" /></div>
                    </div>
                    <div class="form-row mt-2">
                        <div class="col-md-10"><label for="f4Profe">Profesor guía (opcional)</label><select id="f4Profe" class="custom-select" disabled><option value="">— Sin asignar —</option></select></div>
                        <div class="col-md-2 d-flex align-items-end"><button type="button" id="f4Add" class="btn btn-primary btn-block" disabled><i class="bi bi-plus-lg mr-1"></i> Agregar</button></div>
                    </div>
                    <div class="d-flex justify-content-end mt-3">
                        <button type="button" id="f4Cupos" class="btn btn-outline-primary btn-sm"><i class="bi bi-sliders mr-1" aria-hidden="true"></i> Editar cupos</button>
                    </div>
                    <partial name="_CuposAnio" />
                    <script src="~/Content/js/components/cupos-anio.js" asp-append-version="true"></script>
                    <table class="table table-sm table-hover mt-2">
                        <thead><tr><th>Nivel</th><th>Grado</th><th>Sección</th><th>Modalidad</th><th>Profe guía</th><th>Cupo</th><th>Estado</th><th></th></tr></thead>
                        <tbody id="f4Body"><tr><td colspan="8" class="text-center text-muted">Cargando…</td></tr></tbody>
                    </table>
                    <script>
                    document.addEventListener('DOMContentLoaded',function(){
                        var aniId=@id, grados=[];
                        var $n=$('#f4Nivel'),$g=$('#f4Grado'),$s=$('#f4Seccion'),$m=$('#f4Mod'),$p=$('#f4Profe'),$c=$('#f4Cupo'),$a=$('#f4Add'),$b=$('#f4Body');
                        function opt(v,t){return '<option value="'+v+'">'+t+'</option>';}
                        function ready(){ $a.prop('disabled',!($n.val()&&$g.val()&&$s.val())); }
                        $.getJSON('@Url.Action("ListAsync","NivelesEducativos")',function(r){(r.data||[]).forEach(function(x){$n.append(opt(x.Niv_Id,x.Niv_Descripcion));});});
                        $.getJSON('@Url.Action("ListAsync","CursosNiveles")',function(r){grados=r.data||[];});
                        $.getJSON('@Url.Action("ListAsync","Secciones")',function(r){(r.data||[]).forEach(function(x){$s.append(opt(x.Sec_Id,x.Sec_Descripcion));});});
                        $.getJSON('@Url.Action("ListAsync","Modalidades")',function(r){(r.data||[]).forEach(function(x){$m.append(opt(x.Mda_Id,x.Mda_Descripcion));});});
                        $.getJSON('@Url.Action("ListAsync","Empleados")',function(r){(r.data||[]).forEach(function(x){$p.append(opt(x.Emp_Id,x.Emp_Nombre||''));});});
                        $n.on('change',function(){var nv=parseInt(this.value,10);$g.html('<option value="">Seleccione…</option>').prop('disabled',true);$s.val('').prop('disabled',true);$m.val('').prop('disabled',true);$p.val('').prop('disabled',true);
                            if(nv){grados.filter(function(x){return x.Niv_Id===nv;}).forEach(function(x){$g.append(opt(x.Cun_Id,x.Cun_Descripcion));});$g.prop('disabled',false);} ready();});
                        $g.on('change',function(){var ok=!!this.value;$s.prop('disabled',!ok);$m.prop('disabled',!ok);$p.prop('disabled',!ok); if(!ok){$s.val('');$m.val('');$p.val('');} ready();});
                        $s.on('change',ready);
                        function load(){ $.getJSON('@Url.Action("ListAsync","SeccionesAnio")'+'?aniId='+aniId,function(r){var rows=(r&&r.data)||[];
                            if(!rows.length){$b.html('<tr><td colspan="8" class="text-center text-muted">Aún no hay secciones.</td></tr>');return;}
                            $b.html(rows.map(function(x){return '<tr><td>'+(x.Niv_Descripcion||'')+'</td><td>'+(x.Cun_Descripcion||'')+'</td><td>'+(x.Sec_Descripcion||'')+'</td><td>'+(x.Mda_Descripcion||'—')+'</td><td>'+(x.Emp_Nombre||'<span class="text-muted">Sin asignar</span>')+'</td><td>'+(x.Sea_Cupo||'—')+'</td><td>'+(x.Sea_EstadoDescripcion||'')+'</td><td><button type="button" class="btn btn-sm btn-danger f4-del" data-id="'+x.Sea_Id+'"><i class="fas fa-trash"></i></button></td></tr>';}).join(''));});}
                        $a.on('click',function(){var model={Sea_Id:0,Ani_Id:aniId,Niv_Id:parseInt($n.val(),10),Cun_Id:parseInt($g.val(),10),Sec_Id:parseInt($s.val(),10),Mda_Id:$m.val()?parseInt($m.val(),10):null,Emp_Id:$p.val()?parseInt($p.val(),10):null,Sea_Cupo:$c.val()?parseInt($c.val(),10):null,Sea_Nombre:($g.find('option:selected').text()+' '+$s.find('option:selected').text()).trim(),Sea_Estado:2};
                            $a.prop('disabled',true); $.post('@Url.Action("CreateAsync","SeccionesAnio")',model,function(res){ if(res&&res.success){$n.val('').trigger('change');$c.val('');load();}else{alert('No se pudo agregar (¿sección duplicada?).');ready();} });});
                        $b.on('click','.f4-del',function(){if(!confirm('¿Eliminar sección?'))return;$.post('@Url.Action("DeleteAsync","SeccionesAnio")',{Sea_Id:$(this).data('id')},function(){load();});});
                        $('#f4Cupos').on('click',function(){ GcCupos.abrir(aniId,'',load); });
                        load();
                    });
                    </script>
                }
                break;

            case 4:
                <h4 class="mb-1">Asignaturas para este año</h4>
                <p class="text-muted mb-4">Define qué materias se dictan este año, en qué grado y con qué docente.</p>
                @if (id == 0)
                {
                    <div class="alert alert-light-warning" role="alert">Primero crea el borrador (paso 1) para agregar asignaturas.</div>
                }
                else
                {
                    <div class="form-row">
                        <div class="col-md-4"><label for="ofaMat">Materia</label><select id="ofaMat" class="custom-select"></select></div>
                        <div class="col-md-3"><label for="ofaGra">Grado</label><select id="ofaGra" class="custom-select"><option value="">— Todos —</option></select></div>
                        <div class="col-md-3"><label for="ofaDoc">Docente</label><select id="ofaDoc" class="custom-select"><option value="">— Sin asignar —</option></select></div>
                        <div class="col-md-1"><label for="ofaHrs">Hrs/sem</label><input type="number" id="ofaHrs" class="form-control" min="0" /></div>
                        <div class="col-md-1 d-flex align-items-end"><button type="button" id="ofaAdd" class="btn btn-primary btn-block" title="Agregar"><i class="bi bi-plus-lg"></i></button></div>
                    </div>
                    <table class="table table-sm table-hover mt-3">
                        <thead><tr><th>Materia</th><th>Grado</th><th>Docente</th><th>Hrs</th><th>Estado</th><th></th></tr></thead>
                        <tbody id="ofaBody"><tr><td colspan="6" class="text-center text-muted">Cargando…</td></tr></tbody>
                    </table>
                    <script>
                    document.addEventListener('DOMContentLoaded',function(){
                        var aniId=@id;
                        var $mat=$('#ofaMat'),$gra=$('#ofaGra'),$doc=$('#ofaDoc'),$hrs=$('#ofaHrs'),$b=$('#ofaBody');
                        function opt(v,t){return '<option value="'+v+'">'+t+'</option>';}
                        $.getJSON('@Url.Action("ListAsync","Materias")',function(r){(r.data||[]).forEach(function(x){$mat.append(opt(x.Mat_Id,x.Mat_Nombre));});});
                        $.getJSON('@Url.Action("ListAsync","CursosNiveles")',function(r){(r.data||[]).forEach(function(x){$gra.append(opt(x.Cun_Id,x.Cun_Descripcion));});});
                        $.getJSON('@Url.Action("ListAsync","Empleados")',function(r){(r.data||[]).forEach(function(x){$doc.append(opt(x.Emp_Id,x.Emp_Nombre||''));});});
                        function load(){ $.getJSON('@Url.Action("ListAsync","OfertasAnio")'+'?id='+aniId,function(r){var rows=(r&&r.data)||[];
                            if(!rows.length){$b.html('<tr><td colspan="6" class="text-center text-muted">Aún no hay asignaturas.</td></tr>');return;}
                            $b.html(rows.map(function(o){return '<tr><td>'+(o.Mat_Nombre||'')+'</td><td>'+(o.Cun_Descripcion||'—')+'</td><td>'+(o.Emp_Nombre||'<span class="text-muted">Sin asignar</span>')+'</td><td>'+(o.Ofa_HorasSemana!=null?o.Ofa_HorasSemana:'—')+'</td><td>'+(o.Ofa_EstadoDescripcion||'')+'</td><td><button type="button" class="btn btn-sm btn-danger ofa-del" data-id="'+o.Ofa_Id+'"><i class="fas fa-trash"></i></button></td></tr>';}).join(''));});}
                        $('#ofaAdd').on('click',function(){var mat=$mat.val(); if(!mat){alert('Seleccione una materia.');return;}
                            $.post('@Url.Action("CreateAsync","OfertasAnio")',{Ofa_Id:0,Ani_Id:aniId,Mat_Id:mat,Cun_Id:$gra.val()||null,Emp_Id:$doc.val()||null,Ofa_HorasSemana:$hrs.val()||null,Ofa_Estado:3},function(){$hrs.val('');load();});});
                        $b.on('click','.ofa-del',function(){if(!confirm('¿Quitar asignatura?'))return;$.post('@Url.Action("DeleteAsync","OfertasAnio")',{Ofa_Id:$(this).data('id')},function(){load();});});
                        load();
                    });
                    </script>
                }
                break;

            case 5:
                {
                    int cPer = ViewBag.CountPeriodos != null ? (int)ViewBag.CountPeriodos : 0;
                    int cSec = ViewBag.CountSecciones != null ? (int)ViewBag.CountSecciones : 0;
                    bool okFechas = !string.IsNullOrEmpty(fIni) && !string.IsNullOrEmpty(fFin);
                    <h4 class="mb-1">Revisar y publicar</h4>
                    <p class="text-muted mb-4">Revisa el resumen y publica el año lectivo.</p>
                    @if (TempData["PublishError"] != null)
                    {
                        <div class="alert alert-light-danger" role="alert"><i class="fas fa-exclamation-triangle mr-1"></i> @TempData["PublishError"]</div>
                    }
                    <div class="form-row">
                        <div class="col-6 mb-3"><p class="text-muted small mb-1">Año</p><p class="font-weight-bold mb-0">@(Model != null ? Model.Ani_Anio.ToString() : "—")</p></div>
                        <div class="col-6 mb-3"><p class="text-muted small mb-1">Nombre</p><p class="font-weight-bold mb-0">@(Model != null ? Model.Ani_Nombre : "—")</p></div>
                        <div class="col-6 mb-3"><p class="text-muted small mb-1">Inicio</p><p class="font-weight-bold mb-0">@(string.IsNullOrEmpty(fIni) ? "—" : fIni)</p></div>
                        <div class="col-6 mb-3"><p class="text-muted small mb-1">Fin</p><p class="font-weight-bold mb-0">@(string.IsNullOrEmpty(fFin) ? "—" : fFin)</p></div>
                    </div>
                    <div class="mt-3">
                        <h6 class="font-weight-bold">Requisitos para publicar</h6>
                        <div class="py-1">@(okFechas ? "✅" : "⬜") Fechas de inicio y fin</div>
                        <div class="py-1">@(cPer > 0 ? "✅" : "⬜") Al menos un período de reporte <span class="text-muted">(@cPer)</span></div>
                        <div class="py-1">@(cSec > 0 ? "✅" : "⬜") Al menos una sección <span class="text-muted">(@cSec)</span></div>
                    </div>
                    <div class="alert alert-light-warning mt-3" role="alert"><i class="fas fa-info-circle mr-1"></i> Al publicar, el estado del año pasa a <strong>Abierto</strong>. Si falta algún requisito, el botón te devolverá aquí con el detalle.</div>
                }
                break;
        }

        @if (step > 1 && step != 2)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between mt-4">
                <a href="@Url.Action("Setup", new { id = id, step = step - 1 })" class="btn"><i class="bi bi-arrow-left mr-1"></i> Atrás</a>
                @if (step < 5)
                {
                    <a href="@Url.Action("Setup", new { id = id, step = step + 1 })" class="btn btn-primary">Continuar <i class="bi bi-arrow-right ml-1"></i></a>
                }
                else
                {
                    using (Html.BeginForm("PublishAsync", "AniosLectivos", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.Hidden("id", id)
                        <button type="submit" class="btn btn-success"><i class="fas fa-check mr-1"></i> Publicar y finalizar</button>
                    }
                }
            </div>
            <div class="text-right mt-2">
                <a href="@Url.Action("Index")" class="btn btn-link">Guardar y finalizar más tarde</a>
            </div>
        }
      </div>
    </div>
</div>
</div>
