@{
    ViewBag.Title = "Directorio de Alumnos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Directorio de Alumnos</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-address-book" style="font-size:32px;"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Directorio de Alumnos</h1>
                <p>Datos de contacto de alumnos y encargados</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="row mb-3">
        <div class="col-md-3">
            <select id="filter-Cur_Id" class="form-control">
                <option value="">-- Todos los cursos --</option>
            </select>
        </div>
        <div class="col-md-3">
            <select id="filter-Sec_Id" class="form-control">
                <option value="">-- Todas las secciones --</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary btn-sm w-100" id="btn-filtrar">
                <i class="fa-solid fa-filter"></i> Filtrar
            </button>
        </div>
    </div>
    <div class="card-listado-catalogo">
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="datatable-alumnosdirectorio">
                    <thead>
                        <tr>
                            <th>Identidad</th>
                            <th>Alumno</th>
                            <th>Curso</th>
                            <th>Seccion</th>
                            <th>Encargado</th>
                            <th>Telefono</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/alumnosdirectorio.js"></script>
    <script>
        AlumnosDirectorio.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("CursosDropdown")",
            "@Url.Action("SeccionesDropdown")"
        );
    </script>
}
