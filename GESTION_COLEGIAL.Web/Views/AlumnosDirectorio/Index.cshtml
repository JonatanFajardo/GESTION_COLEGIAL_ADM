@{
    ViewBag.Title = "Directorio de Alumnos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Directorio de Alumnos</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Directorio de alumnos</h4>
        <p class="text-muted mb-0">Datos de contacto de alumnos y encargados.</p>
    </div>
</div>

<div>
    <div class="statbox widget box box-shadow mb-4">
    <div class="form-row align-items-end">
        <div class="col-md-3">
            <select id="filter-Cur_Id" class="custom-select">
                <option value="">-- Todos los cursos --</option>
            </select>
        </div>
        <div class="col-md-3">
            <select id="filter-Sec_Id" class="custom-select">
                <option value="">-- Todas las secciones --</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-primary w-100" id="btn-filtrar">
                <i class="fa-solid fa-filter mr-1"></i> Filtrar
            </button>
        </div>
    </div>
    </div>

    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable-alumnosdirectorio">
                    <thead>
                        <tr>
                            <th>Identidad</th>
                            <th>Alumno</th>
                            <th>Curso</th>
                            <th>Seccion</th>
                            <th>Encargado</th>
                            <th>Telefono</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/alumnosdirectorio.js"></script>
    <script>
        AlumnosDirectorio.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("CursosDropdown")",
            "@Url.Action("SeccionesDropdown")"
        );
    </script>
}
