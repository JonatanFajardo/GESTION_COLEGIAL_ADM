@{
    ViewBag.Title = "Bitácora de Actividad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Bitácora</li>
        </ol>
    </nav>
</div>
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Bitácora de Actividad</h4>
        <p class="text-muted mb-0">Registro de acciones realizadas en el sistema</p>
    </div>
</div>
<div class="fluid-container">
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="form-row">
                <div class="col-md-3 mb-2 mb-md-0">
                    <input type="number" id="filter-usu" class="form-control" placeholder="ID Usuario">
                </div>
                <div class="col-md-3 mb-2 mb-md-0">
                    <input type="text" id="filter-tabla" class="form-control" placeholder="Tabla (ej: tbAlumnos)">
                </div>
                <div class="col-md-2 mb-2 mb-md-0">
                    <input type="number" id="filter-top" class="form-control" placeholder="Top N" value="200">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btn-filtrar">
                        <i class="fa-solid fa-filter mr-1"></i> Filtrar
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable-bitacora">
                    <thead>
                        <tr>
                            <th>Fecha</th><th>Usuario</th><th>Tabla</th>
                            <th>Acción</th><th>Detalle</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Content/js/pages/bitacora.js"></script>
    <script>Bitacora.init("@Url.Action("ListAsync")");</script>
}
