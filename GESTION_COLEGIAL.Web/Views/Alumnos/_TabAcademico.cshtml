@{
    Layout = null;
    int alumnoId = ViewBag.AlumnoId;
    int anioActual = DateTime.Now.Year;
}
<div>
    <div id="boletin-provisional" hidden></div>

    <div class="statbox widget box box-shadow mb-3" id="panel-boletin">
        <div class="widget-header p-3 d-flex flex-wrap align-items-center justify-content-between">
            <h5 class="mb-2 mb-md-0"><i class="bi bi-journal-bookmark mr-2" aria-hidden="true"></i>Notas por semestre y parcial</h5>
            <div class="form-inline">
                <label for="f-anio-ficha" class="mr-2 small text-muted mb-0">Año</label>
                <select id="f-anio-ficha" class="custom-select custom-select-sm w-auto mr-3">
                    @for (var a = anioActual; a >= anioActual - 3; a--)
                    {
                        <option value="@a">@a</option>
                    }
                </select>
                <label for="f-sem-boletin" class="mr-2 small text-muted mb-0">Semestre</label>
                <select id="f-sem-boletin" class="custom-select custom-select-sm w-auto"></select>
            </div>
        </div>
        <div class="px-3 pb-3">
            <div class="d-flex align-items-baseline mb-3">
                <span class="text-muted mr-2">Promedio general</span>
                <span class="h4 mb-0 font-weight-bold text-primary" id="nb-promedio-general">-</span>
                <span class="text-muted small ml-2">(escala de 0 a 100)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0" id="tabla-boletin">
                    <thead><tr id="thead-boletin"></tr></thead>
                    <tbody id="tbody-boletin"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="statbox widget box box-shadow">
                <div class="widget-header p-3">
                    <h5 class="mb-0"><i class="bi bi-arrow-right-circle mr-2"></i>Acciones</h5>
                </div>
                <div class="p-3 d-flex flex-wrap">
                    <a href="/BoletinAdm" class="btn btn-sm btn-outline-primary mr-2 mb-2">
                        <i class="bi bi-file-earmark-text mr-1"></i>
                        Ver boletín completo <i class="bi bi-arrow-right ml-1"></i>
                    </a>
                    <a href="/NotasAdm" class="btn btn-sm btn-outline-primary mr-2 mb-2">
                        <i class="bi bi-journal-check mr-1"></i>
                        Ver cuaderno de notas <i class="bi bi-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/js/components/boletin-provisional.js" asp-append-version="true"></script>
<script src="~/Content/js/components/boletin-notas.js" asp-append-version="true"></script>
<script>
    BoletinNotas.incrustar({
        aluId: @alumnoId,
        anio: @anioActual,
        urlGet: "@Url.Action("BoletinAsync", "Alumnos")",
        urlPublicacion: "@Url.Action("PublicacionAsync", "Alumnos")",
        urlEscala: "@Url.Action("EscalaAsync", "Alumnos")",
        urlNotaMinima: "@Url.Action("NotaMinimaAsync", "Alumnos")",
        avisoProvisional: "#boletin-provisional"
    });
</script>
