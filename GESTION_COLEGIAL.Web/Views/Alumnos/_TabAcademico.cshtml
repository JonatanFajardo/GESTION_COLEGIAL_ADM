@using System.Linq
@using System.Collections.Generic
@{
    Layout = null;
    var anio = DateTime.Now.Year;

    // Utilidades locales para leer campos de un dynamic sin romper si no existen.
    Func<dynamic, string, object> getVal = (row, name) =>
    {
        if (row == null) return null;
        try
        {
            var dict = row as IDictionary<string, object>;
            if (dict != null)
            {
                object v;
                return dict.TryGetValue(name, out v) ? v : null;
            }
            var prop = ((object)row).GetType().GetProperty(name);
            return prop != null ? prop.GetValue(row, null) : null;
        }
        catch { return null; }
    };

    Func<object, decimal?> toDec = (v) =>
    {
        if (v == null) return null;
        decimal d;
        if (decimal.TryParse(v.ToString(), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out d)) return d;
        if (decimal.TryParse(v.ToString(), out d)) return d;
        return null;
    };

    Func<object, int?> toParcial = (v) =>
    {
        if (v == null) return null;
        int n;
        if (int.TryParse(v.ToString(), out n)) return n;
        // Ej: "Parcial 1" / "P1"
        var s = v.ToString();
        var digits = new string(s.Where(char.IsDigit).ToArray());
        if (int.TryParse(digits, out n)) return n;
        return null;
    };

    var items = Model as List<dynamic>;

    // Agrupar por materia y armar { materia, p1, p2, p3, promedio }
    var filas = new List<dynamic>();
    decimal promGeneral = 0m;
    string estadoRend = "Sin datos";
    string badgeClass = "bg-secondary";

    if (items != null && items.Any())
    {
        var grupos = items
            .GroupBy(r => (getVal(r, "Mat_Nombre") ?? getVal(r, "Mat_Descripcion") ?? "Sin materia").ToString())
            .ToList();

        foreach (var g in grupos)
        {
            decimal? p1 = null, p2 = null, p3 = null;
            foreach (var r in g)
            {
                var parNum = toParcial(getVal(r, "Par_Numero") ?? getVal(r, "Pac_Numero") ?? getVal(r, "Pac_Descripcion"));
                var nota = toDec(getVal(r, "Not_Nota") ?? getVal(r, "Nota"));
                if (parNum == 1) p1 = nota;
                else if (parNum == 2) p2 = nota;
                else if (parNum == 3) p3 = nota;
            }
            var notas = new[] { p1, p2, p3 }.Where(n => n.HasValue).Select(n => n.Value).ToList();
            decimal? prom = notas.Any() ? (decimal?)notas.Average() : null;
            filas.Add(new
            {
                Materia = g.Key,
                P1 = p1,
                P2 = p2,
                P3 = p3,
                Promedio = prom
            });
        }

        var promedios = filas
            .Select(f => (decimal?)f.Promedio)
            .Where(p => p.HasValue)
            .Select(p => p.Value)
            .ToList();

        if (promedios.Any())
        {
            promGeneral = promedios.Average();
            if (promGeneral >= 90) { estadoRend = "Sobresaliente"; badgeClass = "bg-success"; }
            else if (promGeneral >= 80) { estadoRend = "Bueno"; badgeClass = "bg-primary"; }
            else if (promGeneral >= 70) { estadoRend = "Regular"; badgeClass = "bg-warning text-dark"; }
            else { estadoRend = "Deficiente"; badgeClass = "bg-danger"; }
        }
    }

    Func<decimal?, string> fmt = (n) => n.HasValue ? n.Value.ToString("0.0") : "-";
}

<div class="af-tab-academico">
    @if (items == null || !items.Any())
    {
        <div class="af-empty text-center p-4">
            <i class="bi bi-inbox" style="font-size:2rem; color:#94a3b8;"></i>
            <div class="mt-2 text-muted">Sin notas registradas para el año @anio.</div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="af-section-card h-100">
                    <div class="af-section-header">
                        <h5 class="mb-0"><i class="bi bi-award me-2"></i>Promedio general</h5>
                    </div>
                    <div class="p-3 text-center">
                        <div style="font-size: 3rem; font-weight: 700; color: #4f46e5; line-height: 1;">
                            @promGeneral.ToString("0.0")
                        </div>
                        <div class="mt-2">
                            <span class="badge @badgeClass" style="font-size: 0.9rem;">@estadoRend</span>
                        </div>
                        <div class="text-muted small mt-3">Escala: 0 - 100 pts</div>
                    </div>
                </div>
            </div>

            <div class="col-md-8 mb-3">
                <div class="af-section-card h-100">
                    <div class="af-section-header d-flex align-items-center justify-content-between">
                        <h5 class="mb-0"><i class="bi bi-journal-bookmark me-2"></i>Notas por parcial</h5>
                        <small class="text-muted">Año lectivo @anio</small>
                    </div>
                    <div class="p-3">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Materia</th>
                                        <th class="text-center">I</th>
                                        <th class="text-center">II</th>
                                        <th class="text-center">III</th>
                                        <th class="text-center">Promedio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in filas)
                                    {
                                        var promFila = (decimal?)f.Promedio;
                                        var claseProm = (promFila.HasValue && promFila.Value < 70) ? "text-danger fw-bold" : "fw-bold";
                                        <tr>
                                            <td>@f.Materia</td>
                                            <td class="text-center">@fmt((decimal?)f.P1)</td>
                                            <td class="text-center">@fmt((decimal?)f.P2)</td>
                                            <td class="text-center">@fmt((decimal?)f.P3)</td>
                                            <td class="text-center @claseProm">@fmt(promFila)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="af-section-card">
                <div class="af-section-header">
                    <h5 class="mb-0"><i class="bi bi-arrow-right-circle me-2"></i>Acciones</h5>
                </div>
                <div class="p-3 d-flex flex-wrap gap-3">
                    <a href="/BoletinAdm" class="af-btn-link">
                        <i class="bi bi-file-earmark-text me-1"></i>
                        Ver boletín completo <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                    <a href="/NotasAdm" class="af-btn-link">
                        <i class="bi bi-journal-check me-1"></i>
                        Ver cuaderno de notas <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
