@using Newtonsoft.Json.Linq
@{
    Layout = null;
    var encargados = Model as System.Collections.Generic.List<dynamic>;

    // Helper: leer campo defensivo sobre JObject / ExpandoObject / POCO
    Func<dynamic, string, object> getVal = (obj, key) =>
    {
        if (obj == null) return null;
        try
        {
            var jo = obj as JObject;
            if (jo != null && jo.TryGetValue(key, System.StringComparison.OrdinalIgnoreCase, out var v))
                return v.Type == JTokenType.Null ? null : v.ToObject<object>();
        }
        catch { }
        try
        {
            var dict = obj as System.Collections.Generic.IDictionary<string, object>;
            if (dict != null && dict.ContainsKey(key)) return dict[key];
        }
        catch { }
        try
        {
            var prop = ((object)obj).GetType().GetProperty(key);
            if (prop != null) return prop.GetValue(obj);
        }
        catch { }
        return null;
    };

    Func<dynamic, string> nombreCompleto = (e) =>
    {
        var partes = new[] {
            (getVal(e, "Per_PrimerNombre") ?? "").ToString(),
            (getVal(e, "Per_SegundoNombre") ?? "").ToString(),
            (getVal(e, "Per_ApellidoPaterno") ?? "").ToString(),
            (getVal(e, "Per_ApellidoMaterno") ?? "").ToString()
        };
        return string.Join(" ", partes.Where(p => !string.IsNullOrWhiteSpace(p))).Trim();
    };

    Func<string, string> iniciales = (nombre) =>
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "?";
        var partes = nombre.Split(new[] { ' ' }, System.StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 2) return (partes[0][0].ToString() + partes[partes.Length - 2][0].ToString()).ToUpper();
        return partes[0][0].ToString().ToUpper();
    };

    // Paleta rotativa para avatares
    int aluId = ViewBag.AluId is int ai ? ai : 0;
    bool puedeEditar = ViewBag.PuedeEditar is bool pe && pe;
    var colores = new[] { "#4f46e5", "#f97316", "#10b981", "#06b6d4", "#8b5cf6", "#ef4444" };
}

@if (encargados == null || !encargados.Any())
{
    <div class="statbox widget box box-shadow text-center py-5">
        <i class="bi bi-inbox h1 text-muted d-block"></i>
        <h5>Sin encargados vinculados</h5>
        <p class="text-muted">Este alumno no tiene encargados registrados en el sistema.</p>
        @if (puedeEditar && aluId > 0)
        {
            <button type="button" class="btn btn-sm btn-primary mr-2 mb-2 af-fam-ligar" data-alu="@aluId">
                <i class="bi bi-link-45deg mr-1"></i> Ligar un encargado
            </button>
        }
        <a href="/Encargados/Index" class="btn btn-sm btn-outline-primary mr-2 mb-2">
            Gestionar encargados <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    return;
}

<div class="statbox widget box box-shadow">
    <div class="widget-header d-flex flex-wrap align-items-center justify-content-between mb-3">
        <h5 class="mb-0"><i class="bi bi-people-fill mr-2"></i>Encargados del alumno</h5>
        <span class="text-muted small">@encargados.Count registrado@(encargados.Count == 1 ? "" : "s")</span>
        @if (puedeEditar && aluId > 0)
        {
            <button type="button" class="btn btn-sm btn-primary af-fam-ligar" data-alu="@aluId">
                <i class="bi bi-link-45deg mr-1"></i> Ligar otro encargado
            </button>
        }
    </div>

    <div class="row">
        @{ var idx = 0; }
        @foreach (var enc in encargados)
        {
            var encId = getVal(enc, "Enc_Id");
            var nombre = nombreCompleto(enc);
            var parentesco = (getVal(enc, "Par_Descripcion") ?? "Sin parentesco").ToString();
            var telefono = (getVal(enc, "Per_Telefono") ?? "").ToString();
            var email = (getVal(enc, "Per_CorreoElectronico") ?? "").ToString();
            var direccion = (getVal(enc, "Per_Direccion") ?? "").ToString();
            var ocupacion = (getVal(enc, "Enc_Ocupacion") ?? "").ToString();
            var principalRaw = getVal(enc, "EncargadoPrincipal");
            var esPrincipal = false;
            if (principalRaw is bool b) { esPrincipal = b; }
            else if (principalRaw != null) { bool.TryParse(principalRaw.ToString(), out esPrincipal); }
            var color = colores[idx % colores.Length];
            idx++;

            <div class="col-md-6 mb-3"><div class="border rounded p-3 h-100">
                <div class="d-flex align-items-start">
                    <div class="af-avatar-circle rounded-circle d-flex align-items-center justify-content-center font-weight-bold text-white mr-3" style="background:@color;">
                        @iniciales(nombre)
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center flex-wrap mb-1">
                            <strong class="mr-2">@(string.IsNullOrWhiteSpace(nombre) ? "(Sin nombre)" : nombre)</strong>
                            @if (esPrincipal)
                            {
                                <span class="badge badge-primary">
                                    <i class="bi bi-star-fill"></i> Encargado principal
                                </span>
                            }
                        </div>
                        <div class="mb-2">
                            <span class="badge outline-badge-dark">@parentesco</span>
                            @if (!string.IsNullOrWhiteSpace(ocupacion))
                            {
                                <span class="badge outline-badge-secondary ml-1">@ocupacion</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(telefono))
                        {
                            <div class="small text-muted mb-1">
                                <i class="bi bi-telephone mr-1"></i>@telefono
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            <div class="small text-muted mb-1">
                                <i class="bi bi-envelope mr-1"></i>@email
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(direccion))
                        {
                            <div class="small text-muted mb-2">
                                <i class="bi bi-geo-alt mr-1"></i>@direccion
                            </div>
                        }
                        @if (encId != null)
                        {
                            <a href="/Encargados/Detalle/@encId" class="btn btn-sm btn-outline-primary mr-2 mb-2">
                                Ver ficha del encargado <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                        @if (puedeEditar && aluId > 0 && encId != null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger mb-2 af-fam-desligar" data-alu="@aluId" data-enc="@encId" data-nombre="@nombre">
                                <i class="bi bi-x-circle mr-1"></i> Desligar
                            </button>
                        }
                    </div>
                </div>
            </div></div>
        }
    </div>

    <div class="text-right mt-3">
        <a href="/Encargados/Index" class="btn btn-sm btn-outline-primary mr-2 mb-2">
            Ver todos los encargados <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>
