@model GESTION_COLEGIAL.Business.Models.AlumnoViewModel
@{
    ViewBag.Title = "Crear";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts {
    <script src="~/Content/js/form-alumnos.js"></script>
    <script src="~/Content/js/pages/alumnos.js"></script>
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/alumnos">Alumnos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Crear Alumno</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Registro de alumnos</h4>
        <p class="text-muted mb-0">Complete la información personal y académica del estudiante.</p>
    </div>
</div>

<div>
    @using (Html.BeginForm("Guardar", "Alumnos", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
    <div class="row">
        <!-- Columna Izquierda - Información Personal -->
        <div class="col-md-12 col-lg-7 mb-4">
            <div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4>Información Personal</h4></div></div>
                </div>

                <div class="widget-content widget-content-area">
                    <div class="form-group d-flex align-items-center justify-content-between">
                        <label class="mb-0">Estado del alumno</label>
                        <div class="d-flex align-items-center">
                            <span class="badge badge-success mr-2" id="statusBadge"><span id="statusDot"></span><span id="statusText">Activo</span></span>
                            <label class="switch s-outline s-outline-primary mb-0">
                                <input type="checkbox" id="statusToggle" checked>
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>
                    <hr />
                    @Html.HiddenFor(model => model.Alu_Id)
                    @Html.HiddenFor(model => model.Per_Id)

                    <div class="row">
                        @* Columna Identidad *@
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Identidad
                                </label>
                                @Html.EditorFor(model => model.Per_Identidad, new { htmlAttributes = new { type = "number", @class = "form-control", @minlength = "13", @placeholder = "0801200012345" } })
                                @Html.ValidationMessageFor(model => model.Per_Identidad, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        @* Columna Primer Nombre *@
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Primer Nombre
                                </label>
                                @Html.EditorFor(model => model.Per_PrimerNombre, new { htmlAttributes = new { @class = "form-control", @placeholder = "Juan" } })
                                @Html.ValidationMessageFor(model => model.Per_PrimerNombre, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        @* Columna Segundo Nombre *@
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Segundo Nombre
                                </label>
                                @Html.EditorFor(model => model.Per_SegundoNombre, new { htmlAttributes = new { @class = "form-control", @placeholder = "Carlos (opcional)" } })
                                @Html.ValidationMessageFor(model => model.Per_SegundoNombre, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        @* Columna Apellido Paterno *@
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Apellido Paterno
                                </label>
                                @Html.EditorFor(model => model.Per_ApellidoPaterno, new { htmlAttributes = new { @class = "form-control", @placeholder = "López" } })
                                @Html.ValidationMessageFor(model => model.Per_ApellidoPaterno, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        @* Columna Apellido Materno *@
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Apellido Materno
                                </label>
                                @Html.EditorFor(model => model.Per_ApellidoMaterno, new { htmlAttributes = new { @class = "form-control", @placeholder = "García (opcional)" } })
                                @Html.ValidationMessageFor(model => model.Per_ApellidoMaterno, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        @* Columna Fecha Nacimiento *@
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Fecha de Nacimiento
                                </label>
                                @Html.TextBoxFor(model => model.Per_FechaNacimiento, new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(model => model.Per_FechaNacimiento, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        @* Columna Correo Electronico *@
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Correo Electrónico
                                </label>
                                @Html.EditorFor(model => model.Per_CorreoElectronico, new { htmlAttributes = new { @class = "form-control", type = "email", @placeholder = "juan.lopez@correo.com" } })
                                @Html.ValidationMessageFor(model => model.Per_CorreoElectronico, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        @* Columna Teléfono *@
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Teléfono
                                </label>
                                @Html.EditorFor(model => model.Per_Telefono, new { htmlAttributes = new { @class = "form-control", @maxlength = "9", @placeholder = "9876-5432" } })
                                @Html.ValidationMessageFor(model => model.Per_Telefono, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        @* Columna Dirección *@
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Dirección
                                </label>
                                @Html.EditorFor(model => model.Per_Direccion, new { htmlAttributes = new { @class = "form-control", @placeholder = "Barrio El Centro, 2 cuadras al norte del parque" } })
                                @Html.ValidationMessageFor(model => model.Per_Direccion, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        @* Columna Sexo *@
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Sexo
                                </label>
                                @Html.EditorFor(model => model.Per_Sexo, new { htmlAttributes = new { @class = "form-control", @placeholder = "M / F", @maxlength = "1" } })
                                @Html.ValidationMessageFor(model => model.Per_Sexo, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-3">
                        @Html.ActionLink("Cancelar", "Index", "Alumnos", null, new { @class = "btn mr-2", @id = "cancelBtn" })
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save mr-1"></i> Guardar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha - Información Académica -->
        <div class="col-md-12 col-lg-5 mb-4">
            <div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4>Información Académica</h4></div></div>
                </div>

                <div class="widget-content widget-content-area">
                    <div class="row">
                        @* Columna Nivel Educativo *@
                        <div class="col-md-6 col-lg-12">
                            <div class="form-group">
                                <div class="d-flex align-items-center justify-content-between">
                                    <label for="Niv_Id">
                                        Nivel educativo
                                    </label>
                                    <a href="/NivelesEducativos/Index" target="_blank" class="btn btn-link btn-sm p-0 mb-2" title="Agregar nuevo nivel educativo"><i class="bi bi-plus-lg mr-1"></i>Agregar
                                    </a>
                                </div>
                                @Html.DropDownList("Niv_Id", Model.NivelesEducativosList, "-- Seleccionar Nivel Educativo --", htmlAttributes: new { @class = "custom-select" })
                                @Html.ValidationMessageFor(model => model.Niv_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        @* Columna Curso niveles *@
                        <div class="col-md-6 col-lg-12">
                            <div class="form-group">
                                <div class="d-flex align-items-center justify-content-between">
                                    <label for="Cun_Id">
                                        Curso niveles
                                    </label>
                                    <a href="/CursosNiveles/Index" target="_blank" class="btn btn-link btn-sm p-0 mb-2" title="Agregar nuevo curso nivel"><i class="bi bi-plus-lg mr-1"></i>Agregar
                                    </a>
                                </div>
                                @*@Html.DropDownList("Cun_Id", ViewBag.Niveles as List<SelectListItem>, "-- Seleccionar Curso --", htmlAttributes: new { @class = "custom-select" })*@
                                @Html.DropDownListFor(model => model.Cun_Id,
                                ViewBag.Niveles as List<SelectListItem> ?? new List<SelectListItem>(),
                                "-- Seleccionar Curso --",
                                new { @class = "custom-select" })

                                @Html.ValidationMessageFor(model => model.Cun_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        @* Columna Modalidades *@
                        <div class="col-md-6 col-lg-12">
                            <div class="form-group">
                                <div class="d-flex align-items-center justify-content-between">
                                    <label for="Mda_Id">
                                        Modalidad
                                    </label>
                                    <a href="/Modalidades/Index" target="_blank" class="btn btn-link btn-sm p-0 mb-2" title="Agregar nueva modalidad"><i class="bi bi-plus-lg mr-1"></i>Agregar
                                    </a>
                                </div>
                                @*@Html.DropDownList("Mda_Id", ViewBag.Modalidades as List<SelectListItem>, "-- Seleccionar Modalidad --", htmlAttributes: new { @class = "custom-select" })*@
                                @Html.DropDownListFor(model => model.Mda_Id,
                                ViewBag.Modalidades as List<SelectListItem> ?? new List<SelectListItem>(),
                                "-- Seleccionar Modalidad --",
                                new { @class = "custom-select" })
                                @Html.ValidationMessageFor(model => model.Mda_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        @* Columna Cursos *@
                        <div class="col-md-6 col-lg-12">
                            <div class="form-group">
                                <div class="d-flex align-items-center justify-content-between">
                                    <label for="Cur_Id">
                                        Cursos
                                    </label>
                                    <a href="/Cursos/Index" target="_blank" class="btn btn-link btn-sm p-0 mb-2" title="Agregar nuevo curso"><i class="bi bi-plus-lg mr-1"></i>Agregar
                                    </a>
                                </div>
                                @*@Html.DropDownList("Cur_Id", ViewBag.Cursos as List<SelectListItem>, "-- Seleccionar Curso --", htmlAttributes: new { @class = "custom-select" })*@
                                @Html.DropDownListFor(model => model.Cur_Id,
                                ViewBag.Cursos as List<SelectListItem> ?? new List<SelectListItem>(),
                                "-- Seleccionar Cursos --",
                                new { @class = "custom-select" })
                                @Html.ValidationMessageFor(model => model.Cur_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        @* Columna Secciones *@
                        <div class="col-md-6 col-lg-12">
                            <div class="form-group">
                                <div class="d-flex align-items-center justify-content-between">
                                    <label for="Sec_Id">
                                        Curso secciones
                                    </label>
                                    <a href="/Secciones/Index" target="_blank" class="btn btn-link btn-sm p-0 mb-2" title="Agregar nueva sección"><i class="bi bi-plus-lg mr-1"></i>Agregar
                                    </a>
                                </div>
                                @*@Html.DropDownList("Sec_Id", ViewBag.Secciones as List<SelectListItem>, "-- Seleccionar seccion --", htmlAttributes: new { @class = "custom-select" })*@
                                @Html.DropDownListFor(model => model.Sec_Id,
                                ViewBag.Secciones as List<SelectListItem> ?? new List<SelectListItem>(),
                                "-- Seleccionar Curso secciones --",
                                new { @class = "custom-select" })
                                @Html.ValidationMessageFor(model => model.Sec_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        @* Columna Estado *@
                        <div class="col-md-6 col-lg-12">
                            <div class="form-group">
                                <div class="d-flex align-items-center justify-content-between">
                                    <label for="Est_Id">
                                        Estado
                                    </label>
                                    <a href="/Estados/Index" target="_blank" class="btn btn-link btn-sm p-0 mb-2" title="Agregar nuevo estado"><i class="bi bi-plus-lg mr-1"></i>Agregar
                                    </a>
                                </div>
                                @Html.DropDownList("Est_Id", Model.EstadosList, "-- Seleccionar Estado --", htmlAttributes: new { @class = "custom-select" })
                                @Html.ValidationMessageFor(model => model.Est_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    }
</div>