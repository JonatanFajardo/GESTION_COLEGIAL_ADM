@model GESTION_COLEGIAL.Business.Models.AlumnoViewModel
@{
    ViewBag.Title = "Ficha del Alumno";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/Content/css/pages/alumno-ficha.css" rel="stylesheet" />
    <link href="~/css/pages/fichas-salud.css" rel="stylesheet" asp-append-version="true" />
}
@{
    var estadoColor = Model.Est_Descripcion == "Activo" ? "badge-success" :
                      Model.Est_Descripcion == "Suspendido" ? "badge-warning" :
                      Model.Est_Descripcion == "Graduado" ? "badge-primary" : "badge-secondary";

    var sexoTexto = Model.Per_Sexo == "M" ? "Masculino" : "Femenino";
    var sexoIcono = Model.Per_Sexo == "M" ? "bi-gender-male" : "bi-gender-female";

    var nombreCompleto = !string.IsNullOrEmpty(Model.Alu_Nombre)
        ? Model.Alu_Nombre
        : $"{Model.Per_PrimerNombre} {Model.Per_SegundoNombre} {Model.Per_ApellidoPaterno} {Model.Per_ApellidoMaterno}".Replace("  ", " ").Trim();

    var gradoDescripcion = !string.IsNullOrEmpty(Model.Cun_Descripcion) ? Model.Cun_Descripcion
                         : !string.IsNullOrEmpty(Model.Cno_Descripcion) ? Model.Cno_Descripcion
                         : null;

    // Pestaña "Salud": solo con el permiso "Fichas de salud" (el endpoint también lo exige).
    bool verSalud = (Session["RoleName"] as string ?? "").Equals("admin", StringComparison.OrdinalIgnoreCase)
                    || GESTION_COLEGIAL.UI.Filters.SessionManager.TienePantalla(Session["pantallas"] as string, "Fichas de salud");
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Alumnos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Ficha</li>
        </ol>
    </nav>
</div>

<div>

    <div class="statbox widget box box-shadow layout-top-spacing mb-4">
        <div class="d-flex flex-wrap align-items-center">
            <div class="mr-4 mb-2 text-center">
                @if (!string.IsNullOrEmpty(Model.Per_Imagen))
                {
                    var imageUrl = Model.Per_Imagen.Replace("~/", "/");
                    <img src="@imageUrl" alt="@nombreCompleto" class="af-avatar rounded-circle">
                }
                else
                {
                    <div class="af-avatar rounded-circle bg-light d-flex align-items-center justify-content-center text-muted h2 mb-0">
                        <i class="bi bi-person-fill"></i>
                    </div>
                }
                <div class="mt-2"><span class="badge outline-badge-primary">#@Model.Alu_Id.ToString().PadLeft(4, '0')</span></div>
            </div>

            <div class="flex-grow-1 mb-2">
                <h4 class="mb-1">@nombreCompleto</h4>
                <p class="text-muted mb-2">
                    <i class="bi bi-mortarboard-fill mr-1"></i> @Model.Niv_Descripcion
                    @if (!string.IsNullOrEmpty(gradoDescripcion))
                    {
                        <span> &mdash; @gradoDescripcion</span>
                    }
                </p>
                <div class="d-flex flex-wrap align-items-center text-muted small">
                    @if (!string.IsNullOrEmpty(Model.Per_Identidad))
                    {
                        <span class="mr-3"><i class="bi bi-card-text mr-1"></i>@Model.Per_Identidad</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Sec_Descripcion))
                    {
                        <span class="mr-3"><i class="bi bi-bookmark mr-1"></i>Sección @Model.Sec_Descripcion</span>
                    }
                    @if (Model.AnioCursado.HasValue && Model.AnioCursado > 0)
                    {
                        <span class="mr-3"><i class="bi bi-calendar-range mr-1"></i>@Model.AnioCursado</span>
                    }
                    <span class="badge @estadoColor">@Model.Est_Descripcion</span>
                </div>
            </div>

            <div class="mb-2">
                <a href="@Url.Action("FindAsync", new { id = Model.Alu_Id })" class="btn btn-primary mr-2 mb-1">
                    <i class="bi bi-pencil mr-1"></i> Editar
                </a>
                @if ((Session["RoleName"] as string ?? "").Equals("admin", StringComparison.OrdinalIgnoreCase)
                     || GESTION_COLEGIAL.UI.Filters.SessionManager.TienePantalla(Session["pantallas"] as string, "Constancias y expediente"))
                {
                    <a href="@Url.Action("Index", "Constancias", new { aluId = Model.Alu_Id })" class="btn btn-outline-primary mr-2 mb-1">
                        <i class="bi bi-file-earmark-text mr-1"></i> Constancias
                    </a>
                }
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary mb-1">
                    <i class="bi bi-arrow-left mr-1"></i> Volver
                </a>
            </div>
        </div>
    </div>

    <!-- ============================================================
         KPIs — cargados vía AJAX (AlumnoFicha.init)
         ============================================================ -->
    <div class="row">
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value af-kpi-value" id="af-kpi-promedio">—</h6>
                            <p>Promedio</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-mortarboard-fill"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2"><span id="af-kpi-promedio-trend">—</span></p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value af-kpi-value" id="af-kpi-asistencia">—</h6>
                            <p>Asistencia</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-check2-circle"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2"><span id="af-kpi-asistencia-trend">—</span></p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value af-kpi-value" id="af-kpi-cuenta">—</h6>
                            <p>Cuenta</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-cash-coin"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2"><span id="af-kpi-cuenta-trend">—</span></p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value af-kpi-value" id="af-kpi-tareas">—</h6>
                            <p>Tareas</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-journal-check"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2"><span id="af-kpi-tareas-trend">—</span></p>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================
         TABS
         ============================================================ -->
    <div class="mb-4">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item"><a href="#" class="nav-link af-tab active" data-tab="resumen" role="tab" aria-selected="true"><i class="bi bi-clipboard-data mr-1"></i>Resumen</a></li>
            <li class="nav-item"><a href="#" class="nav-link af-tab" data-tab="datos" role="tab" aria-selected="false"><i class="bi bi-person-vcard mr-1"></i>Datos</a></li>
            <li class="nav-item"><a href="#" class="nav-link af-tab" data-tab="academico" role="tab" aria-selected="false"><i class="bi bi-book mr-1"></i>Académico</a></li>
            <li class="nav-item"><a href="#" class="nav-link af-tab" data-tab="asistencia" role="tab" aria-selected="false"><i class="bi bi-calendar-check mr-1"></i>Asistencia</a></li>
            <li class="nav-item"><a href="#" class="nav-link af-tab" data-tab="pagos" role="tab" aria-selected="false"><i class="bi bi-cash-stack mr-1"></i>Pagos</a></li>
            <li class="nav-item"><a href="#" class="nav-link af-tab" data-tab="familia" role="tab" aria-selected="false"><i class="bi bi-people mr-1"></i>Familia</a></li>
            @if (verSalud)
            {
                <li class="nav-item"><a href="#" class="nav-link af-tab" data-tab="salud" role="tab" aria-selected="false"><i class="bi bi-heart-pulse mr-1"></i>Salud</a></li>
            }
            <li class="nav-item"><a href="#" class="nav-link af-tab" data-tab="documentos" role="tab" aria-selected="false"><i class="bi bi-file-earmark-text mr-1"></i>Documentos</a></li>
            <li class="nav-item"><a href="#" class="nav-link af-tab" data-tab="historial" role="tab" aria-selected="false"><i class="bi bi-clock-history mr-1"></i>Historial</a></li>
        </ul>
    </div>

    <!-- ============================================================
         TAB CONTENT — Resumen (default, lazy-load vía AJAX)
         ============================================================ -->
    <div class="af-tab-panel active" id="af-tab-content-resumen" role="tabpanel"></div>

    <!-- ============================================================
         TAB CONTENT — Datos (server-side, contenido actual del Detail)
         ============================================================ -->
    <div class="af-tab-panel" id="af-tab-content-datos" role="tabpanel" hidden>
        <div class="row">
            <!-- Columna izquierda: Nombres + Datos Personales -->
            <div class="col-md-6">
                <div class="statbox widget box box-shadow mb-4">
                    <div class="widget-header"><h5 class="mb-3"><i class="bi bi-person mr-2"></i>Nombres</h5></div>
                    <div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-person text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Primer Nombre</small>
                                <span class="font-weight-bold">@Model.Per_PrimerNombre</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-person text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Segundo Nombre</small>
                                <span class="font-weight-bold">@(string.IsNullOrEmpty(Model.Per_SegundoNombre) ? "—" : Model.Per_SegundoNombre)</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-person-badge text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Apellido Paterno</small>
                                <span class="font-weight-bold">@Model.Per_ApellidoPaterno</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-person-badge text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Apellido Materno</small>
                                <span class="font-weight-bold">@(string.IsNullOrEmpty(Model.Per_ApellidoMaterno) ? "—" : Model.Per_ApellidoMaterno)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="statbox widget box box-shadow mb-4">
                    <div class="widget-header"><h5 class="mb-3"><i class="bi bi-card-text mr-2"></i>Datos Personales</h5></div>
                    <div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-card-text text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Identidad</small>
                                <span class="font-weight-bold">@Model.Per_Identidad</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-calendar2-heart text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Fecha de Nacimiento</small>
                                <span class="font-weight-bold">@Model.Per_FechaNacimiento.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi @sexoIcono text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Sexo</small>
                                <span class="font-weight-bold">@sexoTexto</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="statbox widget box box-shadow mb-4">
                    <div class="widget-header"><h5 class="mb-3"><i class="bi bi-telephone mr-2"></i>Información de Contacto</h5></div>
                    <div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-telephone text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Teléfono</small>
                                <span class="font-weight-bold">@(string.IsNullOrEmpty(Model.Per_Telefono) ? "—" : Model.Per_Telefono)</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-envelope text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Correo Electrónico</small>
                                <span class="font-weight-bold">@(string.IsNullOrEmpty(Model.Per_CorreoElectronico) ? "—" : Model.Per_CorreoElectronico)</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-geo-alt text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Dirección</small>
                                <span class="font-weight-bold">@(string.IsNullOrEmpty(Model.Per_Direccion) ? "—" : Model.Per_Direccion)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="statbox widget box box-shadow mb-4">
                    <div class="widget-header"><h5 class="mb-3"><i class="bi bi-mortarboard mr-2"></i>Información Académica</h5></div>
                    <div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-layers text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Nivel Educativo</small>
                                <span class="font-weight-bold">@Model.Niv_Descripcion</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-hash text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Grado Académico</small>
                                <span class="font-weight-bold">@Model.Cno_Descripcion</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-grid text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Modalidad</small>
                                <span class="font-weight-bold">@Model.Mda_Descripcion</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-book text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Curso</small>
                                <span class="font-weight-bold">@Model.Cur_Descripcion</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-bookmark text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Sección</small>
                                <span class="font-weight-bold">@Model.Sec_Descripcion</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-calendar-range text-primary mr-3 mt-1"></i>
                            <div>
                                <small class="text-muted d-block">Año Cursado</small>
                                <span class="font-weight-bold">@Model.AnioCursado</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="statbox widget box box-shadow mb-4">
                    <div class="widget-header"><h5 class="mb-3"><i class="bi bi-clock-history mr-2"></i>Información de Registro</h5></div>
                    <div>
                <div class="d-flex align-items-start mb-3">
                    <i class="bi bi-plus-circle text-success mr-3 mt-1"></i>
                    <div>
                        <small class="text-muted d-block">Registrado por</small>
                        <div class="font-weight-bold">@Model.Per_UsuarioRegistraNombre</div>
                        <small class="text-muted">
                            <i class="bi bi-clock"></i> @Model.Per_FechaRegistra.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                </div>
                @if (Model.Per_FechaModifica.HasValue)
                {
                    <div class="d-flex align-items-start mb-3">
                    <i class="bi bi-pencil text-primary mr-3 mt-1"></i>
                        <div>
                            <small class="text-muted d-block">Modificado por</small>
                            <div class="font-weight-bold">@Model.Per_UsuarioModificaNombre</div>
                            <small class="text-muted">
                                <i class="bi bi-clock"></i> @Model.Per_FechaModifica.Value.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ============================================================
         TAB CONTENT — Placeholders (lazy-load vía AJAX)
         ============================================================ -->
    <div class="af-tab-panel" id="af-tab-content-academico"  role="tabpanel" hidden></div>
    <div class="af-tab-panel" id="af-tab-content-asistencia" role="tabpanel" hidden></div>
    <div class="af-tab-panel" id="af-tab-content-pagos"      role="tabpanel" hidden></div>
    <div class="af-tab-panel" id="af-tab-content-familia"    role="tabpanel" hidden></div>
    @if (verSalud)
    {
        <div class="af-tab-panel" id="af-tab-content-salud"  role="tabpanel" hidden></div>
    }
    <div class="af-tab-panel" id="af-tab-content-documentos" role="tabpanel" hidden></div>
    <div class="af-tab-panel" id="af-tab-content-historial"  role="tabpanel" hidden></div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/alumnos.detail.js"></script>
    <script src="~/Content/js/pages/alumno-ficha.js"></script>
    <script>
        AlumnoFicha.init(@Model.Alu_Id);
    </script>
}
