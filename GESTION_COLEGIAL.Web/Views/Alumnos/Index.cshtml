@model GESTION_COLEGIAL.Business.Models.AlumnoViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content ">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Alumnos</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Gestión de alumnos</h4>
        <p class="text-muted mb-0">Administre el registro de estudiantes matriculados en el sistema.</p>
    </div>
    <div class="mt-2 mt-md-0">
        @if (ViewBag.PuedeCrear == true)
        {
            <a href="@Url.Action("Nuevo", "Alumnos")" class="btn btn-primary">
                <i class="bi bi-plus-lg mr-1"></i> Nuevo alumno
            </a>
        }
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="row"><div class="col-12"><h4>Listado de alumnos</h4></div></div>
    </div>
    <div class="widget-content widget-content-area">
        <div id="tabla-alumnos" data-usuario="@(Session["Username"] as string ?? "anonimo")"></div>
    </div>
</div>


<!-- Modal Delete-->
<div class="modal" id="delete-modal-secondary" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        @using (Ajax.BeginForm("Eliminar", "Alumnos", new AjaxOptions
        {
            HttpMethod = "Post",
            OnBegin = "Modals.begin",
            OnComplete = "Modals.complete",
            OnFailure = "Modals.failure",
            OnSuccess = "Modals.success"
        }))
        {
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"></h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar" hidden>
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <h5>
                    </h5>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                @Html.HiddenFor(model => model.Alu_Id, new { @id = "delete-item-id" })
                                <p>¿Está seguro de que desea eliminar este registro?</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" id="accept-delete-btn" class="btn btn-danger"><i class="bi bi-trash"></i></button>
                </div>
            </div>
        }
    </div>
</div>
<!-- Fin Modal -->
@section Scripts{
    <partial name="_GcTabla" />
    <script src="~/Content/js/pages/alumnos.js" asp-append-version="true"></script>
    <script>
    Alumnos.datatable({
        urlList: "@Url.Action("ListAsync")",
        urlInsert: "@Url.Action("Nuevo")",
        urlUpdate: "@Url.Action("Editar")",
        urlDetail: "@Url.Action("Detalle")",
        permisos: {
            crear: @(ViewBag.PuedeCrear == true ? "true" : "false"),
            editar: @(ViewBag.PuedeEditar == true ? "true" : "false"),
            eliminar: @(ViewBag.PuedeEliminar == true ? "true" : "false")
        }
    });
    </script>
}