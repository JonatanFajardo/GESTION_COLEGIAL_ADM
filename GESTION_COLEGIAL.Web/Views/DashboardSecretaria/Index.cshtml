@{
    ViewBag.Title = "Dashboard Secretaria";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/pages/dashboard-secretaria.css" rel="stylesheet" asp-append-version="true" />
}

<div>

    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
        <div class="mr-3">
            <h4 class="mb-1">Dashboard Secretaría</h4>
            <p class="text-muted mb-0">Trámites del día</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap align-items-center">
            <label class="mb-0 mr-2">Año</label>
            <select id="sel-anio" class="custom-select w-auto mr-3"></select>
            <button type="button" class="btn btn-primary" id="btn-actualizar"><i class="fas fa-rotate-right mr-1"></i>Actualizar</button>
        </div>
    </div>

    <!-- KPI Cards -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-gauge-high mr-1"></i>Indicadores Clave</h6>
    <div class="row">
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-matriculados">—</h6>
                            <p>Matriculados</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-user-graduate"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-nuevas-mes">—</h6>
                            <p>Nuevas Matrículas Mes</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-user-plus"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-docs-pendientes">—</h6>
                            <p>Documentos Pendientes</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-folder-open"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-sin-foto">—</h6>
                            <p>Alumnos Sin Foto</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-id-card"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-enc-incompletos">—</h6>
                            <p>Encargados Incompletos</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-circle-exclamation"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-cumple-semana">—</h6>
                            <p>Cumpleaños Semana</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-cake-candles"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Calendario escolar ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="bi bi-calendar3 mr-1"></i>Calendario</h6>
    <div class="row mb-4">
        <div class="col-md-12">
            @await Html.PartialAsync("_ProximosDias")
        </div>
    </div>

    <!-- Bandeja Tramites de Hoy -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-inbox mr-1"></i>Trámites de Hoy</h6>
    <div class="row">
        <div class="col-md-12 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-content widget-content-area">
                <div id="lista-tramites">
                    <p class="text-center text-muted small py-4 mb-0">Cargando...</p>
                </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts: Matricula por Mes + Por Curso -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-chart-bar mr-1"></i>Matrícula</h6>
    <div class="row">
        <div class="col-md-6 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-chart-line mr-1"></i>Nuevas Matrículas por Mes</h4><span class="small font-weight-bold text-muted" id="stat-matricula-mes"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h260" id="chart-matricula-mes"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-chalkboard mr-1"></i>Matrícula por Curso (Top 8)</h4><span class="small font-weight-bold text-muted" id="stat-matricula-seccion"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h260" id="chart-matricula-seccion"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Documentos pendientes + Top alumnos -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-folder-open mr-1"></i>Documentos Pendientes</h6>
    <div class="row">
        <div class="col-md-6 layout-spacing">
            <div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-file-lines mr-1"></i>Documentos Pendientes por Tipo</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Tipo de Documento</th>
                                <th class="text-center">Pendientes</th>
                                <th>Volumen</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-docs-tipo">
                            <tr><td class="text-center text-muted py-4" colspan="3">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 layout-spacing">
            <div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-user-xmark mr-1"></i>Top Alumnos con Docs Pendientes</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Alumno</th>
                                <th>Curso</th>
                                <th class="text-center">Docs</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-alumnos-docs">
                            <tr><td class="text-center text-muted py-4" colspan="4">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Encargados + Cumpleaños -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-users mr-1"></i>Encargados y Cumpleaños</h6>
    <div class="row">
        <div class="col-md-6 layout-spacing">
            <div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-user-shield mr-1"></i>Encargados Incompletos</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Faltante</th>
                                <th class="text-center">A Cargo</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-encargados">
                            <tr><td class="text-center text-muted py-4" colspan="3">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 layout-spacing">
            <div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-cake-candles mr-1"></i>Cumpleaños de la Semana</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div id="lista-cumple">
                    <p class="text-center text-muted small py-4 mb-0">Cargando...</p>
                </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/dashboardsecretaria.js"></script>
    <script>
        DashboardSecretaria.init("@Url.Action("ResumenAsync")");
    </script>
}
