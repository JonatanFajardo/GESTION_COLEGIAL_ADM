@{
    ViewBag.Title = "Dashboard Secretaria";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Spacing (Bootstrap rules del proyecto) */
    .dd-wrapper { padding: 0 6px 24px; }
    .dd-wrapper .row { margin-bottom: 22px; }
    .dd-wrapper .row:last-child { margin-bottom: 0; }
    .dd-wrapper [class*="col-"] { padding-left: 10px; padding-right: 10px; }

    /* Header */
    .dd-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 22px;
        padding: 16px 22px;
        background: linear-gradient(135deg, #1e293b 0%, #0f4c81 100%);
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(15,76,129,.3);
    }
    .dd-header-left { display: flex; align-items: center; gap: 14px; }
    .dd-header-icon {
        width: 46px; height: 46px;
        background: rgba(255,255,255,.15);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; color: #fff;
    }
    .dd-header h2 { margin: 0; font-size: 1.25rem; font-weight: 700; color: #fff; }
    .dd-header-sub { font-size: .78rem; color: rgba(255,255,255,.6); margin-top: 2px; }
    .dd-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .dd-controls label { font-size: .8rem; color: rgba(255,255,255,.7); font-weight: 600; margin: 0; }
    .dd-controls select {
        height: 34px; padding: 0 10px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 7px; font-size: .84rem; color: #fff;
        outline: none; cursor: pointer;
    }
    .dd-controls select option { background: #1e293b; color: #fff; }
    .btn-actualizar {
        height: 34px; padding: 0 18px;
        background: #fff; color: #1e293b;
        border: none; border-radius: 7px;
        font-size: .84rem; font-weight: 700;
        cursor: pointer; transition: all .2s;
        display: flex; align-items: center; gap: 6px;
    }
    .btn-actualizar:hover { background: #e0f2fe; transform: translateY(-1px); }

    /* Section heading */
    .dd-section {
        display: flex; align-items: center; gap: 10px;
        margin-bottom: 14px;
    }
    .dd-section-accent {
        width: 4px; height: 20px; border-radius: 2px; flex-shrink: 0;
    }
    .dd-section-label {
        font-size: .78rem; font-weight: 800; color: #475569;
        text-transform: uppercase; letter-spacing: .7px; white-space: nowrap;
    }
    .dd-section-line { flex: 1; height: 1px; background: #e2e8f0; }

    /* KPI Cards */
    .kpi-card {
        background: #fff;
        border-radius: 12px;
        padding: 16px 18px 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.04);
        position: relative;
        overflow: hidden;
        transition: transform .15s, box-shadow .15s;
        border-left: 4px solid transparent;
    }
    .kpi-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.1); }
    .kpi-card.c-blue   { border-left-color: #3b82f6; }
    .kpi-card.c-green  { border-left-color: #22c55e; }
    .kpi-card.c-red    { border-left-color: #ef4444; }
    .kpi-card.c-amber  { border-left-color: #f59e0b; }
    .kpi-card.c-orange { border-left-color: #f97316; }
    .kpi-card.c-purple { border-left-color: #a855f7; }

    .kpi-card .kpi-icon-bg {
        position: absolute; right: -6px; bottom: -6px;
        font-size: 3.8rem; opacity: .05; color: #0f172a; pointer-events: none;
    }
    .kpi-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px; }
    .kpi-icon {
        width: 36px; height: 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center; font-size: .95rem;
    }
    .kpi-icon.blue   { background: #eff6ff; color: #3b82f6; }
    .kpi-icon.green  { background: #f0fdf4; color: #22c55e; }
    .kpi-icon.red    { background: #fef2f2; color: #ef4444; }
    .kpi-icon.amber  { background: #fffbeb; color: #f59e0b; }
    .kpi-icon.orange { background: #fff7ed; color: #f97316; }
    .kpi-icon.purple { background: #faf5ff; color: #a855f7; }

    .kpi-value { font-size: 1.7rem; font-weight: 800; color: #0f172a; line-height: 1; }
    .kpi-label { font-size: .7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; margin-top: 4px; }

    /* Panel */
    .dd-panel {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.04);
        padding: 18px 20px;
    }

    /* Chart header */
    .chart-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; }
    .chart-title { font-size: .8rem; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .5px; }
    .chart-stat { font-size: .82rem; font-weight: 700; color: #3b82f6; }

    /* Tablas */
    .dd-table { width: 100%; font-size: .82rem; border-collapse: collapse; }
    .dd-table th {
        background: #f8fafc; color: #64748b;
        font-weight: 700; font-size: .7rem; text-transform: uppercase; letter-spacing: .5px;
        padding: 8px 12px; border-bottom: 2px solid #e2e8f0;
    }
    .dd-table td { padding: 8px 12px; border-bottom: 1px solid #f1f5f9; color: #334155; vertical-align: middle; }
    .dd-table tr:last-child td { border-bottom: none; }
    .dd-table tr:hover td { background: #f8fafc; }

    /* Progress bar */
    .dd-progress { height: 7px; background: #e2e8f0; border-radius: 4px; overflow: hidden; min-width: 70px; }
    .dd-progress-fill { height: 100%; border-radius: 4px; transition: width .5s cubic-bezier(.4,0,.2,1); }

    /* Rank badge */
    .rank-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        font-size: .7rem; font-weight: 800;
    }
    .rank-1 { background: #fef9c3; color: #a16207; }
    .rank-2 { background: #f1f5f9; color: #475569; }
    .rank-3 { background: #fff7ed; color: #c2410c; }
    .rank-n { background: #f8fafc; color: #94a3b8; }

    /* Tramites bandeja */
    .tramite-item {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 12px 14px; border-radius: 10px; font-size: .85rem;
        border-left: 3px solid transparent;
        margin-bottom: 8px;
        background: #f8fafc;
    }
    .tramite-item:last-child { margin-bottom: 0; }
    .tramite-item.alta  { background: #fef2f2; border-left-color: #ef4444; }
    .tramite-item.media { background: #fff7ed; border-left-color: #f97316; }
    .tramite-item.baja  { background: #eff6ff; border-left-color: #3b82f6; }
    .tramite-icon { font-size: 1.3rem; flex-shrink: 0; margin-top: 1px; line-height: 1; }
    .tramite-body { flex: 1; }
    .tramite-alumno { color: #1e293b; font-weight: 700; line-height: 1.3; }
    .tramite-detalle { color: #64748b; font-size: .78rem; margin-top: 2px; }
    .tramite-badge {
        display: inline-block; margin-top: 4px;
        font-size: .62rem; padding: 1px 8px; border-radius: 20px; font-weight: 700;
    }
    .badge-alta  { background: #fee2e2; color: #b91c1c; }
    .badge-media { background: #ffedd5; color: #c2410c; }
    .badge-baja  { background: #dbeafe; color: #1d4ed8; }

    /* Cumple list */
    .cumple-item {
        display: flex; align-items: center; gap: 12px;
        padding: 10px 12px; border-radius: 10px;
        background: #faf5ff;
        margin-bottom: 8px;
    }
    .cumple-item:last-child { margin-bottom: 0; }
    .cumple-avatar {
        width: 38px; height: 38px; border-radius: 50%;
        background: linear-gradient(135deg, #a855f7, #7e22ce);
        color: #fff; font-weight: 800; font-size: .9rem;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .cumple-body { flex: 1; min-width: 0; }
    .cumple-nombre { font-weight: 700; color: #1e293b; font-size: .85rem; line-height: 1.2; }
    .cumple-meta { font-size: .72rem; color: #64748b; margin-top: 2px; }
    .cumple-right { text-align: right; }
    .cumple-fecha { font-size: .78rem; font-weight: 700; color: #7e22ce; }
    .cumple-edad { font-size: .68rem; color: #94a3b8; }

    /* Faltante badge */
    .faltante-badge {
        display: inline-block; font-size: .68rem; padding: 2px 8px;
        border-radius: 20px; font-weight: 700;
        background: #fef3c7; color: #92400e;
    }

    /* Chart canvas */
    canvas { display: block; }

    /* Cumpleaños scroll cap */
    #lista-cumple {
        max-height: 430px;
        overflow-y: auto;
        padding-right: 4px;
    }
    #lista-cumple::-webkit-scrollbar { width: 5px; }
    #lista-cumple::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
    #lista-cumple::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    #lista-cumple::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* Empty state */
    .dd-empty {
        text-align: center; color: #94a3b8; font-size: .82rem;
        padding: 18px 0; margin: 0;
    }

    /* Equal-height columns (Bootstrap 3 flexbox override) */
    .dd-row-eq { display: flex; flex-wrap: wrap; margin-left: -10px; margin-right: -10px; }
    .dd-row-eq > [class*="col-"] { display: flex; flex-direction: column; padding-left: 10px; padding-right: 10px; }
    .dd-row-eq > [class*="col-"] > .dd-panel { flex: 1; }
</style>

<div class="dd-wrapper">

    <!-- Header -->
    <div class="dd-header">
        <div class="dd-header-left">
            <div class="dd-header-icon"><i class="fa-solid fa-clipboard-list"></i></div>
            <div>
                <h2>Dashboard Secretaría</h2>
                <div class="dd-header-sub">Trámites del día</div>
            </div>
        </div>
        <div class="dd-controls">
            <label>Año</label>
            <select id="sel-anio"></select>
            <button class="btn-actualizar" id="btn-actualizar">
                <i class="fa-solid fa-rotate-right"></i> Actualizar
            </button>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="dd-section">
        <div class="dd-section-accent" style="background:#3b82f6;"></div>
        <span class="dd-section-label"><i class="fa-solid fa-gauge-high" style="margin-right:5px;"></i>Indicadores Clave</span>
        <div class="dd-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-2 col-sm-4 col-6">
            <div class="kpi-card c-blue">
                <i class="fa-solid fa-user-graduate kpi-icon-bg"></i>
                <div class="kpi-top">
                    <div class="kpi-icon blue"><i class="fa-solid fa-user-graduate"></i></div>
                </div>
                <div class="kpi-value" id="kpi-matriculados">—</div>
                <div class="kpi-label">Matriculados</div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6">
            <div class="kpi-card c-green">
                <i class="fa-solid fa-user-plus kpi-icon-bg"></i>
                <div class="kpi-top">
                    <div class="kpi-icon green"><i class="fa-solid fa-user-plus"></i></div>
                </div>
                <div class="kpi-value" id="kpi-nuevas-mes">—</div>
                <div class="kpi-label">Nuevas Matrículas Mes</div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6">
            <div class="kpi-card c-red">
                <i class="fa-solid fa-folder-open kpi-icon-bg"></i>
                <div class="kpi-top">
                    <div class="kpi-icon red"><i class="fa-solid fa-folder-open"></i></div>
                </div>
                <div class="kpi-value" id="kpi-docs-pendientes">—</div>
                <div class="kpi-label">Documentos Pendientes</div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6">
            <div class="kpi-card c-amber">
                <i class="fa-solid fa-id-card kpi-icon-bg"></i>
                <div class="kpi-top">
                    <div class="kpi-icon amber"><i class="fa-solid fa-id-card"></i></div>
                </div>
                <div class="kpi-value" id="kpi-sin-foto">—</div>
                <div class="kpi-label">Alumnos Sin Foto</div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6">
            <div class="kpi-card c-orange">
                <i class="fa-solid fa-circle-exclamation kpi-icon-bg"></i>
                <div class="kpi-top">
                    <div class="kpi-icon orange"><i class="fa-solid fa-circle-exclamation"></i></div>
                </div>
                <div class="kpi-value" id="kpi-enc-incompletos">—</div>
                <div class="kpi-label">Encargados Incompletos</div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6">
            <div class="kpi-card c-purple">
                <i class="fa-solid fa-cake-candles kpi-icon-bg"></i>
                <div class="kpi-top">
                    <div class="kpi-icon purple"><i class="fa-solid fa-cake-candles"></i></div>
                </div>
                <div class="kpi-value" id="kpi-cumple-semana">—</div>
                <div class="kpi-label">Cumpleaños Semana</div>
            </div>
        </div>
    </div>

    <!-- Bandeja Tramites de Hoy -->
    <div class="dd-section">
        <div class="dd-section-accent" style="background:#ef4444;"></div>
        <span class="dd-section-label"><i class="fa-solid fa-inbox" style="margin-right:5px;"></i>Trámites de Hoy</span>
        <div class="dd-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="dd-panel">
                <div id="lista-tramites">
                    <p class="dd-empty">Cargando...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts: Matricula por Mes + Por Curso -->
    <div class="dd-section">
        <div class="dd-section-accent" style="background:#6366f1;"></div>
        <span class="dd-section-label"><i class="fa-solid fa-chart-bar" style="margin-right:5px;"></i>Matrícula</span>
        <div class="dd-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="dd-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-chart-line" style="margin-right:5px;color:#3b82f6;"></i>Nuevas Matrículas por Mes</span>
                    <span class="chart-stat" id="stat-matricula-mes" style="color:#3b82f6;"></span>
                </div>
                <canvas id="chart-matricula-mes" style="max-height:260px;"></canvas>
            </div>
        </div>
        <div class="col-md-6">
            <div class="dd-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-chalkboard" style="margin-right:5px;color:#6366f1;"></i>Matrícula por Curso (Top 8)</span>
                    <span class="chart-stat" id="stat-matricula-seccion" style="color:#6366f1;"></span>
                </div>
                <canvas id="chart-matricula-seccion" style="max-height:260px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Documentos pendientes + Top alumnos -->
    <div class="dd-section">
        <div class="dd-section-accent" style="background:#ef4444;"></div>
        <span class="dd-section-label"><i class="fa-solid fa-folder-open" style="margin-right:5px;"></i>Documentos Pendientes</span>
        <div class="dd-section-line"></div>
    </div>
    <div class="row dd-row-eq">
        <div class="col-md-6">
            <div class="dd-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-file-lines" style="margin-right:5px;color:#ef4444;"></i>Documentos Pendientes por Tipo</span>
                </div>
                <div style="overflow-x:auto;">
                    <table class="dd-table">
                        <thead>
                            <tr>
                                <th>Tipo de Documento</th>
                                <th style="text-align:center;width:90px;">Pendientes</th>
                                <th style="min-width:120px;">Volumen</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-docs-tipo">
                            <tr><td colspan="3" style="text-align:center;color:#94a3b8;padding:20px;">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="dd-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-user-xmark" style="margin-right:5px;color:#ef4444;"></i>Top Alumnos con Docs Pendientes</span>
                </div>
                <div style="overflow-x:auto;">
                    <table class="dd-table">
                        <thead>
                            <tr>
                                <th style="width:32px;">#</th>
                                <th>Alumno</th>
                                <th>Curso</th>
                                <th style="text-align:center;width:60px;">Docs</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-alumnos-docs">
                            <tr><td colspan="4" style="text-align:center;color:#94a3b8;padding:20px;">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Encargados + Cumpleaños -->
    <div class="dd-section">
        <div class="dd-section-accent" style="background:#a855f7;"></div>
        <span class="dd-section-label"><i class="fa-solid fa-users" style="margin-right:5px;"></i>Encargados y Cumpleaños</span>
        <div class="dd-section-line"></div>
    </div>
    <div class="row dd-row-eq">
        <div class="col-md-6">
            <div class="dd-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-user-shield" style="margin-right:5px;color:#f97316;"></i>Encargados Incompletos</span>
                </div>
                <div style="overflow-x:auto;">
                    <table class="dd-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Faltante</th>
                                <th style="text-align:center;width:90px;">A Cargo</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-encargados">
                            <tr><td colspan="3" style="text-align:center;color:#94a3b8;padding:20px;">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="dd-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-cake-candles" style="margin-right:5px;color:#a855f7;"></i>Cumpleaños de la Semana</span>
                </div>
                <div id="lista-cumple">
                    <p class="dd-empty">Cargando...</p>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/dashboardsecretaria.js"></script>
    <script>
        DashboardSecretaria.init("@Url.Action("ResumenAsync")");
    </script>
}
