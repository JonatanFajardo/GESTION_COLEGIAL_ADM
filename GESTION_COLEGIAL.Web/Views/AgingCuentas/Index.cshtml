@{
    ViewBag.Title = "Aging de Cuentas por Cobrar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Aging de Cuentas por Cobrar</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Aging de Cuentas por Cobrar</h4>
        <p class="text-muted mb-0">Antigüedad de saldos pendientes por cobrar</p>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="row"><div class="col-12"><h4>Saldos por antigüedad</h4></div></div>
    </div>
    <div class="widget-content widget-content-area">
        <div class="table-responsive">
            <table class="table table-hover nowrap" id="datatable-agingcuentas">
                <thead><tr><th>Alumno</th><th>Tramo</th><th>Monto</th><th>Cantidad</th></tr></thead>
            </table>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/agingcuentas.js"></script>
    <script>
        AgingCuentas.init("@Url.Action("ListAsync")");
    </script>
}
