@{
    ViewBag.Title = "Aging de Cuentas por Cobrar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Aging de Cuentas por Cobrar</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-clock-rotate-left" style="font-size:32px;"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Aging de Cuentas por Cobrar</h1>
                <p>Antigüedad de saldos pendientes por cobrar</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="card-listado-catalogo">
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="datatable-agingcuentas">
                    <thead><tr><th>Alumno</th><th>Tramo</th><th>Monto</th><th>Cantidad</th></tr></thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/agingcuentas.js"></script>
    <script>
        AgingCuentas.init("@Url.Action("ListAsync")");
    </script>
}
