@{
    ViewBag.Title = "Dashboard Caja";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuId = ViewBag.UsuId ?? 1;
}

<style>
    /* ── Wrapper ── */
    .caj-wrapper { padding: 0 6px 32px; }
    .caj-wrapper .row { margin-bottom: 22px; }
    .caj-wrapper .row:last-child { margin-bottom: 0; }
    .caj-wrapper [class*="col-"] { padding-left: 10px; padding-right: 10px; }

    /* ── Header ── */
    .caj-header {
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 12px;
        margin-bottom: 22px; padding: 16px 22px;
        background: linear-gradient(135deg, #15803d 0%, #0e6b35 60%, #b45309 100%);
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(21,128,61,.3);
    }
    .caj-header-left { display: flex; align-items: center; gap: 14px; }
    .caj-header-icon {
        width: 46px; height: 46px;
        background: rgba(255,255,255,.15); border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; color: #fff;
    }
    .caj-header h2 { margin: 0; font-size: 1.25rem; font-weight: 700; color: #fff; }
    .caj-header-sub { font-size: .78rem; color: rgba(255,255,255,.65); margin-top: 2px; }
    .caj-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .caj-controls label { font-size: .8rem; color: rgba(255,255,255,.8); font-weight: 600; margin: 0; }
    .caj-controls input[type=date] {
        height: 34px; padding: 0 10px;
        background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.3);
        border-radius: 7px; font-size: .84rem; color: #fff; outline: none; cursor: pointer;
        color-scheme: dark;
    }
    .btn-actualizar {
        height: 34px; padding: 0 18px;
        background: #fff; color: #15803d;
        border: none; border-radius: 7px;
        font-size: .84rem; font-weight: 700; cursor: pointer;
        transition: all .2s; display: flex; align-items: center; gap: 6px;
    }
    .btn-actualizar:hover { background: #ecfdf5; transform: translateY(-1px); }

    /* ── Section heading ── */
    .caj-section { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .caj-section-accent { width: 4px; height: 20px; border-radius: 2px; flex-shrink: 0; }
    .caj-section-label {
        font-size: .78rem; font-weight: 800; color: #475569;
        text-transform: uppercase; letter-spacing: .7px; white-space: nowrap;
    }
    .caj-section-line { flex: 1; height: 1px; background: #e2e8f0; }

    /* ── KPI Cards ── */
    .kpi-card {
        background: #fff; border-radius: 12px; padding: 16px 18px 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.04);
        position: relative; overflow: hidden;
        transition: transform .15s, box-shadow .15s;
        border-left: 4px solid transparent;
    }
    .kpi-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.1); }
    .kpi-card.c-green  { border-left-color: #22c55e; }
    .kpi-card.c-amber  { border-left-color: #f59e0b; }
    .kpi-card.c-blue   { border-left-color: #3b82f6; }
    .kpi-card.c-teal   { border-left-color: #14b8a6; }
    .kpi-card.c-red    { border-left-color: #ef4444; }
    .kpi-card.c-orange { border-left-color: #f97316; }
    .kpi-card.c-purple { border-left-color: #a855f7; }
    .kpi-card.c-emerald{ border-left-color: #10b981; }
    .kpi-card .kpi-icon-bg {
        position: absolute; right: -6px; bottom: -6px;
        font-size: 3.8rem; opacity: .05; color: #0f172a; pointer-events: none;
    }
    .kpi-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px; }
    .kpi-icon {
        width: 36px; height: 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center; font-size: .95rem;
    }
    .kpi-icon.green  { background: #f0fdf4; color: #22c55e; }
    .kpi-icon.amber  { background: #fffbeb; color: #f59e0b; }
    .kpi-icon.blue   { background: #eff6ff; color: #3b82f6; }
    .kpi-icon.teal   { background: #f0fdfa; color: #14b8a6; }
    .kpi-icon.red    { background: #fef2f2; color: #ef4444; }
    .kpi-icon.orange { background: #fff7ed; color: #f97316; }
    .kpi-icon.purple { background: #faf5ff; color: #a855f7; }
    .kpi-icon.emerald{ background: #ecfdf5; color: #10b981; }
    .kpi-value { font-size: 1.55rem; font-weight: 800; color: #0f172a; line-height: 1; }
    .kpi-value.money { font-size: 1.35rem; }
    .kpi-label { font-size: .7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; margin-top: 4px; }

    /* ── Panel ── */
    .caj-panel { background: #fff; border-radius: 12px; box-shadow: 0 1px 4px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.04); padding: 18px 20px; }
    .chart-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 6px; }
    .chart-title { font-size: .8rem; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .5px; }
    .chart-stat { font-size: .82rem; font-weight: 700; }

    /* ── Stats box ── */
    .stats-row { display: flex; gap: 10px; align-items: stretch; flex-wrap: wrap; }
    .stats-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px 18px; border-radius: 10px; min-width: 92px; flex: 1; }
    .stats-cell.green { background: #f0fdf4; }
    .stats-cell.amber { background: #fffbeb; }
    .stats-cell.blue  { background: #eff6ff; }
    .stats-val { font-size: 1.7rem; font-weight: 800; line-height: 1; }
    .stats-lbl { font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; margin-top: 4px; text-align: center; }
    .stats-val.green { color: #16a34a; } .stats-lbl.green { color: #4ade80; }
    .stats-val.amber { color: #d97706; } .stats-lbl.amber { color: #fbbf24; }
    .stats-val.blue  { color: #2563eb; } .stats-lbl.blue  { color: #93c5fd; }

    /* ── Tablas ── */
    .caj-table { width: 100%; font-size: .82rem; border-collapse: collapse; }
    .caj-table th { background: #f8fafc; color: #64748b; font-weight: 700; font-size: .7rem; text-transform: uppercase; letter-spacing: .5px; padding: 8px 12px; border-bottom: 2px solid #e2e8f0; }
    .caj-table td { padding: 8px 12px; border-bottom: 1px solid #f1f5f9; color: #334155; vertical-align: middle; }
    .caj-table tr:last-child td { border-bottom: none; }
    .caj-table tr:hover td { background: #f8fafc; }
    .scroll-area { max-height: 430px; overflow-y: auto; }

    /* ── Top alumnos (lista con avatars) ── */
    .topal-item { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
    .topal-item:last-child { border-bottom: none; }
    .topal-avatar { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 2px solid #e2e8f0; }
    .topal-avatar-ph { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, #15803d, #f59e0b); display: flex; align-items: center; justify-content: center; color: #fff; font-size: .95rem; font-weight: 700; flex-shrink: 0; }
    .topal-info { flex: 1; min-width: 0; }
    .topal-nombre { font-size: .85rem; font-weight: 700; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .topal-meta   { font-size: .7rem; color: #64748b; }
    .topal-badge  { font-size: .78rem; font-weight: 800; padding: 4px 11px; border-radius: 20px; background: #ecfdf5; color: #047857; white-space: nowrap; flex-shrink: 0; }

    /* ── Cuentas vencidas ── */
    .venc-item { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
    .venc-item:last-child { border-bottom: none; }
    .venc-dias { width: 56px; flex-shrink: 0; text-align: center; padding: 6px 4px; border-radius: 8px; background: #fef2f2; color: #b91c1c; font-weight: 800; font-size: .95rem; line-height: 1; }
    .venc-dias.med { background: #fffbeb; color: #b45309; }
    .venc-dias-lbl { font-size: .55rem; font-weight: 700; text-transform: uppercase; margin-top: 3px; opacity: .8; display: block; }
    .venc-info { flex: 1; min-width: 0; }
    .venc-nombre { font-size: .85rem; font-weight: 700; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .venc-concepto { font-size: .7rem; color: #64748b; }
    .venc-monto { font-size: .9rem; font-weight: 800; color: #b91c1c; white-space: nowrap; flex-shrink: 0; }

    /* ── Último arqueo ── */
    .arqueo-card { background: linear-gradient(135deg, #ecfdf5, #fffbeb); border-radius: 12px; padding: 16px; border: 1px solid #d1fae5; }
    .arqueo-row { display: flex; justify-content: space-between; align-items: baseline; padding: 7px 0; border-bottom: 1px dashed #d1fae5; font-size: .82rem; }
    .arqueo-row:last-child { border-bottom: none; }
    .arqueo-lbl { color: #64748b; font-weight: 600; font-size: .72rem; text-transform: uppercase; letter-spacing: .4px; }
    .arqueo-val { font-weight: 700; color: #0f172a; }
    .arqueo-total { font-size: 1.4rem; font-weight: 800; color: #15803d; }
    .arqueo-empty { text-align: center; color: #94a3b8; padding: 30px 10px; font-size: .82rem; }

    /* ── Alertas ── */
    .alertas-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
    .alerta-item { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; border-radius: 10px; font-size: .83rem; border-left: 3px solid transparent; }
    .alerta-item.alta  { background: #fef2f2; border-left-color: #ef4444; }
    .alerta-item.media { background: #fffbeb; border-left-color: #f59e0b; }
    .alerta-item.baja  { background: #ecfdf5; border-left-color: #10b981; }
    .alerta-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 1px; }
    .alerta-msg  { color: #1e293b; font-weight: 600; line-height: 1.3; flex: 1; }
    .alerta-badge { display: inline-block; margin-top: 4px; font-size: .62rem; padding: 1px 7px; border-radius: 20px; font-weight: 700; }
    .badge-alta  { background: #fee2e2; color: #b91c1c; }
    .badge-media { background: #fef3c7; color: #92400e; }
    .badge-baja  { background: #d1fae5; color: #047857; }

    /* ── Forma de pago badge ── */
    .fpa-badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: .68rem; font-weight: 700; }
    .fpa-Efectivo      { background: #dcfce7; color: #166534; }
    .fpa-Tarjeta       { background: #dbeafe; color: #1d4ed8; }
    .fpa-Transferencia { background: #ede9fe; color: #6d28d9; }
    .fpa-Cheque        { background: #fef3c7; color: #92400e; }
    .fpa-Otro          { background: #f1f5f9; color: #475569; }

    .empty-state { text-align: center; color: #94a3b8; font-size: .82rem; padding: 26px 10px; }

    /* ── Animaciones ── */
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .kpi-card  { animation: fadeInUp .35s ease both; }
    .caj-panel { animation: fadeInUp .4s ease both; }
    .kpi-card:nth-child(1) { animation-delay:.04s; } .kpi-card:nth-child(2) { animation-delay:.08s; }
    .kpi-card:nth-child(3) { animation-delay:.12s; } .kpi-card:nth-child(4) { animation-delay:.16s; }
    .kpi-card:nth-child(5) { animation-delay:.20s; } .kpi-card:nth-child(6) { animation-delay:.24s; }
    .kpi-card:nth-child(7) { animation-delay:.28s; } .kpi-card:nth-child(8) { animation-delay:.32s; }
</style>

<div class="caj-wrapper">

    <!-- ══ Header ══ -->
    <div class="caj-header">
        <div class="caj-header-left">
            <div class="caj-header-icon"><i class="fa-solid fa-cash-register"></i></div>
            <div>
                <h2>Dashboard Caja</h2>
                <div class="caj-header-sub">Movimientos del cajero en tiempo real</div>
            </div>
        </div>
        <div class="caj-controls">
            <label>Fecha</label>
            <input type="date" id="caj-fecha" />
            <button class="btn-actualizar" id="btn-actualizar">
                <i class="fa-solid fa-rotate-right"></i> Actualizar
            </button>
        </div>
    </div>

    <!-- ══ Movimientos Hoy: Pagos por Hora ══ -->
    <div class="caj-section">
        <div class="caj-section-accent" style="background:#22c55e;"></div>
        <span class="caj-section-label"><i class="fa-solid fa-chart-line" style="margin-right:5px;"></i>Movimientos del Día</span>
        <div class="caj-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="caj-panel" style="height:100%;">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-bullseye" style="margin-right:5px;color:#15803d;"></i>Resumen</span>
                </div>
                <div class="stats-row" style="margin-bottom:14px;">
                    <div class="stats-cell green">
                        <div class="stats-val green" id="stat-eficiencia">—</div>
                        <div class="stats-lbl green">% Cobranza</div>
                    </div>
                    <div class="stats-cell blue">
                        <div class="stats-val blue" id="stat-hora-pico">—</div>
                        <div class="stats-lbl blue">Hora Pico</div>
                    </div>
                </div>
                <div class="stats-row">
                    <div class="stats-cell amber">
                        <div class="stats-val amber" id="stat-pagos-prom">—</div>
                        <div class="stats-lbl amber">Pagos/Hora Activa</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="caj-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-clock" style="margin-right:5px;color:#22c55e;"></i>Pagos por Hora</span>
                    <span class="chart-stat" id="stat-monto-hora" style="color:#22c55e;"></span>
                </div>
                <canvas id="chart-pagos-hora" style="max-height:220px;"></canvas>
            </div>
        </div>
    </div>

    <!-- ══ Distribución ══ -->
    <div class="caj-section">
        <div class="caj-section-accent" style="background:#6366f1;"></div>
        <span class="caj-section-label"><i class="fa-solid fa-chart-pie" style="margin-right:5px;"></i>Distribución de Cobros</span>
        <div class="caj-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-5">
            <div class="caj-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-wallet" style="margin-right:5px;color:#6366f1;"></i>Por Forma de Pago</span>
                    <span class="chart-stat" id="stat-formas" style="color:#6366f1;"></span>
                </div>
                <canvas id="chart-forma-pago" style="max-height:240px;"></canvas>
            </div>
        </div>
        <div class="col-md-7">
            <div class="caj-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-tags" style="margin-right:5px;color:#14b8a6;"></i>Por Concepto</span>
                </div>
                <canvas id="chart-concepto" style="max-height:240px;"></canvas>
            </div>
        </div>
    </div>

    <!-- ══ Resumen Semanal ══ -->
    <div class="caj-section">
        <div class="caj-section-accent" style="background:#3b82f6;"></div>
        <span class="caj-section-label"><i class="fa-solid fa-calendar-week" style="margin-right:5px;"></i>Resumen Semanal</span>
        <div class="caj-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="caj-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-arrow-trend-up" style="margin-right:5px;color:#3b82f6;"></i>Cobros Últimos 7 Días</span>
                    <span class="chart-stat" id="stat-semana" style="color:#3b82f6;"></span>
                </div>
                <canvas id="chart-semana" style="max-height:210px;"></canvas>
            </div>
        </div>
    </div>

    <!-- ══ KPIs Cobros ══ -->
    <div class="caj-section">
        <div class="caj-section-accent" style="background:#15803d;"></div>
        <span class="caj-section-label"><i class="fa-solid fa-coins" style="margin-right:5px;"></i>Cobros del Día</span>
        <div class="caj-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card c-green">
                <i class="fa-solid fa-sack-dollar kpi-icon-bg"></i>
                <div class="kpi-top"><div class="kpi-icon green"><i class="fa-solid fa-sack-dollar"></i></div></div>
                <div class="kpi-value money" id="kpi-cobrado">—</div>
                <div class="kpi-label">Cobrado Hoy</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card c-emerald">
                <i class="fa-solid fa-receipt kpi-icon-bg"></i>
                <div class="kpi-top"><div class="kpi-icon emerald"><i class="fa-solid fa-receipt"></i></div></div>
                <div class="kpi-value" id="kpi-cobros">—</div>
                <div class="kpi-label">Transacciones</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card c-blue">
                <i class="fa-solid fa-ticket kpi-icon-bg"></i>
                <div class="kpi-top"><div class="kpi-icon blue"><i class="fa-solid fa-ticket"></i></div></div>
                <div class="kpi-value money" id="kpi-ticket">—</div>
                <div class="kpi-label">Ticket Promedio</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card c-amber">
                <i class="fa-solid fa-trophy kpi-icon-bg"></i>
                <div class="kpi-top"><div class="kpi-icon amber"><i class="fa-solid fa-trophy"></i></div></div>
                <div class="kpi-value money" id="kpi-mayor">—</div>
                <div class="kpi-label">Mayor Pago</div>
            </div>
        </div>
    </div>

    <!-- ══ KPIs Pendientes ══ -->
    <div class="caj-section">
        <div class="caj-section-accent" style="background:#f59e0b;"></div>
        <span class="caj-section-label"><i class="fa-solid fa-triangle-exclamation" style="margin-right:5px;"></i>Pendientes y Riesgo</span>
        <div class="caj-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card c-teal">
                <i class="fa-solid fa-user-group kpi-icon-bg"></i>
                <div class="kpi-top"><div class="kpi-icon teal"><i class="fa-solid fa-user-group"></i></div></div>
                <div class="kpi-value" id="kpi-alumnos">—</div>
                <div class="kpi-label">Alumnos Atendidos</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card c-orange">
                <i class="fa-solid fa-file-invoice-dollar kpi-icon-bg"></i>
                <div class="kpi-top"><div class="kpi-icon orange"><i class="fa-solid fa-file-invoice-dollar"></i></div></div>
                <div class="kpi-value" id="kpi-pend-cnt">—</div>
                <div class="kpi-label">Cuentas Pendientes</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card c-purple">
                <i class="fa-solid fa-money-bill-wave kpi-icon-bg"></i>
                <div class="kpi-top"><div class="kpi-icon purple"><i class="fa-solid fa-money-bill-wave"></i></div></div>
                <div class="kpi-value money" id="kpi-pend-monto">—</div>
                <div class="kpi-label">Monto Pendiente</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card c-red">
                <i class="fa-solid fa-fire kpi-icon-bg"></i>
                <div class="kpi-top"><div class="kpi-icon red"><i class="fa-solid fa-fire"></i></div></div>
                <div class="kpi-value money" id="kpi-mora">—</div>
                <div class="kpi-label">Mora Acumulada</div>
            </div>
        </div>
    </div>

    <!-- ══ Timeline + Top Alumnos ══ -->
    <div class="caj-section">
        <div class="caj-section-accent" style="background:#15803d;"></div>
        <span class="caj-section-label"><i class="fa-solid fa-timeline" style="margin-right:5px;"></i>Timeline y Top Alumnos</span>
        <div class="caj-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-7">
            <div class="caj-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-list-ul" style="margin-right:5px;color:#15803d;"></i>Últimos Pagos del Día</span>
                    <span class="chart-stat" id="stat-timeline" style="color:#15803d;"></span>
                </div>
                <div class="scroll-area" style="overflow-x:auto;">
                    <table class="caj-table">
                        <thead>
                            <tr>
                                <th>Hora</th>
                                <th>Alumno</th>
                                <th style="text-align:center;">Forma</th>
                                <th>Referencia</th>
                                <th style="text-align:right;">Monto</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-timeline">
                            <tr><td colspan="5" class="empty-state">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="caj-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-medal" style="margin-right:5px;color:#f59e0b;"></i>Top Alumnos del Día</span>
                </div>
                <div id="lista-top-alumnos" class="scroll-area"></div>
            </div>
        </div>
    </div>

    <!-- ══ Cuentas Vencidas + Último Arqueo ══ -->
    <div class="caj-section">
        <div class="caj-section-accent" style="background:#ef4444;"></div>
        <span class="caj-section-label"><i class="fa-solid fa-circle-exclamation" style="margin-right:5px;"></i>Cuentas Vencidas y Arqueo</span>
        <div class="caj-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-8">
            <div class="caj-panel">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-hourglass-end" style="margin-right:5px;color:#ef4444;"></i>Más Vencidas</span>
                    <span class="chart-stat" id="stat-vencidas" style="color:#ef4444;"></span>
                </div>
                <div id="lista-vencidas" class="scroll-area"></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="caj-panel" style="height:100%;">
                <div class="chart-header">
                    <span class="chart-title"><i class="fa-solid fa-box-archive" style="margin-right:5px;color:#15803d;"></i>Último Arqueo</span>
                </div>
                <div id="arqueo-info"></div>
            </div>
        </div>
    </div>

    <!-- ══ Alertas ══ -->
    <div class="caj-section">
        <div class="caj-section-accent" style="background:#f59e0b;"></div>
        <span class="caj-section-label"><i class="fa-solid fa-bell" style="margin-right:5px;"></i>Alertas de Caja</span>
        <div class="caj-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="caj-panel">
                <div class="alertas-grid" id="lista-alertas">
                    <p class="empty-state" style="grid-column:1/-1;">Sin alertas activas.</p>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/dashboardcajero.js"></script>
    <script>
        DashboardCajero.init("@Url.Action("ResumenAsync")", @usuId);
    </script>
}
