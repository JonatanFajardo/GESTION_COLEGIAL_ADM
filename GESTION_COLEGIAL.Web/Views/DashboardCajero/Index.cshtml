@{
    ViewBag.Title = "Dashboard Caja";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuId = ViewBag.UsuId ?? 1;
}

@section Styles{
    <link href="~/css/pages/dashboard-cajero.css" rel="stylesheet" asp-append-version="true" />
}

<div>

    <!-- ══ Header ══ -->
    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
        <div class="mr-3">
            <h4 class="mb-1">Dashboard Caja</h4>
            <p class="text-muted mb-0">Movimientos del cajero en tiempo real</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap align-items-center">
            <label class="mb-0 mr-2">Fecha</label>
            <input type="date" id="caj-fecha" class="form-control w-auto mr-3" />
            <button type="button" class="btn btn-primary" id="btn-actualizar"><i class="fas fa-rotate-right mr-1"></i>Actualizar</button>
        </div>
    </div>

    <!-- ══ Movimientos Hoy: Pagos por Hora ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-chart-line mr-1"></i>Movimientos del Día</h6>
    <div class="row">
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-bullseye mr-1"></i>Resumen</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="d-flex flex-wrap align-items-stretch mb-3">
                    <div class="border rounded text-center px-3 py-2 flex-fill mb-2 mr-2">
                        <h3 class="font-weight-bold text-success mb-0" id="stat-eficiencia">—</h3>
                        <p class="small text-muted text-uppercase font-weight-bold mb-0">% Cobranza</p>
                    </div>
                    <div class="border rounded text-center px-3 py-2 flex-fill mb-2 mr-2">
                        <h3 class="font-weight-bold text-info mb-0" id="stat-hora-pico">—</h3>
                        <p class="small text-muted text-uppercase font-weight-bold mb-0">Hora Pico</p>
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-stretch">
                    <div class="border rounded text-center px-3 py-2 flex-fill mb-2 mr-2">
                        <h3 class="font-weight-bold text-warning mb-0" id="stat-pagos-prom">—</h3>
                        <p class="small text-muted text-uppercase font-weight-bold mb-0">Pagos/Hora Activa</p>
                    </div>
                </div>
                </div>
            </div>
        </div>
        <div class="col-md-8 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-clock mr-1"></i>Pagos por Hora</h4><span class="small font-weight-bold text-muted" id="stat-monto-hora"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h220" id="chart-pagos-hora"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Calendario escolar ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="bi bi-calendar3 mr-1"></i>Calendario</h6>
    <div class="row mb-4">
        <div class="col-md-12">
            @await Html.PartialAsync("_ProximosDias")
        </div>
    </div>

    <!-- ══ Distribución ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-chart-pie mr-1"></i>Distribución de Cobros</h6>
    <div class="row">
        <div class="col-md-5 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-wallet mr-1"></i>Por Forma de Pago</h4><span class="small font-weight-bold text-muted" id="stat-formas"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h240" id="chart-forma-pago"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-7 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-tags mr-1"></i>Por Concepto</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h240" id="chart-concepto"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Resumen Semanal ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-calendar-week mr-1"></i>Resumen Semanal</h6>
    <div class="row">
        <div class="col-md-12 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-arrow-trend-up mr-1"></i>Cobros Últimos 7 Días</h4><span class="small font-weight-bold text-muted" id="stat-semana"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h210" id="chart-semana"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ KPIs Cobros ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-coins mr-1"></i>Cobros del Día</h6>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-cobrado">—</h6>
                            <p>Cobrado Hoy</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-sack-dollar"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-cobros">—</h6>
                            <p>Transacciones</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-receipt"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-ticket">—</h6>
                            <p>Ticket Promedio</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-ticket"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-mayor">—</h6>
                            <p>Mayor Pago</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-trophy"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ KPIs Pendientes ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-triangle-exclamation mr-1"></i>Pendientes y Riesgo</h6>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-alumnos">—</h6>
                            <p>Alumnos Atendidos</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-user-group"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-pend-cnt">—</h6>
                            <p>Cuentas Pendientes</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-file-invoice-dollar"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-pend-monto">—</h6>
                            <p>Monto Pendiente</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-money-bill-wave"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-mora">—</h6>
                            <p>Mora Acumulada</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-fire"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Timeline + Top Alumnos ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-timeline mr-1"></i>Timeline y Top Alumnos</h6>
    <div class="row">
        <div class="col-md-7 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-list-ul mr-1"></i>Últimos Pagos del Día</h4><span class="small font-weight-bold text-muted" id="stat-timeline"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="scroll-area table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Hora</th>
                                <th>Alumno</th>
                                <th class="text-center">Forma</th>
                                <th>Referencia</th>
                                <th class="text-right">Monto</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-timeline">
                            <tr><td colspan="5" class="text-center text-muted small py-4">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
                </div>
            </div>
        </div>
        <div class="col-md-5 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-medal mr-1"></i>Top Alumnos del Día</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div id="lista-top-alumnos" class="scroll-area"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Cuentas Vencidas + Último Arqueo ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-circle-exclamation mr-1"></i>Cuentas Vencidas y Arqueo</h6>
    <div class="row">
        <div class="col-md-8 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-hourglass-end mr-1"></i>Más Vencidas</h4><span class="small font-weight-bold text-muted" id="stat-vencidas"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div id="lista-vencidas" class="scroll-area"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-box-archive mr-1"></i>Último Arqueo</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div id="arqueo-info"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Alertas ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-bell mr-1"></i>Alertas de Caja</h6>
    <div class="row">
        <div class="col-md-12 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-content widget-content-area">
                <div class="alertas-grid" id="lista-alertas">
                    <p class="text-center text-muted small py-4 mb-0 alertas-grid-full">Sin alertas activas.</p>
                </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/dashboardcajero.js"></script>
    <script>
        DashboardCajero.init("@Url.Action("ResumenAsync")", @usuId);
    </script>
}
