@model GESTION_COLEGIAL.UI.Models.ConstanciasIndexViewModel
@using GESTION_COLEGIAL.UI.Models
@{
    ViewBag.Title = "Constancias y expediente";
    var M = Model;
    Func<string, string> urlTipo = t => Url.Action("Index", new { tipo = t, aniId = M.AniId, aluId = M.AluId, q = M.Buscar });
    Func<int, string> urlPagina = p => Url.Action("Index", new { tipo = M.Tipo, aniId = M.AniId, aluId = M.AluId, q = M.Buscar, pagina = p });
    string urlEmitir = Url.Action("Emitir", new { tipo = M.Tipo, aluId = M.AluId });
    Func<string, string> BadgeTipo = t => (t ?? "").ToLowerInvariant() switch { "estudio" => "outline-badge-success", "boletin" => "outline-badge-info", "expediente" => "outline-badge-warning", _ => "outline-badge-secondary" };
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item">Académico</li>
            <li class="breadcrumb-item active" aria-current="page">Constancias y expediente</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Constancias y expediente</h4>
        <p class="text-muted mb-0">Documentos oficiales de los alumnos. Un documento emitido no cambia: para corregirlo se emite una revisión nueva.</p>
    </div>
    @if (M.PuedeEmitir)
    {
        <div class="mt-2 mt-md-0">
            <a class="btn btn-primary" href="@urlEmitir">
                <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i> Emitir documento
            </a>
        </div>
    }
</div>

<div class="cst-page">
    @if (!string.IsNullOrEmpty(M.Aviso))
    {
        <div class="alert alert-light-danger" role="alert"><i class="bi bi-exclamation-circle mr-1" aria-hidden="true"></i> @M.Aviso</div>
    }
    <section class="statbox widget box box-shadow mb-4" aria-labelledby="cst-filtros-titulo">
        <h5 class="mb-1" id="cst-filtros-titulo">Buscar un documento</h5>
        <p class="text-muted small mb-3">Filtre por tipo y año, o busque por nombre, identidad o referencia.</p>

        @if (M.AluId.HasValue)
        {
            <p class="d-flex flex-wrap align-items-center mb-3">
                <i class="bi bi-person mr-1" aria-hidden="true"></i>
                Solo los documentos de <strong>@(string.IsNullOrWhiteSpace(M.AlumnoFiltro) ? "este alumno" : M.AlumnoFiltro)</strong>
                <a class="btn btn-sm btn-link" href="@Url.Action("Index", new { tipo = M.Tipo, aniId = M.AniId, q = M.Buscar })">
                    <i class="bi bi-x-lg mr-1" aria-hidden="true"></i> Ver de todos
                </a>
            </p>
        }

        <div class="d-flex flex-wrap mb-3" role="group" aria-label="Tipo de documento">
            <a class="btn btn-sm btn-rounded mr-2 mb-2 @(M.Tipo == null ? "btn-primary" : "btn-outline-primary")" href="@urlTipo(null)" aria-current="@(M.Tipo == null ? "true" : null)">Todos</a>
            @foreach (var t in CatalogoDocumentos.Tipos)
            {
                <a class="btn btn-sm btn-rounded mr-2 mb-2 @(M.Tipo == t.Codigo ? "btn-primary" : "btn-outline-primary")" href="@urlTipo(t.Codigo)"
                   aria-current="@(M.Tipo == t.Codigo ? "true" : null)">@t.Etiqueta</a>
            }
        </div>

        <form method="get" action="@Url.Action("Index")" id="cst-form-filtros" class="form-row align-items-end">
            @if (M.Tipo != null) { <input type="hidden" name="tipo" value="@M.Tipo" /> }
            @if (M.AluId.HasValue) { <input type="hidden" name="aluId" value="@M.AluId" /> }
            <div class="form-group col-md-4">
                <label for="filtro-anio">Año lectivo</label>
                <select id="filtro-anio" name="aniId" class="custom-select" data-auto>
                    <option value="">Todos los años</option>
                    @foreach (var a in M.Anios)
                    {
                        <option value="@a.Ani_Id" selected="@(a.Ani_Id == M.AniId)">@(string.IsNullOrWhiteSpace(a.Ani_Nombre) ? a.Ani_Anio.ToString() : a.Ani_Nombre)</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-4">
                <label for="filtro-buscar">Alumno o referencia</label>
                <input id="filtro-buscar" name="q" type="search" class="form-control" value="@M.Buscar"
                       placeholder="Nombre, identidad o CE-26-…" autocomplete="off" maxlength="100" />
            </div>
            <div class="form-group col-md-4">
                <button type="submit" class="btn btn-outline-primary mr-2"><i class="bi bi-search mr-1" aria-hidden="true"></i> Buscar</button>
                @if (M.HayFiltros)
                {
                    <a class="btn btn-link" href="@Url.Action("Index")"><i class="bi bi-x-lg mr-1" aria-hidden="true"></i> Quitar filtros</a>
                }
            </div>
        </form>
        <p class="text-muted small mt-2 mb-0" id="cst-cargando" role="status" hidden>Actualizando documentos…</p>
    </section>

    <section class="statbox widget box box-shadow mb-4" aria-labelledby="cst-lista-titulo">
        <h5 class="mb-1" id="cst-lista-titulo">Documentos emitidos</h5>
        <p class="text-muted small mb-3">El más reciente va primero. Abra uno para leerlo o imprimirlo.</p>

        @if (M.Documentos.Count == 0)
        {
            if (M.HayFiltros)
            {
                <div class="text-center py-5">
                    <i class="bi bi-search h1 text-muted d-block" aria-hidden="true"></i>
                    <h5>Nada coincide con este filtro</h5>
                    <p class="text-muted">No hay documentos emitidos con esos datos.</p>
                    <div>
                        <a class="btn btn-outline-primary mr-2" href="@Url.Action("Index")">Ver todos los documentos</a>
                        @if (M.PuedeEmitir)
                        {
                            <a class="btn btn-primary" href="@urlEmitir">Emitir uno</a>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-text h1 text-muted d-block" aria-hidden="true"></i>
                    <h5>Todavía no se ha emitido ningún documento</h5>
                    <p class="text-muted">Aquí aparecerán las constancias de estudio, los boletines y los expedientes que emita la Secretaría.</p>
                    @if (M.PuedeEmitir)
                    {
                        <a class="btn btn-primary" href="@urlEmitir">Emitir el primero</a>
                    }
                </div>
            }
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Referencia</th>
                            <th scope="col">Tipo</th>
                            <th scope="col">Alumno</th>
                            <th scope="col">Año / parcial</th>
                            <th scope="col">Revisión</th>
                            <th scope="col">Emitido</th>
                            <th scope="col" class="text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in M.Documentos)
                        {
                            var t = CatalogoDocumentos.Tipo(d.Doc_Tipo);
                            <tr class="@(d.Doc_EsUltima ? "" : "text-muted")">
                                <td><a class="font-weight-bold" href="@Url.Action("Ver", new { id = d.Doc_Id })">@d.Doc_Referencia</a></td>
                                <td><span class="badge @BadgeTipo(d.Doc_Tipo)"><i class="@t.Icono mr-1" aria-hidden="true"></i>@t.Etiqueta</span></td>
                                <td>
                                    <span class="font-weight-bold d-block">@d.Alu_Nombre</span>
                                    <span class="small text-muted d-block">@d.Alu_Identidad</span>
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(d.Ani_Nombre) ? "Todos los años" : d.Ani_Nombre)
                                    @if (!string.IsNullOrWhiteSpace(d.Pac_Descripcion))
                                    {
                                        <span class="small text-muted d-block">Parcial @d.Pac_Descripcion</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge outline-badge-dark">r@(d.Doc_Revision)</span>
                                    @if (!d.Doc_EsUltima)
                                    {
                                        <span class="small text-warning d-block"><i class="bi bi-arrow-repeat mr-1" aria-hidden="true"></i> Reemplazada</span>
                                    }
                                </td>
                                <td class="text-muted text-nowrap">
                                    @CatalogoDocumentos.Fecha(d.Doc_FechaEmision)
                                    <span class="small text-muted d-block">@(string.IsNullOrWhiteSpace(d.Doc_EmitidoPor) ? "" : "por " + d.Doc_EmitidoPor)</span>
                                </td>
                                <td class="text-right">
                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Ver", new { id = d.Doc_Id })"
                                       aria-label="Ver el documento @d.Doc_Referencia">
                                        <i class="bi bi-eye mr-1" aria-hidden="true"></i> Ver
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (M.Paginas > 1)
            {
                <nav class="d-flex flex-wrap align-items-center justify-content-between mt-3" aria-label="Páginas de documentos">
                    <span class="text-muted small">Mostrando @M.Desde–@M.Hasta de @M.Total</span>
                    <ul class="pagination mb-0">
                        <li class="page-item @(M.Pagina <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@urlPagina(M.Pagina - 1)" aria-label="Página anterior"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                        </li>
                        @for (int p = 1; p <= M.Paginas; p++)
                        {
                            if (p == 1 || p == M.Paginas || Math.Abs(p - M.Pagina) <= 1)
                            {
                                <li class="page-item @(p == M.Pagina ? "active" : "")">
                                    <a class="page-link" href="@urlPagina(p)" aria-current="@(p == M.Pagina ? "page" : null)">@p</a>
                                </li>
                            }
                            else if (p == 2 || p == M.Paginas - 1)
                            {
                                <li class="page-item disabled" aria-hidden="true"><span class="page-link">…</span></li>
                            }
                        }
                        <li class="page-item @(M.Pagina >= M.Paginas ? "disabled" : "")">
                            <a class="page-link" href="@urlPagina(M.Pagina + 1)" aria-label="Página siguiente"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                        </li>
                    </ul>
                </nav>
            }
            else
            {
                <p class="text-muted small mt-3 mb-0">@M.Total @(M.Total == 1 ? "documento" : "documentos")</p>
            }
        }
    </section>
</div>

@section Scripts{
    <script src="~/Content/js/pages/constancias.js" asp-append-version="true"></script>
}
