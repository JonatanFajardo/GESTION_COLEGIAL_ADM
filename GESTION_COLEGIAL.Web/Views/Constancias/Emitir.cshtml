@model GESTION_COLEGIAL.UI.Models.ConstanciaEmitirPaginaViewModel
@using GESTION_COLEGIAL.UI.Models
@{
    ViewBag.Title = "Emitir un documento";
    var M = Model;
    string tipoInicial = M.Tipo ?? "";
}

@section Styles{
    <link href="~/css/pages/constancias.css" rel="stylesheet" asp-append-version="true" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Constancias y expediente</a></li>
            <li class="breadcrumb-item active" aria-current="page">Emitir un documento</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Emitir un documento</h4>
        <p class="text-muted mb-0">Elija el documento y el alumno, revise la vista previa y emítalo. Lo emitido queda fijo; una corrección se emite como revisión nueva.</p>
    </div>
    <div class="mt-2 mt-md-0">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index")">
            <i class="bi bi-arrow-left mr-1" aria-hidden="true"></i> Volver
        </a>
    </div>
</div>

<div class="cst-page">
    <div class="alert alert-light-danger" id="cst-error-general" role="alert" hidden></div>

    <form id="cst-form-emitir" novalidate aria-label="Emitir un documento"
          data-url-previa="@Url.Action("VistaPreviaAsync")" data-url-emitir="@Url.Action("EmitirAsync")">
        @Html.AntiForgeryToken()

        @* 1 · Tipo *@
        <section class="statbox widget box box-shadow mb-4">
            <h5 class="mb-1"><span class="badge badge-primary mr-2">1</span> Qué documento</h5>
            <fieldset class="row">
                <legend class="sr-only">Tipo de documento</legend>
                @foreach (var t in CatalogoDocumentos.Tipos)
                {
                    <div class="col-md-4 mb-3">
                        <div class="custom-control custom-radio border rounded p-3 pl-5 h-100">
                            <input type="radio" class="custom-control-input" id="tipo-@t.Codigo" name="tipo" value="@t.Codigo" checked="@(t.Codigo == tipoInicial)"
                                   data-pide-anio="@(t.PideAnio ? "1" : "0")" data-pide-parcial="@(t.PideParcial ? "1" : "0")" />
                            <label class="custom-control-label d-block" for="tipo-@t.Codigo">
                                <i class="@t.Icono text-primary h4 d-block mb-1" aria-hidden="true"></i>
                                <span class="font-weight-bold d-block">@t.Titulo</span>
                                <span class="small text-muted">@t.Explicacion</span>
                            </label>
                        </div>
                    </div>
                }
            </fieldset>
            <p class="small text-danger mb-0" data-error="tipo"></p>
        </section>

        @* 2 · Alumno *@
        <section class="statbox widget box box-shadow mb-4">
            <h5 class="mb-1"><span class="badge badge-primary mr-2">2</span> Alumno</h5>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="cst-buscar-alumno">Buscar</label>
                    <input id="cst-buscar-alumno" type="search" class="form-control" placeholder="Escriba nombre o identidad para acortar la lista" autocomplete="off" />
                </div>
                <div class="form-group col-md-6">
                    <label for="alumno">Alumno</label>
                    <select id="alumno" class="custom-select">
                        <option value="">Elija un alumno</option>
                        @foreach (var a in M.Alumnos)
                        {
                            <option value="@a.Alu_Id" selected="@(a.Alu_Id == M.AluId)"
                                    data-buscar="@((a.Nombre + " " + a.Identidad).ToLowerInvariant())">@a.Nombre@(string.IsNullOrWhiteSpace(a.Identidad) ? "" : " · " + a.Identidad)@(string.IsNullOrWhiteSpace(a.Ubicacion) ? "" : " · " + a.Ubicacion)</option>
                        }
                    </select>
                    <p class="small text-danger mb-0" data-error="alumno"></p>
                </div>
            </div>
            @if (M.Alumnos.Count == 0)
            {
                <p class="small text-muted mt-2 mb-0">No se pudo cargar la lista de alumnos. Recargue la página.</p>
            }
        </section>

        @* 3 · Año y parcial *@
        <section class="statbox widget box box-shadow mb-4" id="cst-bloque-anio">
            <h5 class="mb-1"><span class="badge badge-primary mr-2">3</span> Año lectivo</h5>
            <p class="text-muted small mb-3" id="cst-anio-expediente" hidden>El expediente lleva todos los años que el alumno cursó: no hace falta elegir año.</p>
            <div class="form-row" id="cst-campos-anio">
                <div class="form-group col-md-6">
                    <label for="anio">Año lectivo</label>
                    <select id="anio" class="custom-select">
                        <option value="">Elija el año</option>
                        @foreach (var a in M.Anios)
                        {
                            <option value="@a.Ani_Id" selected="@(a.Ani_Id == M.AniIdSugerido)">@(string.IsNullOrWhiteSpace(a.Ani_Nombre) ? a.Ani_Anio.ToString() : a.Ani_Nombre)@(a.Ani_EsActual ? " (actual)" : "")</option>
                        }
                    </select>
                    <p class="small text-danger mb-0" data-error="anio"></p>
                </div>
                <div class="form-group col-md-6" id="cst-campo-parcial" hidden>
                    <label for="parcial">Parcial</label>
                    <select id="parcial" class="custom-select">
                        <option value="">Todos los parciales</option>
                        @foreach (var p in M.Parciales)
                        {
                            <option value="@p.Pac_Id" selected="@(p.Pac_Id == M.PacId)">@p.Pac_Descripcion</option>
                        }
                    </select>
                    <p class="small text-muted mt-2 mb-0">Opcional: deje "Todos" para el boletín del año completo.</p>
                </div>
            </div>
        </section>

        @* 4 · Vista previa *@
        <section class="statbox widget box box-shadow mb-4">
            <h5 class="mb-1"><span class="badge badge-primary mr-2">4</span> Vista previa</h5>
            <p class="text-muted small mb-3">Así quedará el documento. Revíselo antes de emitirlo.</p>
            <button type="button" class="btn btn-outline-primary" id="cst-ver-previa">
                <i class="bi bi-eye mr-1" aria-hidden="true"></i> Ver vista previa
            </button>
            <p class="text-muted small mt-2 mb-0" id="cst-previa-cargando" role="status" hidden>Preparando la vista previa…</p>

            <div class="alert alert-light-warning mt-3" id="cst-aviso-revision" role="status" hidden></div>

            <div class="form-group mt-3" id="cst-campo-motivo" hidden>
                <label for="motivo">Motivo de la revisión</label>
                <textarea id="motivo" class="form-control" rows="2" maxlength="500"
                          placeholder="Qué se corrige y por qué (ej. se corrigió la nota de Matemáticas del segundo parcial)"></textarea>
                <p class="small text-danger mb-0" data-error="motivo"></p>
            </div>

            <div class="cst-previa-marco" id="cst-previa" aria-live="polite"></div>
        </section>

        @* 5 · Emitir *@
        <div class="d-flex justify-content-end">
            <a class="btn mr-2" href="@Url.Action("Index")">Cancelar</a>
            <button type="submit" class="btn btn-primary" id="cst-emitir" disabled>
                <i class="bi bi-check2-circle mr-1" aria-hidden="true"></i> Emitir documento
            </button>
        </div>
        <p class="small text-muted text-right mt-2" id="cst-emitir-nota">Primero vea la vista previa.</p>
    </form>
</div>

@section Scripts{
    <script src="~/Content/js/pages/constancias.js" asp-append-version="true"></script>
}
