@model GESTION_COLEGIAL.UI.Models.ConstanciaVerViewModel
@using GESTION_COLEGIAL.UI.Models
@{
    var M = Model;
    var D = M.Documento;
    var tipo = CatalogoDocumentos.Tipo(D.Doc_Tipo);
    ViewBag.Title = tipo.Titulo + " " + D.Doc_Referencia;
    bool reemplazada = M.Ultima != null && M.Ultima.Doc_Id != D.Doc_Id;
}

@section Styles{
    <link href="~/css/pages/constancias.css" rel="stylesheet" asp-append-version="true" />
}

<div class="breadcrumb-wrapper-content cst-no-imprimir">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Constancias y expediente</a></li>
            <li class="breadcrumb-item active" aria-current="page">@D.Doc_Referencia</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 cst-no-imprimir">
    <div class="mr-3">
        <h4 class="mb-1"><i class="@tipo.Icono text-primary mr-1" aria-hidden="true"></i> @tipo.Titulo · @D.Doc_Referencia</h4>
        <p class="text-muted mb-0">@D.Alu_Nombre · revisión @D.Doc_Revision · emitido el @CatalogoDocumentos.Fecha(D.Doc_FechaEmision)</p>
    </div>
    <div class="mt-2 mt-md-0">
        <button type="button" class="btn btn-primary" data-imprimir>
            <i class="bi bi-printer mr-1" aria-hidden="true"></i> Imprimir
        </button>
    </div>
</div>

<div class="cst-page">
    @if (!string.IsNullOrEmpty(M.Aviso))
    {
        <div class="alert alert-light-success cst-no-imprimir" role="status">
            <i class="bi bi-check-circle mr-1" aria-hidden="true"></i> @M.Aviso
        </div>
    }
    @if (reemplazada)
    {
        <div class="alert alert-light-warning cst-no-imprimir" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            Hay una revisión más nueva. Esta es la revisión @D.Doc_Revision; el colegio emitió después la revisión @M.Ultima.Doc_Revision.
            Esta página queda tal como se emitió.
            <a href="@Url.Action("Ver", new { id = M.Ultima.Doc_Id })">Abrir la revisión @M.Ultima.Doc_Revision</a>
        </div>
    }
    @if (M.ContenidoIlegible)
    {
        <div class="alert alert-light-danger cst-no-imprimir" role="alert">
            No se pudo leer el contenido guardado de este documento. Se muestran solo los datos generales.
        </div>
    }

    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 cst-no-imprimir">
        <a class="btn btn-link" href="@Url.Action("Index", new { aluId = D.Alu_Id })">
            <i class="bi bi-arrow-left mr-1" aria-hidden="true"></i> Volver
        </a>
        <div>
            @if (M.PuedeEmitir)
            {
                <a class="btn btn-outline-primary" href="@Url.Action("Emitir", new { tipo = D.Doc_Tipo, aluId = D.Alu_Id, aniId = D.Ani_Id, pacId = D.Pac_Id })">
                    <i class="bi bi-arrow-repeat mr-1" aria-hidden="true"></i> Emitir una revisión
                </a>
            }
        </div>
    </div>

    <div class="cst-papel">
        <partial name="_Documento" model="M.Impreso" />
    </div>

    <section class="statbox widget box box-shadow mb-4 cst-no-imprimir" aria-labelledby="cst-revisiones-titulo">
        <h5 class="mb-1" id="cst-revisiones-titulo">Historial de revisiones</h5>
        <p class="text-muted small mb-3">Un documento emitido nunca cambia. Una corrección se emite como la revisión siguiente y las anteriores siguen disponibles.</p>
        <ol class="list-group">
            @foreach (var r in M.Revisiones)
            {
                bool actual = r.Doc_Id == D.Doc_Id;
                <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between @(actual ? "border-primary" : "")">
                    <div>
                        <p class="font-weight-bold mb-0">
                            Revisión @r.Doc_Revision · @r.Doc_Referencia
                            @if (actual) { <span class="small text-muted font-weight-normal">(está leyendo esta)</span> }
                        </p>
                        <p class="small text-muted mb-0">
                            @CatalogoDocumentos.Fecha(r.Doc_FechaEmision)@(string.IsNullOrWhiteSpace(r.Doc_EmitidoPor) ? "" : " · " + r.Doc_EmitidoPor)@(string.IsNullOrWhiteSpace(r.Doc_Motivo) ? "" : " · " + r.Doc_Motivo)
                        </p>
                    </div>
                    <div class="d-flex align-items-center small">
                        @if (r.Doc_Promedio.HasValue)
                        {
                            <span class="text-muted mr-3">Promedio @CatalogoDocumentos.Promedio(r.Doc_Promedio)</span>
                        }
                        @if (!actual)
                        {
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Ver", new { id = r.Doc_Id })"
                               aria-label="Abrir la revisión @r.Doc_Revision">Abrir</a>
                        }
                    </div>
                </li>
            }
        </ol>
    </section>
</div>

@section Scripts{
    <script src="~/Content/js/pages/constancias.js" asp-append-version="true"></script>
}
