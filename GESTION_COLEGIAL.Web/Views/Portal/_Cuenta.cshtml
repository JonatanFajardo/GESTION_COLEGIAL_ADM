@model GESTION_COLEGIAL.UI.Models.PortalPaginaViewModel
@{
    var M = Model;
    var hoy = DateTime.Today;
    var cultura = new System.Globalization.CultureInfo("es-HN");
    decimal pendiente = M.Cargos.Sum(c => c.Cco_MontoPendiente);
    decimal vencido = M.Cargos.Where(c => c.Cco_MontoPendiente > 0 && c.Cco_FechaVencimiento.Date < hoy).Sum(c => c.Cco_MontoPendiente);
    decimal pagado = M.Cargos.Sum(c => c.MontoPagado);
}

@if (M.Cargos.Count == 0)
{
    <div class="alert alert-light-info mb-4">No hay cargos registrados este año.</div>
}
else
{
    <div class="row">
        <div class="col-12 col-md-4 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value">L @pendiente.ToString("N2")</h6>
                            <p>Falta pagar</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-wallet2" aria-hidden="true"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value @(vencido > 0 ? "text-danger" : "")">L @vencido.ToString("N2")</h6>
                            <p>Vencido</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-exclamation-circle" aria-hidden="true"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value">L @pagado.ToString("N2")</h6>
                            <p>Pagado este año</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Concepto</th>
                            <th scope="col" class="d-none d-md-table-cell">Vence</th>
                            <th scope="col" class="text-right d-none d-sm-table-cell">Total</th>
                            <th scope="col" class="text-right d-none d-md-table-cell">Pagado</th>
                            <th scope="col" class="text-right">Pendiente</th>
                            <th scope="col">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in M.Cargos)
                        {
                            bool estaVencido = c.Cco_MontoPendiente > 0 && c.Cco_FechaVencimiento.Date < hoy;
                            string mes = c.Cco_Mes >= 1 && c.Cco_Mes <= 12 ? cultura.DateTimeFormat.GetMonthName(c.Cco_Mes) : "";
                            <tr>
                                <td>@c.Cpa_Descripcion<span class="d-block small text-muted">@mes @c.Cco_Anio</span></td>
                                <td class="d-none d-md-table-cell text-nowrap">@c.Cco_FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td class="text-right d-none d-sm-table-cell">@c.Cco_MontoTotal.ToString("N2")</td>
                                <td class="text-right d-none d-md-table-cell">@c.MontoPagado.ToString("N2")</td>
                                <td class="text-right font-weight-bold">@c.Cco_MontoPendiente.ToString("N2")</td>
                                <td>
                                    @if (c.Cco_MontoPendiente <= 0)
                                    {
                                        <span class="badge badge-success">Pagado</span>
                                    }
                                    else if (estaVencido)
                                    {
                                        <span class="badge badge-danger">Vencido</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">@(string.IsNullOrWhiteSpace(c.Estado) ? "Pendiente" : c.Estado)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
