@model GESTION_COLEGIAL.UI.Models.ReporteAsistenciaSeccionViewModel
@using GESTION_COLEGIAL.UI.Models
@{
    var M = Model;
    var I = M.Info;
    // El nombre de la sección ya suele traer el grado ("Séptimo A · Matutina"): no repetirlo.
    string nombre = string.IsNullOrWhiteSpace(I.Grado) || (I.Seccion ?? "").StartsWith(I.Grado, StringComparison.OrdinalIgnoreCase)
        ? (I.Seccion ?? "").Trim()
        : (I.Grado + " " + I.Seccion).Trim();
    ViewBag.Title = "Asistencia " + nombre;
    string urlVolver = Url.Action("Index", new { desde = M.DesdeIso, hasta = M.HastaIso, nivId = M.NivId, cunId = M.CunId, seaId = M.SeaIdFiltro });
    string archivo = ("asistencia-" + nombre + "-" + M.DesdeIso + "-a-" + M.HastaIso).Replace(" ", "-").ToLowerInvariant() + ".csv";
    // Color de la barra de % según el tono (bien / atención / riesgo)
    Func<decimal?, string> colorTono = p => FormatoAsistencia.Tono(p) switch { "bien" => "success", "atencion" => "warning", _ => "danger" };
}

@section Styles{
    <link href="~/css/pages/reporte-asistencia.css" rel="stylesheet" asp-append-version="true" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="@urlVolver">Asistencia de alumnos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@nombre</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">@nombre</h4>
        <p class="text-muted mb-0">Asistencia del @FormatoAsistencia.Dia(M.Desde) al @FormatoAsistencia.Dia(M.Hasta).</p>
    </div>
    <div class="mt-2 mt-md-0">
        <a class="btn btn-outline-secondary" href="@urlVolver">
            <i class="bi bi-arrow-left mr-1" aria-hidden="true"></i> Todas las secciones
        </a>
    </div>
</div>

<div class="fluid-container">
    <section class="statbox widget box box-shadow mb-4" aria-label="Datos de la sección">
        <div class="widget-content widget-content-area">
            <dl class="row mb-0">
                <div class="col-sm-6 col-lg-3 mb-2 mb-lg-0"><dt class="text-muted small">Sección</dt><dd class="mb-0 font-weight-bold">@I.Seccion</dd></div>
                <div class="col-sm-6 col-lg-3 mb-2 mb-lg-0"><dt class="text-muted small">Grado</dt><dd class="mb-0 font-weight-bold">@I.Grado</dd></div>
                <div class="col-sm-6 col-lg-3 mb-2 mb-lg-0"><dt class="text-muted small">Nivel</dt><dd class="mb-0 font-weight-bold">@I.Nivel</dd></div>
                <div class="col-sm-6 col-lg-3">
                    <dt class="text-muted small">Docente guía</dt>
                    @if (string.IsNullOrWhiteSpace(I.Guia))
                    {
                        <dd class="mb-0 text-muted">Sin asignar</dd>
                    }
                    else
                    {
                        <dd class="mb-0 font-weight-bold">@I.Guia</dd>
                    }
                </div>
            </dl>
        </div>
    </section>

    <section class="statbox widget box box-shadow mb-4" aria-labelledby="ras-alumnos-titulo">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4 id="ras-alumnos-titulo">Alumnos</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="d-flex flex-wrap align-items-start justify-content-between mb-3">
                <p class="text-muted mb-2 mr-3">
                    P presente · T tardanza · A ausente · J justificado.
                    @if (M.EnRiesgo > 0)
                    {
                        <span>@M.EnRiesgo @(M.EnRiesgo == 1 ? "alumno está" : "alumnos están") en riesgo.</span>
                    }
                </p>
                @if (M.Alumnos.Count > 0)
                {
                    <div class="d-flex flex-wrap align-items-center">
                        <div class="custom-control custom-checkbox mr-3 mb-2">
                            <input type="checkbox" class="custom-control-input" id="ras-solo-riesgo" data-tabla="#ras-tabla-alumnos" />
                            <label class="custom-control-label" for="ras-solo-riesgo">Solo en riesgo</label>
                        </div>
                        <button type="button" class="btn btn-outline-primary mb-2" data-exportar="#ras-tabla-alumnos" data-archivo="@archivo">
                            <i class="bi bi-file-earmark-spreadsheet mr-1" aria-hidden="true"></i> Exportar a Excel
                        </button>
                    </div>
                }
            </div>

            @if (M.Alumnos.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-people fa-3x mb-3 d-block" aria-hidden="true"></i>
                    <h5>Esta sección no tiene alumnos</h5>
                    <p class="mb-0">Cuando haya alumnos matriculados en la sección, aquí verá su asistencia.</p>
                </div>
            }
            else
            {
                if (!M.HayRegistros)
                {
                    <div class="alert alert-light-info mb-3" role="status">
                        <i class="bi bi-info-circle mr-1" aria-hidden="true"></i>
                        Todavía no hay pase de lista en estas fechas. Pruebe con otro rango desde <a class="alert-link" href="@urlVolver">el reporte general</a>.
                    </div>
                }
                <div class="table-responsive">
                    <table class="table table-hover" id="ras-tabla-alumnos">
                        <thead>
                            <tr>
                                <th scope="col">Alumno</th>
                                <th scope="col" class="text-right"><abbr title="Presentes">P</abbr></th>
                                <th scope="col" class="text-right"><abbr title="Tardanzas">T</abbr></th>
                                <th scope="col" class="text-right"><abbr title="Ausentes">A</abbr></th>
                                <th scope="col" class="text-right"><abbr title="Justificados">J</abbr></th>
                                <th scope="col">%</th>
                                <th scope="col">Última ausencia</th>
                                <th scope="col">Situación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in M.Alumnos)
                            {
                                <tr data-riesgo="@(a.EnRiesgo ? "1" : "0")">
                                    <td data-csv="@a.NombreAlumno">
                                        <span class="font-weight-bold">@a.NombreAlumno</span>
                                        @if (!string.IsNullOrWhiteSpace(a.Identidad))
                                        {
                                            <span class="d-block text-muted small">@a.Identidad</span>
                                        }
                                    </td>
                                    <td class="text-right">@a.Presentes</td>
                                    <td class="text-right">@a.Tardanzas</td>
                                    <td class="text-right">@a.Ausentes</td>
                                    <td class="text-right">@a.Justificados</td>
                                    <td data-csv="@(a.PorcAsistencia.HasValue ? a.PorcAsistencia.Value.ToString("0.0", FormatoAsistencia.Cultura) : "")">
                                        <span class="font-weight-bold">@FormatoAsistencia.Porcentaje(a.PorcAsistencia)</span>
                                        @if (a.PorcAsistencia.HasValue)
                                        {
                                            <div class="progress mb-0 mt-1" aria-hidden="true">
                                                <div class="progress-bar bg-@colorTono(a.PorcAsistencia)" style="width:@(FormatoAsistencia.Ancho(a.PorcAsistencia))%"></div>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-muted text-nowrap">
                                        @(a.UltimaAusencia.HasValue ? FormatoAsistencia.Dia(a.UltimaAusencia.Value) : "Ninguna")
                                    </td>
                                    <td data-csv="@(a.EnRiesgo ? "En riesgo" : "")">
                                        @if (a.EnRiesgo)
                                        {
                                            <span class="badge badge-danger"><i class="bi bi-exclamation-triangle mr-1" aria-hidden="true"></i>En riesgo</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="text-muted text-center py-3 mb-0" id="ras-sin-riesgo" hidden>Ningún alumno está en riesgo en estas fechas.</p>
                </div>
            }
        </div>
    </section>

    @if (M.Alumnos.Count > 0)
    {
        <section class="statbox widget box box-shadow mb-4" aria-labelledby="ras-planilla-titulo">
            <div class="widget-header">
                <div class="row"><div class="col-12"><h4 id="ras-planilla-titulo">Planilla día por día</h4></div></div>
            </div>
            <div class="widget-content widget-content-area ras-planilla-bloque">
            <p class="text-muted">Cada columna es un día de clase (lunes a viernes). Deslice hacia los lados para ver más días.</p>

            <ul class="ras-leyenda" aria-label="Leyenda de colores">
                <li><span class="ras-celda ras-celda--P">P</span> Presente</li>
                <li><span class="ras-celda ras-celda--T">T</span> Tardanza</li>
                <li><span class="ras-celda ras-celda--A">A</span> Ausente</li>
                <li><span class="ras-celda ras-celda--J">J</span> Justificado</li>
                <li><span class="ras-celda ras-celda--cierre"></span> Sin clases (feriado o cierre)</li>
                <li><span class="ras-celda ras-celda--vacia"></span> Sin pase de lista</li>
            </ul>

            @if (M.Dias.Count == 0)
            {
                <p class="text-muted mb-0">No hay días de clase en estas fechas.</p>
            }
            else
            {
                <div class="ras-planilla-envoltura" tabindex="0" role="region" aria-label="Planilla de asistencia, se desplaza hacia los lados">
                    <table class="ras-planilla">
                        <thead>
                            <tr>
                                <th scope="col" class="ras-planilla-fija">Alumno</th>
                                @foreach (var d in M.Dias)
                                {
                                    <th scope="col" class="@(d.EsCierre ? "ras-dia--cierre" : "")"
                                        title="@(FormatoAsistencia.Dia(d.Fecha))@(d.EsCierre && !string.IsNullOrWhiteSpace(d.Motivo) ? " · " + d.Motivo : "")">
                                        <span class="ras-dia-semana">@FormatoAsistencia.DiaSemana(d.Fecha)</span>
                                        <span class="ras-dia-fecha">@FormatoAsistencia.DiaCorto(d.Fecha)</span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in M.Alumnos)
                            {
                                <tr data-riesgo="@(a.EnRiesgo ? "1" : "0")">
                                    <th scope="row" class="ras-planilla-fija">@a.NombreAlumno</th>
                                    @foreach (var d in M.Dias)
                                    {
                                        if (d.EsCierre)
                                        {
                                            <td class="ras-dia--cierre" title="@(string.IsNullOrWhiteSpace(d.Motivo) ? "Sin clases" : d.Motivo)">
                                                <span class="ras-celda ras-celda--cierre"><span class="sr-only">Sin clases</span></span>
                                            </td>
                                        }
                                        else
                                        {
                                            string e = M.EstadoDe(a.Alu_Id, d.Fecha);
                                            string etiqueta = FormatoAsistencia.Estado(e);
                                            if (string.IsNullOrEmpty(etiqueta))
                                            {
                                                <td><span class="ras-celda ras-celda--vacia"><span class="sr-only">Sin pase de lista</span></span></td>
                                            }
                                            else
                                            {
                                                <td title="@etiqueta · @FormatoAsistencia.Dia(d.Fecha)">
                                                    <span class="ras-celda ras-celda--@e" aria-label="@etiqueta">@e</span>
                                                </td>
                                            }
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            </div>
        </section>
    }
</div>

@section Scripts{
    <script src="~/Content/js/pages/reporte-asistencia.js" asp-append-version="true"></script>
}
