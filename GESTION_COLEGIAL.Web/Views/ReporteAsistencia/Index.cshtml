@model GESTION_COLEGIAL.UI.Models.ReporteAsistenciaIndexViewModel
@using GESTION_COLEGIAL.UI.Models
@{
    ViewBag.Title = "Asistencia de alumnos";
    var M = Model;
    Func<DateTime, DateTime, string> urlRango = (d, h) =>
        Url.Action("Index", new { desde = FormatoAsistencia.Iso(d), hasta = FormatoAsistencia.Iso(h), nivId = M.NivId, cunId = M.CunId, seaId = M.SeaId });
    // Para la cascada en el navegador: cada sección con su grado y nivel.
    var filtrosJson = Newtonsoft.Json.JsonConvert.SerializeObject(M.Filtros.Select(f => new { s = f.Sea_Id, sn = f.Seccion, n = f.Niv_Id, nn = f.Nivel, c = f.Cun_Id, cn = f.Grado }));
    bool hayDatos = M.Secciones.Count > 0 && M.Registros > 0;
    // Color de la barra de % según el tono (bien / atención / riesgo)
    Func<decimal?, string> colorTono = p => FormatoAsistencia.Tono(p) switch { "bien" => "success", "atencion" => "warning", _ => "danger" };
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item">Académico</li>
            <li class="breadcrumb-item active" aria-current="page">Asistencia de alumnos</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Asistencia de alumnos</h4>
        <p class="text-muted mb-0">
            Cómo va la asistencia de cada sección según el pase de lista, y quiénes necesitan atención.
            @if (!M.VerTodas) { <span>Usted ve solo las secciones donde da clase.</span> }
        </p>
    </div>
    @if (hayDatos)
    {
        <div class="mt-2 mt-md-0">
            <button type="button" class="btn btn-outline-primary" data-exportar="#ras-tabla-secciones"
                    data-archivo="asistencia-secciones-@(M.DesdeIso)-a-@(M.HastaIso).csv">
                <i class="bi bi-file-earmark-spreadsheet mr-1" aria-hidden="true"></i> Exportar a Excel
            </button>
        </div>
    }
</div>

<div class="fluid-container">
    @if (M.Anio == null)
    {
        <section class="statbox widget box box-shadow mb-4">
            <div class="widget-content widget-content-area text-center text-muted py-5">
                <i class="bi bi-calendar-x fa-3x mb-3 d-block" aria-hidden="true"></i>
                <h5>No hay un año lectivo para hoy</h5>
                <p class="mb-0">El reporte se arma con las secciones del año lectivo en curso. Cuando el año esté abierto, aquí aparecerá la asistencia.</p>
            </div>
        </section>
    }
    else
    {
        <section class="statbox widget box box-shadow mb-4" aria-labelledby="ras-filtros-titulo">
            <div class="widget-header">
                <div class="row"><div class="col-12"><h4 id="ras-filtros-titulo">Año lectivo @M.Anio.Ani_Nombre</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <p class="text-muted">Elija las fechas y, si quiere, un nivel, un grado o una sección.</p>

                <div class="mb-3" role="group" aria-label="Atajos de fechas">
                    @foreach (var a in M.Atajos)
                    {
                        <a class="btn btn-sm btn-rounded @(a.Activo ? "btn-primary" : "btn-outline-primary") mr-1 mb-1" href="@urlRango(a.Desde, a.Hasta)"
                           aria-current="@(a.Activo ? "true" : null)" title="@FormatoAsistencia.Dia(a.Desde) al @FormatoAsistencia.Dia(a.Hasta)">@a.Nombre</a>
                    }
                </div>

                <form method="get" action="@Url.Action("Index")" id="ras-form-filtros" class="form-row align-items-end" novalidate
                      data-filtros="@filtrosJson" data-max-dias="@FormatoAsistencia.MaxDias">
                    <div class="col-md-6 col-xl-2 form-group">
                        <label for="ras-desde">Desde</label>
                        <input type="date" id="ras-desde" name="desde" class="form-control" value="@M.DesdeIso" max="@M.HoyIso" required />
                    </div>
                    <div class="col-md-6 col-xl-2 form-group">
                        <label for="ras-hasta">Hasta</label>
                        <input type="date" id="ras-hasta" name="hasta" class="form-control" value="@M.HastaIso" max="@M.HoyIso" required />
                    </div>
                    <div class="col-md-4 col-xl-2 form-group">
                        <label for="ras-nivel">Nivel</label>
                        <select id="ras-nivel" name="nivId" class="custom-select" disabled="@(M.Filtros.Count == 0)">
                            <option value="">Todos los niveles</option>
                            @foreach (var n in M.Niveles)
                            {
                                <option value="@n.Niv_Id" selected="@(n.Niv_Id == M.NivId)">@n.Nivel</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 col-xl-2 form-group">
                        <label for="ras-grado">Grado</label>
                        <select id="ras-grado" name="cunId" class="custom-select" disabled="@(!M.NivId.HasValue)">
                            <option value="">@(M.NivId.HasValue ? "Todos los grados" : "Elija un nivel primero")</option>
                            @foreach (var g in M.Grados)
                            {
                                <option value="@g.Cun_Id" selected="@(g.Cun_Id == M.CunId)">@g.Grado</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 col-xl-2 form-group">
                        <label for="ras-seccion">Sección</label>
                        <select id="ras-seccion" name="seaId" class="custom-select" disabled="@(!M.CunId.HasValue)">
                            <option value="">@(M.CunId.HasValue ? "Todas las secciones" : "Elija un grado primero")</option>
                            @foreach (var s in M.SeccionesFiltro)
                            {
                                <option value="@s.Sea_Id" selected="@(s.Sea_Id == M.SeaId)">@s.Seccion</option>
                            }
                        </select>
                    </div>
                    <div class="col-xl-2 form-group">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search mr-1" aria-hidden="true"></i> Ver reporte</button>
                        @if (M.HayFiltros)
                        {
                            <a class="btn btn-link" href="@Url.Action("Index", new { desde = M.DesdeIso, hasta = M.HastaIso })">
                                <i class="bi bi-x-lg mr-1" aria-hidden="true"></i> Quitar filtros
                            </a>
                        }
                    </div>
                </form>
                <p class="text-danger small mb-0" id="ras-error-fechas" role="alert">@M.Error</p>
                <p class="text-muted small mb-0" id="ras-cargando" role="status" hidden>Armando el reporte…</p>
            </div>
        </section>

        @if (M.Error == null && M.Filtros.Count == 0)
        {
            <section class="statbox widget box box-shadow mb-4">
                <div class="widget-content widget-content-area text-center text-muted py-5">
                    <i class="bi bi-people fa-3x mb-3 d-block" aria-hidden="true"></i>
                    <h5>No hay secciones para mostrar</h5>
                    <p class="mb-0">
                        @(M.VerTodas ? "El año lectivo todavía no tiene secciones con alumnos."
                                     : "Usted no tiene secciones asignadas en el horario de este año. Si da clase, pida que lo agreguen al horario.")
                    </p>
                </div>
            </section>
        }
        else if (M.Error == null)
        {
            <div class="row" aria-label="Resumen del período">
                <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                    <div class="widget widget-card-four">
                        <div class="widget-content">
                            <div class="w-content">
                                <div class="w-info">
                                    <h6 class="value">@(M.PorcGeneral.HasValue ? FormatoAsistencia.Porcentaje(M.PorcGeneral) : "—")</h6>
                                    <p>Asistencia general</p>
                                </div>
                                <div><div class="w-icon"><i class="bi bi-percent" aria-hidden="true"></i></div></div>
                            </div>
                            <p class="text-muted small mb-0 mt-2">Presentes y tardanzas sobre todos los registros</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                    <div class="widget widget-card-four">
                        <div class="widget-content">
                            <div class="w-content">
                                <div class="w-info">
                                    <h6 class="value">@M.Ausentes.ToString("N0", FormatoAsistencia.Cultura)</h6>
                                    <p>Ausencias</p>
                                </div>
                                <div><div class="w-icon"><i class="bi bi-person-x" aria-hidden="true"></i></div></div>
                            </div>
                            <p class="text-muted small mb-0 mt-2">Más @M.Justificados.ToString("N0", FormatoAsistencia.Cultura) justificadas</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                    <div class="widget widget-card-four">
                        <div class="widget-content">
                            <div class="w-content">
                                <div class="w-info">
                                    <h6 class="value">@M.Tardanzas.ToString("N0", FormatoAsistencia.Cultura)</h6>
                                    <p>Tardanzas</p>
                                </div>
                                <div><div class="w-icon"><i class="bi bi-alarm" aria-hidden="true"></i></div></div>
                            </div>
                            <p class="text-muted small mb-0 mt-2">Cuentan como asistencia</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                    <div class="widget widget-card-four">
                        <div class="widget-content">
                            <div class="w-content">
                                <div class="w-info">
                                    <h6 class="value">@M.EnRiesgo.ToString("N0", FormatoAsistencia.Cultura)</h6>
                                    <p>Alumnos en riesgo</p>
                                </div>
                                <div><div class="w-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div></div>
                            </div>
                            <p class="text-muted small mb-0 mt-2">Menos de 90 % o 3 ausencias sin justificar</p>
                        </div>
                    </div>
                </div>
            </div>

            <section class="statbox widget box box-shadow mb-4" aria-labelledby="ras-secciones-titulo">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4 id="ras-secciones-titulo">Asistencia por sección</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    <p class="text-muted">
                        Del @FormatoAsistencia.Dia(M.Desde) al @FormatoAsistencia.Dia(M.Hasta).
                        Abra la planilla de una sección para ver a cada alumno día por día.
                    </p>

                    @if (!hayDatos)
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-clipboard fa-3x mb-3 d-block" aria-hidden="true"></i>
                            <h5>Todavía no hay pase de lista en estas fechas</h5>
                            <p>Cuando los docentes pasen lista, aquí verá cómo va cada sección. Pruebe con otro rango de fechas.</p>
                            @if (M.HayFiltros)
                            {
                                <a class="btn btn-outline-primary" href="@Url.Action("Index", new { desde = M.DesdeIso, hasta = M.HastaIso })">Ver todas las secciones</a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover" id="ras-tabla-secciones">
                                <thead>
                                    <tr>
                                        <th scope="col">Sección</th>
                                        <th scope="col">Grado</th>
                                        <th scope="col" class="text-right">Alumnos</th>
                                        <th scope="col" class="text-right">Días de clase</th>
                                        <th scope="col">% asistencia</th>
                                        <th scope="col" class="text-right">Ausencias</th>
                                        <th scope="col" class="text-right">Tardanzas</th>
                                        <th scope="col" class="text-right">En riesgo</th>
                                        <th scope="col" class="text-right" data-csv-omitir><span class="sr-only">Acciones</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in M.Secciones)
                                    {
                                        var urlSeccion = Url.Action("Seccion", new { id = s.Sea_Id, desde = M.DesdeIso, hasta = M.HastaIso, nivId = M.NivId, cunId = M.CunId, seaId = M.SeaId });
                                        <tr>
                                            <td>
                                                <a class="font-weight-bold" href="@urlSeccion">@s.Seccion</a>
                                            </td>
                                            <td data-csv="@s.Grado - @s.Nivel">
                                                @s.Grado
                                                <span class="d-block text-muted small">@s.Nivel</span>
                                            </td>
                                            <td class="text-right">@s.Alumnos</td>
                                            <td class="text-right" data-csv="@s.DiasClase">
                                                @s.DiasClase
                                                <span class="d-block text-muted small">@s.DiasConRegistro con pase de lista</span>
                                            </td>
                                            <td data-csv="@(s.PorcAsistencia.HasValue ? s.PorcAsistencia.Value.ToString("0.0", FormatoAsistencia.Cultura) : "")">
                                                <span class="font-weight-bold">@FormatoAsistencia.Porcentaje(s.PorcAsistencia)</span>
                                                @if (s.PorcAsistencia.HasValue)
                                                {
                                                    <div class="progress mb-0 mt-1" aria-hidden="true">
                                                        <div class="progress-bar bg-@colorTono(s.PorcAsistencia)" style="width:@(FormatoAsistencia.Ancho(s.PorcAsistencia))%"></div>
                                                    </div>
                                                }
                                            </td>
                                            <td class="text-right">@s.Ausentes</td>
                                            <td class="text-right">@s.Tardanzas</td>
                                            <td class="text-right" data-csv="@s.AlumnosEnRiesgo">
                                                @if (s.AlumnosEnRiesgo > 0)
                                                {
                                                    <span class="badge badge-danger">@s.AlumnosEnRiesgo</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                            <td class="text-right text-nowrap" data-csv-omitir>
                                                <a class="btn btn-sm btn-outline-primary" href="@urlSeccion" aria-label="Ver la planilla de @s.Grado @s.Seccion">
                                                    <i class="bi bi-table mr-1" aria-hidden="true"></i> Ver planilla
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>

@section Scripts{
    <script src="~/Content/js/pages/reporte-asistencia.js" asp-append-version="true"></script>
}
