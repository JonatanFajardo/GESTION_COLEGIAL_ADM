@model GESTION_COLEGIAL.Business.Models.HorarioAlumnoViewModel
@{
    ViewBag.Title = "Gestión de Horarios de Alumnos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Horarios de Alumnos</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Horarios de Alumnos</h4>
        <p class="text-muted mb-0">Registre y consulte los bloques de horario por sección, materia y aula</p>
    </div>
</div>

<div class="fluid-container">
    <!-- Formulario de Registro/Edición -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4 id="form-title">Registrar Nuevo Horario</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            @using (Ajax.BeginForm("CreateAsync", "HorarioAlumnos", new AjaxOptions
            {
                HttpMethod = "Post",
                OnBegin = "HorarioAlumnos.onFormBegin",
                OnSuccess = "HorarioAlumnos.onFormSuccess",
                OnFailure = "HorarioAlumnos.onFormFailure"
            }, new { @id = "horario-form" }))
            {
                @Html.HiddenFor(model => model.HoAl_Id, new { @id = "HoAl_Id" })

                <!-- Contexto Académico -->
                <div class="border-bottom pb-3 mb-4">
                    <h5 class="mb-3">Contexto Académico</h5>
                    <div class="form-row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="HoAl_Año">Año Académico <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(model => model.HoAl_Año,
                                    new { @class = "form-control", @id = "HoAl_Año", @type = "number", @min = "2020", @max = "2050", required = "required" })
                                @Html.ValidationMessageFor(model => model.HoAl_Año, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="Sem_Id">Semestre <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.Sem_Id,
                                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                    "Seleccione...",
                                    new { @class = "custom-select", @id = "Sem_Id", required = "required" })
                                @Html.ValidationMessageFor(model => model.Sem_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="Mda_Id">Modalidad</label>
                                @Html.DropDownListFor(model => model.Mda_Id,
                                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                    "Seleccione...",
                                    new { @class = "custom-select", @id = "Mda_Id" })
                                @Html.ValidationMessageFor(model => model.Mda_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="Sec_Id">Sección <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.Sec_Id,
                                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                    "Seleccione...",
                                    new { @class = "custom-select", @id = "Sec_Id", required = "required" })
                                @Html.ValidationMessageFor(model => model.Sec_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="Cur_Id">Curso <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.Cur_Id,
                                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                    "Seleccione...",
                                    new { @class = "custom-select", @id = "Cur_Id", required = "required" })
                                @Html.ValidationMessageFor(model => model.Cur_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="Cun_Id">Nivel <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.Cun_Id,
                                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                    "Seleccione...",
                                    new { @class = "custom-select", @id = "Cun_Id", required = "required" })
                                @Html.ValidationMessageFor(model => model.Cun_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="Mat_Id">Materia <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.Mat_Id,
                                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                    "Seleccione...",
                                    new { @class = "custom-select", @id = "Mat_Id", required = "required" })
                                @Html.ValidationMessageFor(model => model.Mat_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="Emp_Id">Profesor <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.Emp_Id,
                                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                    "Seleccione...",
                                    new { @class = "custom-select", @id = "Emp_Id", required = "required" })
                                @Html.ValidationMessageFor(model => model.Emp_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="Aul_Id">Aula <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.Aul_Id,
                                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                    "Seleccione...",
                                    new { @class = "custom-select", @id = "Aul_Id", required = "required" })
                                @Html.ValidationMessageFor(model => model.Aul_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Horario -->
                <div class="mb-4">
                    <h5 class="mb-3">Horario</h5>
                    <div class="form-row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="Dia_Id">Día <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.Dia_Id,
                                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                    "Seleccione...",
                                    new { @class = "custom-select", @id = "Dia_Id", required = "required" })
                                @Html.ValidationMessageFor(model => model.Dia_Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="HoAl_HoraInicio">Hora Inicio <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.HoAl_HoraInicio,
                                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                    "Seleccione...",
                                    new { @class = "custom-select", @id = "HoAl_HoraInicio", required = "required" })
                                @Html.ValidationMessageFor(model => model.HoAl_HoraInicio, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="HoAl_HoraFinaliza">Hora Finaliza <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.HoAl_HoraFinaliza,
                                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                    "Seleccione...",
                                    new { @class = "custom-select", @id = "HoAl_HoraFinaliza", required = "required" })
                                @Html.ValidationMessageFor(model => model.HoAl_HoraFinaliza, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Botones -->
                <div class="d-flex">
                    <button type="submit" class="btn btn-primary mr-2" id="submit-btn">
                        <i class="bi bi-save mr-1"></i> Guardar
                    </button>
                    <button type="button" class="btn" id="cancel-btn" style="display:none;">
                        <i class="bi bi-x-lg mr-1"></i> Cancelar
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Listado de Horarios -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Horarios Registrados</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover wrap" id="datatable">
                    <thead>
                        <tr>
                            <th>Año</th>
                            <th>Semestre</th>
                            <th>Sección</th>
                            <th>Curso/Nivel</th>
                            <th>Materia</th>
                            <th>Profesor</th>
                            <th>Aula</th>
                            <th>Día</th>
                            <th>Hora Inicio</th>
                            <th>Hora Finaliza</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Delete-->
<div class="modal" id="delete-modal-secondary" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        @using (Ajax.BeginForm("DeleteAsync", "HorarioAlumnos", new AjaxOptions
        {
            HttpMethod = "Post",
            OnBegin = "HorarioAlumnos.onDeleteBegin",
            OnComplete = "HorarioAlumnos.onDeleteComplete",
            OnFailure = "HorarioAlumnos.onDeleteFailure",
            OnSuccess = "HorarioAlumnos.onDeleteSuccess"
        }))
        {
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    <div class="form-row">
                        <div class="col-md-12">
                            <div class="form-group">
                                @Html.HiddenFor(model => model.HoAl_Id, new { @id = "delete-item-id" })
                                <p>¿Está seguro de que desea eliminar este horario?</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash mr-1"></i> Eliminar
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/horarioalumnos.js"></script>
}
