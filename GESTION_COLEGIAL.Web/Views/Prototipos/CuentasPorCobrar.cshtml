@{
    ViewBag.Title = "Cuentas por cobrar (prototipo)";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Reemplaza"] = "Cuentas por cobrar, Deudores, Morosos, Cargos pendientes y Moratorias (5 pantallas → 1).";
    ViewData["Falta"] = "que la lista de la API traiga el Id del alumno, nivel y sección (hoy se cruzan por nombre) y el monto de mora.";
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item">Caja</li>
            <li class="breadcrumb-item active" aria-current="page">Cuentas por cobrar</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Cuentas por cobrar</h4>
        <p class="text-muted mb-0">Lo que deben los alumnos: filtrá por estado, mirá la antigüedad y abrí la cuenta de cada alumno.</p>
    </div>
    <div class="mt-2 mt-md-0">
        <a href="@Url.Action("CargosMasivos", "CuentasCobrar")" class="btn btn-outline-primary mr-2"><i class="bi bi-collection mr-1"></i> Cargos masivos</a>
        <a href="@Url.Action("NuevoPago", "Pagos")" class="btn btn-primary"><i class="bi bi-cash-coin mr-1"></i> Nuevo pago</a>
    </div>
</div>

<partial name="_Aviso" />

<div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four"><div class="widget-content"><div class="w-content">
            <div class="w-info"><h6 class="value" id="k-total">—</h6><p>Total por cobrar</p></div>
            <div><div class="w-icon"><i class="bi bi-wallet2"></i></div></div>
        </div></div></div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four"><div class="widget-content"><div class="w-content">
            <div class="w-info"><h6 class="value text-danger" id="k-vencido">—</h6><p>Vencido +30 días</p></div>
            <div><div class="w-icon"><i class="bi bi-exclamation-triangle"></i></div></div>
        </div></div></div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four"><div class="widget-content"><div class="w-content">
            <div class="w-info"><h6 class="value" id="k-alumnos">—</h6><p>Alumnos con deuda</p></div>
            <div><div class="w-icon"><i class="bi bi-people"></i></div></div>
        </div></div></div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four"><div class="widget-content"><div class="w-content">
            <div class="w-info"><h6 class="value" id="k-cargos">—</h6><p>Cargos pendientes</p></div>
            <div><div class="w-icon"><i class="bi bi-receipt"></i></div></div>
        </div></div></div>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-content widget-content-area">
        <div class="d-flex flex-wrap align-items-center mb-3">
            <div class="btn-group mr-3 mb-2" role="group" aria-label="Estado" id="f-estado">
                <button type="button" class="btn btn-primary" data-estado="pendiente">Pendientes <span class="badge badge-light ml-1" data-n="pendiente">0</span></button>
                <button type="button" class="btn btn-outline-primary" data-estado="vencida">Vencidas <span class="badge badge-light ml-1" data-n="vencida">0</span></button>
                <button type="button" class="btn btn-outline-primary" data-estado="pagada">Pagadas <span class="badge badge-light ml-1" data-n="pagada">0</span></button>
                <button type="button" class="btn btn-outline-primary" data-estado="todas">Todas <span class="badge badge-light ml-1" data-n="todas">0</span></button>
            </div>
            <label for="f-antig" class="mb-2 mr-2 text-muted small">Antigüedad</label>
            <select id="f-antig" class="custom-select custom-select-sm w-auto mb-2">
                <option value="">Cualquiera</option>
                <option>Al día</option><option>1-30 días</option><option>31-60 días</option><option>61-90 días</option><option>Más de 90 días</option>
            </select>
        </div>
        <div id="tabla-cxc" data-usuario="@(Session["Username"] as string ?? "anonimo")"></div>
    </div>
</div>

@section Scripts{
    <partial name="_GcTabla" />
    <script src="~/Content/js/pages/prototipo-comun.js" asp-append-version="true"></script>
    <script src="~/Content/js/pages/prototipo-cxc.js" asp-append-version="true"></script>
}
