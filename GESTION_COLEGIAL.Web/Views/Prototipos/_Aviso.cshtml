@* Aviso de prototipo. ViewData["Reemplaza"] = pantallas que sustituye; ViewData["Falta"] = lo que necesita de la API/DB. *@
<div class="alert alert-warning mb-4" role="alert">
    <div class="d-flex align-items-start">
        <i class="bi bi-cone-striped mr-2 mt-1"></i>
        <div>
            <strong>PROTOTIPO</strong> — pantalla de muestra para revisar la idea. Lee datos reales, pero <strong>no guarda nada</strong>.
            @if (ViewData["Reemplaza"] != null)
            {
                <div class="mt-1"><strong>Reemplaza a:</strong> @ViewData["Reemplaza"]</div>
            }
            @if (ViewData["Falta"] != null)
            {
                <div class="mt-1"><strong>Si se aprueba, falta:</strong> @ViewData["Falta"]</div>
            }
            <div class="mt-1"><a href="@Url.Action("Index", "Prototipos")"><i class="bi bi-arrow-left mr-1"></i>Volver a los prototipos</a></div>
        </div>
    </div>
</div>
