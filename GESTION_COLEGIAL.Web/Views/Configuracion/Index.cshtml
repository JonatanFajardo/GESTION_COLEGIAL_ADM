@model GESTION_COLEGIAL.UI.Models.ConfiguracionViewModel
@{
    ViewBag.Title = "Configuración";
}

@section Styles{
    <link href="~/Content/css/components/cards/card.css" rel="stylesheet" />
    <link href="~/css/pages/configuracion.css" rel="stylesheet" asp-append-version="true" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Configuración</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Configuración</h4>
        <p class="text-muted mb-0">Elija qué desea ajustar. Cada tarjeta abre su sección.</p>
    </div>
</div>

@if (!Model.TieneTarjetas)
{
    <div class="alert alert-light-warning d-flex align-items-center">
        <i class="bi bi-lock h4 mb-0 mr-3" aria-hidden="true"></i>
        <p class="mb-0">No tiene acceso a ninguna sección de configuración.<br />Contacte al administrador si necesita acceso.</p>
    </div>
}

@* Los grupos de una sola tarjeta se acomodan lado a lado; los de varias (y el plegable) ocupan todo el ancho. *@
<div class="row">
@foreach (var grupo in Model.Grupos)
{
    bool ancho = grupo.Tarjetas.Count > 1 || grupo.Plegado;
    var claseColumna = ancho ? "col-12" : "col-lg-6";
    var claseTarjeta = ancho ? "col-xl-4 col-md-6 mb-4" : "col-12 mb-4";
    if (grupo.Plegado)
    {
        <div class="@claseColumna layout-spacing">
            <details class="statbox widget box box-shadow cfg-plegable" id="cfg-@grupo.Id">
                <summary class="widget-header">
                    <div class="d-flex flex-wrap align-items-center px-3 py-3">
                        <h4 class="p-0 mb-0 mr-3">@grupo.Titulo</h4>
                        <span class="text-muted small mr-3">@grupo.Descripcion</span>
                        <span class="badge outline-badge-primary">@grupo.Tarjetas.Count @(grupo.Tarjetas.Count == 1 ? "sección" : "secciones")</span>
                        <i class="bi bi-chevron-down ml-auto cfg-flecha" aria-hidden="true"></i>
                    </div>
                </summary>
                <div class="widget-content widget-content-area">
                    <div class="row">
                        @foreach (var tarjeta in grupo.Tarjetas)
                        {
                            <div class="@claseTarjeta">
                                <partial name="_TarjetaConfiguracion" model="tarjeta" />
                            </div>
                        }
                    </div>
                </div>
            </details>
        </div>
    }
    else
    {
        <div class="@claseColumna layout-spacing">
            <section class="statbox widget box box-shadow h-100" id="cfg-@grupo.Id" aria-labelledby="cfg-titulo-@grupo.Id">
                <div class="widget-header">
                    <div class="row">
                        <div class="col-12">
                            <h4 id="cfg-titulo-@grupo.Id">@grupo.Titulo</h4>
                            <p class="text-muted small px-3 mb-0">@grupo.Descripcion</p>
                        </div>
                    </div>
                </div>
                <div class="widget-content widget-content-area">
                    <div class="row">
                        @foreach (var tarjeta in grupo.Tarjetas)
                        {
                            <div class="@claseTarjeta">
                                <partial name="_TarjetaConfiguracion" model="tarjeta" />
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    }
}
</div>
