@{
    ViewBag.Title = "Asistencia Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/Content/css/pages/asistenciaempleados.css" rel="stylesheet" />
}

@* Breadcrumb *@
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Asistencia Empleados</li>
        </ol>
    </nav>
</div>

@* Page Header *@
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Asistencia del Personal</h4>
        <p class="text-muted mb-0">Registre y consulte la asistencia diaria de los empleados</p>
    </div>
    <div class="mt-2 mt-md-0">
        <button id="btn-registrar-asistencia" class="btn btn-primary">
            <i class="bi bi-plus-lg mr-1"></i> Registrar Asistencia
        </button>
    </div>
</div>

@* Contenido principal *@
<div class="fluid-container">

    @* Filtros *@
    <div id="asi-filtros" class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="form-row align-items-end">
                <div class="col-md-3 col-sm-6 mb-2 mb-md-0">
                    <label for="filtro-empleado">Empleado</label>
                    <select id="filtro-empleado" class="custom-select">
                        <option value="">-- Todos --</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-6 mb-2 mb-md-0">
                    <label for="filtro-desde">Desde</label>
                    <input type="date" id="filtro-desde" class="form-control" autocomplete="off" />
                </div>
                <div class="col-md-3 col-sm-6 mb-2 mb-md-0">
                    <label for="filtro-hasta">Hasta</label>
                    <input type="date" id="filtro-hasta" class="form-control" autocomplete="off" />
                </div>
                <div class="col-md-3 col-sm-6 mb-2 mb-md-0">
                    <button id="btn-buscar" class="btn btn-primary btn-block">
                        <i class="fa-solid fa-magnifying-glass mr-1"></i> Buscar
                    </button>
                </div>
            </div>
            <p class="text-muted small mt-3 mb-0">
                <i class="fa-regular fa-calendar-days mr-1"></i>
                Mostrando: <span id="asi-rango-label" class="font-weight-bold">—</span>
            </p>
        </div>
    </div>

    @* KPI Cards — llenado por JS *@
    <div id="asi-kpis" class="row"></div>

    @* Vista dividida: lista de empleados (izquierda) + calendario (derecha) *@
    <div id="asi-split-view" class="row">
        <div class="col-lg-4 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row">
                        <div class="col-12 d-flex align-items-center justify-content-between">
                            <h4><i class="fa-solid fa-users mr-2"></i>Empleados</h4>
                            <span id="asi-empleados-count" class="badge badge-primary mr-3 mt-3">0</span>
                        </div>
                    </div>
                </div>
                <div class="widget-content widget-content-area p-0">
                    <div class="p-3 border-bottom">
                        <div class="input-group">
                            <div class="input-group-prepend"><span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span></div>
                            <input type="text" id="asi-buscar-empleado" class="form-control" placeholder="Buscar empleado..." autocomplete="off" />
                        </div>
                    </div>
                    <div id="asi-empleados-list" class="asi-empleados-list"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-8 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div id="asi-calendar-panel" class="widget-content widget-content-area asi-calendar-panel">
                    <div class="text-center text-muted p-5">
                        <i class="fa-regular fa-calendar h2 d-block mb-2"></i>
                        <p>Selecciona un empleado de la lista para ver su calendario de asistencia.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@* Modal Registrar Asistencia *@
<div class="modal fade" id="modal-nueva" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Asistencia</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="form-nueva">
                <div class="modal-body">
                    <div>
                        <div class="form-row">
                            <div class="col-md-12 form-group mb-3">
                                <label>Empleado *</label>
                                <select name="Emp_Id" class="custom-select">
                                    <option value="">-- Seleccione Empleado --</option>
                                </select>
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label>Fecha *</label>
                                <input type="date" name="Fecha" class="form-control" />
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label>Tipo *</label>
                                <select name="Tipo" class="custom-select">
                                    <option value="Presente">Presente</option>
                                    <option value="Ausente">Ausente</option>
                                    <option value="Permiso">Permiso</option>
                                    <option value="Tardanza">Tardanza</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/asistenciaempleados.js" asp-append-version="true"></script>
    <script>
        AsistenciaEmpleados.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("CreateAsync")",
            "@Url.Action("DropdownsAsync")"
        );
    </script>
}
