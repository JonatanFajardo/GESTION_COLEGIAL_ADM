@{
    ViewBag.Title = "Estructura Académica";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Estructura Académica</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Estructura académica</h4>
        <p class="text-muted mb-0">Configure los parámetros base sobre los que se construye toda la organización académica</p>
    </div>
    <div class="mt-2 mt-md-0">
        <span class="text-muted small d-block mb-1">Orden en cascada</span>
        <div class="d-flex flex-wrap align-items-center">
            <button type="button" class="btn btn-sm btn-rounded btn-outline-primary ci-cascade-pill mb-1" data-jump="modalidades">1 · Modalidad</button>
            <i class="bi bi-arrow-right text-muted mx-1"></i>
            <button type="button" class="btn btn-sm btn-rounded btn-outline-primary ci-cascade-pill mb-1" data-jump="niveleseducativos">2 · Nivel</button>
            <i class="bi bi-arrow-right text-muted mx-1"></i>
            <button type="button" class="btn btn-sm btn-rounded btn-outline-primary ci-cascade-pill mb-1" data-jump="secciones">3 · Sección</button>
            <i class="bi bi-arrow-right text-muted mx-1"></i>
            <button type="button" class="btn btn-sm btn-rounded btn-outline-primary ci-cascade-pill mb-1" data-jump="semestres">4 · Semestre</button>
            <i class="bi bi-arrow-right text-muted mx-1"></i>
            <button type="button" class="btn btn-sm btn-rounded btn-outline-primary ci-cascade-pill mb-1" data-jump="parciales">5 · Parcial</button>
        </div>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4 ci-tabs-card">
    <div class="widget-content widget-content-area">

        <!-- Pestañas -->
        <ul class="nav nav-pills mb-4" role="tablist" id="ci-tabs">
            <li class="nav-item ci-tab-item active" data-catalog="modalidades">
                <a href="#" class="nav-link active">
                    <span class="font-weight-bold mr-1">1</span><i class="bi bi-clock-history mr-1"></i> Modalidades
                    <span class="badge badge-light ml-1" data-count>—</span>
                </a>
            </li>
            <li class="nav-item ci-tab-item" data-catalog="niveleseducativos">
                <a href="#" class="nav-link">
                    <span class="font-weight-bold mr-1">2</span><i class="bi bi-mortarboard mr-1"></i> Niveles Educativos
                    <span class="badge badge-light ml-1" data-count>—</span>
                </a>
            </li>
            <li class="nav-item ci-tab-item" data-catalog="secciones">
                <a href="#" class="nav-link">
                    <span class="font-weight-bold mr-1">3</span><i class="bi bi-columns-gap mr-1"></i> Secciones
                    <span class="badge badge-light ml-1" data-count>—</span>
                </a>
            </li>
            <li class="nav-item ci-tab-item" data-catalog="semestres">
                <a href="#" class="nav-link">
                    <span class="font-weight-bold mr-1">4</span><i class="bi bi-calendar-range mr-1"></i> Semestres
                    <span class="badge badge-light ml-1" data-count>—</span>
                </a>
            </li>
            <li class="nav-item ci-tab-item" data-catalog="parciales">
                <a href="#" class="nav-link">
                    <span class="font-weight-bold mr-1">5</span><i class="bi bi-calendar2-week mr-1"></i> Parciales
                    <span class="badge badge-light ml-1" data-count>—</span>
                </a>
            </li>
        </ul>

        <!-- Barra de herramientas -->
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
            <div class="input-group mb-2 mr-3 w-auto flex-grow-1">
                <div class="input-group-prepend"><span class="input-group-text"><i class="bi bi-search"></i></span></div>
                <input type="text" id="ci-search" class="form-control" placeholder="Buscar en el catálogo activo..." />
            </div>
            <div class="d-flex align-items-center mb-2">
                <div class="btn-group mr-2" role="group" aria-label="Vista">
                    <button type="button" class="btn btn-sm btn-outline-primary ci-view-btn active" data-view="cards" title="Vista de tarjetas">
                        <i class="bi bi-grid-3x3-gap-fill mr-1"></i> Tarjetas
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary ci-view-btn" data-view="table" title="Vista de tabla">
                        <i class="bi bi-table mr-1"></i> Tabla
                    </button>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary mr-2" id="ci-reload" title="Recargar datos">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button type="button" class="btn btn-primary" id="ci-new-btn">
                    <i class="bi bi-plus-lg mr-1"></i> <span id="ci-new-label">Nuevo</span>
                </button>
            </div>
        </div>

        <!-- Información del catálogo activo -->
        <div class="alert alert-light-info mb-4" id="ci-catalog-info" role="alert">
            <i class="bi bi-info-circle-fill mr-1"></i>
            <strong id="ci-info-title">Modalidades</strong> ·
            <span id="ci-info-desc">Formatos en los que se dicta la enseñanza (matutina, vespertina, nocturna).</span>
        </div>

        <!-- Vista tarjetas (predeterminada) -->
        <div id="ci-cards-view">
            <div class="row" id="ci-cards-grid">
                <!-- Tarjetas generadas por JS -->
            </div>
            <div class="text-center py-5" id="ci-empty" hidden>
                <i class="bi bi-inbox h1 text-muted d-block mb-2"></i>
                <h5>Sin registros</h5>
                <p class="text-muted">Todavía no hay elementos en este catálogo.</p>
                <button type="button" class="btn btn-primary" onclick="document.getElementById('ci-new-btn').click()">
                    <i class="bi bi-plus-lg mr-1"></i> Crear el primero
                </button>
            </div>
        </div>

        <!-- Vista tabla -->
        <div id="ci-table-view" hidden>
            <div class="table-responsive">
                <table class="table table-hover ci-table" id="ci-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th>Registrado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="ci-table-body">
                        <!-- Filas generadas por JS -->
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<!-- Modal crear / editar -->
<div class="modal fade" id="ci-edit-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="ci-edit-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="ci-edit-title">Nuevo registro</h5>
                    <p class="text-muted small mb-0" id="ci-edit-subtitle">Complete los datos del catálogo</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="ci-edit-form" onsubmit="return false;">
                <div class="modal-body">
                    <input type="hidden" id="ci-edit-id" value="0" />
                    <div class="form-group">
                        <label for="ci-edit-descripcion">Descripción <span class="text-danger">*</span></label>
                        <input type="text" id="ci-edit-descripcion" class="form-control" maxlength="100" required autocomplete="off" placeholder="Ej: Presencial, Primaria, 1er semestre..." />
                        <small class="form-text text-muted" id="ci-edit-hint">Ingrese el nombre del registro.</small>
                    </div>
                    <div class="form-group d-flex align-items-center mb-0" id="ci-edit-estado-wrap" hidden>
                        <label class="switch s-icons s-outline s-outline-primary mb-0 mr-2">
                            <input type="checkbox" id="ci-edit-esactivo" checked />
                            <span class="slider round"></span>
                        </label>
                        <span id="ci-edit-esactivo-label">Activo</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="ci-edit-save"><i class="bi bi-check2 mr-1"></i> Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal detalle -->
<div class="modal fade" id="ci-detail-modal" tabindex="-1" role="dialog" aria-labelledby="ci-detail-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="ci-detail-title">Detalle del registro</h5>
                    <p class="text-muted small mb-0" id="ci-detail-catalog-name">Catálogo</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="col-md-4 mb-3">
                        <p class="text-muted small mb-1">ID</p>
                        <p class="font-weight-bold mb-0" id="ci-detail-id">—</p>
                    </div>
                    <div class="col-md-8 mb-3">
                        <p class="text-muted small mb-1">Descripción</p>
                        <p class="font-weight-bold mb-0" id="ci-detail-descripcion">—</p>
                    </div>
                </div>
                <h6 class="border-top pt-3 mb-3"><i class="bi bi-clock-history mr-1"></i> Auditoría</h6>
                <div class="form-row">
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Creado por</p>
                        <p class="mb-0"><strong id="ci-detail-usuarioregistra">—</strong> <span class="text-muted small" id="ci-detail-fecharegistra">—</span></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Última modificación</p>
                        <p class="mb-0"><strong id="ci-detail-usuariomodifica">—</strong> <span class="text-muted small" id="ci-detail-fechamodifica">—</span></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal eliminar -->
<div class="modal fade" id="ci-delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="ci-delete-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ci-delete-title">Eliminar registro</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ci-delete-id" value="0" />
                <p class="mb-3">¿Está seguro de que desea eliminar <strong id="ci-delete-name"></strong> del catálogo <strong id="ci-delete-catalog"></strong>?</p>
                <div class="alert alert-light-danger mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill mr-1"></i>
                    <strong>Esta acción no se puede deshacer.</strong> Si el registro está en uso por otras entidades, la eliminación fallará.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="ci-delete-confirm">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/catalogos-institucion.js"></script>
}
