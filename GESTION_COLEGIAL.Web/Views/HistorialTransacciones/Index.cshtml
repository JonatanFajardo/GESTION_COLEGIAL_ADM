@{
    ViewBag.Title = "Historial de Transacciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/pages/finanzas-dashboard.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Historial de Transacciones</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Historial de Transacciones</h4>
        <p class="text-muted mb-0">Registro completo de pagos realizados por rango de fechas</p>
    </div>
</div>


    <div class="statbox widget box box-shadow mb-4">
    <div class="widget-content widget-content-area">
        <div class="form-row">
                <div class="form-group col-md mb-md-0">
            <label for="input-alumno">Alumno</label>
            <input type="text" id="input-alumno" class="form-control" placeholder="Nombre del alumno..." />
                </div>
                <div class="form-group col-md mb-md-0">
            <label for="input-fecha-desde">Desde</label>
            <input type="date" id="input-fecha-desde" class="form-control" value="@ViewBag.FechaDesdeDefault" />
                </div>
                <div class="form-group col-md mb-md-0">
            <label for="input-fecha-hasta">Hasta</label>
            <input type="date" id="input-fecha-hasta" class="form-control" value="@ViewBag.FechaHastaDefault" />
                </div>
                <div class="form-group col-md-auto d-flex align-items-end mb-md-0">
                    <button class="btn btn-primary btn-block" id="btn-buscar" type="button">
            <i class="fa-solid fa-magnifying-glass"></i> Consultar
        </button>
                </div>
        </div>
    </div>
</div>

    <div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-primary" id="hero-total">L. 0.00</h6>
                        <p>Total recaudado en el período</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-solid fa-clock-rotate-left"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="hero-rango">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value " id="hero-trans">0</h6>
                        <p>Transacciones</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-receipt"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="hero-trans-sub">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value " id="hero-dia">—</h6>
                        <p>Día más activo</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-calendar-event"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="hero-dia-sub">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value " id="hero-prom-dia">L. 0.00</h6>
                        <p>Promedio diario</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-bar-chart"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="hero-prom-sub">—</span></p>
            </div>
        </div>
    </div>
</div>

    <div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-success" id="kpi-mayor">L. 0.00</h6>
                        <p>Mayor pago</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-solid fa-arrow-trend-up"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="kpi-mayor-sub">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-primary" id="kpi-prom">L. 0.00</h6>
                        <p>Ticket promedio</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-solid fa-calculator"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2">Por transacción</p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-info" id="kpi-alumnos">0</h6>
                        <p>Alumnos distintos</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-solid fa-user-group"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="kpi-alumnos-sub">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-warning" id="kpi-cajeros">0</h6>
                        <p>Cajeros activos</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-solid fa-user-tie"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="kpi-cajeros-sub">—</span></p>
            </div>
        </div>
    </div>
</div>

    <div class="row">
<div class="col-xl-4 col-lg-6 col-12 layout-spacing">
<div class="statbox widget box box-shadow h-100">
    <div class="widget-header">
        <div class="row">
            <div class="col-12">
                <h4><i class="fa-solid fa-chart-column mr-1"></i> Tendencia diaria</h4>
                <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Monto recaudado por día</p>
            </div>
        </div>
    </div>
    <div class="widget-content widget-content-area">
                <div class="fd-cols" id="cols-dia"></div>
            </div>
</div>
</div>
<div class="col-xl-4 col-lg-6 col-12 layout-spacing">
<div class="statbox widget box box-shadow h-100">
    <div class="widget-header">
        <div class="row">
            <div class="col-12">
                <h4><i class="fa-solid fa-credit-card mr-1"></i> Formas de pago</h4>
                <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Participación del período</p>
            </div>
        </div>
    </div>
    <div class="widget-content widget-content-area">
                <div class="fd-donut-wrap">
                    <div class="fd-donut" id="donut-formas">
                        <div class="fd-donut-inner">
                            <strong id="donut-num">0</strong>
                            <small>Trans.</small>
                        </div>
                    </div>
                    <div class="fd-donut-legend" id="donut-legend"></div>
                </div>
            </div>
</div>
</div>
<div class="col-xl-4 col-lg-6 col-12 layout-spacing">
<div class="statbox widget box box-shadow h-100">
    <div class="widget-header">
        <div class="row">
            <div class="col-12">
                <h4><i class="fa-solid fa-user-tie mr-1"></i> Top cajeros</h4>
                <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Por monto procesado</p>
            </div>
        </div>
    </div>
    <div class="widget-content widget-content-area p-0" id="rank-cajeros"></div>
</div>
</div>
</div>

    <div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="d-flex flex-wrap align-items-center justify-content-between pr-3">
            <div>
                <h4><i class="fa-solid fa-list-check mr-1"></i> Movimientos del período</h4>
                <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Detalle ordenado por fecha descendente</p>
            </div>
            <div class="mb-2"><div class="d-flex align-items-center">
                <span class="badge outline-badge-primary" id="chip-count">0 transacciones</span>
                <button id="btn-exportar-csv" type="button" class="btn btn-sm btn-outline-primary ml-2 text-nowrap">
                    <i class="fa-solid fa-file-csv mr-1"></i> Exportar CSV
                </button>
            </div></div>
        </div>
    </div>
    <div class="widget-content widget-content-area p-0 fd-scroll" id="feed-trans"></div>
</div>


@section Scripts{
    <script src="~/Content/js/pages/historialtransacciones.js"></script>
    <script>
        HistorialTransacciones.init(
            "@Url.Action("ListAsync")",
            "@ViewBag.FechaDesdeDefault",
            "@ViewBag.FechaHastaDefault"
        );
    </script>
}
