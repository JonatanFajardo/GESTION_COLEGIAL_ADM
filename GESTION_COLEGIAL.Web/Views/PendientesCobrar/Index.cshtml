@{
    ViewBag.Title = "Pendientes por Cobrar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/pages/finanzas-dashboard.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Pendientes por Cobrar</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Pendientes por Cobrar</h4>
        <p class="text-muted mb-0">Cuentas abiertas con saldo pendiente y análisis de vencimiento</p>
    </div>
</div>


    <div class="statbox widget box box-shadow mb-4">
    <div class="widget-content widget-content-area">
        <div class="form-row">
                <div class="form-group col-md mb-md-0">
            <label for="input-buscador">Buscar alumno o concepto</label>
            <input type="text" id="input-buscador" class="form-control" placeholder="Escriba para filtrar..." />
                </div>
                <div class="form-group col-md mb-md-0">
            <label for="select-estado">Estado</label>
            <select id="select-estado" class="custom-select">
                <option value="">Todos los estados</option>
                <option value="vencido">Solo vencidos</option>
                <option value="hoy">Vencen hoy</option>
                <option value="proximo">Próximos a vencer</option>
            </select>
                </div>
                <div class="form-group col-md-auto d-flex align-items-end mb-md-0">
                    <button class="btn btn-primary btn-block" id="btn-refrescar" type="button">
            <i class="fa-solid fa-arrows-rotate"></i> Refrescar
        </button>
                </div>
        </div>
    </div>
</div>

    <div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-primary" id="hero-total">L. 0.00</h6>
                        <p>Cartera total pendiente</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="hero-sub">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value " id="hero-cuentas">0</h6>
                        <p>Cuentas abiertas</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-receipt"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="hero-cuentas-sub">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value " id="hero-prom">L. 0.00</h6>
                        <p>Saldo promedio</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-calendar-event"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2">Por cuenta</p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value " id="hero-anti">0 días</h6>
                        <p>Antigüedad media</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-bar-chart"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2">Desde vencimiento</p>
            </div>
        </div>
    </div>
</div>

    <div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-danger" id="kpi-vencidas">0</h6>
                        <p>Vencidas</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-solid fa-triangle-exclamation"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="kpi-vencidas-sub">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-warning" id="kpi-hoy">0</h6>
                        <p>Vencen hoy</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-solid fa-clock"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="kpi-hoy-sub">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-info" id="kpi-prox">0</h6>
                        <p>Próximos 7 días</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-regular fa-calendar"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="kpi-prox-sub">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-primary" id="kpi-alumnos">0</h6>
                        <p>Alumnos deudores</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-solid fa-user-graduate"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="kpi-alumnos-sub">—</span></p>
            </div>
        </div>
    </div>
</div>

    <div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="d-flex flex-wrap align-items-center justify-content-between pr-3">
            <div>
                <h4><i class="fa-solid fa-hourglass-half mr-1"></i> Antigüedad de saldos</h4>
                <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Distribución por rango de vencimiento (días)</p>
            </div>
            <div class="mb-2"><span class="badge outline-badge-danger" id="chip-criticas">—</span></div>
        </div>
    </div>
    <div class="widget-content widget-content-area">
            <div class="fd-aging-row" id="aging-row"></div>
        </div>
</div>

    <div class="row">
<div class="col-lg-6 col-12 layout-spacing">
<div class="statbox widget box box-shadow h-100">
    <div class="widget-header">
        <div class="row">
            <div class="col-12">
                <h4><i class="fa-solid fa-ranking-star mr-1"></i> Top 8 alumnos deudores</h4>
                <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Ordenado por saldo pendiente</p>
            </div>
        </div>
    </div>
    <div class="widget-content widget-content-area p-0" id="rank-deudores"></div>
</div>
</div>
<div class="col-lg-6 col-12 layout-spacing">
<div class="statbox widget box box-shadow h-100">
    <div class="widget-header">
        <div class="row">
            <div class="col-12">
                <h4><i class="fa-solid fa-tags mr-1"></i> Conceptos pendientes</h4>
                <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Participación sobre la cartera</p>
            </div>
        </div>
    </div>
    <div class="widget-content widget-content-area">
                <div class="fd-bar-list" id="bars-conceptos"></div>
            </div>
</div>
</div>
</div>

    <div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="d-flex flex-wrap align-items-center justify-content-between pr-3">
            <div>
                <h4><i class="fa-solid fa-list-check mr-1"></i> Detalle de cuentas pendientes</h4>
                <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Lista priorizada por días de vencimiento</p>
            </div>
            <div class="mb-2"><span class="badge outline-badge-primary" id="chip-count">0 cuentas</span></div>
        </div>
    </div>
    <div class="widget-content widget-content-area p-0 fd-scroll" id="feed-cuentas"></div>
</div>


@section Scripts{
    <script src="~/Content/js/pages/pendientescobrar.js"></script>
    <script>
        PendientesCobrar.init("@Url.Action("ListAsync")");
    </script>
}
