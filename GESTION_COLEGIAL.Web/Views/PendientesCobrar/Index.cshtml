@{
    ViewBag.Title = "Pendientes por Cobrar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/finanzas-dashboard.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Pendientes por Cobrar</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-file-invoice-dollar"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Pendientes por Cobrar</h1>
                <p>Cuentas abiertas con saldo pendiente y análisis de vencimiento</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">

    <div class="fd-filters">
        <div>
            <label for="input-buscador" class="form-label-catalogo">Buscar alumno o concepto</label>
            <input type="text" id="input-buscador" class="form-control" placeholder="Escriba para filtrar..." />
        </div>
        <div>
            <label for="select-estado" class="form-label-catalogo">Estado</label>
            <select id="select-estado" class="form-control">
                <option value="">Todos los estados</option>
                <option value="vencido">Solo vencidos</option>
                <option value="hoy">Vencen hoy</option>
                <option value="proximo">Próximos a vencer</option>
            </select>
        </div>
        <button class="btn-fd" id="btn-refrescar" type="button">
            <i class="fa-solid fa-arrows-rotate"></i> Refrescar
        </button>
    </div>

    <div class="fd-hero">
        <div class="fd-hero-grid">
            <div class="fd-hero-main">
                <p class="fd-hero-label"><i class="fa-solid fa-file-invoice-dollar"></i> Cartera total pendiente</p>
                <p class="fd-hero-value" id="hero-total">L. 0.00</p>
                <p class="fd-hero-sub" id="hero-sub">—</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">Cuentas abiertas</p>
                <p class="fd-hero-stat-value" id="hero-cuentas">0</p>
                <p class="fd-hero-stat-trend" id="hero-cuentas-sub">—</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">Saldo promedio</p>
                <p class="fd-hero-stat-value" id="hero-prom">L. 0.00</p>
                <p class="fd-hero-stat-trend">por cuenta</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">Antigüedad media</p>
                <p class="fd-hero-stat-value" id="hero-anti">0 días</p>
                <p class="fd-hero-stat-trend">desde vencimiento</p>
            </div>
        </div>
    </div>

    <div class="fd-kpi-row">
        <div class="fd-kpi kpi-rose">
            <div class="fd-kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Vencidas</p>
                <p class="fd-kpi-value" id="kpi-vencidas">0</p>
                <p class="fd-kpi-foot" id="kpi-vencidas-sub">—</p>
            </div>
        </div>
        <div class="fd-kpi kpi-amber">
            <div class="fd-kpi-icon"><i class="fa-solid fa-clock"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Vencen hoy</p>
                <p class="fd-kpi-value" id="kpi-hoy">0</p>
                <p class="fd-kpi-foot" id="kpi-hoy-sub">—</p>
            </div>
        </div>
        <div class="fd-kpi kpi-cyan">
            <div class="fd-kpi-icon"><i class="fa-regular fa-calendar"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Próximos 7 días</p>
                <p class="fd-kpi-value" id="kpi-prox">0</p>
                <p class="fd-kpi-foot" id="kpi-prox-sub">—</p>
            </div>
        </div>
        <div class="fd-kpi kpi-indigo">
            <div class="fd-kpi-icon"><i class="fa-solid fa-user-graduate"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Alumnos deudores</p>
                <p class="fd-kpi-value" id="kpi-alumnos">0</p>
                <p class="fd-kpi-foot" id="kpi-alumnos-sub">—</p>
            </div>
        </div>
    </div>

    <div class="fd-panel" style="margin-bottom:1.25rem;">
        <div class="fd-panel-head">
            <div>
                <p class="fd-panel-title"><i class="fa-solid fa-hourglass-half"></i> Antigüedad de saldos</p>
                <p class="fd-panel-sub">Distribución por rango de vencimiento (días)</p>
            </div>
            <span class="fd-chip c-rose" id="chip-criticas">—</span>
        </div>
        <div class="fd-panel-body">
            <div class="fd-aging-row" id="aging-row"></div>
        </div>
    </div>

    <div class="fd-grid-2">
        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-ranking-star"></i> Top 8 alumnos deudores</p>
                    <p class="fd-panel-sub">Ordenado por saldo pendiente</p>
                </div>
            </div>
            <div class="fd-panel-body fd-flush" id="rank-deudores"></div>
        </div>

        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-tags"></i> Conceptos pendientes</p>
                    <p class="fd-panel-sub">Participación sobre la cartera</p>
                </div>
            </div>
            <div class="fd-panel-body">
                <div class="fd-bar-list" id="bars-conceptos"></div>
            </div>
        </div>
    </div>

    <div class="fd-panel">
        <div class="fd-panel-head">
            <div>
                <p class="fd-panel-title"><i class="fa-solid fa-list-check"></i> Detalle de cuentas pendientes</p>
                <p class="fd-panel-sub">Lista priorizada por días de vencimiento</p>
            </div>
            <span class="fd-chip" id="chip-count">0 cuentas</span>
        </div>
        <div class="fd-panel-body fd-flush fd-scroll" id="feed-cuentas"></div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/pendientescobrar.js"></script>
    <script>
        PendientesCobrar.init("@Url.Action("ListAsync")");
    </script>
}
