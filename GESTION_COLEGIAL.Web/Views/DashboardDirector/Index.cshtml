@{
    ViewBag.Title = "Dashboard Director";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/pages/dashboard-director.css" rel="stylesheet" asp-append-version="true" />
}

<div>

    <!-- ══ Header ══ -->
    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
        <div class="mr-3">
            <h4 class="mb-1">Dashboard Director</h4>
            <p class="text-muted mb-0">Resumen ejecutivo en tiempo real</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap align-items-center">
            <label class="mb-0 mr-2">Año</label>
            <select id="sel-anio" class="custom-select w-auto mr-3"></select>
            <label class="mb-0 mr-2">Mes</label>
            <select id="sel-mes" class="custom-select w-auto mr-3"></select>
            <button type="button" class="btn btn-primary" id="btn-actualizar"><i class="fas fa-rotate-right mr-1"></i>Actualizar</button>
        </div>
    </div>

    <!-- ══ KPI Cards ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-gauge-high mr-1"></i>Indicadores Clave</h6>
    <div class="row">
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-alumnos">—</h6>
                            <p>Total Alumnos</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-user-graduate"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-empleados">—</h6>
                            <p>Empleados</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-users"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-cobrado">—</h6>
                            <p>Cobrado Mes</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-circle-dollar-to-slot"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-deuda">—</h6>
                            <p>Deuda Pendiente</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-triangle-exclamation"></i></div></div>
                    </div>
                <span class="badge badge-danger mt-2" id="kpi-cuentas-vencidas-badge"></span>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-promedio">—</h6>
                            <p>Promedio Gral.</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-star-half-stroke"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-riesgo">—</h6>
                            <p>Alumnos Riesgo</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-user-clock"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Calendario escolar ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="bi bi-calendar3 mr-1"></i>Calendario</h6>
    <div class="row mb-4">
        <div class="col-md-12">
            @await Html.PartialAsync("_ProximosDias")
        </div>
    </div>

    <!-- ══ Asistencia ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-clipboard-user mr-1"></i>Asistencia Hoy</h6>
    <div class="row">
        <div class="col-md-12 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-content widget-content-area">
                <div class="row align-items-center">
                    <div class="col-md-7">
                        <div class="d-flex flex-wrap align-items-stretch">
                            <div class="text-center px-3 py-2 mb-2">
                        <h2 class="font-weight-bold mb-0" id="kpi-pct-asistencia">—</h2>
                        <p class="small text-muted text-uppercase font-weight-bold mb-0">% Asistencia</p>
                    </div>
                            <div class="border-left mx-2 mb-2"></div>
                            <div class="border rounded text-center px-3 py-2 flex-fill mb-2 mr-2">
                        <h3 class="font-weight-bold text-success mb-0" id="kpi-presentes">—</h3>
                        <p class="small text-muted text-uppercase font-weight-bold mb-0">Presentes</p>
                    </div>
                            <div class="border rounded text-center px-3 py-2 flex-fill mb-2 mr-2">
                        <h3 class="font-weight-bold text-danger mb-0" id="kpi-ausentes">—</h3>
                        <p class="small text-muted text-uppercase font-weight-bold mb-0">Ausentes</p>
                    </div>
                            <div class="border rounded text-center px-3 py-2 flex-fill mb-2 mr-2">
                        <h3 class="font-weight-bold text-warning mb-0" id="kpi-tardanzas">—</h3>
                        <p class="small text-muted text-uppercase font-weight-bold mb-0">Tardanzas</p>
                    </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <canvas class="dash-chart-h150" id="chart-asistencia"></canvas>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Matrícula + Cobros ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-chart-bar mr-1"></i>Matrícula y Finanzas</h6>
    <div class="row">
        <div class="col-md-6 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-chalkboard mr-1"></i>Matrícula por Curso</h4><span class="small font-weight-bold text-muted" id="stat-total-matricula"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h260" id="chart-matricula"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-money-bill-trend-up mr-1"></i>Cobros por Mes</h4><span class="small font-weight-bold text-muted" id="stat-total-cobros"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h260" id="chart-cobros"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Rendimiento + Deuda ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-graduation-cap mr-1"></i>Rendimiento y Deuda</h6>
    <div class="row">
        <div class="col-md-7 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-graduation-cap mr-1"></i>Rendimiento por Curso</h4><span><span class="badge outline-badge-success">≥70</span> <span class="badge outline-badge-warning">60–69</span> <span class="badge outline-badge-danger">&lt;60</span></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Curso</th>
                                <th class="text-center">Promedio</th>
                                <th class="text-center">En Riesgo</th>
                                <th>Nivel</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-rendimiento">
                            <tr><td class="text-center text-muted py-4" colspan="4">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
                </div>
            </div>
        </div>
        <div class="col-md-5 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-file-invoice-dollar mr-1"></i>Top Cursos con Deuda</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Curso</th>
                                <th class="text-center">Alumnos</th>
                                <th class="text-right">Monto</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-deuda">
                            <tr><td class="text-center text-muted py-4" colspan="4">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Alertas ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-bell mr-1"></i>Alertas del Sistema</h6>
    <div class="row">
        <div class="col-md-12 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-content widget-content-area">
                <div class="alertas-grid" id="lista-alertas">
                    <p class="text-muted m-0">Sin alertas activas.</p>
                </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/dashboarddirector.js"></script>
    <script>
        DashboardDirector.init("@Url.Action("ResumenAsync")");
    </script>
}
