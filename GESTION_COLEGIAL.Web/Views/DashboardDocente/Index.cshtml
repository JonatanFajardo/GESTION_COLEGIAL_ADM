@{
    ViewBag.Title = "Dashboard Docente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/pages/home-modern.css">

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Dashboard Docente</li>
        </ol>
    </nav>
</div>

<div class="home-content-wrapper">
    <div class="welcome-card-modern">
        <div class="welcome-content-modern">
            <h1>Dashboard Docente</h1>
            <p class="welcome-text-modern">Resumen en tiempo real</p>
        </div>
        <div class="welcome-decoration-modern">
            <i class="fa-solid fa-chalkboard-user" style="font-size:64px;opacity:.3;"></i>
        </div>
    </div>

    <div class="stats-grid-modern">
        <div class="stat-card-modern">
            <div class="stat-header-modern">
                <div class="stat-icon-modern blue">
                    <i class="fa-solid fa-book-open"></i>
                </div>
            </div>
            <div class="stat-label-modern">Clases Hoy</div>
            <div class="stat-value-modern" id="kpi-clasesHoy">—</div>
        </div>
        <div class="stat-card-modern">
            <div class="stat-header-modern">
                <div class="stat-icon-modern green">
                    <i class="fa-solid fa-users"></i>
                </div>
            </div>
            <div class="stat-label-modern">Alumnos</div>
            <div class="stat-value-modern" id="kpi-alumnosTotal">—</div>
        </div>
        <div class="stat-card-modern">
            <div class="stat-header-modern">
                <div class="stat-icon-modern orange">
                    <i class="fa-solid fa-clipboard-list"></i>
                </div>
            </div>
            <div class="stat-label-modern">Tareas Pendientes</div>
            <div class="stat-value-modern" id="kpi-tareasPendientes">—</div>
        </div>
        <div class="stat-card-modern">
            <div class="stat-header-modern">
                <div class="stat-icon-modern purple">
                    <i class="fa-solid fa-star-half-stroke"></i>
                </div>
            </div>
            <div class="stat-label-modern">Promedio Sección</div>
            <div class="stat-value-modern" id="kpi-promedioSeccion">—</div>
        </div>
    </div>

    <div class="mt-4">
        @await Html.PartialAsync("_ProximosDias")
    </div>
    <div id="dashboard-detail" class="mt-4"></div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/dashboarddocente.js"></script>
    <script>
        DashboardDocente.init("@Url.Action("ResumenAsync")");
    </script>
}
