@{
    ViewBag.Title = "Dashboard Docente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Dashboard Docente</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Dashboard Docente</h4>
        <p class="text-muted mb-0">Resumen en tiempo real</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-clasesHoy">—</h6>
                        <p>Clases Hoy</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-book-open"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-alumnosTotal">—</h6>
                        <p>Alumnos</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-users"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-tareasPendientes">—</h6>
                        <p>Tareas Pendientes</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-clipboard-list"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-promedioSeccion">—</h6>
                        <p>Promedio Sección</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-star-half-stroke"></i></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mb-4">
    @await Html.PartialAsync("_ProximosDias")
</div>
<div id="dashboard-detail" class="mb-4"></div>

@section Scripts{
    <script src="~/Content/js/pages/dashboarddocente.js"></script>
    <script>
        DashboardDocente.init("@Url.Action("ResumenAsync")");
    </script>
}
