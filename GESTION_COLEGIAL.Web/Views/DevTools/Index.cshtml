@{
    ViewBag.Title = "Dev Tools";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/pages/devtools.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Dev Tools</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Dev Tools</h4>
        <p class="text-muted mb-0">Herramientas internas — solo administrador</p>
    </div>
</div>

<div class="fluid-container">
    <div class="row">
        <!-- ============== SINCRONIZADOR DE FECHAS ============== -->
        <div class="col-lg-8">
            <div class="statbox widget box box-shadow mb-4" id="card-sync">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4><i class="fa-solid fa-calendar-days mr-2"></i>Sincronizador de Fechas</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">

                <div class="row align-items-center mb-2">
                    <div class="col-md-4 text-center py-2"><p class="text-muted small text-uppercase mb-0">Año en la data</p><h5 class="font-weight-bold mb-0" id="sync-anio-actual">—</h5></div>
                    <div class="col-md-4 text-center py-2"><p class="text-muted small text-uppercase mb-0">Año del sistema</p><h5 class="font-weight-bold mb-0" id="sync-anio-objetivo">—</h5></div>
                    <div class="col-md-4 text-center py-2"><p class="text-muted small text-uppercase mb-0">Delta</p><h5 class="font-weight-bold mb-0" id="sync-delta">—</h5></div>
                </div>

                <div class="d-flex align-items-center mb-3 mt-3">
                    <button id="btn-sync-detectar" class="btn btn-outline-primary btn-sm mr-2">
                        <i class="fa-solid fa-arrows-rotate mr-1"></i> Detectar
                    </button>
                    <button id="btn-sync-run" class="btn btn-primary btn-sm" disabled>
                        <i class="fa-solid fa-play mr-1"></i> Avanzar fechas
                    </button>
                    <div class="ml-auto" id="sync-status"></div>
                </div>

                <div class="progress mt-3 mb-1"><div class="progress-bar bg-gradient-primary" id="sync-progress" style="width:0%"></div></div>
                <div class="d-flex justify-content-between small text-muted">
                    <span id="sync-progress-text">0 de 0</span>
                    <span id="sync-progress-percent">0%</span>
                </div>

                <div id="sync-steps" class="mt-3"></div>
                </div>
            </div>
        </div>

        <!-- ============== ESTADO BD ============== -->
        <div class="col-lg-4">
            <div class="statbox widget box box-shadow mb-4" id="card-estado">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4><i class="fa-solid fa-database mr-2"></i>Estado de la BD</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="row" id="estado-grid">
                    <div class="col-6 text-center py-2"><p class="text-muted small text-uppercase mb-0">Alumnos</p><h5 class="font-weight-bold mb-0" data-stat="TotalAlumnos">—</h5></div>
                    <div class="col-6 text-center py-2"><p class="text-muted small text-uppercase mb-0">Empleados</p><h5 class="font-weight-bold mb-0" data-stat="TotalEmpleados">—</h5></div>
                    <div class="col-6 text-center py-2"><p class="text-muted small text-uppercase mb-0">Usuarios</p><h5 class="font-weight-bold mb-0" data-stat="TotalUsuarios">—</h5></div>
                    <div class="col-6 text-center py-2"><p class="text-muted small text-uppercase mb-0">Roles</p><h5 class="font-weight-bold mb-0" data-stat="TotalRoles">—</h5></div>
                    <div class="col-6 text-center py-2"><p class="text-muted small text-uppercase mb-0">Pantallas</p><h5 class="font-weight-bold mb-0" data-stat="TotalPantallas">—</h5></div>
                    <div class="col-6 text-center py-2"><p class="text-muted small text-uppercase mb-0">Sesiones activas</p><h5 class="font-weight-bold mb-0" data-stat="SesionesActivas">—</h5></div>
                    <div class="col-6 text-center py-2"><p class="text-muted small text-uppercase mb-0">Pagos</p><h5 class="font-weight-bold mb-0" data-stat="TotalPagos">—</h5></div>
                    <div class="col-6 text-center py-2"><p class="text-muted small text-uppercase mb-0">Ctas pendientes</p><h5 class="font-weight-bold mb-0" data-stat="CuentasPendientes">—</h5></div>
                    <div class="col-12 text-center py-2"><p class="text-muted small text-uppercase mb-0">Año actual data</p><h5 class="font-weight-bold mb-0" data-stat="AnioActualData">—</h5></div>
                </div>
                <button id="btn-estado-refresh" class="btn btn-outline-primary btn-sm w-100 mt-3">
                    <i class="fa-solid fa-arrows-rotate mr-1"></i> Refrescar
                </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============== IMPERSONAR ROL ============== -->
    <div class="row">
        <div class="col-12">
            <div class="statbox widget box box-shadow mb-4" id="card-impersonar">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4><i class="fa-solid fa-user-secret mr-2"></i>Impersonar Rol</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <p class="text-muted small mb-2">Cargar las pantallas de otro rol en tu sesión actual (sin logout). Útil para ver el sidebar como lo vería ese rol.</p>

                @if (TempData["ImpError"] != null)
                {
                    <div class="alert alert-danger small mt-2 mb-2">
                        <i class="fa-solid fa-triangle-exclamation mr-1"></i> @TempData["ImpError"]
                    </div>
                }
                @if (TempData["ImpOk"] != null)
                {
                    <div class="alert alert-success small mt-2 mb-2">
                        <i class="fa-solid fa-circle-check mr-1"></i> @TempData["ImpOk"]
                    </div>
                }

                <form method="post" action="@Url.Action("ImpersonarAsync")" id="frm-impersonar">
                    <div class="form-row align-items-end">
                        <div class="col-md-5 mb-2 mb-md-0">
                            <label class="small font-weight-bold">Rol a impersonar</label>
                            <select id="imp-rol" name="rolId" class="custom-select" required></select>
                        </div>
                        <div class="col-md-3 mb-2 mb-md-0">
                            <button type="submit" id="btn-imp-cargar" class="btn btn-primary w-100">
                                <i class="fa-solid fa-mask mr-1"></i> Impersonar
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button type="button" id="btn-imp-restaurar" class="btn btn-outline-primary w-100"
                                    formaction="@Url.Action("RestaurarAsync")" formmethod="post"
                                    onclick="document.getElementById('frm-restaurar').submit();">
                                <i class="fa-solid fa-rotate-left mr-1"></i> Volver a admin
                            </button>
                        </div>
                    </div>
                </form>
                <form method="post" action="@Url.Action("RestaurarAsync")" id="frm-restaurar" style="display:none;"></form>
                <div class="alert alert-info small mt-2 mb-0" id="imp-status" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/devtools.js?v=3"></script>
    <script>
        DevTools.init({
            urlDetectar:    "@Url.Action("DetectarAsync")",
            urlPaso:        "@Url.Action("PasoAsync")",
            urlEstado:      "@Url.Action("EstadoBDAsync")",
            urlRoles:       "@Url.Action("RolesAsync")",
            urlImpersonar:  "@Url.Action("ImpersonarAsync")",
            urlRestaurar:   "@Url.Action("RestaurarAsync")"
        });
    </script>
}
