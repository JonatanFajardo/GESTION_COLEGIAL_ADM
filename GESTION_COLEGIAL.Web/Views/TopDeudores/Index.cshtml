@{
    ViewBag.Title = "Top Alumnos con Deuda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Top Alumnos con Deuda</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Top Alumnos con Deuda</h4>
        <p class="text-muted mb-0">Alumnos con mayor deuda acumulada</p>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="row"><div class="col-12"><h4>Ranking de alumnos</h4></div></div>
    </div>
    <div class="widget-content widget-content-area">
        <div class="table-responsive">
            <table class="table table-hover nowrap" id="datatable-topdeudores">
                <thead><tr><th>Alumno</th><th>Deuda Total</th><th>Cuotas</th></tr></thead>
            </table>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/topdeudores.js"></script>
    <script>
        TopDeudores.init("@Url.Action("ListAsync")");
    </script>
}
