@{
    ViewBag.Title = "Directorio de Contacto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/pages/directorio-contacto.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Directorio de Contacto</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Directorio de contacto</h4>
        <p class="text-muted mb-0">Encuentre rápido el contacto de alumnos y encargados para llamadas y comunicaciones.</p>
    </div>
</div>

<div>

    <!-- KPIs -->
    <div class="row">
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-total-alumnos">—</h6>
                            <p>Alumnos filtrados</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-mortarboard-fill"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-total-encargados">—</h6>
                            <p>Encargados registrados</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-people-fill"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-sin-correo">—</h6>
                            <p>Encargados sin correo</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-envelope-slash-fill"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-sin-telefono">—</h6>
                            <p>Encargados sin teléfono</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-telephone-x-fill"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" role="tablist" id="dc-tabs">
        <li class="nav-item ci-tab-item active" data-target="alumno">
            <a href="#" class="nav-link active"><i class="bi bi-person-vcard mr-1"></i> Por alumno <span class="badge badge-primary ml-1" id="tab-count-alumno">—</span></a>
        </li>
        <li class="nav-item ci-tab-item" data-target="encargado">
            <a href="#" class="nav-link"><i class="bi bi-people mr-1"></i> Por encargado <span class="badge badge-primary ml-1" id="tab-count-encargado">—</span></a>
        </li>
    </ul>

    <!-- Panel activo -->
    <div class="statbox widget box box-shadow mb-4">

        <!-- Barra de herramientas -->
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
            <div class="mb-2 mr-2">
                <input type="text" id="dc-search" class="form-control" placeholder="Buscar en el directorio..." />
            </div>
            <div class="d-flex flex-wrap align-items-center mb-2">
                <div class="btn-group mr-2 ci-view-toggle" role="group" aria-label="Vista">
                    <button type="button" class="btn btn-outline-primary btn-sm ci-view-btn active" data-view="cards" title="Vista de tarjetas">
                        <i class="bi bi-grid-3x3-gap-fill mr-1"></i> Tarjetas
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm ci-view-btn" data-view="table" title="Vista de tabla">
                        <i class="bi bi-table mr-1"></i> Tabla
                    </button>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm mr-2" id="dc-reload" title="Recargar">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <a href="@Url.Action("CreateAsync", "Encargados")" class="btn btn-primary btn-sm" id="dc-new-encargado" style="display:none;">
                    <i class="bi bi-plus-lg mr-1"></i> Nuevo encargado
                </a>
            </div>
        </div>

        <!-- Filtros (solo pestaña alumno) -->
        <div class="mb-3" id="dc-filters">
            <small class="text-muted d-block mb-1">Filtrar por:</small>
            <div class="d-flex flex-wrap" id="dc-chips-curso">
                <span class="btn btn-sm btn-rounded btn-outline-primary mr-2 mb-2 grad-chip active" data-cur="">Todos los cursos</span>
            </div>
            <div class="d-flex flex-wrap" id="dc-chips-seccion">
                <span class="btn btn-sm btn-rounded btn-outline-primary mr-2 mb-2 grad-chip active" data-sec="">Todas las secciones</span>
            </div>
        </div>

        <!-- Tab 1: Por Alumno -->
        <div id="dc-tab-alumno">

            <!-- Empty state (fuera de las vistas para que no sea afectado por su layout) -->
            <div class="text-center text-muted py-5" id="dc-empty-alumno">
                <i class="bi bi-funnel h2 d-block"></i>
                <h5>Selecciona un curso o sección</h5>
                <p>Elige un atajo de <strong>curso</strong> arriba para ver los contactos filtrados. Evitamos cargar todos los alumnos a la vez para no afectar el rendimiento.</p>
            </div>

            <!-- Cards view -->
            <div id="dc-cards-alumno" style="display:none;">
                <div class="row" id="dc-cards-grid-alumno"></div>
            </div>

            <!-- Table view -->
            <div id="dc-table-alumno" style="display:none;">
                <div class="table-responsive">
                    <table class="table table-hover w-100" id="dc-datatable-alumno">
                        <thead>
                            <tr>
                                <th>Identidad</th>
                                <th>Alumno</th>
                                <th>Curso</th>
                                <th>Sección</th>
                                <th>Encargado</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 2: Por Encargado -->
        <div id="dc-tab-encargado" style="display:none;">

            <div class="text-center text-muted py-5" id="dc-empty-encargado" style="display:none;">
                <i class="bi bi-inbox h2 d-block"></i>
                <h5>Sin encargados</h5>
                <p>No hay encargados registrados en el sistema.</p>
            </div>

            <!-- Cards view -->
            <div id="dc-cards-encargado">
                <div class="row" id="dc-cards-grid-encargado"></div>
            </div>

            <!-- Table view -->
            <div id="dc-table-encargado" style="display:none;">
                <div class="table-responsive">
                    <table class="table table-hover w-100" id="dc-datatable-encargado">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Identidad</th>
                                <th>Nombre</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>Ocupación</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/directoriocontacto.js"></script>
    <script>
        DirectorioContacto.init({
            urlAlumnos:     "@Url.Action("ListAlumnosAsync")",
            urlEncargados:  "@Url.Action("ListEncargadosAsync")",
            urlCursos:      "@Url.Action("CursosDropdown")",
            urlSecciones:   "@Url.Action("SeccionesDropdown")",
            urlEncEditar:   "@Url.Action("FindAsync", "Encargados")",
            urlEncDetalle:  "@Url.Action("DetailAsync", "Encargados")"
        });
    </script>
}
