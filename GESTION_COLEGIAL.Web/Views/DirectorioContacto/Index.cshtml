@{
    ViewBag.Title = "Directorio de Contacto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/pages/catalogos-institucion.css" rel="stylesheet" />
    <link href="~/Content/css/pages/kpisacademicos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/graduados-directorio.css" rel="stylesheet" />
    <link href="~/Content/css/pages/directorio-contacto.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Directorio de Contacto</li>
        </ol>
    </nav>
</div>

<!-- Hero -->
<div class="ci-hero">
    <div class="ci-hero-content">
        <div class="ci-hero-left">
            <div class="ci-hero-icon"><i class="bi bi-person-lines-fill"></i></div>
            <div class="ci-hero-text">
                <h1>Directorio de Contacto</h1>
                <p>Encuentre rápido el contacto de alumnos y encargados para llamadas y comunicaciones</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">

    <!-- KPIs -->
    <div class="row dc-kpis mb-3">
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="kpi-stat-card kpi-stat-indigo">
                <div class="kpi-stat-icon"><i class="bi bi-mortarboard-fill"></i></div>
                <div class="kpi-stat-body">
                    <div class="kpi-stat-valor" id="kpi-total-alumnos">—</div>
                    <div class="kpi-stat-label">Alumnos filtrados</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="kpi-stat-card kpi-stat-emerald">
                <div class="kpi-stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="kpi-stat-body">
                    <div class="kpi-stat-valor" id="kpi-total-encargados">—</div>
                    <div class="kpi-stat-label">Encargados registrados</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="kpi-stat-card kpi-stat-amber">
                <div class="kpi-stat-icon"><i class="bi bi-envelope-slash-fill"></i></div>
                <div class="kpi-stat-body">
                    <div class="kpi-stat-valor" id="kpi-sin-correo">—</div>
                    <div class="kpi-stat-label">Encargados sin correo</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="kpi-stat-card kpi-stat-cyan">
                <div class="kpi-stat-icon"><i class="bi bi-telephone-x-fill"></i></div>
                <div class="kpi-stat-body">
                    <div class="kpi-stat-valor" id="kpi-sin-telefono">—</div>
                    <div class="kpi-stat-label">Encargados sin teléfono</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="ci-tabs-card">
        <ul class="nav ci-tabs" role="tablist" id="dc-tabs">
            <li class="nav-item ci-tab-item active" data-target="alumno">
                <a href="#" class="ci-tab-link">
                    <span class="ci-tab-num">1</span>
                    <span class="ci-tab-icon"><i class="bi bi-person-vcard"></i></span>
                    <span class="ci-tab-label">Por Alumno</span>
                    <span class="ci-tab-count" id="tab-count-alumno">—</span>
                </a>
            </li>
            <li class="nav-item ci-tab-item" data-target="encargado">
                <a href="#" class="ci-tab-link">
                    <span class="ci-tab-num">2</span>
                    <span class="ci-tab-icon"><i class="bi bi-people"></i></span>
                    <span class="ci-tab-label">Por Encargado</span>
                    <span class="ci-tab-count" id="tab-count-encargado">—</span>
                </a>
            </li>
        </ul>
    </div>

    <!-- Panel activo -->
    <div class="ci-panel">

        <!-- Toolbar -->
        <div class="ci-toolbar">
            <div class="ci-toolbar-left">
                <div class="ci-search-wrap">
                    <i class="bi bi-search"></i>
                    <input type="text" id="dc-search" placeholder="Buscar en el directorio..." />
                </div>
            </div>
            <div class="ci-toolbar-right">
                <div class="ci-view-toggle" role="group" aria-label="Vista">
                    <button type="button" class="ci-view-btn active" data-view="cards" title="Vista de tarjetas">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                        <span>Cards</span>
                    </button>
                    <button type="button" class="ci-view-btn" data-view="table" title="Vista de tabla">
                        <i class="bi bi-table"></i>
                        <span>Tabla</span>
                    </button>
                </div>
                <button type="button" class="ci-btn-ghost" id="dc-reload" title="Recargar">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <a href="@Url.Action("CreateAsync", "Encargados")" class="ci-btn-primary" id="dc-new-encargado" style="display:none;">
                    <i class="bi bi-plus-lg"></i>
                    <span>Nuevo Encargado</span>
                </a>
            </div>
        </div>

        <!-- Filtros (solo pestaña alumno) -->
        <div class="dc-filters" id="dc-filters">
            <span class="grad-chips-label">Filtrar por:</span>
            <div class="grad-chips" id="dc-chips-curso">
                <span class="grad-chip active" data-cur="">Todos los cursos</span>
            </div>
            <div class="grad-chips" id="dc-chips-seccion">
                <span class="grad-chip active" data-sec="">Todas las secciones</span>
            </div>
        </div>

        <!-- Tab 1: Por Alumno -->
        <div class="dc-tab-content" id="dc-tab-alumno">

            <!-- Empty state (fuera de las vistas para que no sea afectado por su layout) -->
            <div class="dc-empty" id="dc-empty-alumno">
                <i class="bi bi-funnel"></i>
                <h4>Selecciona un curso o sección</h4>
                <p>Elige un chip de <strong>curso</strong> arriba para ver los contactos filtrados. Evitamos cargar todos los alumnos a la vez para no afectar el rendimiento.</p>
            </div>

            <!-- Cards view -->
            <div class="ci-cards-view" id="dc-cards-alumno" style="display:none;">
                <div class="ci-cards-grid" id="dc-cards-grid-alumno"></div>
            </div>

            <!-- Table view -->
            <div class="ci-table-view" id="dc-table-alumno" style="display:none;">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered" id="dc-datatable-alumno" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Identidad</th>
                                <th>Alumno</th>
                                <th>Curso</th>
                                <th>Sección</th>
                                <th>Encargado</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 2: Por Encargado -->
        <div class="dc-tab-content" id="dc-tab-encargado" style="display:none;">

            <div class="dc-empty" id="dc-empty-encargado" style="display:none;">
                <i class="bi bi-inbox"></i>
                <h4>Sin encargados</h4>
                <p>No hay encargados registrados en el sistema.</p>
            </div>

            <!-- Cards view -->
            <div class="ci-cards-view" id="dc-cards-encargado">
                <div class="ci-cards-grid" id="dc-cards-grid-encargado"></div>
            </div>

            <!-- Table view -->
            <div class="ci-table-view" id="dc-table-encargado" style="display:none;">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered" id="dc-datatable-encargado" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Identidad</th>
                                <th>Nombre</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>Ocupación</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/directoriocontacto.js"></script>
    <script>
        DirectorioContacto.init({
            urlAlumnos:     "@Url.Action("ListAlumnosAsync")",
            urlEncargados:  "@Url.Action("ListEncargadosAsync")",
            urlCursos:      "@Url.Action("CursosDropdown")",
            urlSecciones:   "@Url.Action("SeccionesDropdown")",
            urlEncEditar:   "@Url.Action("FindAsync", "Encargados")",
            urlEncDetalle:  "@Url.Action("DetailAsync", "Encargados")"
        });
    </script>
}
