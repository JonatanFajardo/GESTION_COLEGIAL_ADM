@model GESTION_COLEGIAL.Business.Models.RolViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/elements/custom-tree_view.css" rel="stylesheet" />
    <link href="~/Content/css/pages/roles.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Roles</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Gestion de Roles</h4>
        <p class="text-muted mb-0">Administre los roles y asigne pantallas de acceso</p>
    </div>
    <div class="mt-2 mt-md-0">
        <button class="btn btn-primary" id="add-btn-header" data-toggle="modal" data-target="#edit-modal">
            <i class="bi bi-plus-lg mr-1"></i>
            Nuevo Rol
        </button>
    </div>
</div>

<div class="fluid-container">
    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Listado de Roles</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Descripcion</th>
                            <th>Pantallas</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear/Editar Rol -->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Gestion de Rol</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            @using (Ajax.BeginForm("CreateAsync", "Roles", new AjaxOptions
            {
                HttpMethod = "Post",
                OnBegin = "Catalogs.begin",
                OnComplete = "Catalogs.complete",
                OnFailure = "Catalogs.failure",
                OnSuccess = "Catalogs.success"
            }))
            {
            <div class="fluid-container">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                @Html.HiddenFor(model => model.Rol_Id, new { @id = "item-id" })
                <div class="modal-body">
                    <h6 class="font-weight-bold mb-3">Informacion del Rol</h6>
                    <div>
                        <div class="row">
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label>
                                        Descripcion del Rol
                                        <span class="text-danger">*</span>
                                    </label>
                                    @Html.EditorFor(model => model.Rol_Descripcion, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej: Administrador, Docente..." } })
                                    @Html.ValidationMessageFor(model => model.Rol_Descripcion, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Estado</label>
                                    <div class="d-flex align-items-center mt-2">
                                        <label class="switch s-outline s-outline-primary mb-0 mr-2">
                                            @Html.CheckBoxFor(model => model.Rol_Estado, new { @id = "Rol_Estado" })
                                            <span class="slider round"></span>
                                        </label>
                                        <label for="Rol_Estado" class="mb-0">Activo</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z"/>
                        </svg>
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1H2z"/>
                        </svg>
                        Guardar Rol
                    </button>
                </div>
            </div>
            }
        </div>
    </div>
</div>

<!-- Modal Delete -->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        @using (Ajax.BeginForm("DeleteAsync", "Roles", new AjaxOptions
        {
            HttpMethod = "Post",
            OnBegin = "Catalogs.begin",
            OnComplete = "Catalogs.complete",
            OnFailure = "Catalogs.failure",
            OnSuccess = "Catalogs.success"
        }))
        {
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Eliminar rol</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body text-center">
                @Html.HiddenFor(model => model.Rol_Id, new { @id = "delete-item-id" })
                <i class="fas fa-exclamation-triangle text-danger h1 d-block mb-3"></i>
                <p class="mb-0">¿Está seguro de que desea eliminar el rol <span id="delete-item-name" class="font-weight-bold"></span>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger">Eliminar</button>
            </div>
        </div>
        }
    </div>
</div>

<!-- Modal Detalle -->
<div class="modal fade" id="detail-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-file-alt mr-1"></i> Detalle del Rol</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="col-6 mb-3"><p class="text-muted small mb-0">ID</p><p class="font-weight-bold mb-0" id="detail-rol-id"></p></div>
                    <div class="col-6 mb-3"><p class="text-muted small mb-0">Descripcion</p><p class="font-weight-bold mb-0" id="detail-rol-descripcion"></p></div>
                    <div class="col-6 mb-3"><p class="text-muted small mb-0">Estado</p><p class="font-weight-bold mb-0" id="detail-rol-estado"></p></div>
                    <div class="col-6 mb-3"><p class="text-muted small mb-0">Pantallas asignadas</p><p class="font-weight-bold mb-0" id="detail-rol-cantidadpantallas"></p></div>
                </div>
                <h6 class="font-weight-bold border-top pt-3 mb-3"><i class="fas fa-history mr-1"></i> Auditoria</h6>
                <div class="form-row">
                    <div class="col-6"><p class="text-muted small mb-0"><i class="fas fa-calendar text-success mr-1"></i>Fecha de creacion</p><p class="font-weight-bold mb-0" id="detail-rol-fecharegistra"></p></div>
                    <div class="col-6"><p class="text-muted small mb-0"><i class="fas fa-calendar text-info mr-1"></i>Fecha de modificacion</p><p class="font-weight-bold mb-0" id="detail-rol-fechamodifica"></p></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Asignar Pantallas (Tree View) -->
<div class="modal fade" id="pantallas-modal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Asignar Pantallas al Rol</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="pantallas-rol-id" />
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-primary mr-2" id="btn-select-all">
                            <i class="fas fa-check-double mr-1"></i>Seleccionar todas
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-deselect-all">
                            <i class="fas fa-times mr-1"></i>Deseleccionar todas
                        </button>
                    </div>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btn-expand-all">
                            <i class="fas fa-expand-arrows-alt mr-1"></i>Expandir
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btn-collapse-all">
                            <i class="fas fa-compress-arrows-alt mr-1"></i>Colapsar
                        </button>
                    </div>
                </div>
                <div id="pantallas-tree-container" class="pantallas-tree border rounded p-3">
                    <!-- Tree se carga dinamicamente -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btn-save-pantallas">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1H2z"/>
                    </svg>
                    Guardar Pantallas
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/plugins/treeview/custom-jstree.js"></script>
    <script src="~/Content/js/pages/roles.js"></script>
    <script>
        // Inicializar DataTable de roles (con boton de pantallas integrado)
        Roles.datatableCatalogs({
            urlList: "@Url.Action("ListAsync")",
            urlDetail: "@Url.Action("DetailAsync")"
        });

        // Configurar el patron de catalogos para crear/editar
        Catalogs.configure({
            displayName: "roles",
            urlUpdate: "@Url.Action("FindAsync")"
        });

        // Configurar el patron de detalle en modal
        CatalogsCfg.configure({
            displayName: "rol",
            getUrl: "@Url.Action("DetailAsync")"
        });
    </script>
    <script>
        // === Logica de asignacion de pantallas con Tree View ===
        var urlPantallasList = "@Url.Action("PantallasListAsync")";
        var urlPantallasByRol = "@Url.Action("PantallasByRolAsync")";
        var urlSavePantallas = "@Url.Action("SavePantallasAsync")";

        // Abrir modal de pantallas
        $(document).on('click', '.btn-pantallas', function () {
            var rolId = $(this).data('id');
            $('#pantallas-rol-id').val(rolId);
            loadPantallasTree(rolId);
            $('#pantallas-modal').modal('show');
        });

        function loadPantallasTree(rolId) {
            var container = $('#pantallas-tree-container');
            container.html('<div class="text-center py-4"><i class="fa-solid fa-spinner fa-spin-pulse fa-2x text-primary"></i><p class="mt-2 text-muted">Cargando pantallas...</p></div>');

            // Cargar todas las pantallas
            $.ajax({
                url: urlPantallasList,
                type: "GET",
                dataType: "json",
                success: function (allPantallas) {
                    // Cargar pantallas asignadas
                    $.ajax({
                        url: urlPantallasByRol + "?id=" + rolId,
                        type: "GET",
                        dataType: "json",
                        success: function (assigned) {
                            var assignedIds = [];
                            if (assigned && assigned.data) {
                                assignedIds = assigned.data.map(function (x) { return x.Pan_Id; });
                            }
                            var pantallas = allPantallas.data || allPantallas;
                            buildTree(container, pantallas, assignedIds);
                        },
                        error: function () {
                            container.html('<p class="text-danger text-center py-3">Error al cargar pantallas asignadas</p>');
                        }
                    });
                },
                error: function () {
                    container.html('<p class="text-danger text-center py-3">Error al cargar pantallas</p>');
                }
            });
        }

        // Extraer el nombre de la pantalla (entidad) quitando el verbo CRUD
        function extractPantalla(descripcion) {
            var prefijos = ['Crear ', 'Editar ', 'Eliminar ', 'Listado de '];
            for (var i = 0; i < prefijos.length; i++) {
                if (descripcion.indexOf(prefijos[i]) === 0) {
                    return descripcion.substring(prefijos[i].length);
                }
            }
            return descripcion;
        }

        function buildTree(container, pantallas, assignedIds) {
            if (!pantallas || pantallas.length === 0) {
                container.html('<p class="text-muted text-center py-3">No hay pantallas disponibles</p>');
                return;
            }

            // Agrupar por Pan_Grupo -> Pantalla (entidad) -> Items
            var grupos = {};
            $.each(pantallas, function (i, p) {
                var grupo = p.Pan_Grupo || 'General';
                var pantalla = extractPantalla(p.Pan_Descripcion);
                if (!grupos[grupo]) grupos[grupo] = {};
                if (!grupos[grupo][pantalla]) grupos[grupo][pantalla] = [];
                grupos[grupo][pantalla].push(p);
            });

            // Iconos por grupo
            var grupoIcons = {
                'General': 'fas fa-home',
                'Cursos': 'fas fa-book-open',
                'Alumnos': 'fas fa-user-graduate',
                'Recursos Humanos': 'fas fa-briefcase',
                'Horarios': 'fas fa-calendar-alt',
                'Institucion': 'fas fa-university',
                'Financiero': 'fas fa-dollar-sign',
                'Seguridad': 'fas fa-shield-alt',
                'Academico': 'fas fa-graduation-cap'
            };

            var html = '<ul class="file-tree">';

            $.each(grupos, function (grupoName, subgrupos) {
                var grupoId = grupoName.replace(/\s+/g, '_').toLowerCase();
                var icon = grupoIcons[grupoName] || 'fas fa-folder';

                // Contar totales del grupo
                var totalItems = 0, checkedItems = 0;
                $.each(subgrupos, function (sgName, items) {
                    $.each(items, function (i, p) {
                        totalItems++;
                        if (assignedIds.indexOf(p.Pan_Id) >= 0) checkedItems++;
                    });
                });

                html += '<li class="file-tree-folder open">';
                html += '<span class="grupo-header" data-grupo="' + grupoId + '">';
                html += '<i class="' + icon + ' grupo-icon text-info"></i>';
                html += grupoName;
                html += ' <span class="badge badge-secondary">' + checkedItems + '/' + totalItems + '</span>';
                html += '<span class="grupo-check-all" data-grupo="' + grupoId + '" title="Seleccionar/Deseleccionar grupo"> (marcar todo)</span>';
                html += '</span>';
                html += '<ul style="display: block;">';

                $.each(subgrupos, function (pantallaName, items) {
                    var subgrupoId = grupoId + '_' + pantallaName.replace(/\s+/g, '_').toLowerCase();
                    var sgTotal = items.length;
                    var sgChecked = 0;
                    $.each(items, function (i, p) {
                        if (assignedIds.indexOf(p.Pan_Id) >= 0) sgChecked++;
                    });

                    html += '<li class="pantalla-subgrupo file-tree-folder open">';
                    html += '<span class="pantalla-subgrupo-header" data-subgrupo="' + subgrupoId + '" data-grupo="' + grupoId + '">';
                    html += '<i class="fas fa-file-alt text-primary mr-1"></i>';
                    html += pantallaName.charAt(0).toUpperCase() + pantallaName.slice(1);
                    html += ' <span class="badge badge-secondary">' + sgChecked + '/' + sgTotal + '</span>';
                    html += '<span class="pantalla-subgrupo-check-all" data-subgrupo="' + subgrupoId + '" data-grupo="' + grupoId + '"> (marcar todo)</span>';
                    html += '</span>';
                    html += '<ul class="pantalla-subgrupo-content" style="display: block;">';

                    $.each(items, function (i, p) {
                        var checked = assignedIds.indexOf(p.Pan_Id) >= 0 ? 'checked' : '';
                        html += '<li class="pantalla-item">';
                        html += '<div class="custom-control custom-checkbox">';
                        html += '<input type="checkbox" class="custom-control-input pantalla-check" id="pan_' + p.Pan_Id + '" value="' + p.Pan_Id + '" data-grupo="' + grupoId + '" data-subgrupo="' + subgrupoId + '" ' + checked + '>';
                        html += '<label class="custom-control-label" for="pan_' + p.Pan_Id + '">' + p.Pan_Descripcion + '</label>';
                        html += '</div>';
                        html += '</li>';
                    });

                    html += '</ul>';
                    html += '</li>';
                });

                html += '</ul>';
                html += '</li>';
            });

            html += '</ul>';
            container.html(html);

            // Inicializar eventos del tree
            initTreeEvents();
        }

        function initTreeEvents() {
            // Toggle grupo (expandir/colapsar)
            $('.grupo-header').off('click').on('click', function (e) {
                if ($(e.target).hasClass('grupo-check-all')) return;
                var $ul = $(this).closest('li').children('ul');
                $ul.slideToggle(200);
                $(this).closest('li').toggleClass('open');
            });

            // Toggle sub-grupo (expandir/colapsar)
            $('.pantalla-subgrupo-header').off('click').on('click', function (e) {
                if ($(e.target).hasClass('pantalla-subgrupo-check-all')) return;
                var $ul = $(this).closest('li').children('ul');
                $ul.slideToggle(200);
                $(this).closest('li').toggleClass('open');
            });

            // Marcar/desmarcar todo el grupo
            $('.grupo-check-all').off('click').on('click', function (e) {
                e.stopPropagation();
                var grupoId = $(this).data('grupo');
                var $checks = $('.pantalla-check[data-grupo="' + grupoId + '"]');
                var allChecked = $checks.length === $checks.filter(':checked').length;
                $checks.prop('checked', !allChecked);
                updateAllBadges(grupoId);
            });

            // Marcar/desmarcar todo el sub-grupo
            $('.pantalla-subgrupo-check-all').off('click').on('click', function (e) {
                e.stopPropagation();
                var subgrupoId = $(this).data('subgrupo');
                var grupoId = $(this).data('grupo');
                var $checks = $('.pantalla-check[data-subgrupo="' + subgrupoId + '"]');
                var allChecked = $checks.length === $checks.filter(':checked').length;
                $checks.prop('checked', !allChecked);
                updateSubgrupoBadge(subgrupoId);
                updateGrupoBadge(grupoId);
            });

            // Actualizar badges al cambiar checkbox
            $('.pantalla-check').off('change').on('change', function () {
                var grupoId = $(this).data('grupo');
                var subgrupoId = $(this).data('subgrupo');
                updateSubgrupoBadge(subgrupoId);
                updateGrupoBadge(grupoId);
            });
        }

        function updateSubgrupoBadge(subgrupoId) {
            var $checks = $('.pantalla-check[data-subgrupo="' + subgrupoId + '"]');
            var total = $checks.length;
            var checked = $checks.filter(':checked').length;
            var $header = $('.pantalla-subgrupo-header[data-subgrupo="' + subgrupoId + '"]');
            $header.find('.badge').text(checked + '/' + total);
        }

        function updateGrupoBadge(grupoId) {
            var $checks = $('.pantalla-check[data-grupo="' + grupoId + '"]');
            var total = $checks.length;
            var checked = $checks.filter(':checked').length;
            var $header = $('.grupo-header[data-grupo="' + grupoId + '"]');
            $header.find('.badge').text(checked + '/' + total);
        }

        function updateAllBadges(grupoId) {
            // Actualizar badge del grupo
            updateGrupoBadge(grupoId);
            // Actualizar badges de todos los sub-grupos dentro de este grupo
            $('.pantalla-subgrupo-header[data-grupo="' + grupoId + '"]').each(function () {
                updateSubgrupoBadge($(this).data('subgrupo'));
            });
        }

        // Seleccionar / Deseleccionar todas
        $('#btn-select-all').click(function () {
            $('.pantalla-check').prop('checked', true);
            $('.grupo-header').each(function () {
                updateAllBadges($(this).data('grupo'));
            });
        });

        $('#btn-deselect-all').click(function () {
            $('.pantalla-check').prop('checked', false);
            $('.grupo-header').each(function () {
                updateAllBadges($(this).data('grupo'));
            });
        });

        // Expandir / Colapsar todos (aplica a grupos y sub-grupos)
        $('#btn-expand-all').click(function () {
            $('.file-tree-folder').addClass('open').children('ul').slideDown(200);
        });

        $('#btn-collapse-all').click(function () {
            $('.file-tree-folder').removeClass('open').children('ul').slideUp(200);
        });

        // Guardar pantallas
        $('#btn-save-pantallas').click(function () {
            var rolId = $('#pantallas-rol-id').val();
            var selectedIds = [];
            $('.pantalla-check:checked').each(function () {
                selectedIds.push($(this).val());
            });

            var $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Guardando...');

            $.ajax({
                url: urlSavePantallas,
                type: "POST",
                data: { rolId: rolId, pantallaIds: selectedIds.join(',') },
                success: function (response) {
                    $('#pantallas-modal').modal('hide');
                    alertConfig.alert(response.message, response.type);
                    var table = Roles.getTable();
                    if (table) {
                        table.ajax.reload(null, false);
                    } else {
                        location.reload();
                    }
                },
                error: function () {
                    alertConfig.alert("Error al guardar las pantallas", "error");
                },
                complete: function () {
