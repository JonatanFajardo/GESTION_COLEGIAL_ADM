@{
    ViewBag.Title = "Analítica Académica";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/pages/analitica-academica.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Analítica Académica</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Analítica Académica</h4>
        <p class="text-muted mb-0">Indicadores institucionales y rendimiento por sección</p>
    </div>
</div>

<div class="fluid-container">

    <!-- Filtros compartidos -->
    <div id="card-filtros" class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="form-row align-items-end">
                <div class="col-auto form-group mb-0">
                    <label for="filtro-anio">Año</label>
                    <input type="number" id="filtro-anio" class="form-control" min="2000" max="2099" />
                </div>
                <div class="col-auto form-group mb-0">
                    <label for="filtro-parcial">Parcial</label>
                    <select id="filtro-parcial" class="custom-select"></select>
                </div>
                <div class="col-auto">
                    <button id="btn-filtrar" class="btn btn-primary">
                        <i class="fa-solid fa-magnifying-glass mr-1"></i> Consultar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs del hub -->
    <ul class="nav nav-tabs mb-4" id="aa-tabs" role="tablist">
        <li class="nav-item">
            <a href="#" class="nav-link active" data-tab="resumen"><i class="fa-solid fa-gauge-high mr-1"></i> Resumen institucional</a>
        </li>
        <li class="nav-item">
            <a href="#" class="nav-link" data-tab="rendimiento"><i class="fa-solid fa-chart-column mr-1"></i> Rendimiento por sección</a>
        </li>
    </ul>

    <!-- ══════════ TAB 1: Resumen institucional ══════════ -->
    <div id="tab-resumen" class="aa-tab-panel">

        <!-- Fila 1: KPI principales -->
        <div class="row">
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-total-alumnos">—</h6>
                            <p>Total Alumnos</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-user-graduate"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-total-docentes">—</h6>
                            <p>Total Docentes</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-chalkboard-teacher"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-promedio-general">—</h6>
                            <p>Promedio General</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-chart-line"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-porcentaje-asistencia">—</h6>
                            <p>% Asistencia</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-calendar-check"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        </div>

        <!-- Barra de asistencia -->
        <div class="statbox widget box box-shadow mb-4 d-none" id="card-asistencia-barra">
            <div class="widget-content widget-content-area">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="font-weight-bold"><i class="fa-solid fa-calendar-check mr-1"></i> Asistencia Institucional</span>
                    <span class="font-weight-bold" id="barra-asistencia-texto">0%</span>
                </div>
                <div class="progress mb-0">
                    <div class="progress-bar bg-success" id="barra-asistencia" role="progressbar"></div>
                </div>
            </div>
        </div>

        <!-- Fila 2: distribución -->
        <div class="row">
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-success" id="kpi-aprobados">—</h6>
                            <p>Aprobados</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-circle-check"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2" id="kpi-aprobados-pct">&nbsp;</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-warning" id="kpi-en-riesgo">—</h6>
                            <p>En Riesgo</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-triangle-exclamation"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2" id="kpi-en-riesgo-pct">&nbsp;</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-danger" id="kpi-reprobados">—</h6>
                            <p>Reprobados</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-circle-xmark"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2" id="kpi-reprobados-pct">&nbsp;</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-materias">—</h6>
                            <p>Materias evaluadas</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-book-open"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2" id="kpi-secciones-sub">&nbsp;</p>
                </div>
            </div>
        </div>
        </div>

        <!-- Fila 3: Gráficos -->
        <div class="row">
            <div class="col-12 col-lg-5 layout-spacing">
                <div class="statbox widget box box-shadow h-100">
                    <div class="widget-header">
                        <div class="row"><div class="col-12">
                            <h4 class="pb-0">Distribución de Promedios</h4>
                            <p class="text-muted small px-3 mb-0">Materias por rango de calificación</p>
                        </div></div>
                    </div>
                    <div class="widget-content widget-content-area">
                        <div class="aa-chart"><canvas id="chart-distribucion"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-7 layout-spacing">
                <div class="statbox widget box box-shadow h-100">
                    <div class="widget-header">
                        <div class="row"><div class="col-12">
                            <h4 class="pb-0">Top 10 Materias por Promedio</h4>
                            <p class="text-muted small px-3 mb-0">Mejores promedios del parcial seleccionado</p>
                        </div></div>
                    </div>
                    <div class="widget-content widget-content-area">
                        <div class="aa-chart"><canvas id="chart-top-materias"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fila 4: Matrícula + Riesgo -->
        <div class="row">
            <div class="col-12 col-lg-7 layout-spacing">
                <div class="statbox widget box box-shadow h-100">
                    <div class="widget-header">
                        <div class="row"><div class="col-12">
                            <h4 class="pb-0">Matrícula por Grado Académico</h4>
                            <p class="text-muted small px-3 mb-0">Distribución por género</p>
                        </div></div>
                    </div>
                    <div class="widget-content widget-content-area">
                        <div class="aa-chart"><canvas id="chart-piramide"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-5 layout-spacing">
                <div class="statbox widget box box-shadow h-100">
                    <div class="widget-header">
                        <div class="row"><div class="col-12">
                            <h4 class="pb-0">Alumnos en Riesgo</h4>
                            <p class="text-muted small px-3 mb-0" id="sub-en-riesgo">Promedio menor a 70 — Top 15</p>
                        </div></div>
                    </div>
                    <div class="widget-content widget-content-area">
                        <div class="table-responsive aa-scroll">
                            <table class="table table-hover table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Alumno</th>
                                        <th>Sección</th>
                                        <th class="text-right">Prom.</th>
                                    </tr>
                                </thead>
                                <tbody id="tabla-en-riesgo">
                                    <tr><td colspan="3" class="text-center text-muted py-3">Sin datos.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ══════════ TAB 2: Rendimiento por sección ══════════ -->
    <div id="tab-rendimiento" class="aa-tab-panel" style="display:none">

        <!-- KPIs del tab -->
        <div id="rps-kpis" class="row" style="display:none">
            <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                <div class="widget widget-card-four">
                    <div class="widget-content">
                        <div class="w-content">
                            <div class="w-info">
                                <h6 class="value" id="kpi-promedio">—</h6>
                                <p>Promedio General</p>
                            </div>
                            <div><div class="w-icon"><i class="fa-solid fa-chart-line"></i></div></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                <div class="widget widget-card-four">
                    <div class="widget-content">
                        <div class="w-content">
                            <div class="w-info">
                                <h6 class="value" id="kpi-alumnos">—</h6>
                                <p>Total Alumnos</p>
                            </div>
                            <div><div class="w-icon"><i class="fa-solid fa-user-graduate"></i></div></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                <div class="widget widget-card-four">
                    <div class="widget-content">
                        <div class="w-content">
                            <div class="w-info">
                                <h6 class="value" id="kpi-secciones">—</h6>
                                <p>Secciones</p>
                            </div>
                            <div><div class="w-icon"><i class="fa-solid fa-layer-group"></i></div></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                <div class="widget widget-card-four">
                    <div class="widget-content">
                        <div class="w-content">
                            <div class="w-info">
                                <h6 class="value" id="kpi-cursos">—</h6>
                                <p>Cursos evaluados</p>
                            </div>
                            <div><div class="w-icon"><i class="fa-solid fa-book"></i></div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Container de secciones -->
        <div id="rendimiento-container">
            <div class="statbox widget box box-shadow">
                <div class="widget-content widget-content-area text-center text-muted py-5">
                    <i class="fa-solid fa-chart-column fa-3x mb-3"></i>
                    <h5>Sin consulta activa</h5>
                    <p class="mb-0">Selecciona el año y parcial para ver el rendimiento de cada sección.</p>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/kpisacademicos.js"></script>
    <script>
        KPIsAcademicos.init({
            urlFind:          "@Url.Action("FindAsync")",
            urlDropdowns:     "@Url.Action("DropdownsAsync")",
            urlRendimiento:   "@Url.Action("RendimientoAsync")",
            urlEnRiesgo:      "@Url.Action("EnRiesgoAsync")",
            urlPiramide:      "@Url.Action("PiramideAsync")",
            urlNotaMinima:    "@Url.Action("NotaMinimaAsync", "GraduacionAlumnos")",
            urlDetalleAlumno: "@Url.Action("Detalle", "Alumnos")"
        });
    </script>
}
