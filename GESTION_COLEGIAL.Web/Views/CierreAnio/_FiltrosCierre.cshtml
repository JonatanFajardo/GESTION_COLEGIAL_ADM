@* Filtros en cascada Nivel → Grado → Sección del cierre del año (el hijo se habilita al elegir el padre). *@
<div class="form-row mb-2">
    <div class="form-group col-md-4">
        <label for="ca-f-nivel">Nivel</label>
        <select id="ca-f-nivel" class="custom-select"><option value="">Todos los niveles</option></select>
    </div>
    <div class="form-group col-md-4">
        <label for="ca-f-grado">Grado</label>
        <select id="ca-f-grado" class="custom-select" disabled><option value="">Todos los grados</option></select>
    </div>
    <div class="form-group col-md-4">
        <label for="ca-f-seccion">Sección</label>
        <select id="ca-f-seccion" class="custom-select" disabled><option value="">Elija una sección</option></select>
    </div>
</div>
