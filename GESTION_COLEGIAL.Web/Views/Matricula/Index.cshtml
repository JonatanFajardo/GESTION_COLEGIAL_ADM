@model GESTION_COLEGIAL.Business.Models.AlumnoViewModel
@{
    ViewBag.Title = "Matrícula nueva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/Content/css/pages/matricula.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/Alumnos">Alumnos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Matrícula nueva</li>
        </ol>
    </nav>
</div>

<div>
    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
        <div class="mr-3">
            <h4 class="mb-1">Matrícula nueva</h4>
            <p class="text-muted mb-0">Registro guiado del estudiante paso a paso: datos, encargado, documentos y confirmación.</p>
        </div>
    </div>

    @* Desde la lista de espera (?aspiranteId=): aviso y datos precargados. Sin ese parámetro no aparece nada. *@
    @if (ViewBag.Aspirante is GESTION_COLEGIAL.Business.Models.AspiranteViewModel asp)
    {
        <div class="alert alert-light-info mb-4" role="status">
            <i class="bi bi-list-ol mr-1" aria-hidden="true"></i>
            <strong>Matrícula desde la lista de espera: @asp.Aspirante</strong> (cupo ofrecido en @asp.Cun_Descripcion).
            Los datos que ya se anotaron vienen cargados; complete lo que falta. Al confirmar, el aspirante quedará como matriculado.
            <a href="@Url.Action("Aspirante", "ListaEspera", new { id = asp.Asp_Id })" class="ml-1">Volver al aspirante</a>
        </div>
    }
    else if (ViewBag.AspiranteAviso is string avisoAsp)
    {
        <div class="alert alert-light-warning mb-4" role="alert">
            <i class="fas fa-exclamation-triangle mr-1" aria-hidden="true"></i> @avisoAsp
            <a href="@Url.Action("Index", "ListaEspera")" class="ml-1">Ir a la lista de espera</a>
        </div>
    }

    <ul class="mat-steps" id="matSteps">
        <li data-step="1" class="active"><span class="mat-step-num">1</span><br>Datos del alumno</li>
        <li data-step="2"><span class="mat-step-num">2</span><br>Encargado</li>
        <li data-step="3"><span class="mat-step-num">3</span><br>Documentos</li>
        <li data-step="4"><span class="mat-step-num">4</span><br>Confirmación</li>
    </ul>

    <div class="statbox widget box box-shadow">
        <!-- ================= PASO 1 ================= -->
        <div class="mat-panel active" data-panel="1">
            <h5 class="mb-3"><i class="fas fa-id-card text-primary mr-2"></i>Datos personales del alumno</h5>
            <div class="row">
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>Identidad <span class="text-danger">*</span></label>
                    <input type="text" id="Per_Identidad" name="Per_Identidad" class="form-control" maxlength="15" placeholder="0801-2000-12345" data-req data-len="13" autocomplete="off">
                    <div class="invalid-feedback">Ingrese los 13 dígitos de identidad.</div>
                    <small class="form-text text-muted" id="identidadAviso"></small>
                </div>
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>Primer nombre <span class="text-danger">*</span></label>
                    <input type="text" id="Per_PrimerNombre" name="Per_PrimerNombre" class="form-control" data-req>
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>Segundo nombre</label>
                    <input type="text" id="Per_SegundoNombre" name="Per_SegundoNombre" class="form-control">
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>Apellido paterno <span class="text-danger">*</span></label>
                    <input type="text" id="Per_ApellidoPaterno" name="Per_ApellidoPaterno" class="form-control" data-req>
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>Apellido materno</label>
                    <input type="text" id="Per_ApellidoMaterno" name="Per_ApellidoMaterno" class="form-control">
                </div>
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>Fecha de nacimiento <span class="text-danger">*</span></label>
                    <input type="date" id="Per_FechaNacimiento" name="Per_FechaNacimiento" class="form-control" data-req>
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>Sexo <span class="text-danger">*</span></label>
                    <select id="Per_Sexo" name="Per_Sexo" class="custom-select" data-req>
                        <option value="">-- Seleccionar --</option>
                        <option value="M">Masculino</option>
                        <option value="F">Femenino</option>
                    </select>
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>Teléfono <span class="text-danger">*</span></label>
                    <input type="text" id="Per_Telefono" name="Per_Telefono" class="form-control" maxlength="9" placeholder="98765432" data-req>
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>Correo electrónico <span class="text-danger">*</span></label>
                    <input type="email" id="Per_CorreoElectronico" name="Per_CorreoElectronico" class="form-control" placeholder="alumno@correo.com" data-req>
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 form-group mat-field" data-field>
                    <label>Dirección <span class="text-danger">*</span></label>
                    <input type="text" id="Per_Direccion" name="Per_Direccion" class="form-control" placeholder="Barrio, referencia" data-req>
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
            </div>

            <hr />
            <h5 class="mb-3"><i class="fas fa-layer-group text-primary mr-2"></i>Ubicación académica</h5>
            <div class="alert alert-light-info mb-3">
                <i class="fas fa-circle-info mr-1"></i> Seleccione en cascada: cada nivel habilita el siguiente
                (Nivel → Grado → Modalidad → Curso → Sección → Estado).
            </div>
            @{
                var aniosInscripcion = ViewBag.AniosInscripcion as System.Collections.Generic.List<GESTION_COLEGIAL.Business.Models.AnioInscripcionViewModel>
                    ?? new System.Collections.Generic.List<GESTION_COLEGIAL.Business.Models.AnioInscripcionViewModel>();
                int aniSeleccionado = (int)(ViewBag.AnioSeleccionado ?? 0);
                bool anioFijo = (bool)(ViewBag.AnioFijo ?? false);
            }
            <div class="row">
                <div class="col-md-4 form-group mat-field" data-field>
                    <label for="Ani_Id">Año de inscripción <span class="text-danger">*</span></label>
                    <select id="Ani_Id" name="Ani_Id" class="custom-select" disabled="@anioFijo" data-req="true">
                        @if (aniSeleccionado == 0)
                        {
                            <option value="" selected>-- Elija el año --</option>
                        }
                        @foreach (var a in aniosInscripcion)
                        {
                            <option value="@a.Ani_Id" selected="@(a.Ani_Id == aniSeleccionado)">@a.Ani_Nombre (@(a.EsActivo ? "activo" : a.Ani_EstadoTexto.ToLower()))</option>
                        }
                    </select>
                    <small class="form-text text-muted" id="aniAviso">@(anioFijo ? "El aspirante aspira a este año." : aniSeleccionado == 0 ? "El año activo ya no admite matrículas: elija el año en que va a inscribir." : "Por defecto el año activo. Para inscribir en el año siguiente, ese año debe tener sus secciones creadas.")</small>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>1 · Nivel educativo <span class="text-danger">*</span></label>
                    @Html.DropDownList("Niv_Id", Model.NivelesEducativosList, "-- Seleccionar Nivel --", new { @class = "custom-select", data_req = "true" })
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>2 · Grado académico <span class="text-danger">*</span></label>
                    <select id="Cun_Id" name="Cun_Id" class="custom-select" data-req disabled>
                        <option value="">-- Seleccione el nivel primero --</option>
                    </select>
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>3 · Modalidad <span class="text-danger">*</span></label>
                    <select id="Mda_Id" name="Mda_Id" class="custom-select" data-req disabled>
                        <option value="">-- Seleccione el grado primero --</option>
                    </select>
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>4 · Curso <span class="text-danger">*</span></label>
                    <select id="Cur_Id" name="Cur_Id" class="custom-select" data-req disabled>
                        <option value="">-- Seleccione la modalidad primero --</option>
                    </select>
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>5 · Sección <span class="text-danger">*</span></label>
                    <select id="Sec_Id" name="Sec_Id" class="custom-select" data-req disabled>
                        <option value="">-- Seleccione el curso primero --</option>
                    </select>
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
                <div class="col-md-4 form-group mat-field" data-field>
                    <label>6 · Estado <span class="text-danger">*</span></label>
                    @Html.DropDownList("Est_Id", Model.EstadosList, "-- Seleccionar Estado --", new { @class = "custom-select", data_req = "true" })
                    <div class="invalid-feedback">Campo requerido.</div>
                </div>
            </div>

            <div id="matCupoAviso" class="alert d-none mb-3" role="status"></div>

            @* Ocultos que el AlumnoViewModel necesita al crear *@
            <input type="hidden" id="Alu_Id" name="Alu_Id" value="0" />
            <input type="hidden" id="Per_Id" name="Per_Id" value="0" />
            <input type="hidden" id="Per_EsActivo" name="Per_EsActivo" value="true" />
        </div>

        <!-- ================= PASO 2 ================= -->
        <div class="mat-panel" data-panel="2">
            <h5 class="mb-3"><i class="fas fa-user-shield text-primary mr-2"></i>Encargado del alumno</h5>
            <p class="text-muted small mb-3">Vincule un encargado ya registrado o cree uno nuevo, e indique el parentesco.</p>

            <div class="d-flex flex-wrap mb-3">
                <div class="btn btn-outline-primary text-left mr-2 mb-2 mat-toggle-btn active" data-enc-mode="existente">
                    <strong class="d-block"><i class="fas fa-user-check mr-1"></i> Vincular existente</strong>
                    <small>Buscar un encargado ya registrado.</small>
                </div>
                <div class="btn btn-outline-primary text-left mb-2 mat-toggle-btn" data-enc-mode="nuevo">
                    <strong class="d-block"><i class="fas fa-user-plus mr-1"></i> Registrar nuevo</strong>
                    <small>Dar de alta un encargado nuevo.</small>
                </div>
            </div>


            <!-- Modo existente -->
            <div id="encExistente">
                <div class="row">
                    <div class="col-md-8 form-group mat-field" data-field data-group="enc-existente">
                        <label>Encargado registrado <span class="text-danger">*</span></label>
                        <select id="encExistenteSel" class="custom-select">
                            <option value="">-- Seleccionar encargado --</option>
                        </select>
                        <div class="invalid-feedback">Seleccione un encargado.</div>
                    </div>
                    <div class="col-md-4 form-group mat-field" data-field data-group="enc-existente">
                        <label>Parentesco <span class="text-danger">*</span></label>
                        <select id="parExistenteSel" class="custom-select mat-par">
                            <option value="">-- Seleccionar --</option>
                        </select>
                        <div class="invalid-feedback">Seleccione el parentesco.</div>
                    </div>
                </div>
            </div>

            <!-- Modo nuevo -->
            <div id="encNuevo" style="display:none;">
                <div class="row">
                    <div class="col-md-4 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Identidad <span class="text-danger">*</span></label>
                        <input type="text" id="enc_Per_Identidad" class="form-control" maxlength="15" placeholder="0801-1980-12345" data-req-enc autocomplete="off">
                        <div class="invalid-feedback">Campo requerido (13 dígitos).</div>
                    </div>
                    <div class="col-md-4 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Primer nombre <span class="text-danger">*</span></label>
                        <input type="text" id="enc_Per_PrimerNombre" class="form-control" data-req-enc>
                        <div class="invalid-feedback">Campo requerido.</div>
                    </div>
                    <div class="col-md-4 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Segundo nombre</label>
                        <input type="text" id="enc_Per_SegundoNombre" class="form-control">
                        <div class="invalid-feedback">Campo requerido.</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Apellido paterno <span class="text-danger">*</span></label>
                        <input type="text" id="enc_Per_ApellidoPaterno" class="form-control" data-req-enc>
                        <div class="invalid-feedback">Campo requerido.</div>
                    </div>
                    <div class="col-md-4 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Apellido materno</label>
                        <input type="text" id="enc_Per_ApellidoMaterno" class="form-control">
                        <div class="invalid-feedback">Campo requerido.</div>
                    </div>
                    <div class="col-md-4 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Fecha de nacimiento <span class="text-danger">*</span></label>
                        <input type="date" id="enc_Per_FechaNacimiento" class="form-control" data-req-enc>
                        <div class="invalid-feedback">Campo requerido.</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Sexo <span class="text-danger">*</span></label>
                        <select id="enc_Per_Sexo" class="custom-select" data-req-enc>
                            <option value="">-- Seleccionar --</option>
                            <option value="M">Masculino</option>
                            <option value="F">Femenino</option>
                        </select>
                        <div class="invalid-feedback">Campo requerido.</div>
                    </div>
                    <div class="col-md-4 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Teléfono <span class="text-danger">*</span></label>
                        <input type="text" id="enc_Per_Telefono" class="form-control" maxlength="9" data-req-enc>
                        <div class="invalid-feedback">Campo requerido.</div>
                    </div>
                    <div class="col-md-4 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Correo electrónico <span class="text-danger">*</span></label>
                        <input type="email" id="enc_Per_CorreoElectronico" class="form-control" data-req-enc>
                        <div class="invalid-feedback">Campo requerido.</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Dirección <span class="text-danger">*</span></label>
                        <input type="text" id="enc_Per_Direccion" class="form-control" data-req-enc>
                        <div class="invalid-feedback">Campo requerido.</div>
                    </div>
                    <div class="col-md-3 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Ocupación <span class="text-danger">*</span></label>
                        <input type="text" id="enc_Enc_Ocupacion" class="form-control" data-req-enc>
                        <div class="invalid-feedback">Campo requerido.</div>
                    </div>
                    <div class="col-md-3 form-group mat-field" data-field data-group="enc-nuevo">
                        <label>Parentesco <span class="text-danger">*</span></label>
                        <select id="parNuevoSel" class="custom-select mat-par">
                            <option value="">-- Seleccionar --</option>
                        </select>
                        <div class="invalid-feedback">Seleccione el parentesco.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= PASO 3 ================= -->
        <div class="mat-panel" data-panel="3">
            <h5 class="mb-3"><i class="fas fa-folder-open text-primary mr-2"></i>Checklist de documentos requeridos</h5>
            <p class="text-muted small mb-3">Marque los documentos entregados. El seguimiento formal se realiza en la pantalla Documentos del alumno.</p>

            <div class="alert alert-light-warning mb-3">
                <i class="fas fa-triangle-exclamation mr-1"></i>
                <strong>Nota:</strong> el API no genera aún la lista de documentos requeridos para un alumno
                nuevo. Este checklist es de referencia y no se persiste. Tras crear la matrícula podrá gestionar
                los documentos reales en <em>Documentos del alumno</em>.
            </div>

            <div id="matDocsList">
                <div class="custom-control custom-checkbox border rounded py-2 pr-3 mb-2 d-flex align-items-center mat-doc-item">
                    <input type="checkbox" class="custom-control-input mat-doc-check" id="matDoc1" data-doc="Partida de nacimiento">
                    <label class="custom-control-label font-weight-bold" for="matDoc1">Partida de nacimiento</label>
                    <span class="badge outline-badge-danger ml-auto">Requerido</span>
                </div>
                <div class="custom-control custom-checkbox border rounded py-2 pr-3 mb-2 d-flex align-items-center mat-doc-item">
                    <input type="checkbox" class="custom-control-input mat-doc-check" id="matDoc2" data-doc="Tarjeta de identidad del encargado">
                    <label class="custom-control-label font-weight-bold" for="matDoc2">Tarjeta de identidad del encargado</label>
                    <span class="badge outline-badge-danger ml-auto">Requerido</span>
                </div>
                <div class="custom-control custom-checkbox border rounded py-2 pr-3 mb-2 d-flex align-items-center mat-doc-item">
                    <input type="checkbox" class="custom-control-input mat-doc-check" id="matDoc3" data-doc="Certificado de estudios previos">
                    <label class="custom-control-label font-weight-bold" for="matDoc3">Certificado de estudios previos</label>
                    <span class="badge outline-badge-danger ml-auto">Requerido</span>
                </div>
                <div class="custom-control custom-checkbox border rounded py-2 pr-3 mb-2 d-flex align-items-center mat-doc-item">
                    <input type="checkbox" class="custom-control-input mat-doc-check" id="matDoc4" data-doc="Constancia de conducta">
                    <label class="custom-control-label font-weight-bold" for="matDoc4">Constancia de conducta</label>
                    <span class="badge outline-badge-secondary ml-auto">Opcional</span>
                </div>
                <div class="custom-control custom-checkbox border rounded py-2 pr-3 mb-2 d-flex align-items-center mat-doc-item">
                    <input type="checkbox" class="custom-control-input mat-doc-check" id="matDoc5" data-doc="Fotografías tamaño carné">
                    <label class="custom-control-label font-weight-bold" for="matDoc5">Fotografías tamaño carné</label>
                    <span class="badge outline-badge-secondary ml-auto">Opcional</span>
                </div>
            </div>
        </div>

        <!-- ================= PASO 4 ================= -->
        <div class="mat-panel" data-panel="4">
            <h5 class="mb-3"><i class="fas fa-clipboard-check text-primary mr-2"></i>Resumen de confirmación</h5>
            <p class="text-muted small mb-3">Revise los datos antes de guardar la matrícula.</p>

            <div class="row mat-summary-grid">
                <div class="col-md-6 mb-3"><div class="border rounded p-3 h-100" id="sumAlumno">
                    <h6 class="text-primary font-weight-bold"><i class="fas fa-user mr-1"></i> Alumno</h6>
                </div></div>
                <div class="col-md-6 mb-3"><div class="border rounded p-3 h-100" id="sumAcademico">
                    <h6 class="text-primary font-weight-bold"><i class="fas fa-layer-group mr-1"></i> Ubicación académica</h6>
                </div></div>
                <div class="col-md-6 mb-3"><div class="border rounded p-3 h-100" id="sumEncargado">
                    <h6 class="text-primary font-weight-bold"><i class="fas fa-user-shield mr-1"></i> Encargado</h6>
                </div></div>
                <div class="col-md-6 mb-3"><div class="border rounded p-3 h-100" id="sumDocumentos">
                    <h6 class="text-primary font-weight-bold"><i class="fas fa-folder-open mr-1"></i> Documentos marcados</h6>
                </div></div>
            </div>

            <div id="matResultado" style="display:none;"></div>
        </div>

        <!-- ================= NAV ================= -->
        <div class="d-flex justify-content-between mt-4" id="matNav">
            <button type="button" class="btn btn-outline-secondary" id="btnPrev" hidden><i class="fas fa-arrow-left mr-1"></i> Anterior</button>
            <div class="flex-grow-1"></div>
            <button type="button" class="btn btn-primary" id="btnNext">Siguiente <i class="fas fa-arrow-right ml-1"></i></button>
            <button type="button" class="btn btn-success ml-2" id="btnConfirm" hidden><i class="fas fa-check mr-1"></i> Confirmar matrícula</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/pages/matricula.js"></script>
    <script>
        Matricula.init({
            urlGrados:       "@Url.Action("GetGradosAsync", "Matricula")",
            urlModalidades:  "@Url.Action("GetModalidadesAsync", "Matricula")",
            urlCursos:       "@Url.Action("GetCursosAsync", "Matricula")",
            urlSecciones:    "@Url.Action("GetSeccionesAsync", "Matricula")",
            urlBuscarAlumno: "@Url.Action("BuscarAlumnoPorIdentidadAsync", "Matricula")",
            urlEncargados:   "@Url.Action("ListarEncargadosAsync", "Matricula")",
            urlParentescos:  "@Url.Action("ListarParentescosAsync", "Matricula")",
            urlGuardarEnc:   "@Url.Action("GuardarEncargadoAsync", "Matricula")",
            urlVincularEnc:  "@Url.Action("VincularEncargadoAsync", "Matricula")",
            urlGuardarAlu:   "@Url.Action("GuardarAlumnoAsync", "Matricula")",
            urlVerificarCupo: "@Url.Action("VerificarCupoAsync", "AnioConexion")",
            urlDocumentos:   "@Url.Action("Index", "DocumentosAlumnoAdm")",
            urlAlumnos:      "@Url.Action("Index", "Alumnos")",
            aspirante:       @Html.Raw(ViewBag.AspiranteJson ?? "null")
        });
    </script>
}
