@{
    ViewBag.Title = "Cartera";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/pages/finanzas-dashboard.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Módulo Financiero</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cartera</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Cartera</h4>
        <p class="text-muted mb-0">Panorama unificado de la deuda: antigüedad, morosidad por nivel, mayores deudores y cuentas pendientes</p>
    </div>
    <div class="mt-2 mt-md-0">
        <button type="button" class="btn btn-primary" id="cartera-btn-solicitar">
            <i class="fa-solid fa-paper-plane mr-1"></i> Solicitar cobro
        </button>
    </div>
</div>

<!-- ══════════ KPIs — datos de /PendientesCobrar/ListAsync ══════════ -->
<div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-primary" id="cartera-kpi-total">L. 0.00</h6>
                        <p>Total por cobrar</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="cartera-kpi-total-sub">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-danger" id="cartera-kpi-vencido">L. 0.00</h6>
                        <p>Vencido</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-calendar-x"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="cartera-kpi-vencido-sub">—</span></p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-success" id="cartera-kpi-recuperacion">0%</h6>
                        <p>% Recuperación</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-graph-up-arrow"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2">Pagado sobre lo emitido</p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-warning" id="cartera-kpi-alumnos">0</h6>
                        <p>Alumnos deudores</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-people"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2"><span id="cartera-kpi-alumnos-sub">—</span></p>
            </div>
        </div>
    </div>
</div>

<!-- ══════════ Pestañas ══════════ -->
<ul class="nav nav-tabs mb-4" id="cartera-tabs" role="tablist">
        <li class="nav-item cartera-tab-item active" data-tab="nivel">
            <a href="#" class="nav-link active"><i class="fa-solid fa-chart-bar mr-1"></i> Por nivel</a>
        </li>
        <li class="nav-item cartera-tab-item" data-tab="aging">
            <a href="#" class="nav-link"><i class="fa-solid fa-clock-rotate-left mr-1"></i> Antigüedad de saldos</a>
        </li>
        <li class="nav-item cartera-tab-item" data-tab="top">
            <a href="#" class="nav-link"><i class="fa-solid fa-ranking-star mr-1"></i> Top deudores</a>
        </li>
        <li class="nav-item cartera-tab-item" data-tab="pend">
            <a href="#" class="nav-link"><i class="fa-solid fa-list-check mr-1"></i> Pendientes</a>
        </li>
</ul>

<!-- ══════════ TAB 1: Resumen / Aging — /AgingCuentas/ListAsync ══════════ -->
    <div id="tab-aging" class="cartera-tab-panel" style="display:none">
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-header">
                <div class="d-flex flex-wrap align-items-center justify-content-between pr-3">
                    <div>
                        <h4><i class="fa-solid fa-hourglass-half mr-1"></i> Antigüedad de saldos</h4>
                        <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Saldo pendiente agrupado por tramo de vencimiento</p>
                    </div>
                    <span class="badge outline-badge-primary mb-2" id="cartera-aging-chip">—</span>
                </div>
            </div>
            <div class="widget-content widget-content-area">
                <div class="fd-aging-row" id="cartera-aging-row"></div>
            </div>
        </div>

        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-header">
                <div class="row">
                    <div class="col-12">
                        <h4><i class="fa-solid fa-table-list mr-1"></i> Detalle por alumno y tramo</h4>
                        <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Origen: Aging de Cuentas por Cobrar</p>
                    </div>
                </div>
            </div>
            <div class="widget-content widget-content-area p-0 fd-scroll">
                <table class="table table-hover mb-0" id="cartera-aging-table">
                    <thead>
                        <tr>
                            <th>Alumno</th>
                            <th>Tramo</th>
                            <th class="text-right">Monto</th>
                            <th class="text-right">Días</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ══════════ TAB 2: Drill-down Curso → Sección → Alumnos (desde PendientesCobrar) ══════════ -->
    <div id="tab-nivel" class="cartera-tab-panel">
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-header">
                <div class="d-flex flex-wrap align-items-center justify-content-between pr-3">
                    <div>
                        <h4><i class="fa-solid fa-layer-group mr-1"></i> Deuda por curso y sección</h4>
                        <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Clic en una fila para desglosar: curso → sección → alumnos</p>
                    </div>
                    <span class="badge outline-badge-primary mb-2" id="cartera-drill-chip">—</span>
                </div>
            </div>
            <div class="widget-content widget-content-area p-0 fd-scroll">
                <div id="cartera-drill" class="cartera-drill"></div>
            </div>
        </div>
    </div>

    <!-- ══════════ TAB 3: Top Deudores — /TopDeudores/ListAsync ══════════ -->
    <div id="tab-top" class="cartera-tab-panel" style="display:none">
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-header">
                <div class="d-flex flex-wrap align-items-center justify-content-between pr-3">
                    <div>
                        <h4><i class="fa-solid fa-ranking-star mr-1"></i> Alumnos con mayor deuda</h4>
                        <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Ordenado por deuda total acumulada</p>
                    </div>
                    <span class="badge outline-badge-primary mb-2" id="cartera-top-chip">0 alumnos</span>
                </div>
            </div>
            <div class="widget-content widget-content-area p-0" id="cartera-top-rank"></div>
        </div>
    </div>

    <!-- ══════════ TAB 4: Pendientes — /PendientesCobrar/ListAsync ══════════ -->
    <div id="tab-pend" class="cartera-tab-panel" style="display:none">

        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-content widget-content-area">
                <div class="form-row">
                    <div class="form-group col-md-4 mb-md-0">
                        <label for="cartera-pend-buscar">Buscar alumno o concepto</label>
                        <input type="text" id="cartera-pend-buscar" class="form-control" placeholder="Escriba para filtrar..." />
                    </div>
                    <div class="form-group col-md-4 mb-md-0">
                        <label for="cartera-pend-estado">Estado</label>
                        <select id="cartera-pend-estado" class="custom-select">
                    <option value="">Todos los estados</option>
                    <option value="vencido">Solo vencidos</option>
                    <option value="hoy">Vencen hoy</option>
                    <option value="proximo">Próximos a vencer</option>
                        </select>
                    </div>
                    <div class="form-group col-md-4 mb-md-0">
                        <label for="cartera-pend-concepto">Concepto</label>
                        <select id="cartera-pend-concepto" class="custom-select">
                    <option value="">Todos los conceptos</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6 col-12 layout-spacing"><div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                <div class="d-flex flex-wrap align-items-center justify-content-between pr-3">
                    <div>
                        <h4><i class="fa-solid fa-hourglass-half mr-1"></i> Antigüedad de saldos</h4>
                        <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Distribución por rango de días vencidos</p>
                    </div>
                    <span class="badge outline-badge-danger mb-2" id="cartera-pend-criticas">—</span>
                </div>
            </div>
                <div class="widget-content widget-content-area">
                    <div class="fd-aging-row" id="cartera-pend-aging"></div>
                </div>
            </div></div>
            <div class="col-lg-6 col-12 layout-spacing"><div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                <div class="row">
                    <div class="col-12">
                        <h4><i class="fa-solid fa-tags mr-1"></i> Conceptos pendientes</h4>
                        <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Participación sobre la cartera filtrada</p>
                    </div>
                </div>
            </div>
                <div class="widget-content widget-content-area">
                    <div class="fd-bar-list" id="cartera-pend-conceptos"></div>
                </div>
            </div></div>
        </div>

        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-header">
                <div class="d-flex flex-wrap align-items-center justify-content-between pr-3">
                    <div>
                        <h4><i class="fa-solid fa-list-check mr-1"></i> Detalle de cuentas pendientes</h4>
                        <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Priorizado por días de vencimiento</p>
                    </div>
                    <span class="badge outline-badge-primary mb-2" id="cartera-pend-count">0 cuentas</span>
                </div>
            </div>
            <div class="widget-content widget-content-area p-0 fd-scroll" id="cartera-pend-feed"></div>
        </div>
    </div>

@* ══════════ Modal: Solicitar cobro (correo simulado a encargados) ══════════ *@
<div class="modal fade" id="cartera-modal-solicitar" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title"><i class="fa-solid fa-paper-plane mr-1"></i> Solicitar cobro</h5>
                    <p class="small text-muted mb-0">Envía un recordatorio de pago por correo a los encargados</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div id="sc-form">
                    <label class="font-weight-bold">¿A quién le solicitamos el cobro?</label>
                    <div class="sc-scope-grid">
                        <div class="sc-scope active" data-scope="todos">
                            <div class="sc-scope-num" id="sc-num-todos">0</div>
                            <div class="sc-scope-lbl">Todos los deudores</div>
                            <div class="sc-scope-monto" id="sc-monto-todos">L. 0.00</div>
                        </div>
                        <div class="sc-scope" data-scope="vencido">
                            <div class="sc-scope-num" id="sc-num-vencido">0</div>
                            <div class="sc-scope-lbl">Solo vencidos</div>
                            <div class="sc-scope-monto" id="sc-monto-vencido">L. 0.00</div>
                        </div>
                        <div class="sc-scope" data-scope="critico">
                            <div class="sc-scope-num" id="sc-num-critico">0</div>
                            <div class="sc-scope-lbl">Críticos +90d</div>
                            <div class="sc-scope-monto" id="sc-monto-critico">L. 0.00</div>
                        </div>
                    </div>

                    <p class="small text-muted text-uppercase font-weight-bold mb-1">Vista previa del correo</p>
                    <div class="sc-preview" id="sc-preview"></div>

                    <div class="alert alert-light-warning mt-3 mb-0">
                        <i class="fa-solid fa-circle-info mr-1"></i>
                        <strong>Simulación:</strong> este proyecto no tiene servidor de correo configurado. Se registrará la solicitud y se mostrará el resumen, pero <strong>no se envía ningún correo real</strong>.
                    </div>
                </div>

                <div id="sc-result" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal" id="sc-btn-cerrar">Cancelar</button>
                <button type="button" class="btn btn-primary" id="sc-btn-enviar">
                    <i class="fa-solid fa-paper-plane"></i> Enviar recordatorios
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/cartera.js" asp-append-version="true"></script>
    <script>
        Cartera.init({
            urlAging: "@Url.Action("ListAsync", "AgingCuentas")",
            urlNivel: "@Url.Action("ListAsync", "MorosidadPorNivel")",
            urlTop:   "@Url.Action("ListAsync", "TopDeudores")",
            urlPend:  "@Url.Action("PendientesAsync", "Cartera")",
            urlNuevoPago: "@Url.Action("NuevoPago", "Pagos")",
            urlEstadoCuenta: "@Url.Action("EstadoCuenta", "CuentasCobrar")"
        });
    </script>
}
