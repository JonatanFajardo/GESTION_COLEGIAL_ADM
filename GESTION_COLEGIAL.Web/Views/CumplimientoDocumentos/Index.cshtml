@{
    ViewBag.Title = "Cumplimiento de Documentos de Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* BREADCRUMB *@
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Cumplimiento de Documentos</li>
        </ol>
    </nav>
</div>

@* PAGE HEADER *@
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Cumplimiento de Documentos</h4>
        <p class="text-muted mb-0">Estado de entrega de documentos requeridos por empleado</p>
    </div>
</div>

<div class="fluid-container">

    @* SECCIÓN 1 — STATS GLOBALES *@
    <div id="cdoc-stats" class="row">
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="cdoc-stat-pct">—</h6>
                            <p>Cumplimiento Global</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-chart-pie"></i></div></div>
                    </div>
                    <div class="progress mt-2 mb-0">
                        <div id="cdoc-stat-progress" class="progress-bar bg-gradient-primary" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2"><span id="cdoc-stat-sub-global">documentos entregados sobre el total</span></p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="cdoc-stat-entregados">—</h6>
                            <p>Documentos Entregados</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-circle-check"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2">con confirmación de recepción</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="cdoc-stat-pendientes">—</h6>
                            <p>Documentos Pendientes</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-circle-xmark"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2">aún sin registrar entrega</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="cdoc-stat-vencidos">—</h6>
                            <p>Vencimientos</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-triangle-exclamation"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2"><span id="cdoc-stat-porvencer">—</span> por vencer (≤30 días)</p>
                </div>
            </div>
        </div>
    </div>

    @* SECCIÓN 2 — FILTRO *@
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="form-row align-items-center">
                <div class="col-md-5 col-sm-8 mb-2 mb-sm-0">
                    <select id="filter-empleado" class="custom-select">
                        <option value="">-- Todos los empleados --</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-4">
                    <button class="btn btn-primary w-100" id="btn-filtrar">
                        <i class="fa-solid fa-filter mr-1"></i> Filtrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* SECCIÓN 3 — TABS: INCOMPLETOS / COMPLETOS *@
    <ul class="nav nav-tabs mb-4" id="cdoc-tabs" role="tablist">
        <li class="nav-item cdoc-tab-item active" data-tab="incompletos" role="presentation">
            <a href="javascript:void(0);" class="nav-link active" role="tab">
                <i class="fa-solid fa-hourglass-half mr-1"></i>
                <span>Incompletos</span>
                <span class="badge badge-primary ml-1" id="cdoc-count-incompletos">0</span>
            </a>
        </li>
        <li class="nav-item cdoc-tab-item" data-tab="completos" role="presentation">
            <a href="javascript:void(0);" class="nav-link" role="tab">
                <i class="fa-solid fa-circle-check mr-1"></i>
                <span>Completos</span>
                <span class="badge badge-success ml-1" id="cdoc-count-completos">0</span>
            </a>
        </li>
    </ul>

    @* GRIDS DE EMPLEADOS (tarjetas inyectadas por JS) *@
    <div id="cdoc-grid-incompletos" class="row"></div>
    <div id="cdoc-grid-completos" class="row" hidden></div>

</div>

@* MODAL — Registrar / actualizar documento *@
<div class="modal fade" id="cdoc-modal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cdoc-modal-title">Documento</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="cdoc-form">
                <div class="modal-body">
                    <input type="hidden" id="cdoc-emp-id" />
                    <input type="hidden" id="cdoc-documento" />
                    <p class="mb-2"><strong id="cdoc-modal-emp"></strong></p>
                    <div class="form-group">
                        <label>Fecha de entrega <small class="text-muted">(dejar vacío si aún no se entrega)</small></label>
                        <input type="date" id="cdoc-fecha-entrega" class="form-control" />
                        <small class="form-text text-muted">Al registrar una fecha de entrega el documento se marca como entregado automáticamente.</small>
                    </div>
                    <div class="form-group">
                        <label>Fecha de vencimiento <small class="text-muted">(dejar vacío si no vence)</small></label>
                        <input type="date" id="cdoc-fecha-vencimiento" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Observación</label>
                        <textarea id="cdoc-observacion" class="form-control" rows="2"></textarea>
                    </div>
                    <div id="cdoc-form-error" class="text-danger small font-weight-bold" style="display:none;"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/cumplimientodocumentos.js"></script>
    <script>
        CumplimientoDocumentos.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("EmpleadosDropdownAsync")",
            "@Url.Action("MarcarEntregadoAsync")"
        );
    </script>
}
