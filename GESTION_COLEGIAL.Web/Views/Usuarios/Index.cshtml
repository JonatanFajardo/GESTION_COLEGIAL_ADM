@model GESTION_COLEGIAL.Business.Models.UsuarioViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
}


<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Usuarios</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Gestion de Usuarios</h4>
        <p class="text-muted mb-0">Administre los usuarios y sus roles de acceso al sistema</p>
    </div>
    <div class="mt-2 mt-md-0">
        <button class="btn btn-primary" id="add-btn-header" data-toggle="modal" data-target="#edit-modal">
            <i class="bi bi-plus-lg mr-1"></i>
            Nuevo Usuario
        </button>
    </div>
</div>

<div class="fluid-container">
    @* Listado *@
    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Listado de Usuarios</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Gestion de Usuario</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            @using (Ajax.BeginForm("CreateAsync", "Usuarios", new AjaxOptions
            {
                HttpMethod = "Post",
                OnBegin = "Catalogs.begin",
                OnComplete = "Catalogs.complete",
                OnFailure = "Catalogs.failure",
                OnSuccess = "Catalogs.success"

            }))
            {
            <div class="fluid-container">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                @Html.HiddenFor(model => model.Usu_Id, new { @id = "item-id" })
                <div class="modal-body">
                    <!-- Informacion Basica -->
                    <h6 class="font-weight-bold mb-3"></h6>

                    <div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>
                                        Nombre de Usuario
                                        <span class="text-danger">*</span>
                                    </label>
                                    @Html.EditorFor(model => model.Usu_Name, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej: jsmith" } })
                                    @Html.ValidationMessageFor(model => model.Usu_Name, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        Ingrese un nombre de usuario unico para el sistema
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>
                                        Rol
                                        <span class="text-danger">*</span>
                                    </label>
                                    @Html.DropDownListFor(model => model.Rol_Id, new SelectList(Enumerable.Empty<SelectListItem>()), "Seleccione un rol", new { @class = "custom-select", @id = "Rol_Id" })
                                    @Html.ValidationMessageFor(model => model.Rol_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>
                                        Empleado Id
                                    </label>
                                    @Html.EditorFor(model => model.Emp_Id, new { htmlAttributes = new { @class = "form-control", placeholder = "Id del empleado" } })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>
                                        Estado
                                    </label>
                                    <div class="d-flex align-items-center mt-2">
                                        <label class="switch s-outline s-outline-primary mb-0 mr-2">
                                            @Html.CheckBoxFor(model => model.Usu_EsActivo, new { @id = "Usu_EsActivo" })
                                            <span class="slider round"></span>
                                        </label>
                                        <label for="Usu_EsActivo" class="mb-0">Usuario activo</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z"/>
                        </svg>
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1H2z"/>
                        </svg>
                        Guardar Usuario
                    </button>
                </div>
            </div>
            }
        </div>
    </div>
</div>
<!-- Fin Modal -->
<!-- Modal Delete-->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        @using (Ajax.BeginForm("DeleteAsync", "Usuarios", new AjaxOptions
        {
            HttpMethod = "Post",
            OnBegin = "Catalogs.begin",
            OnComplete = "Catalogs.complete",
            OnFailure = "Catalogs.failure",
            OnSuccess = "Catalogs.success"
        }))
        {
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalTitle">Eliminar usuario</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body text-center">
                @Html.HiddenFor(model => model.Usu_Id, new { @id = "delete-item-id" })
                <i class="fas fa-exclamation-triangle text-danger h1 d-block mb-3"></i>
                <p>¿Está seguro de que desea eliminar el usuario <span id="delete-item-name" class="font-weight-bold"></span>?</p>
                <div class="alert alert-light-danger text-left mb-0">
                    <p class="font-weight-bold mb-1"><i class="fas fa-exclamation-triangle mr-1"></i> Esta accion no se puede deshacer</p>
                    <p class="mb-0">El registro sera eliminado permanentemente del sistema.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger">Eliminar</button>
            </div>
        </div>
        }
    </div>
</div>
<!-- Fin Modal -->

    <!-- Modal Detalle -->
    <div class="modal fade" id="detail-modal" tabindex="-1" role="dialog" aria-labelledby="detailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="detailModalLabel">
                        <i class="fas fa-file-alt mr-1"></i>
                        Detalle del Usuario
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="modal-body">
                    <div class="form-row">
                        <div class="col-6 mb-3"><p class="text-muted small mb-0">ID</p><p class="font-weight-bold mb-0" id="detail-usu-id"></p></div>
                        <div class="col-6 mb-3"><p class="text-muted small mb-0">Nombre de Usuario</p><p class="font-weight-bold mb-0" id="detail-usu-name"></p></div>
                        <div class="col-6 mb-3"><p class="text-muted small mb-0">Rol</p><p class="font-weight-bold mb-0" id="detail-rol-descripcion"></p></div>
                        <div class="col-6 mb-3"><p class="text-muted small mb-0">Estado</p><p class="font-weight-bold mb-0" id="detail-usu-esactivo"></p></div>
                    </div>
                    <h6 class="font-weight-bold border-top pt-3 mb-3"><i class="fas fa-history mr-1"></i> Informacion de Auditoria</h6>
                    <div class="form-row">
                        <div class="col-6"><p class="text-muted small mb-0"><i class="fas fa-calendar text-success mr-1"></i>Fecha de creacion</p><p class="font-weight-bold mb-0" id="detail-usu-fechacreacion"></p></div>
                        <div class="col-6"><p class="text-muted small mb-0"><i class="fas fa-calendar text-info mr-1"></i>Fecha de modificacion</p><p class="font-weight-bold mb-0" id="detail-usu-fechamodificacion"></p></div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Fin Modal Detalle -->

@section Scripts{
    <script src="~/Content/js/pages/usuarios.js"></script>
    <script>
        Usuarios.datatableCatalogs({
            urlList: "@Url.Action("ListAsync")",
            urlDetail: "@Url.Action("DetailAsync")"
        });
    </script>
    <script>
        Catalogs.configure({
            displayName: "usuarios",
            urlUpdate: "@Url.Action("FindAsync")"
        });
        CatalogsCfg.configure({
            displayName: "usuario",
            getUrl: "@Url.Action("DetailAsync")"
        });
    </script>
    <script>
        // Cargar roles en el dropdown al abrir el modal
        $('#edit-modal').on('show.bs.modal', function () {
            $.ajax({
                url: "@Url.Action("RolesDropdownAsync")",
                type: "GET",
                dataType: "json",
                success: function (data) {
                    var dropdown = $('#Rol_Id');
                    var currentVal = dropdown.val();
                    dropdown.find('option:not(:first)').remove();
                    if (data && data.data) {
                        $.each(data.data, function (i, item) {
                            dropdown.append($('<option></option>').val(item.Rol_Id).text(item.Rol_Descripcion));
                        });
                    }
                    if (currentVal) {
                        dropdown.val(currentVal);
                    }
                }
            });
        });
    </script>
}
