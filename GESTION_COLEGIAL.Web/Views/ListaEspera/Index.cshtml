@model GESTION_COLEGIAL.UI.Models.ListaEsperaIndexViewModel
@using GESTION_COLEGIAL.Business.Models
@{
    ViewBag.Title = "Lista de espera";
    var M = Model;
}

@section Styles{
    <link href="~/css/pages/lista-espera.css" rel="stylesheet" asp-append-version="true" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item">Alumnos</li>
            <li class="breadcrumb-item active" aria-current="page">Lista de espera</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Lista de espera</h4>
        <p class="text-muted mb-0">Aspirantes que esperan cupo, en el orden de la cola de cada grado.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center mt-2 mt-md-0">
        <label for="lde-anio" class="mb-0 mr-2 text-muted small">Año lectivo</label>
        <select id="lde-anio" class="custom-select w-auto mr-2">
            @foreach (var a in M.Anios)
            {
                <option value="@a.Ani_Id" selected="@(a.Ani_Id == M.AniId)">@a.Ani_Nombre@(a.EsActivo ? " (activo)" : "")</option>
            }
        </select>
        @if (M.PuedeGestionar && M.AdmiteRegistro)
        {
            <a class="btn btn-primary" href="@Url.Action("Registrar", new { anio = M.AniId })">
                <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i> Nuevo aspirante
            </a>
        }
    </div>
</div>

<div id="lde-lista" data-anio="@M.AniId"
     data-url-lista="@Url.Action("ListAsync", new { aniId = M.AniId })"
     data-url-resumen="@Url.Action("ResumenAsync", new { aniId = M.AniId })"
     data-url-grados="@Url.Action("GradosAsync")" data-url-modalidades="@Url.Action("ModalidadesAsync")"
     data-url-estado="@Url.Action("CambiarEstadoAsync")" data-url-aspirante="@Url.Action("Aspirante")"
     data-url-matricula="@Url.Action("Index", "Matricula")"
     data-gestionar="@(M.PuedeGestionar ? "1" : "0")" data-matricular="@(M.PuedeMatricular && M.EsAnioActivo ? "1" : "0")">
    @Html.AntiForgeryToken()

    @if (M.PuedeMatricular && !M.EsAnioActivo)
    {
        <div class="alert alert-light-info mb-4" role="status">
            <i class="bi bi-info-circle mr-1" aria-hidden="true"></i>
            La matrícula se hace en el año activo. Los aspirantes de @(M.Anio?.Ani_Nombre) se podrán matricular cuando ese año sea el activo; mientras tanto se pueden registrar, ordenar y recibir ofertas.
        </div>
    }

    @* ── Indicadores ── *@
    <div class="row">
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four lde-kpi lde-kpi-indigo">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-espera">—</h6>
                            <p>En espera</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2" id="kpi-espera-nota">&nbsp;</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four lde-kpi lde-kpi-ambar">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-ofertas">—</h6>
                            <p>Ofertas abiertas</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-envelope-paper" aria-hidden="true"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2">Cada oferta reserva un asiento</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four lde-kpi lde-kpi-esmeralda">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-matriculados">—</h6>
                            <p>Matriculados desde la lista</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-person-check" aria-hidden="true"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2" id="kpi-matriculados-nota">&nbsp;</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four lde-kpi lde-kpi-cian">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-libres">—</h6>
                            <p>Cupos libres</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-door-open" aria-hidden="true"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2" id="kpi-libres-nota">&nbsp;</p>
                </div>
            </div>
        </div>
    </div>

    @* ── Resumen por grado (Dirección) ── *@
    <section class="statbox widget box box-shadow mb-4" aria-labelledby="lde-resumen-titulo">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4 id="lde-resumen-titulo">Cupo y demanda por grado</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover mb-0 lde-resumen">
                    <thead>
                        <tr>
                            <th>Grado</th>
                            <th class="text-right">Cupo</th>
                            <th class="text-right">Matriculados</th>
                            <th class="text-right">Ofertas</th>
                            <th class="text-right">En espera</th>
                            <th class="text-right">Libres</th>
                            <th>Siguiente en la cola</th>
                        </tr>
                    </thead>
                    <tbody id="lde-resumen-cuerpo">
                        <tr><td colspan="7" class="text-center text-muted py-4">Cargando…</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="text-muted small mb-0 mt-3">
                Cupo = suma del cupo de las secciones del año. Ocupados = matriculados + ofertas abiertas.
                Si alguna sección del grado no tiene cupo, el grado queda <strong>sin definir</strong> y se puede ofrecer con advertencia.
            </p>
        </div>
    </section>

    @* ── La cola ── *@
    <section class="statbox widget box box-shadow mb-4" aria-labelledby="lde-cola-titulo">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4 id="lde-cola-titulo">Aspirantes</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <form class="form-row align-items-end mb-2" id="lde-filtros" aria-label="Filtrar aspirantes" onsubmit="return false;">
                <div class="col-sm-6 col-lg-3 form-group mb-2">
                    <label for="f-nivel" class="small text-muted mb-1">Nivel</label>
                    <select id="f-nivel" class="custom-select custom-select-sm">
                        <option value="">Todos los niveles</option>
                        @foreach (var n in M.Niveles)
                        {
                            <option value="@n.Value">@n.Text</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-2 form-group mb-2">
                    <label for="f-grado" class="small text-muted mb-1">Grado</label>
                    <select id="f-grado" class="custom-select custom-select-sm" disabled>
                        <option value="">Elija nivel</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-2 form-group mb-2">
                    <label for="f-modalidad" class="small text-muted mb-1">Modalidad</label>
                    <select id="f-modalidad" class="custom-select custom-select-sm" disabled>
                        <option value="">Elija grado</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3 form-group mb-2">
                    <label for="f-estado" class="small text-muted mb-1">Estado</label>
                    <select id="f-estado" class="custom-select custom-select-sm">
                        <option value="abiertos" selected>En espera y ofrecidos</option>
                        @foreach (var e in CatalogoAspirantes.Estados)
                        {
                            <option value="@e.Codigo">@e.Etiqueta</option>
                        }
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="col-lg-2 form-group mb-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="f-limpiar"><i class="bi bi-x-lg mr-1" aria-hidden="true"></i>Limpiar filtros</button>
                </div>
            </form>

            <div id="tabla-espera" data-usuario="@(Session["Username"] as string ?? "anonimo")"></div>
        </div>
    </section>
</div>

<partial name="_ModalEstado" />

@section Scripts{
    <partial name="_GcTabla" />
    <script src="~/Content/js/pages/lista-espera.js" asp-append-version="true"></script>
}
