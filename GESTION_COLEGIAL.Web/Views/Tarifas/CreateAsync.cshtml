@model GESTION_COLEGIAL.Business.Models.TarifaViewModel
@{
    ViewBag.Title = Model.Tar_Id == 0 ? "Crear Tarifa" : "Editar Tarifa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Módulo Financiero</a></li>
            <li class="breadcrumb-item"><a href="/Tarifas/Index">Tarifas</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ViewBag.Title</li>
        </ol>
    </nav>
</div>

@using (Html.BeginForm("Save", "Tarifas", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
        <div class="mr-3">
            <h4 class="mb-1">@(Model.Tar_Id == 0 ? "Registro de tarifa" : "Edición de tarifa")</h4>
            <p class="text-muted mb-0">Complete la información de la tarifa por nivel/curso</p>
        </div>
    </div>

    <div>
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-header">
                <div class="row"><div class="col-12"><h4>Datos de la tarifa</h4></div></div>
            </div>

            <div class="widget-content widget-content-area">
                @Html.HiddenFor(model => model.Tar_Id)

                <div class="form-row">
                    @* Columna Concepto de Pago *@
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.ConceptoPago_Id, "Concepto de Pago", htmlAttributes: new { })
                            @Html.DropDownList("ConceptoPago_Id", Model.ConceptosPagoList, "-- Seleccionar Concepto de Pago --", htmlAttributes: new { @class = "custom-select" })
                            @Html.ValidationMessageFor(model => model.ConceptoPago_Id, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    @* Columna Monto *@
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Tar_Monto, "Monto", htmlAttributes: new { })
                            @Html.EditorFor(model => model.Tar_Monto, new { htmlAttributes = new { @class = "form-control", @type = "number", @step = "0.01", @min = "0" } })
                            @Html.ValidationMessageFor(model => model.Tar_Monto, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    @* Columna Nivel Educativo *@
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Nivel_Id, "Nivel Educativo", htmlAttributes: new { })
                            @Html.DropDownList("Nivel_Id", Model.NivelesEducativosList, "-- Seleccionar Nivel --", htmlAttributes: new { @class = "custom-select" })
                            @Html.ValidationMessageFor(model => model.Nivel_Id, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    @* Columna Curso/Nivel *@
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.CursoNivel_Id, "Curso/Nivel", htmlAttributes: new { })
                            @Html.DropDownList("CursoNivel_Id", Model.CursosNivelesList, "-- Seleccionar Curso --", htmlAttributes: new { @class = "custom-select" })
                            @Html.ValidationMessageFor(model => model.CursoNivel_Id, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    @* Columna Año de Vigencia *@
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Tar_AnioVigencia, "Año de Vigencia", htmlAttributes: new { })
                            @Html.EditorFor(model => model.Tar_AnioVigencia, new { htmlAttributes = new { @class = "form-control", @type = "number", @min = "2000", @max = "2100" } })
                            @Html.ValidationMessageFor(model => model.Tar_AnioVigencia, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    @Html.ActionLink("Cancelar", "Index", "Tarifas", null, new { @class = "btn mr-2" })
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save mr-1"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/Content/js/form-encargados.js"></script>
}
