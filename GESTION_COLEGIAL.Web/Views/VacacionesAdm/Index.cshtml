@{
    ViewBag.Title = "Control de Vacaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Vacaciones / Permisos</li>
        </ol>
    </nav>
</div>
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Vacaciones y Permisos</h4>
        <p class="text-muted mb-0">Gestione las solicitudes de vacaciones del personal</p>
    </div>
    <div class="mt-2 mt-md-0">
        <button class="btn btn-primary" data-toggle="modal" data-target="#modal-nueva">
            <i class="bi bi-plus-lg mr-1"></i> Nueva Solicitud
        </button>
    </div>
</div>
<div class="fluid-container">
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable-vac">
                    <thead><tr>
                        <th>Empleado</th><th>Tipo</th><th>Inicio</th><th>Fin</th>
                        <th>Días</th><th>Estado</th><th>Acciones</th>
                    </tr></thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nueva Solicitud -->
<div class="modal fade" id="modal-nueva" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nueva Solicitud</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="form-nueva">
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label>Empleado *</label>
                            <select name="Emp_Id" class="custom-select">
                                <option value="">-- Seleccione Empleado --</option>
                            </select>
                        </div>

                        @* Panel de saldo de vacaciones — se llena por JS al elegir empleado *@
                        <div class="col-md-12">
                            <div id="vac-saldo-panel" class="border rounded p-3 mb-3" style="display:none;">
                              <div class="d-flex flex-wrap align-items-center">
                                <div class="text-center mr-4">
                                    <h5 class="font-weight-bold mb-0" id="vac-saldo-derecho">—</h5>
                                    <small class="text-muted text-uppercase">Días por año</small>
                                </div>
                                <div class="text-center mr-4">
                                    <h5 class="font-weight-bold mb-0" id="vac-saldo-tomados">—</h5>
                                    <small class="text-muted text-uppercase">Tomados</small>
                                </div>
                                <div class="text-center mr-4">
                                    <h5 class="font-weight-bold text-success mb-0" id="vac-saldo-disponible">—</h5>
                                    <small class="text-muted text-uppercase">Disponibles</small>
                                </div>
                                <div class="ml-auto text-right text-muted small font-weight-bold" id="vac-saldo-antig"></div>
                              </div>
                            </div>
                            <div id="vac-saldo-msg" class="alert alert-light-info small" style="display:none;"></div>
                        </div>

                        <div class="form-group col-md-6">
                            <label>Fecha Inicio *</label>
                            <input type="date" name="Vac_FechaInicio" class="form-control">
                        </div>
                        <div class="form-group col-md-6">
                            <label>Fecha Fin *</label>
                            <input type="date" name="Vac_FechaFin" class="form-control">
                        </div>
                        <div class="form-group col-md-6">
                            <label>Tipo *</label>
                            <select name="Vac_Tipo" class="custom-select">
                                <option value="Vacaciones">Vacaciones</option>
                                <option value="Permiso">Permiso</option>
                                <option value="Incapacidad">Incapacidad</option>
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Días solicitados</label>
                            <input type="text" id="vac-dias-calc" class="form-control" readonly value="—">
                        </div>

                        @* Horas — solo visibles cuando el Tipo = Permiso *@
                        <div class="col-md-12" id="vac-horas-row" style="display:none;">
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label>Hora Inicio *</label>
                                    <input type="time" name="Vac_HoraInicio" class="form-control">
                                </div>
                                <div class="form-group col-md-6">
                                    <label>Hora Fin *</label>
                                    <input type="time" name="Vac_HoraFin" class="form-control">
                                </div>
                                <div class="col-md-12">
                                    <div class="alert alert-light-info small">
                                        <i class="bi bi-clock mr-1"></i> El permiso se registra por horas dentro del día. Indique la hora de inicio y de fin.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-md-12">
                            <label>Observación</label>
                            <textarea name="Vac_Motivo" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-md-12">
                            <div id="vac-form-error" class="alert alert-light-danger small font-weight-bold mb-0" style="display:none;"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/vacacionesadm.js"></script>
    <script>
        VacacionesAdm.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("CreateAsync")",
            "@Url.Action("ApproveAsync")",
            "@Url.Action("DropdownsAsync")",
            "@Url.Action("SaldoAsync")"
        );
    </script>
}
