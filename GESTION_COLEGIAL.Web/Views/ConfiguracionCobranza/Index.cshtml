@{
    ViewBag.Title = "Configuración de Cobranza";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Configuración de Cobranza</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Configuración de cobranza</h4>
        <p class="text-muted mb-0">Administre los parámetros que definen qué se cobra, cuánto y cómo</p>
    </div>
    <div class="mt-2 mt-md-0">
        <small class="d-block text-muted text-uppercase font-weight-bold mb-1">Orden lógico</small>
        <div class="d-flex flex-wrap align-items-center">
        <button type="button" class="btn btn-sm btn-rounded btn-outline-primary cc-cascade-pill mb-1" data-jump="conceptospago">1 · Concepto</button>
        <i class="bi bi-arrow-right text-muted mx-1"></i>
        <button type="button" class="btn btn-sm btn-rounded btn-outline-primary cc-cascade-pill mb-1" data-jump="tarifas">2 · Tarifa</button>
        <i class="bi bi-arrow-right text-muted mx-1"></i>
        <button type="button" class="btn btn-sm btn-rounded btn-outline-primary cc-cascade-pill mb-1" data-jump="descuentos">3 · Descuento</button>
        <i class="bi bi-arrow-right text-muted mx-1"></i>
        <button type="button" class="btn btn-sm btn-rounded btn-outline-primary cc-cascade-pill mb-1" data-jump="formaspago">4 · Forma</button>
        <i class="bi bi-arrow-right text-muted mx-1"></i>
        <button type="button" class="btn btn-sm btn-rounded btn-outline-primary cc-cascade-pill mb-1" data-jump="estadospago">5 · Estado</button>
        </div>
    </div>
</div>

<!-- Pestañas -->
<ul class="nav nav-tabs mb-4" role="tablist" id="cc-tabs">
    <li class="nav-item cc-tab-item active" data-catalog="conceptospago">
        <a href="#" class="nav-link active">
            1 · <i class="bi bi-tag mr-1"></i>Conceptos de Pago
            <span class="badge badge-light ml-1" data-count>—</span>
        </a>
    </li>
    <li class="nav-item cc-tab-item" data-catalog="tarifas">
        <a href="#" class="nav-link">
            2 · <i class="bi bi-cash-stack mr-1"></i>Tarifas
            <span class="badge badge-light ml-1" data-count>—</span>
        </a>
    </li>
    <li class="nav-item cc-tab-item" data-catalog="descuentos">
        <a href="#" class="nav-link">
            3 · <i class="bi bi-percent mr-1"></i>Descuentos
            <span class="badge badge-light ml-1" data-count>—</span>
        </a>
    </li>
    <li class="nav-item cc-tab-item" data-catalog="formaspago">
        <a href="#" class="nav-link">
            4 · <i class="bi bi-credit-card mr-1"></i>Formas de Pago
            <span class="badge badge-light ml-1" data-count>—</span>
        </a>
    </li>
    <li class="nav-item cc-tab-item" data-catalog="estadospago">
        <a href="#" class="nav-link">
            5 · <i class="bi bi-flag mr-1"></i>Estados de Pago
            <span class="badge badge-light ml-1" data-count>—</span>
        </a>
    </li>
</ul>

<!-- Panel activo -->
<div class="statbox widget box box-shadow mb-4">
    <div class="widget-content widget-content-area">

        <!-- Barra de herramientas -->
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
            <div class="input-group mb-2 mr-3 flex-fill" style="max-width:420px;">
                <div class="input-group-prepend"><span class="input-group-text"><i class="bi bi-search"></i></span></div>
                <input type="text" class="form-control" id="cc-search" placeholder="Buscar en el catálogo activo..." />
            </div>
            <div class="d-flex align-items-center mb-2">
                <div class="btn-group mr-2" role="group" aria-label="Vista">
                    <button type="button" class="btn btn-sm btn-outline-primary cc-view-btn active" data-view="cards" title="Vista de tarjetas">
                        <i class="bi bi-grid-3x3-gap-fill mr-1"></i> Tarjetas
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary cc-view-btn" data-view="table" title="Vista de tabla">
                        <i class="bi bi-table mr-1"></i> Tabla
                    </button>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary mr-2" id="cc-reload" title="Recargar datos">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button type="button" class="btn btn-primary" id="cc-new-btn">
                    <i class="bi bi-plus-lg mr-1"></i>
                    <span id="cc-new-label">Nuevo</span>
                </button>
            </div>
        </div>

        <!-- Info del catálogo activo -->
        <div class="alert alert-light-info d-flex align-items-start" id="cc-catalog-info">
            <i class="bi bi-info-circle-fill mr-2 mt-1"></i>
            <div>
                <strong id="cc-info-title">Conceptos de Pago</strong>
                <span class="d-block" id="cc-info-desc">Rubros por los que la institución cobra (matrícula, mensualidad, transporte, etc.).</span>
            </div>
        </div>

        <!-- Vista Tarjetas (por defecto) -->
        <div id="cc-cards-view">
            <div class="row" id="cc-cards-grid">
                <!-- Tarjetas inyectadas por JS -->
            </div>
            <div class="text-center py-5" id="cc-empty" hidden>
                <div class="display-4 text-muted mb-2"><i class="bi bi-inbox"></i></div>
                <h5>Sin registros</h5>
                <p class="text-muted">Todavía no hay elementos en este catálogo.</p>
                <button type="button" class="btn btn-primary" onclick="document.getElementById('cc-new-btn').click()">
                    <i class="bi bi-plus-lg mr-1"></i> Crear el primero
                </button>
            </div>
        </div>

        <!-- Vista Tabla -->
        <div id="cc-table-view" hidden>
            <div class="table-responsive">
                <table class="table table-hover" id="cc-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Descripción</th>
                            <th>Uso / Monto</th>
                            <th>Estado</th>
                            <th>Registrado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="cc-table-body">
                        <!-- Filas inyectadas por JS -->
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<!-- ============================================ -->
<!-- Modal: Crear / Editar -->
<!-- ============================================ -->
<div class="modal fade" id="cc-edit-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="cc-edit-title">Nuevo registro</h5>
                    <p class="small text-muted mb-0" id="cc-edit-subtitle">Complete los datos del catálogo</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="cc-edit-form" onsubmit="return false;">
                <div class="modal-body">
                    <input type="hidden" id="cc-edit-id" value="0" />

                    <div class="form-group">
                        <label for="cc-edit-descripcion">Descripción <span class="text-danger">*</span></label>
                        <input type="text" id="cc-edit-descripcion" class="form-control" maxlength="150" required autocomplete="off" placeholder="Ej: Matrícula, Mensualidad, Transporte..." />
                        <small class="form-text text-muted" id="cc-edit-hint">Ingrese el nombre del registro.</small>
                    </div>

                    <!-- ConceptosPago: EsRecurrente + EsObligatorio -->
                    <div class="form-group cc-only-conceptospago" hidden>
                        <label>Tipo de concepto</label>
                        <div class="custom-control custom-checkbox mb-2">
                            <input type="checkbox" class="custom-control-input" id="cc-edit-esrecurrente" />
                            <label class="custom-control-label" for="cc-edit-esrecurrente">
                                <strong>Es recurrente</strong>
                                <small class="d-block text-muted">Se cobra periódicamente (ej: mensualidad).</small>
                            </label>
                        </div>
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="cc-edit-esobligatorio" />
                            <label class="custom-control-label" for="cc-edit-esobligatorio">
                                <strong>Es obligatorio</strong>
                                <small class="d-block text-muted">Todo alumno debe pagarlo.</small>
                            </label>
                        </div>
                    </div>

                    <div class="form-group" id="cc-edit-estado-wrap" hidden>
                        <label class="d-block">Estado</label>
                        <div class="d-flex align-items-center">
                            <label class="switch s-outline s-outline-primary mb-0 mr-2">
                                <input type="checkbox" id="cc-edit-esactivo" checked />
                                <span class="slider round"></span>
                            </label>
                            <span id="cc-edit-esactivo-label">Activo</span>
                        </div>
                    </div>

                    <!-- Aviso para catálogos que redirigen (Tarifas, Descuentos) -->
                    <div class="alert alert-light-warning mb-0" id="cc-edit-redirect" hidden>
                        <i class="bi bi-info-circle-fill mr-1"></i>
                        <strong id="cc-edit-redirect-title">Este catálogo requiere más campos</strong>
                        <span class="d-block" id="cc-edit-redirect-desc">Se te redirigirá a la pantalla completa donde podrás configurar todos los parámetros.</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="cc-edit-save">
                        <i class="bi bi-check2"></i> Guardar
                    </button>
                    <a href="#" class="btn btn-primary" id="cc-edit-redirect-btn" hidden>
                        <i class="bi bi-box-arrow-up-right"></i> Ver formulario completo
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================ -->
<!-- Modal: Detalle -->
<!-- ============================================ -->
<div class="modal fade" id="cc-detail-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">Detalle del registro</h5>
                    <p class="small text-muted mb-0" id="cc-detail-catalog-name">Catálogo</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <div class="small text-muted text-uppercase font-weight-bold">ID</div>
                        <div class="font-weight-bold text-dark" id="cc-detail-id">—</div>
                    </div>
                    <div class="col-md-9 mb-3">
                        <div class="small text-muted text-uppercase font-weight-bold">Descripción</div>
                        <div class="font-weight-bold text-dark" id="cc-detail-descripcion">—</div>
                    </div>
                    <div class="col-12 mb-3" id="cc-detail-extra-wrap" hidden>
                        <div class="small text-muted text-uppercase font-weight-bold" id="cc-detail-extra-label">Uso</div>
                        <div class="font-weight-bold text-dark" id="cc-detail-extra-value">—</div>
                    </div>
                </div>

                <h6 class="font-weight-bold mt-2"><i class="bi bi-clock-history mr-1"></i> Auditoría</h6>
                <ul class="list-group">
                    <li class="list-group-item d-flex align-items-center">
                        <i class="bi bi-person-plus text-success h5 mb-0 mr-3"></i>
                        <div>
                            <small class="d-block text-muted">Creado por</small>
                            <strong id="cc-detail-usuarioregistra">—</strong> <span class="small text-muted" id="cc-detail-fecharegistra">—</span>
                        </div>
                    </li>
                    <li class="list-group-item d-flex align-items-center">
                        <i class="bi bi-pencil-square text-info h5 mb-0 mr-3"></i>
                        <div>
                            <small class="d-block text-muted">Última modificación</small>
                            <strong id="cc-detail-usuariomodifica">—</strong> <span class="small text-muted" id="cc-detail-fechamodifica">—</span>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================ -->
<!-- Modal: Eliminar -->
<!-- ============================================ -->
<div class="modal fade" id="cc-delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Eliminar registro</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body text-center">
                <input type="hidden" id="cc-delete-id" value="0" />
                <div class="display-4 text-danger mb-3"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <p class="mb-4">
                    ¿Está seguro de que desea eliminar <strong class="text-dark" id="cc-delete-name"></strong> del catálogo <strong id="cc-delete-catalog"></strong>?
                </p>
                <div class="alert alert-light-danger text-left mb-0">
                    <strong class="d-block">Esta acción no se puede deshacer</strong>
                    Si el registro está en uso por otras entidades, la eliminación fallará.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="cc-delete-confirm">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/configuracion-cobranza.js"></script>
}
