@{
    ViewBag.Title = "Estado de Resultados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/financiero-analisis.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Estado de Resultados</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Estado de Resultados</h4>
        <p class="text-muted mb-0">Resumen de ingresos y egresos por período</p>
    </div>
    <div class="mt-2 mt-md-0">
        <div class="d-flex flex-wrap align-items-center">
                <label for="f-anio" class="mb-0 mr-2">Año</label>
                <input type="number" class="form-control w-auto mr-3" id="f-anio" value="@ViewBag.AnioActual" min="2020" max="2030" />
                <label for="f-mes" class="mb-0 mr-2">Mes</label>
                <select id="f-mes" class="custom-select w-auto mr-3">
                <!option value="1"  @(ViewBag.MesActual == 1  ? "selected" : "")>Enero</!option>
                <!option value="2"  @(ViewBag.MesActual == 2  ? "selected" : "")>Febrero</!option>
                <!option value="3"  @(ViewBag.MesActual == 3  ? "selected" : "")>Marzo</!option>
                <!option value="4"  @(ViewBag.MesActual == 4  ? "selected" : "")>Abril</!option>
                <!option value="5"  @(ViewBag.MesActual == 5  ? "selected" : "")>Mayo</!option>
                <!option value="6"  @(ViewBag.MesActual == 6  ? "selected" : "")>Junio</!option>
                <!option value="7"  @(ViewBag.MesActual == 7  ? "selected" : "")>Julio</!option>
                <!option value="8"  @(ViewBag.MesActual == 8  ? "selected" : "")>Agosto</!option>
                <!option value="9"  @(ViewBag.MesActual == 9  ? "selected" : "")>Septiembre</!option>
                <!option value="10" @(ViewBag.MesActual == 10 ? "selected" : "")>Octubre</!option>
                <!option value="11" @(ViewBag.MesActual == 11 ? "selected" : "")>Noviembre</!option>
                <!option value="12" @(ViewBag.MesActual == 12 ? "selected" : "")>Diciembre</!option>
                </select>
                <button type="button" class="btn btn-primary" id="btn-consultar"><i class="fas fa-rotate mr-1"></i> Actualizar</button>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="er-kpi-ingresos">—</h6>
                        <p>Total Ingresos</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-arrow-trend-up"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="er-kpi-egresos">—</h6>
                        <p>Total Egresos</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-arrow-trend-down"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="er-kpi-resultado">—</h6>
                        <p>Resultado Neto</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-scale-balanced"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="er-kpi-conceptos">—</h6>
                        <p>Conceptos</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-list-ol"></i></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 col-lg-5 layout-spacing">
        <div class="statbox widget box box-shadow h-100">
            <div class="widget-header">
                <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4>Distribución</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <div class="d-flex justify-content-center align-items-center er-chart-box">
                    <canvas id="er-chart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7 layout-spacing">
        <div class="statbox widget box box-shadow h-100">
            <div class="widget-header">
                <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4>Detalle por Concepto</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <div id="er-table-container">
                    <div class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin mr-2"></i>Cargando...</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/estadorresultados.js"></script>
    <script>
        EstadoResultados.init("@Url.Action("GetAsync")", @ViewBag.AnioActual, @ViewBag.MesActual);
    </script>
}
