@{
    ViewBag.Title = "Dashboard Recursos Humanos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/pages/dashboard-rrhh.css" rel="stylesheet" asp-append-version="true" />
}

<div>

    <!-- ══ Header ══ -->
    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
        <div class="mr-3">
            <h4 class="mb-1">Dashboard Recursos Humanos</h4>
            <p class="text-muted mb-0">Resumen del capital humano en tiempo real</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap align-items-center">
            <label class="mb-0 mr-2">Año</label>
            <select id="sel-anio" class="custom-select w-auto mr-3"></select>
            <label class="mb-0 mr-2">Mes</label>
            <select id="sel-mes" class="custom-select w-auto mr-3"></select>
            <button type="button" class="btn btn-primary" id="btn-actualizar"><i class="fas fa-rotate-right mr-1"></i>Actualizar</button>
        </div>
    </div>

    <!-- ══ KPIs Plantilla ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-gauge-high mr-1"></i>Plantilla</h6>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-activos">—</h6>
                            <p>Empleados Activos</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-users"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-departamentos">—</h6>
                            <p>Departamentos</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-building"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-cargos">—</h6>
                            <p>Cargos</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-briefcase"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-nuevos">—</h6>
                            <p>Nuevos Año Actual</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-user-plus"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Calendario escolar ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="bi bi-calendar3 mr-1"></i>Calendario</h6>
    <div class="row mb-4">
        <div class="col-md-12">
            @await Html.PartialAsync("_ProximosDias")
        </div>
    </div>

    <!-- ══ Asistencia Hoy + Diaria ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-clipboard-user mr-1"></i>Asistencia</h6>
    <div class="row">
        <div class="col-md-5 layout-spacing">
            <div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-calendar-day mr-1"></i>Asistencia Hoy</h4><span class="small font-weight-bold text-muted" id="stat-pct-hoy"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="d-flex flex-wrap align-items-stretch mb-3">
                    <div class="text-center px-3 py-2 mb-2">
                        <h2 class="font-weight-bold mb-0" id="kpi-pct-hoy">—</h2>
                        <p class="small text-muted text-uppercase font-weight-bold mb-0">% Presencia</p>
                    </div>
                    <div class="border-left mx-2 mb-2"></div>
                    <div class="border rounded text-center px-3 py-2 flex-fill mb-2 mr-2">
                        <h3 class="font-weight-bold text-success mb-0" id="kpi-presentes">—</h3>
                        <p class="small text-muted text-uppercase font-weight-bold mb-0">Presentes</p>
                    </div>
                    <div class="border rounded text-center px-3 py-2 flex-fill mb-2 mr-2">
                        <h3 class="font-weight-bold text-danger mb-0" id="kpi-ausentes">—</h3>
                        <p class="small text-muted text-uppercase font-weight-bold mb-0">Ausentes</p>
                    </div>
                    <div class="border rounded text-center px-3 py-2 flex-fill mb-2 mr-2">
                        <h3 class="font-weight-bold text-warning mb-0" id="kpi-tardanzas">—</h3>
                        <p class="small text-muted text-uppercase font-weight-bold mb-0">Tardanzas</p>
                    </div>
                </div>
                <canvas class="dash-chart-h130" id="chart-asistencia-hoy"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-7 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-chart-line mr-1"></i>Últimos 14 Días</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h210" id="chart-asistencia-diaria"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Distribución Plantilla ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-sitemap mr-1"></i>Distribución de Plantilla</h6>
    <div class="row">
        <div class="col-md-5 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-building-columns mr-1"></i>Por Departamento</h4><span class="small font-weight-bold text-muted" id="stat-total-depto"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h240" id="chart-departamento"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-7 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-briefcase mr-1"></i>Por Cargo</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h240" id="chart-cargo"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Demografía ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-chart-pie mr-1"></i>Demografía</h6>
    <div class="row">
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-venus-mars mr-1"></i>Por Género</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h200" id="chart-genero"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-person-half-dress mr-1"></i>Rango de Edad</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h200" id="chart-edad"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-user-plus mr-1"></i>Nuevos por Mes</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h200" id="chart-nuevos"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Cumpleaños del Mes ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-cake-candles mr-1"></i>Cumpleaños del Mes</h6>
    <div class="row">
        <div class="col-md-12 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-content widget-content-area">
                <div id="lista-cumpleanos" class="cumple-grid">
                    <p class="text-muted m-0">Sin cumpleaños este mes.</p>
                </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ KPIs Solicitudes ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-clipboard-list mr-1"></i>Solicitudes y Cumpleaños</h6>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-vac-pend">—</h6>
                            <p>Vacaciones Pend.</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-umbrella-beach"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-per-pend">—</h6>
                            <p>Permisos Pend.</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-file-pen"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-inca-pend">—</h6>
                            <p>Incapacidades Pend.</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-hospital"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-cumple-mes">—</h6>
                            <p>Cumpleaños Mes</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-cake-candles"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Solicitudes Pendientes + Antigüedad ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-inbox mr-1"></i>Solicitudes y Antigüedad</h6>
    <div class="row">
        <div class="col-md-7 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-file-circle-question mr-1"></i>Solicitudes Pendientes</h4><span class="small font-weight-bold text-muted" id="stat-total-sol"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Empleado</th>
                                <th>Cargo / Dpto.</th>
                                <th class="text-center">Tipo</th>
                                <th>Período</th>
                                <th class="text-center">Días</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-solicitudes">
                            <tr><td class="text-center text-muted py-4" colspan="5">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
                </div>
            </div>
        </div>
        <div class="col-md-5 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-medal mr-1"></i>Top Antigüedad</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div id="lista-antiguedad"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Alertas ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-bell mr-1"></i>Alertas RRHH</h6>
    <div class="row">
        <div class="col-md-12 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-content widget-content-area">
                <div class="alertas-grid" id="lista-alertas">
                    <p class="text-muted m-0">Sin alertas activas.</p>
                </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/dashboardrrhh.js"></script>
    <script>
        DashboardRRHH.init("@Url.Action("ResumenAsync")");
    </script>
}
