@model GESTION_COLEGIAL.UI.Models.CasosIndexViewModel
@using GESTION_COLEGIAL.Business.Models
@using GESTION_COLEGIAL.UI.Models
@{
    ViewBag.Title = "Casos de disciplina";
    var M = Model;
    Func<int, string> urlPagina = p => Url.Action("Index", new { estado = M.Estado, tipo = M.Tipo, abiertos = M.SoloAbiertos ? "true" : null, pagina = p });
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item">Académico</li>
            <li class="breadcrumb-item active" aria-current="page">Casos de disciplina</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Casos de disciplina</h4>
        <p class="text-muted mb-0">Qué pasó, quiénes participaron, qué hizo el colegio y cómo avanzó cada caso.</p>
    </div>
    @if (M.PuedeRegistrar)
    {
        <div class="mt-2 mt-md-0">
            <a class="btn btn-primary" href="@Url.Action("Registrar")">
                <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i> Registrar un caso
            </a>
        </div>
    }
</div>

<div class="fluid-container">
    <section class="statbox widget box box-shadow mb-4" aria-labelledby="dis-filtros-titulo">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4 id="dis-filtros-titulo">Registros de conducta y de protección del menor</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <p class="text-muted">
                @M.Abiertos @(M.Abiertos == 1 ? "caso todavía necesita" : "casos todavía necesitan") trabajo.
                Un caso de protección del menor solo lo leen quienes lo atienden, así que esta lista puede ser más corta que la del colegio.
            </p>

            <form method="get" action="@Url.Action("Index")" id="dis-form-filtros" class="form-row align-items-end">
                <div class="col-md-3 form-group">
                    <label for="filtro-estado">Estado</label>
                    <select id="filtro-estado" name="estado" class="custom-select" data-auto>
                        <option value="">Todos los estados</option>
                        @foreach (var e in CatalogoCasos.Estados)
                        {
                            <option value="@e.Codigo" selected="@(e.Codigo == M.Estado)">@e.Etiqueta</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 form-group">
                    <label for="filtro-tipo">Tipo</label>
                    <select id="filtro-tipo" name="tipo" class="custom-select" data-auto>
                        <option value="">Todos los tipos</option>
                        @foreach (var t in CatalogoCasos.Tipos)
                        {
                            <option value="@t.Codigo" selected="@(t.Codigo == M.Tipo)">@t.Etiqueta</option>
                        }
                    </select>
                </div>
                <div class="col-auto form-group">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="filtro-abiertos" name="abiertos" value="true" checked="@M.SoloAbiertos" data-auto />
                        <label class="custom-control-label" for="filtro-abiertos">Solo los que necesitan trabajo</label>
                    </div>
                </div>
                @if (M.HayFiltros)
                {
                    <div class="col-auto form-group">
                        <a class="btn btn-link" href="@Url.Action("Index")"><i class="bi bi-x-lg mr-1" aria-hidden="true"></i> Quitar filtros</a>
                    </div>
                }
                <noscript><div class="col-auto form-group"><button type="submit" class="btn btn-primary">Filtrar</button></div></noscript>
            </form>
            <p class="text-muted small mb-0" id="dis-cargando" role="status" hidden>Actualizando casos…</p>
        </div>
    </section>

    <section class="statbox widget box box-shadow mb-4" aria-labelledby="dis-lista-titulo">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4 id="dis-lista-titulo">Casos registrados</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <p class="text-muted">El más reciente va primero. Abra un caso para leerlo y para hacerlo avanzar.</p>

            @if (M.Casos.Count == 0)
            {
                if (M.HayFiltros)
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-search fa-3x mb-3 d-block" aria-hidden="true"></i>
                        <h5>Nada coincide con este filtro</h5>
                        <p>No hay casos que usted pueda leer en ese estado.</p>
                        <a class="btn btn-outline-primary" href="@Url.Action("Index")">Ver todos los casos</a>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-shield-exclamation fa-3x mb-3 d-block" aria-hidden="true"></i>
                        <h5>Todavía no hay casos</h5>
                        <p>Un caso registra qué pasó, quiénes participaron y qué hizo el colegio al respecto.</p>
                        @if (M.PuedeRegistrar)
                        {
                            <a class="btn btn-primary" href="@Url.Action("Registrar")">Registrar el primer caso</a>
                        }
                    </div>
                }
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">Caso</th>
                                <th scope="col">Tipo</th>
                                <th scope="col">Estado</th>
                                <th scope="col">Ocurrió</th>
                                <th scope="col">Lo atiende</th>
                                <th scope="col" class="text-right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in M.Casos)
                            {
                                <tr>
                                    <td>
                                        <a class="font-weight-bold" href="@Url.Action("Caso", new { id = c.Cas_Id })">@c.Cas_Resumen</a>
                                        <span class="d-block text-muted small">
                                            @c.Cas_Referencia · @c.Personas @(c.Personas == 1 ? "persona nombrada" : "personas nombradas")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge outline-badge-primary">@CatalogoCasos.Tipo(c.Cas_Tipo)</span>
                                        @if (c.Cas_EsReservado)
                                        {
                                            <span class="badge outline-badge-danger"><i class="bi bi-lock mr-1" aria-hidden="true"></i>Reservado</span>
                                        }
                                    </td>
                                    <td><span class="badge outline-badge-secondary">@CatalogoCasos.Estado(c.Cas_Estado)</span></td>
                                    <td class="text-muted text-nowrap">
                                        @FormatoCaso.Dia(c.Cas_FechaOcurrio)
                                        <span class="d-block small">@FormatoCaso.Hora(c.Cas_FechaOcurrio)</span>
                                    </td>
                                    <td class="text-muted">@(string.IsNullOrWhiteSpace(c.Atiende) ? "Nadie todavía" : c.Atiende)</td>
                                    <td class="text-right">
                                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Caso", new { id = c.Cas_Id })"
                                           aria-label="Abrir el caso @c.Cas_Referencia">
                                            <i class="bi bi-eye mr-1" aria-hidden="true"></i> Abrir
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (M.Paginas > 1)
                {
                    <nav class="d-flex flex-wrap align-items-center justify-content-between mt-3" aria-label="Páginas de casos">
                        <span class="text-muted small">Mostrando @M.Desde–@M.Hasta de @M.Total</span>
                        <ul class="pagination mb-0">
                            <li class="page-item @(M.Pagina <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@urlPagina(M.Pagina - 1)" aria-label="Página anterior"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                            </li>
                            @for (int p = 1; p <= M.Paginas; p++)
                            {
                                if (p == 1 || p == M.Paginas || Math.Abs(p - M.Pagina) <= 1)
                                {
                                    <li class="page-item @(p == M.Pagina ? "active" : "")">
                                        <a class="page-link" href="@urlPagina(p)" aria-current="@(p == M.Pagina ? "page" : null)">@p</a>
                                    </li>
                                }
                                else if (p == 2 || p == M.Paginas - 1)
                                {
                                    <li class="page-item disabled" aria-hidden="true"><span class="page-link">…</span></li>
                                }
                            }
                            <li class="page-item @(M.Pagina >= M.Paginas ? "disabled" : "")">
                                <a class="page-link" href="@urlPagina(M.Pagina + 1)" aria-label="Página siguiente"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </section>
</div>

@section Scripts{
    <script src="~/Content/js/pages/disciplina.js" asp-append-version="true"></script>
}
