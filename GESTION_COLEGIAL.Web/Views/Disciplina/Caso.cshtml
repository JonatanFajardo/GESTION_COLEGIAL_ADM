@model GESTION_COLEGIAL.UI.Models.CasoPaginaViewModel
@using GESTION_COLEGIAL.Business.Models
@using GESTION_COLEGIAL.UI.Models
@{
    var M = Model;
    var C = M.Caso;
    ViewBag.Title = "Caso " + C.Cas_Referencia;
    bool abierto = M.EstaAbierto;
    bool atender = M.PuedeAtender && abierto;
}

@section Styles{
    <link href="~/css/pages/disciplina.css" rel="stylesheet" asp-append-version="true" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Casos de disciplina</a></li>
            <li class="breadcrumb-item active" aria-current="page">@C.Cas_Referencia</li>
        </ol>
    </nav>
</div>

<div class="fluid-container" id="dis-caso" data-caso="@C.Cas_Id"
     data-url-estado="@Url.Action("CambiarEstadoAsync")" data-url-accion="@Url.Action("AgregarAccionAsync")"
     data-url-completar="@Url.Action("CompletarAccionAsync")" data-url-nota="@Url.Action("AgregarNotaAsync")">
    @Html.AntiForgeryToken()

    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
        <div class="mr-3">
            <h4 class="mb-1">@C.Cas_Resumen</h4>
            <p class="text-muted mb-0">Caso @C.Cas_Referencia</p>
        </div>
        <div class="mt-2 mt-md-0">
            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">
                <i class="bi bi-arrow-left mr-1" aria-hidden="true"></i> Casos
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(M.Aviso))
    {
        <div class="alert alert-light-success mb-4" role="status"><i class="bi bi-check-circle mr-1" aria-hidden="true"></i> <strong>@M.Aviso</strong></div>
    }
    <div class="alert alert-light-danger mb-4" id="dis-error-general" role="alert" hidden></div>

    <div class="row">
        <div class="col-xl-10">
            @* ── Resumen del caso ── *@
            <section class="statbox widget box box-shadow mb-4" aria-label="Resumen del caso">
                <div class="widget-content widget-content-area">
                    <p class="text-muted">
                        <strong class="text-body">@C.Cas_Referencia</strong>
                        <span>· @CatalogoCasos.Tipo(C.Cas_Tipo)</span>
                        <span>· Lo registró @(string.IsNullOrWhiteSpace(C.Reporta) ? "una persona desconocida" : C.Reporta)</span>
                        @if (!string.IsNullOrWhiteSpace(C.Ani_Nombre))
                        {
                            <span>· Año @C.Ani_Nombre@(string.IsNullOrWhiteSpace(C.Pan_Nombre) ? "" : ", " + C.Pan_Nombre)</span>
                        }
                        @if (C.Cas_EsReservado)
                        {
                            <span class="badge outline-badge-danger ml-1"><i class="bi bi-lock mr-1" aria-hidden="true"></i>Reservado</span>
                        }
                    </p>

                    <dl class="row mb-3">
                        <div class="col-sm-6 col-lg-3 mb-2">
                            <dt class="text-muted small">Estado</dt>
                            <dd class="mb-0 font-weight-bold" id="dis-estado-actual">@CatalogoCasos.Estado(C.Cas_Estado)</dd>
                        </div>
                        <div class="col-sm-6 col-lg-3 mb-2">
                            <dt class="text-muted small">Ocurrió</dt>
                            <dd class="mb-0 font-weight-bold">@FormatoCaso.DiaHora(C.Cas_FechaOcurrio)</dd>
                            @if (!string.IsNullOrWhiteSpace(C.Cas_Lugar))
                            {
                                <dd class="mb-0 text-muted">@C.Cas_Lugar</dd>
                            }
                        </div>
                        <div class="col-sm-6 col-lg-3 mb-2">
                            <dt class="text-muted small">Lo atiende</dt>
                            <dd class="mb-0 @(string.IsNullOrWhiteSpace(C.Atiende) ? "text-muted" : "font-weight-bold")">@(string.IsNullOrWhiteSpace(C.Atiende) ? "—" : C.Atiende)</dd>
                        </div>
                        <div class="col-sm-6 col-lg-3 mb-2">
                            <dt class="text-muted small">Pendiente</dt>
                            <dd class="mb-0 font-weight-bold">@C.Pendientes</dd>
                        </div>
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(C.Cas_Descripcion))
                    {
                        <p class="dis-texto-largo">@C.Cas_Descripcion</p>
                    }

                    @if (M.PuedeAtender && M.Siguientes.Count > 0)
                    {
                        <form class="form-row align-items-center border-top pt-3" id="dis-form-estado" aria-label="Mover el caso" novalidate>
                            <div class="col-md-4 mb-2">
                                <label for="estado" class="sr-only">Mover el caso a</label>
                                <select id="estado" class="custom-select">
                                    @foreach (var s in M.Siguientes)
                                    {
                                        <option value="@s.Codigo">@s.Etiqueta</option>
                                    }
                                </select>
                            </div>
                            <div class="col mb-2">
                                <label for="motivo" class="sr-only">Por qué</label>
                                <input id="motivo" class="form-control" maxlength="500" placeholder="Por qué (opcional)" autocomplete="off" />
                            </div>
                            <div class="col-md-auto mb-2">
                                <button type="submit" class="btn btn-primary btn-block">Mover el caso</button>
                            </div>
                        </form>
                        <p class="text-danger small mb-0" data-error="estado"></p>
                        <p class="text-danger small mb-0" data-error="motivo"></p>
                    }
                </div>
            </section>

            <section class="statbox widget box box-shadow mb-4" aria-labelledby="dis-personas-titulo">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4 id="dis-personas-titulo">Personas</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    @if (M.Personas.Count == 0)
                    {
                        <p class="text-muted mb-0">No se nombró a nadie.</p>
                    }
                    else
                    {
                        <ul class="list-group">
                            @foreach (var p in M.Personas)
                            {
                                <li class="list-group-item d-flex flex-wrap justify-content-between">
                                    <span class="font-weight-bold">
                                        @(string.IsNullOrWhiteSpace(p.Nombre) ? "Sin nombre" : p.Nombre)
                                        @if (!string.IsNullOrWhiteSpace(p.Ubicacion))
                                        {
                                            <span class="text-muted font-weight-normal ml-1">@p.Ubicacion</span>
                                        }
                                    </span>
                                    <span class="text-muted">@CatalogoCasos.Papel(p.Cpe_Papel)@(string.IsNullOrWhiteSpace(p.Cpe_Nota) ? "" : " · " + p.Cpe_Nota)</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>

            <section class="statbox widget box box-shadow mb-4" aria-labelledby="dis-acciones-titulo">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4 id="dis-acciones-titulo">Acciones</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    @if (M.Acciones.Count == 0)
                    {
                        <p class="text-muted">Todavía no hay acciones.</p>
                    }
                    else
                    {
                        <ul class="list-group mb-3">
                            @foreach (var a in M.Acciones)
                            {
                                <li class="list-group-item d-flex align-items-start justify-content-between">
                                    <div class="mr-3">
                                        <p class="font-weight-bold mb-1">
                                            @a.Cac_Tipo
                                            @if (!a.Pendiente)
                                            {
                                                <span class="badge badge-success ml-1">Hecha</span>
                                            }
                                        </p>
                                        <p class="text-muted mb-1">@a.Cac_Descripcion</p>
                                        <p class="text-muted small mb-0">
                                            @(string.IsNullOrWhiteSpace(a.Responsable) ? "Nadie todavía" : a.Responsable)
                                            · @(a.Cac_FechaLimite.HasValue ? FormatoCaso.Dia(a.Cac_FechaLimite.Value) : "Sin fecha")
                                            @if (!a.Pendiente)
                                            {
                                                @: · Hecha el @FormatoCaso.Dia(a.Cac_FechaHecha.Value)
                                            }
                                        </p>
                                    </div>
                                    @if (a.Pendiente && atender)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success text-nowrap" data-completar="@a.Cac_Id">
                                            <i class="bi bi-check-lg mr-1" aria-hidden="true"></i> Marcar hecha
                                        </button>
                                    }
                                </li>
                            }
                        </ul>
                    }

                    @if (atender)
                    {
                        <form id="dis-form-accion" aria-label="Agregar una acción" novalidate>
                            <div class="form-row">
                                <div class="col-md-4 mb-2">
                                    <label for="accion-tipo" class="sr-only">Qué tipo</label>
                                    <input id="accion-tipo" class="form-control" maxlength="100" placeholder="Reunión, derivación…" autocomplete="off" />
                                    <p class="text-danger small mb-0 mt-1" data-error="tipo"></p>
                                </div>
                                <div class="col-md-8 mb-2">
                                    <label for="accion-descripcion" class="sr-only">Qué tiene que pasar</label>
                                    <input id="accion-descripcion" class="form-control" maxlength="1000" placeholder="Qué tiene que pasar" autocomplete="off" />
                                    <p class="text-danger small mb-0 mt-1" data-error="descripcion"></p>
                                </div>
                            </div>
                            <div class="form-row align-items-center">
                                <div class="col mb-2">
                                    <label for="accion-responsable" class="sr-only">Quién</label>
                                    <select id="accion-responsable" class="custom-select">
                                        <option value="">Nadie todavía</option>
                                        @foreach (var e in M.Empleados)
                                        {
                                            <option value="@e.Emp_Id">@e.Nombre@(string.IsNullOrWhiteSpace(e.Cargo) ? "" : " · " + e.Cargo)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <label for="accion-fecha" class="sr-only">Para cuándo</label>
                                    <input type="date" id="accion-fecha" class="form-control" />
                                </div>
                                <div class="col-md-auto mb-2">
                                    <button type="submit" class="btn btn-outline-primary btn-block">Agregar acción</button>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            </section>

            <section class="statbox widget box box-shadow mb-4" aria-labelledby="dis-notas-titulo">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4 id="dis-notas-titulo">Notas</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    @if (M.Notas.Count == 0)
                    {
                        <p class="text-muted">Todavía no hay notas.</p>
                    }
                    else
                    {
                        <ol class="list-group mb-3">
                            @foreach (var n in M.Notas)
                            {
                                <li class="list-group-item">
                                    <p class="text-muted small mb-1">
                                        <strong class="text-body">@(string.IsNullOrWhiteSpace(n.Usuario) ? "Persona desconocida" : n.Usuario)</strong>
                                        <span class="ml-1">@FormatoCaso.DiaHora(n.Cno_Fecha)</span>
                                        @if (n.Cno_EsPrivada)
                                        {
                                            <span class="badge outline-badge-secondary ml-1"><i class="bi bi-lock mr-1" aria-hidden="true"></i>Privada</span>
                                        }
                                    </p>
                                    <p class="dis-texto-largo mb-0">@n.Cno_Texto</p>
                                </li>
                            }
                        </ol>
                    }

                    @if (atender)
                    {
                        <form id="dis-form-nota" aria-label="Agregar una nota" novalidate>
                            <div class="form-group mb-2">
                                <label for="nota" class="sr-only">Nota</label>
                                <textarea id="nota" class="form-control" rows="3" maxlength="5000" placeholder="Agregar una nota"></textarea>
                                <p class="text-danger small mb-0" data-error="nota"></p>
                            </div>
                            <div class="d-flex flex-wrap align-items-center justify-content-between">
                                <div class="custom-control custom-checkbox mb-2">
                                    <input type="checkbox" class="custom-control-input" id="nota-privada" checked />
                                    <label class="custom-control-label" for="nota-privada">Privada: solo para quienes atienden el caso</label>
                                </div>
                                <button type="submit" class="btn btn-outline-primary mb-2">Agregar nota</button>
                            </div>
                        </form>
                    }
                </div>
            </section>

            <section class="statbox widget box box-shadow mb-4" aria-labelledby="dis-historial-titulo">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4 id="dis-historial-titulo">Historial</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    <ol class="list-group">
                        <li class="list-group-item">
                            <p class="font-weight-bold mb-1">Reportado</p>
                            <p class="text-muted small mb-0">@FormatoCaso.Dia(C.Cas_FechaRegistra) · @(string.IsNullOrWhiteSpace(C.Reporta) ? "Persona desconocida" : C.Reporta)</p>
                        </li>
                        @foreach (var h in M.Historial)
                        {
                            <li class="list-group-item">
                                <p class="font-weight-bold mb-1">@CatalogoCasos.Estado(h.Ces_De) → @CatalogoCasos.Estado(h.Ces_A)</p>
                                <p class="text-muted small mb-0">
                                    @FormatoCaso.Dia(h.Ces_Fecha) · @(string.IsNullOrWhiteSpace(h.Usuario) ? "Persona desconocida" : h.Usuario)@(string.IsNullOrWhiteSpace(h.Ces_Motivo) ? "" : " · " + h.Ces_Motivo)
                                </p>
                            </li>
                        }
                    </ol>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/disciplina.js" asp-append-version="true"></script>
}
