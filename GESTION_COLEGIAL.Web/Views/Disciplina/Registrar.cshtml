@model GESTION_COLEGIAL.UI.Models.CasoRegistrarPaginaViewModel
@using GESTION_COLEGIAL.Business.Models
@{
    ViewBag.Title = "Registrar un caso";
    var M = Model;
    string ahora = M.Ahora.ToString("yyyy-MM-ddTHH:mm");
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Casos de disciplina</a></li>
            <li class="breadcrumb-item active" aria-current="page">Registrar un caso</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Registrar un caso</h4>
        <p class="text-muted mb-0">Anote lo que pasó y a quiénes involucra. Después, desde el caso, podrá moverlo de estado y agregar acciones y notas.</p>
    </div>
</div>

<div class="fluid-container">
    <div class="row">
        <div class="col-xl-9">
            <div class="alert alert-light-danger mb-4" id="dis-error-general" role="alert" hidden></div>

            <div class="statbox widget box box-shadow mb-4">
                <div class="widget-content widget-content-area">
                    <form id="dis-form-registrar" aria-label="Registrar un caso" novalidate
                          data-url="@Url.Action("RegistrarAsync")" data-max="@M.MaxPersonas">
                        @Html.AntiForgeryToken()

                        <div class="form-row">
                            <div class="col-12 form-group">
                                <label for="resumen">Resumen</label>
                                <input id="resumen" class="form-control" maxlength="255" placeholder="Una línea que nombre lo que pasó" autocomplete="off" />
                                <p class="text-danger small mb-0" data-error="resumen"></p>
                            </div>

                            <div class="col-md-6 form-group">
                                <label for="tipo">Tipo de caso</label>
                                <select id="tipo" class="custom-select">
                                    @foreach (var t in CatalogoCasos.Tipos)
                                    {
                                        <option value="@t.Codigo">@t.Etiqueta</option>
                                    }
                                </select>
                                <small class="form-text text-muted" id="marca-reservado" hidden><i class="bi bi-lock mr-1" aria-hidden="true"></i> Reservado: solo lo leen quienes lo atienden</small>
                                <p class="text-danger small mb-0" data-error="tipo"></p>
                            </div>

                            <div class="col-md-6 form-group">
                                <label for="fecha">Cuándo</label>
                                <input type="datetime-local" id="fecha" class="form-control" value="@ahora" max="@ahora" />
                                <p class="text-danger small mb-0" data-error="fecha"></p>
                            </div>

                            <div class="col-md-6 form-group">
                                <label for="lugar">Dónde</label>
                                <input id="lugar" class="form-control" maxlength="150" placeholder="Opcional" autocomplete="off" />
                                <p class="text-danger small mb-0" data-error="lugar"></p>
                            </div>

                            <div class="col-md-6 form-group">
                                <label for="atiende">Lo atiende</label>
                                <select id="atiende" class="custom-select">
                                    <option value="">Nadie todavía</option>
                                    @foreach (var e in M.Empleados)
                                    {
                                        <option value="@e.Emp_Id">@e.Nombre@(string.IsNullOrWhiteSpace(e.Cargo) ? "" : " · " + e.Cargo)</option>
                                    }
                                </select>
                                <p class="text-danger small mb-0" data-error="atiende"></p>
                            </div>

                            <div class="col-12 form-group">
                                <label for="descripcion">Qué pasó</label>
                                <textarea id="descripcion" class="form-control" rows="5" maxlength="5000"
                                          placeholder="Lo que usted vio, no lo que cree que significa"></textarea>
                                <p class="text-danger small mb-0" data-error="descripcion"></p>
                            </div>
                        </div>

                        <fieldset class="border-top pt-3 mb-3">
                            <legend class="h6 font-weight-bold w-auto">Personas</legend>
                            <ul class="list-unstyled mb-0" id="dis-filas"></ul>
                            <div class="mt-2">
                                <button type="button" class="btn btn-outline-primary" id="dis-agregar-persona">
                                    <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i> Agregar una persona
                                </button>
                            </div>
                        </fieldset>

                        <div class="d-flex justify-content-end border-top pt-3">
                            <a class="btn mr-2" href="@Url.Action("Index")">Cancelar</a>
                            <button type="submit" class="btn btn-primary" id="dis-guardar">Registrar el caso</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* Una fila de persona: se clona por cada "Agregar una persona" (la lista de alumnos va una sola vez). *@
    <template id="dis-plantilla-fila">
        <li class="form-row align-items-center mb-2">
            <div class="col-md-5 mb-1 mb-md-0">
                <label class="sr-only" data-for="alumno">Alumno</label>
                <select class="custom-select" data-campo="alumno">
                    <option value="">Elija un alumno</option>
                    @foreach (var a in M.Alumnos)
                    {
                        <option value="@a.Alu_Id">@a.Nombre@(string.IsNullOrWhiteSpace(a.Identidad) ? "" : " · " + a.Identidad)</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-1 mb-md-0">
                <label class="sr-only" data-for="papel">Por qué aparece</label>
                <select class="custom-select" data-campo="papel">
                    @foreach (var p in CatalogoCasos.Papeles)
                    {
                        <option value="@p.Codigo">@p.Etiqueta</option>
                    }
                </select>
            </div>
            <div class="col mb-1 mb-md-0">
                <label class="sr-only" data-for="nota">Nota</label>
                <input class="form-control" data-campo="nota" maxlength="255" placeholder="Nota (opcional)" autocomplete="off" />
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-outline-danger" data-quitar>
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
        </li>
    </template>
</div>

@section Scripts{
    <script src="~/Content/js/pages/disciplina.js" asp-append-version="true"></script>
}
