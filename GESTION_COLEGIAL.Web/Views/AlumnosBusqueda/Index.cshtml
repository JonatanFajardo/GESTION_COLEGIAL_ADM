@{
    ViewBag.Title = "Búsqueda de Alumnos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Búsqueda de Alumnos</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-magnifying-glass" style="font-size:32px;"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Búsqueda de Alumnos</h1>
                <p>Búsqueda global de alumnos</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="row mb-3">
            <div class="col-md-3">
                <input type="text" id="filter-Termino" class="form-control" placeholder="Buscar alumno..." value="">
            </div>
        <div class="col-md-2">
            <button class="btn btn-primary btn-sm w-100" id="btn-filtrar">
                <i class="fa-solid fa-filter"></i> Filtrar
            </button>
        </div>
    </div>
    <div class="card-listado-catalogo">
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="datatable-alumnosbusqueda">
                    <thead><tr><th>Alumno</th><th>Sección</th><th>Curso</th></tr></thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/alumnosbusqueda.js"></script>
    <script>
        AlumnosBusqueda.init("@Url.Action("ListAsync")");
    </script>
}
