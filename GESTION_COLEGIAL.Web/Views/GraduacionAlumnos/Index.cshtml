@{
    ViewBag.Title = "Graduación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link rel="stylesheet" href="~/Content/css/pages/graduados-directorio.css" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Graduación</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Graduación</h4>
        <p class="text-muted mb-0">Candidatos del ciclo actual, directorio de egresados y carga histórica.</p>
    </div>
</div>

<div>

    <!-- ═══════════════ Tabs del hub ═══════════════ -->
    <ul class="nav nav-tabs mb-4" role="tablist" id="grad-hub-tabs">
        <li class="nav-item"><a href="#" class="nav-link grad-hub-tab active" data-tab="candidatos" role="tab"><i class="bi bi-person-check-fill mr-1"></i> Candidatos</a></li>
        <li class="nav-item"><a href="#" class="nav-link grad-hub-tab" data-tab="directorio" role="tab"><i class="bi bi-mortarboard-fill mr-1"></i> Directorio de graduados</a></li>
        <li class="nav-item ml-auto"><a href="#" class="nav-link grad-hub-tab text-muted" data-tab="backfill" role="tab" title="Herramienta avanzada de carga histórica"><i class="bi bi-tools mr-1"></i> Backfill histórico</a></li>
    </ul>

    <!-- ═══════════════ TAB 1: CANDIDATOS ═══════════════ -->
    <div id="hub-panel-candidatos" class="grad-hub-panel active" role="tabpanel">

        <div class="statbox widget box box-shadow mb-4">
            <div class="d-flex flex-wrap align-items-center">
                <label for="nota-minima-input" class="mb-0 mr-2 font-weight-bold">
                    Nota mínima de aprobación:
                </label>
                <input type="number" id="nota-minima-input" class="form-control grad-nota-input mr-2" min="0" max="100" step="1" value="70" />
                <button id="btn-guardar-nota-minima" class="btn btn-outline-primary btn-sm mr-2" type="button">
                    <i class="bi bi-save mr-1"></i> Guardar
                </button>
                <small id="nota-minima-status" class="text-muted mr-2"></small>
                <small class="text-muted ml-auto">
                    Cambia el umbral usado para evaluar las notas finales de los candidatos.
                </small>
            </div>
        </div>

        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-header d-flex flex-wrap align-items-center justify-content-between">
                <h4>Listado de candidatos</h4>
                <button id="btn-graduar-seleccionados" class="btn btn-primary" disabled>
                    <i class="bi bi-mortarboard-fill mr-1"></i> Graduar seleccionados
                </button>
            </div>
            <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table id="tbl-candidatos" class="table table-hover w-100">
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="chk-all-candidatos" /></th>
                                <th>Alumno</th>
                                <th>Nivel</th>
                                <th>Curso</th>
                                <th>Sección</th>
                                <th>Notas</th>
                                <th>Deuda</th>
                                <th>Estado</th>
                                <th>Motivos de bloqueo</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════ TAB 2: DIRECTORIO DE GRADUADOS ═══════════════ -->
    <div id="hub-panel-directorio" class="grad-hub-panel" role="tabpanel">

        <!-- Sub-breadcrumb interno (drill-down promociones → detalle) -->
        <nav class="breadcrumb-style-one mb-3" aria-label="Navegación del directorio">
            <ol class="breadcrumb" id="grad-breadcrumb">
                <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                <li class="breadcrumb-item active" id="grad-breadcrumb-current">Directorio de graduados</li>
            </ol>
        </nav>

        <!-- VISTA 1: LANDING (promociones) -->
        <div id="grad-view-promociones">

            <!-- KPI cards -->
            <div class="row">
                <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                    <div class="widget widget-card-four">
                        <div class="widget-content">
                            <div class="w-content">
                                <div class="w-info">
                                    <h6 class="value" id="kpi-total">—</h6>
                                    <p>Total graduados</p>
                                </div>
                                <div><div class="w-icon"><i class="bi bi-mortarboard-fill"></i></div></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                    <div class="widget widget-card-four">
                        <div class="widget-content">
                            <div class="w-content">
                                <div class="w-info">
                                    <h6 class="value" id="kpi-promociones">—</h6>
                                    <p>Promociones</p>
                                </div>
                                <div><div class="w-icon"><i class="bi bi-calendar2-check"></i></div></div>
                            </div>
                            <p class="text-muted small mb-0 mt-2" id="kpi-promociones-hint"></p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                    <div class="widget widget-card-four">
                        <div class="widget-content">
                            <div class="w-content">
                                <div class="w-info">
                                    <h6 class="value" id="kpi-ultimo-anio">—</h6>
                                    <p>Más reciente</p>
                                </div>
                                <div><div class="w-icon"><i class="bi bi-star-fill"></i></div></div>
                            </div>
                            <p class="text-muted small mb-0 mt-2" id="kpi-ultimo-count"></p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12 layout-spacing">
                    <div class="widget widget-card-four">
                        <div class="widget-content">
                            <div class="w-content">
                                <div class="w-info">
                                    <h6 class="value" id="kpi-nivel-top">—</h6>
                                    <p>Nivel dominante</p>
                                </div>
                                <div><div class="w-icon"><i class="bi bi-bar-chart-line-fill"></i></div></div>
                            </div>
                            <p class="text-muted small mb-0 mt-2" id="kpi-nivel-top-pct"></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Toolbar: búsqueda de año + chips -->
            <div class="statbox widget box box-shadow mb-4">
                <div class="form-row align-items-center">
                    <div class="col-md-4 mb-2">
                        <input type="text" id="grad-search-promo" class="form-control" placeholder="Buscar promoción por año..." autocomplete="off" />
                    </div>
                    <div class="col-md-8 d-flex flex-wrap" id="grad-chips-niveles-promo">
                        <!-- Atajos generados dinámicamente -->
                    </div>
                </div>
            </div>

            <!-- Grid de promociones -->
            <div id="grad-promos-container">
                <div class="text-center text-muted py-5"><i class="bi bi-hourglass-split h2 d-block"></i>Cargando promociones...</div>
            </div>
        </div>

        <!-- VISTA 2: DETALLE DE PROMOCIÓN -->
        <div id="grad-view-detalle" style="display:none;">
            <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="btn-volver-promos">
                <i class="bi bi-arrow-left mr-1"></i> Volver a promociones
            </button>

            <div class="mb-4">
            <h4 class="mb-1"><i class="bi bi-mortarboard-fill text-primary mr-2"></i><span id="detalle-anio">Promoción 2025</span></h4>
            <p class="text-muted mb-0" id="detalle-sub">— egresados</p>
        </div>

        <div class="statbox widget box box-shadow mb-4">
            <div class="form-row align-items-center">
                <div class="col-md-4 mb-2">
                    <input type="text" id="grad-search-detalle" class="form-control" placeholder="Buscar por nombre, identidad o título..." autocomplete="off" />
                </div>
                <div class="col-md-8 d-flex flex-wrap" id="grad-chips-niveles-detalle">
                    <!-- Atajos generados dinámicamente -->
                </div>
            </div>
        </div>

            <div id="grad-detalle-container" class="row"></div>
        </div>
    </div>

    <!-- ═══════════════ TAB 3: BACKFILL HISTÓRICO ═══════════════ -->
    <div id="hub-panel-backfill" class="grad-hub-panel" role="tabpanel">

        <div class="alert alert-light-warning d-flex align-items-start mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill mr-2 mt-1"></i>
            <div>
                <strong>Herramienta avanzada de carga histórica (uso único).</strong>
                Procesa graduaciones antiguas en lote para poblar el directorio. Se ejecuta en
                <strong>modo simulación</strong> por defecto: revise el resultado antes de
                desmarcar la casilla y ejecutar la carga real.
            </div>
        </div>

        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-header">
                <div class="row"><div class="col-12"><h4>Parámetros</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <form id="form-backfill" class="form-inline" onsubmit="return false;">
                    <div class="form-group mr-3">
                        <label for="bf-anio" class="mr-2">Año:</label>
                        <input type="number" min="2000" max="2100" id="bf-anio" class="form-control" placeholder="(todos)" />
                    </div>
                    <div class="form-group mr-3">
                        <label for="bf-topn" class="mr-2">Top N:</label>
                        <input type="number" min="1" max="500" id="bf-topn" class="form-control" value="50" />
                    </div>
                    <div class="custom-control custom-checkbox mr-3">
                        <input type="checkbox" class="custom-control-input" id="bf-dryrun" checked />
                        <label class="custom-control-label" for="bf-dryrun">Simular (sin guardar)</label>
                    </div>
                    <button type="button" id="btn-ejecutar-backfill" class="btn btn-primary">
                        <i class="bi bi-play-fill mr-1"></i> Ejecutar
                    </button>
                </form>
            </div>
        </div>

        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-header">
                <div class="row"><div class="col-12"><h4>Resultado</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <div id="bf-resumen" class="mb-3"></div>
                <div class="table-responsive">
                    <table id="tbl-backfill" class="table table-hover w-100">
                        <thead>
                            <tr>
                                <th>Alu_Id</th>
                                <th>Alumno</th>
                                <th>Año</th>
                                <th>Resultado</th>
                                <th>Mensaje</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de ficha del graduado (tab Directorio) -->
<div class="modal fade" id="modal-graduado-detalle" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ficha del graduado</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body" id="modal-graduado-body">Cargando...</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btn-generar-constancia" disabled>
                    <i class="bi bi-file-earmark-pdf mr-1"></i> Generar constancia
                </button>
                <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/pages/constancia-graduado.js"></script>
    <script src="~/Content/js/pages/alumnosgraduados.js"></script>
    <script src="~/Content/js/pages/graduacionalumnos.backfill.js"></script>
    <script src="~/Content/js/pages/graduacionalumnos.js"></script>
    <script>
        // Tab 1: Candidatos (+ orquestación de tabs del hub)
        GraduacionAlumnos.init({
            listUrl:        '@Url.Action("ListCandidatosAsync")',
            graduarUrl:     '@Url.Action("GraduarAsync")',
            notaMinimaUrl:  '@Url.Action("NotaMinimaAsync")'
        });
        GraduacionAlumnos.initHub();

        // Tab 2: Directorio de graduados (endpoints existentes de AlumnosGraduados)
        AlumnosGraduados.init({
            listUrl: '@Url.Action("ListAsync", "AlumnosGraduados")',
            findUrl: '@Url.Action("FindAsync", "AlumnosGraduados")'
        });

        // Tab 3: Backfill histórico
        GraduacionBackfill.init({
            ejecutarUrl: '@Url.Action("BackfillAsync")'
        });
    </script>
}
