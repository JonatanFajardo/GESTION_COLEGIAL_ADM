@{
    ViewBag.Title = "Backfill de graduados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Backfill de graduados</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-text-catalogo">
                <h1>Backfill de graduados (histórico)</h1>
                <p>Procesa graduaciones antiguas en lote. Por defecto se ejecuta en modo simulación.</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="card-listado-catalogo">
        <div class="card-header-listado-catalogo">
            <h3>Parámetros</h3>
        </div>
        <div class="card-body">
            <form id="form-backfill" class="form-inline" onsubmit="return false;">
                <div class="form-group mr-3">
                    <label for="bf-anio" class="mr-2">Año:</label>
                    <input type="number" min="2000" max="2100" id="bf-anio" class="form-control" placeholder="(todos)" />
                </div>
                <div class="form-group mr-3">
                    <label for="bf-topn" class="mr-2">Top N:</label>
                    <input type="number" min="1" max="500" id="bf-topn" class="form-control" value="50" />
                </div>
                <div class="form-check mr-3">
                    <input type="checkbox" class="form-check-input" id="bf-dryrun" checked />
                    <label class="form-check-label" for="bf-dryrun">Dry-run (simular)</label>
                </div>
                <button type="button" id="btn-ejecutar-backfill" class="btn btn-primary">
                    <i class="bi bi-play-fill"></i> Ejecutar
                </button>
            </form>
        </div>
    </div>

    <div class="card-listado-catalogo mt-3">
        <div class="card-header-listado-catalogo">
            <h3>Resultado</h3>
        </div>
        <div class="card-body">
            <div id="bf-resumen" class="mb-3"></div>
            <div class="table-responsive">
                <table id="tbl-backfill" class="table table-striped" style="width:100%">
                    <thead>
                        <tr>
                            <th>Alu_Id</th>
                            <th>Alumno</th>
                            <th>Año</th>
                            <th>Resultado</th>
                            <th>Mensaje</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/pages/graduacionalumnos.backfill.js"></script>
    <script>
        GraduacionBackfill.init({
            ejecutarUrl: '@Url.Action("BackfillAsync")'
        });
    </script>
}
