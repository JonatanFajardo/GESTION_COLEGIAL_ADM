@{
    ViewBag.Title = "Reporte de Antigüedad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Reporte de Antigüedad</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Reporte de Antigüedad</h4>
        <p class="text-muted mb-0">Antigüedad laboral de empleados</p>
    </div>
</div>

<div class="fluid-container">
    <div class="statbox widget box box-shadow mb-3">
        <div class="widget-content widget-content-area">
            <div class="row align-items-end">
                <div class="col-md-5">
                    <label for="filtro-texto">Buscar por empleado o cargo</label>
                    <input type="text" id="filtro-texto" class="form-control" placeholder="Ej. Pérez, Docente..." />
                </div>
                <div class="col-md-2">
                    <label for="filtro-anios-min">Años (mín.)</label>
                    <input type="number" id="filtro-anios-min" class="form-control" min="0" placeholder="0" />
                </div>
                <div class="col-md-2">
                    <label for="filtro-anios-max">Años (máx.)</label>
                    <input type="number" id="filtro-anios-max" class="form-control" min="0" placeholder="—" />
                </div>
                <div class="col-md-2">
                    <button type="button" id="btn-filtrar" class="btn btn-primary w-100">
                        <i class="bi bi-filter"></i> Filtrar
                    </button>
                </div>
                <div class="col-md-1">
                    <button type="button" id="btn-limpiar-filtro" class="btn btn-outline-secondary w-100" title="Limpiar filtros">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable-empleadosantiguedad">
                    <thead><tr><th>Empleado</th><th>Cargo</th><th>Ingreso</th><th>Años</th></tr></thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/empleadosantiguedad.js"></script>
    <script>
        EmpleadosAntiguedad.init("@Url.Action("ListAsync")");
    </script>
}
