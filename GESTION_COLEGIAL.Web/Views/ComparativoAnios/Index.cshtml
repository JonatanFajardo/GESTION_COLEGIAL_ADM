@{
    ViewBag.Title = "Comparativo de Años";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/financiero-analisis.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Comparativo de Años</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Comparativo de Años</h4>
        <p class="text-muted mb-0">Comparación de matrícula entre dos periodos académicos</p>
    </div>
    <div class="mt-2 mt-md-0">
        <div class="d-flex flex-wrap align-items-center">
                <label for="filtro-anio-base" class="mb-0 mr-2">Año Base</label>
                <input type="number" class="form-control w-auto mr-3" id="filtro-anio-base" min="2000" max="2099" />
                <label for="filtro-anio-comparacion" class="mb-0 mr-2">vs.</label>
                <input type="number" class="form-control w-auto mr-3" id="filtro-anio-comparacion" min="2000" max="2099" />
                <button type="button" class="btn btn-primary" id="btn-filtrar"><i class="fas fa-rotate mr-1"></i> Comparar</button>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="ca-kpi-base">—</h6>
                        <p>Total Año Base</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-graduation-cap"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="ca-kpi-comp">—</h6>
                        <p>Total Año Comparación</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-graduation-cap"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="ca-kpi-dif">—</h6>
                        <p>Diferencia Total</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-arrow-right-arrow-left"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="ca-kpi-pct">—</h6>
                        <p>% Cambio Global</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-percent"></i></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 layout-spacing">
        <div class="statbox widget box box-shadow h-100">
            <div class="widget-header">
                <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4>Comparativo por Curso</h4><span id="ca-chart-subtitle" class="small text-muted"></span></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <canvas id="ca-chart" class="fin-chart-240"></canvas>
            </div>
        </div>
    </div>
    <div class="col-12 layout-spacing">
        <div class="statbox widget box box-shadow h-100">
            <div class="widget-header">
                <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4>Detalle por Curso</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <div id="ca-table-container">
                    <div class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin mr-2"></i>Cargando...</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/comparativoanios.js"></script>
    <script>
        ComparativoAnios.init("@Url.Action("ListAsync")");
    </script>
}
