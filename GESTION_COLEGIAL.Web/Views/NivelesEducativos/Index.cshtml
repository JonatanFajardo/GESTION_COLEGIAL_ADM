@model GESTION_COLEGIAL.Business.Models.NivelEducativoViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Niveles Educativos</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Niveles educativos</h4>
        <p class="text-muted mb-0">Administre los niveles educativos de la institución</p>
    </div>
    <div class="mt-2 mt-md-0">
        <button type="button" class="btn btn-primary" id="add-btn-header" data-toggle="modal" data-target="#edit-modal">
            <i class="bi bi-plus-lg mr-1"></i> Nuevo nivel
        </button>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="row"><div class="col-12"><h4>Listado de niveles educativos</h4></div></div>
    </div>
    <div class="widget-content widget-content-area">
        <div class="table-responsive">
            <table class="table table-hover nowrap" id="datatable">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal crear / editar -->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            @using (Ajax.BeginForm("CreateAsync", "NivelesEducativos", new AjaxOptions
            {
                HttpMethod = "Post",
                OnBegin = "Catalogs.begin",
                OnComplete = "Catalogs.complete",
                OnFailure = "Catalogs.failure",
                OnSuccess = "Catalogs.success"
            }))
            {
                @Html.HiddenFor(model => model.Niv_Id, new { @id = "item-id" })
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Nuevo nivel</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label for="Niv_Descripcion">Descripción <span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.Niv_Descripcion, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej: Primaria, Secundaria, Bachillerato" } })
                        @Html.ValidationMessageFor(model => model.Niv_Descripcion, "", new { @class = "text-danger small" })
                        <small class="form-text text-muted">Nivel educativo que desea registrar en la institución.</small>
                    </div>
                    <div class="form-group d-flex align-items-center justify-content-between">
                        <label for="Niv_EsActivo" class="mb-0">Activo</label>
                        <label class="switch s-icons s-outline s-outline-primary mb-0" title="Estado">
                            <input type="checkbox" id="Niv_EsActivo" name="Niv_EsActivo" />
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 mr-1"></i> Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal eliminar -->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        @using (Ajax.BeginForm("DeleteAsync", "NivelesEducativos", new AjaxOptions
        {
            HttpMethod = "Post",
            OnBegin = "Catalogs.begin",
            OnComplete = "Catalogs.complete",
            OnFailure = "Catalogs.failure",
            OnSuccess = "Catalogs.success"
        }))
        {
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalTitle">Eliminar nivel educativo</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    @Html.HiddenFor(model => model.Niv_Id, new { @id = "delete-item-id" })
                    <p class="mb-3">¿Está seguro de que desea eliminar el nivel educativo <strong id="delete-item-name"></strong>?</p>
                    <div class="alert alert-light-danger mb-0" role="alert">
                        <i class="fas fa-exclamation-triangle mr-1"></i>
                        <strong>Esta acción no se puede deshacer.</strong> El registro será eliminado permanentemente del sistema.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash mr-1"></i> Eliminar</button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal detalle -->
<div class="modal fade" id="detail-modal" tabindex="-1" role="dialog" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailModalLabel"><i class="fas fa-file-alt mr-1"></i> Detalle del nivel educativo</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">ID</p>
                        <p class="font-weight-bold mb-0" id="detail-niv-id"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Descripción</p>
                        <p class="font-weight-bold mb-0" id="detail-niv-descripcion"></p>
                    </div>
                </div>
                <h6 class="border-top pt-3 mb-3"><i class="fas fa-history mr-1"></i> Información de auditoría</h6>
                <div class="form-row">
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Creado por</p>
                        <p class="font-weight-bold mb-0" id="detail-niv-usuarioregistranombre"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Fecha de creación</p>
                        <p class="font-weight-bold mb-0" id="detail-niv-fecharegistra"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Modificado por</p>
                        <p class="font-weight-bold mb-0" id="detail-niv-usuariomodificanombre"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Fecha de modificación</p>
                        <p class="font-weight-bold mb-0" id="detail-niv-fechamodifica"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/niveleseducativos.js"></script>
    <script>
        NivelesEducativos.datatableCatalogs({
            urlList: "@Url.Action("ListAsync")",
            urlDetail: "@Url.Action("DetailAsync")"
        });
    </script>
    <script>
        Catalogs.configure({
            displayName: "nivel educativo",
            urlUpdate: "@Url.Action("FindAsync")"
        });
        CatalogsCfg.configure({
            displayName: "nivel educativo",
            getUrl: "@Url.Action("DetailAsync")"
        });
    </script>
}
