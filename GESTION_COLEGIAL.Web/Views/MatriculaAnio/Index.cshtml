@{
    ViewBag.Title = "Inscripción y promociones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/modal-detail.css" rel="stylesheet" />
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <style>
        .promo-grid { display:grid; grid-template-columns: 1fr 1fr; gap:20px; }
        @@media (max-width: 992px){ .promo-grid { grid-template-columns: 1fr; } }
        .promo-card { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:20px; }
        .promo-card h3 { font-size:1rem; font-weight:600; color:#1f2937; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
        .promo-card h3 .num { width:26px; height:26px; border-radius:50%; background:#4f46e5; color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:.8rem; }
        .promo-field { margin-bottom:14px; }
        .promo-field label { display:block; font-size:.8rem; font-weight:600; color:#374151; margin-bottom:6px; }
        .promo-field select { width:100%; padding:9px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:.9rem; background:#fff; }
        .promo-field select:disabled { background:#f3f4f6; color:#9ca3af; }
        .badge-estado { padding:.3em .65em; border-radius:999px; font-size:.72rem; font-weight:600; color:#fff; }
        .mes-1 { background:#10b981; } .mes-2 { background:#6366f1; } .mes-3 { background:#f59e0b; }
        .mes-4 { background:#ef4444; } .mes-5 { background:#0891b2; } .mes-0 { background:#9ca3af; }
        .promo-actions { margin-top:20px; display:flex; justify-content:flex-end; gap:12px; align-items:center; }
        .btn-promover { background:#4f46e5; color:#fff; border:none; border-radius:8px; padding:11px 22px; font-weight:600; font-size:.9rem; cursor:pointer; }
        .btn-promover:disabled { background:#c7d2fe; cursor:not-allowed; }
        .promo-hint { color:#6b7280; font-size:.8rem; }
        .link-exp { background:none; border:none; color:#4f46e5; cursor:pointer; padding:0; font-size:.85rem; text-decoration:underline; }

        /* Pestañas e inscripción del año */
        .ins-tabs { margin-bottom:20px; border-bottom:1px solid #e5e7eb; }
        .ins-tabs .nav-link { color:#4b5563; font-weight:600; border:none; border-bottom:3px solid transparent; padding:10px 16px; }
        .ins-tabs .nav-link.active { color:#4f46e5; border-bottom-color:#4f46e5; background:transparent; }
        .ins-top { display:flex; flex-wrap:wrap; gap:16px 24px; align-items:flex-end; margin-bottom:18px; }
        .ins-top .promo-hint { flex:1; min-width:240px; }
        .ins-kpis { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:12px; margin-bottom:18px; }
        @@media (max-width: 768px){ .ins-kpis { grid-template-columns:repeat(2, minmax(0, 1fr)); } }
        .ins-kpi { border-radius:10px; padding:12px 14px; display:flex; flex-direction:column; gap:2px; border:1px solid transparent; }
        .ins-kpi-num { font-size:1.5rem; font-weight:700; line-height:1.1; }
        .ins-kpi-lbl { font-size:.78rem; font-weight:600; }
        .ins-kpi-indigo { background:#eef2ff; border-color:#c7d2fe; color:#3730a3; }
        .ins-kpi-emerald { background:#ecfdf5; border-color:#a7f3d0; color:#065f46; }
        .ins-kpi-amber { background:#fffbeb; border-color:#fde68a; color:#92400e; }
        .ins-kpi-cyan { background:#ecfeff; border-color:#a5f3fc; color:#155e75; }
        .ins-acciones { display:flex; flex-wrap:wrap; gap:12px 20px; align-items:center; justify-content:space-between; }
        .ins-check { display:flex; gap:8px; align-items:center; font-size:.85rem; color:#374151; margin:0; cursor:pointer; }
        .ins-botones { display:flex; flex-wrap:wrap; gap:10px; }
        .btn-sec { background:#fff; color:#4f46e5; border:1px solid #c7d2fe; border-radius:8px; padding:10px 18px; font-weight:600; font-size:.9rem; cursor:pointer; }
        .btn-sec:disabled { color:#a5b4fc; border-color:#e0e7ff; cursor:not-allowed; }
        .ins-resultado { margin-top:16px; padding:10px 14px; border-radius:8px; background:#ecfdf5; border:1px solid #a7f3d0; color:#065f46; font-size:.875rem; }
        .ins-ok { color:#047857; font-weight:600; }
        .ins-falta { color:#b45309; font-weight:600; }
        .ins-pend { display:inline-block; min-width:28px; padding:.15em .55em; border-radius:999px; background:#fef3c7; color:#92400e; font-weight:700; }
    </style>
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Inscripción y promociones</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo"><i class="fas fa-user-graduate" style="font-size:28px;"></i></div>
            <div class="header-text-catalogo">
                <h1>Inscripción y promociones</h1>
                <p>Inscriba a los alumnos en el año lectivo y, al cerrarlo, páselos al año siguiente.</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">
    <ul class="nav nav-tabs ins-tabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#tab-inscripcion" role="tab" aria-controls="tab-inscripcion" aria-selected="true">
                <i class="bi bi-person-check"></i> Inscripción del año
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#tab-promover" role="tab" aria-controls="tab-promover" aria-selected="false">
                <i class="fas fa-arrow-right"></i> Promover al año siguiente
            </a>
        </li>
    </ul>

    <div class="tab-content">
    <!-- INSCRIPCIÓN DEL AÑO -->
    <div class="tab-pane fade show active" id="tab-inscripcion" role="tabpanel">
        <div class="promo-card">
            <div class="ins-top">
                <div class="promo-field" style="min-width:240px;margin-bottom:0;">
                    <label for="anioInscripcion">Año lectivo</label>
                    <select id="anioInscripcion"><option value="">Cargando…</option></select>
                </div>
                <p class="promo-hint" style="margin:0;">
                    Se inscribe a los alumnos cuyo <strong>año cursado</strong> coincide con el año, en la sección del año
                    de su ubicación (nivel, grado, modalidad y sección). Los alumnos nuevos de Matrícula quedan inscritos solos.
                </p>
            </div>

            <div class="ins-kpis">
                <div class="ins-kpi ins-kpi-indigo"><span class="ins-kpi-num" id="kpiAlumnos">—</span><span class="ins-kpi-lbl">Alumnos del año</span></div>
                <div class="ins-kpi ins-kpi-emerald"><span class="ins-kpi-num" id="kpiInscritos">—</span><span class="ins-kpi-lbl">Inscritos</span></div>
                <div class="ins-kpi ins-kpi-amber"><span class="ins-kpi-num" id="kpiPendientes">—</span><span class="ins-kpi-lbl">Por inscribir</span></div>
                <div class="ins-kpi ins-kpi-cyan"><span class="ins-kpi-num" id="kpiSinSeccion">—</span><span class="ins-kpi-lbl">Grupos sin sección del año</span></div>
            </div>

            <div class="ins-acciones">
                <label class="ins-check">
                    <input type="checkbox" id="chkActivar" checked />
                    Pasar a <strong>Activo</strong> a los inscritos que figuren como <strong>Graduado</strong>
                </label>
                <div class="ins-botones">
                    <button type="button" class="btn-sec" id="btnCrearSecciones" disabled>
                        <i class="bi bi-diagram-3"></i> Crear secciones que faltan
                    </button>
                    <button type="button" class="btn-promover" id="btnInscribir" disabled>
                        <i class="bi bi-person-check"></i> Inscribir a todos
                    </button>
                </div>
            </div>
            <div class="ins-resultado" id="insResultado" style="display:none;" role="status"></div>
        </div>

        <div class="card-listado-catalogo" style="margin-top:20px;">
            <div class="card-header-listado-catalogo">
                <h3><i class="fas fa-layer-group"></i> Grupos del año</h3>
            </div>
            <div class="card-body-listado-catalogo">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered nowrap" id="tablaInscripcion" style="width:100%">
                        <thead>
                            <tr><th>Grupo</th><th>Sección del año</th><th>Alumnos</th><th>Inscritos</th><th>Por inscribir</th></tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- PROMOVER AL AÑO SIGUIENTE -->
    <div class="tab-pane fade" id="tab-promover" role="tabpanel">
    <div class="promo-grid">
        <!-- ORIGEN -->
        <div class="promo-card">
            <h3><span class="num">1</span> Sección de origen</h3>
            <div class="promo-field">
                <label>Año lectivo</label>
                <select id="anioOrigen"><option value="">Seleccione…</option></select>
            </div>
            <div class="promo-field">
                <label>Sección-año</label>
                <select id="seccionOrigen" disabled><option value="">Seleccione un año primero…</option></select>
            </div>
        </div>
        <!-- DESTINO -->
        <div class="promo-card">
            <h3><span class="num">2</span> Sección de destino</h3>
            <div class="promo-field">
                <label>Año lectivo</label>
                <select id="anioDestino"><option value="">Seleccione…</option></select>
            </div>
            <div class="promo-field">
                <label>Sección-año</label>
                <select id="seccionDestino" disabled><option value="">Seleccione un año primero…</option></select>
            </div>
        </div>
    </div>

    <!-- ALUMNOS DE LA SECCIÓN ORIGEN -->
    <div class="card-listado-catalogo" style="margin-top:20px;">
        <div class="card-header-listado-catalogo">
            <h3><i class="fas fa-users"></i> Alumnos de la sección de origen</h3>
        </div>
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="tablaAlumnos" style="width:100%">
                    <thead>
                        <tr><th>Alumno</th><th>Estado</th><th>Expediente</th></tr>
                    </thead>
                </table>
            </div>
            <div class="promo-actions">
                <span class="promo-hint" id="promoHint">Solo se promueven alumnos en estado <strong>Activa</strong>.</span>
                <button type="button" class="btn-promover" id="btnPromover" disabled>
                    <i class="fas fa-arrow-right"></i> Promover
                </button>
            </div>
        </div>
    </div>

    </div>
    </div>

    <!-- Modal de confirmación (inscripción) -->
    <div class="modal fade" id="ins-confirm" tabindex="-1" role="dialog" aria-labelledby="ins-confirm-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document" style="max-width:520px;">
            <div class="modal-content" style="border-radius:12px;border:none;">
                <div class="modal-header" style="border-bottom:1px solid #eef2f7;">
                    <h5 class="modal-title" id="ins-confirm-title" style="font-weight:600;color:#1f2937;">Confirmar</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body" id="ins-confirm-body" style="color:#374151;"></div>
                <div class="modal-footer" style="border-top:1px solid #eef2f7;">
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn-promover" id="ins-confirm-ok">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Expediente -->
    <div class="modal fade" id="exp-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document" style="max-width:640px;">
            <div class="modal-content" style="border-radius:12px;border:none;">
                <div class="modal-header" style="border-bottom:1px solid #eef2f7;">
                    <h5 class="modal-title" id="exp-title" style="font-weight:600;color:#1f2937;">Expediente</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm table-bordered" style="width:100%;font-size:.85rem;">
                        <thead><tr><th>Año</th><th>Sección</th><th>Estado</th></tr></thead>
                        <tbody id="exp-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        var Promociones = (function () {
            var tabla;
            var urls = {
                anios: "@Url.Action("AniosAsync")",
                secciones: "@Url.Action("SeccionesAsync")",
                listBySeccion: "@Url.Action("ListBySeccionAsync")",
                expediente: "@Url.Action("ExpedienteAsync")",
                promover: "@Url.Action("PromoverAsync")"
            };

            function notify(type, msg) {
                if (!msg) msg = (type === "error" ? "Ocurrió un error." : "Operación exitosa.");
                try { if (window.toastr) { toastr[type === "error" ? "error" : "success"](msg); return; } } catch (e) {}
                try { if (window.Swal) { Swal.fire({ icon: type === "error" ? "error" : "success", title: msg, timer: 2200, showConfirmButton: false }); return; } } catch (e) {}
                alert(msg);
            }

            function fillAnios($sel) {
                return $.getJSON(urls.anios).done(function (resp) {
                    var rows = (resp && resp.data) || [];
                    $sel.empty().append('<option value="">Seleccione…</option>');
                    rows.forEach(function (r) {
                        $sel.append('<option value="' + r.Ani_Id + '">' + r.Ani_Nombre + ' · ' + (r.Ani_EstadoDescripcion || '') + '</option>');
                    });
                });
            }

            function fillSecciones($sel, aniId) {
                $sel.prop("disabled", true).empty().append('<option value="">Cargando…</option>');
                return $.getJSON(urls.secciones, { aniId: aniId }).done(function (resp) {
                    var rows = (resp && resp.data) || [];
                    $sel.empty().append('<option value="">Seleccione…</option>');
                    rows.forEach(function (r) {
                        var etq = r.Sea_Nombre || ((r.Cun_Descripcion || '') + ' ' + (r.Sec_Descripcion || ''));
                        $sel.append('<option value="' + r.Sea_Id + '">' + etq + '</option>');
                    });
                    $sel.prop("disabled", rows.length === 0);
                    if (rows.length === 0) $sel.empty().append('<option value="">Sin secciones en este año</option>');
                });
            }

            function cargarAlumnos(seaId) {
                tabla.clear().draw();
                if (!seaId) { refreshBtn(); return; }
                $.getJSON(urls.listBySeccion, { seaId: seaId }).done(function (resp) {
                    var rows = (resp && resp.data) || [];
                    tabla.rows.add(rows).draw();
                    refreshBtn();
                });
            }

            function refreshBtn() {
                var ok = $("#anioOrigen").val() && $("#seccionOrigen").val()
                    && $("#anioDestino").val() && $("#seccionDestino").val()
                    && (tabla.rows().count() > 0)
                    && ($("#seccionOrigen").val() !== $("#seccionDestino").val());
                $("#btnPromover").prop("disabled", !ok);
            }

            function verExpediente(aluId, nombre) {
                $.getJSON(urls.expediente, { aluId: aluId }).done(function (resp) {
                    var rows = (resp && resp.data) || [];
                    $("#exp-title").text("Expediente · " + nombre);
                    var $b = $("#exp-body").empty();
                    if (rows.length === 0) { $b.append('<tr><td colspan="3" class="text-center">Sin historial.</td></tr>'); }
                    rows.forEach(function (r) {
                        $b.append('<tr><td>' + (r.Ani_Nombre || '') + '</td><td>' + (r.Sea_Nombre || '—') +
                            '</td><td><span class="badge-estado mes-' + (r.Mta_Estado || 0) + '">' + (r.Mta_EstadoDescripcion || '') + '</span></td></tr>');
                    });
                    $("#exp-modal").modal("show");
                });
            }

            function promover() {
                var data = {
                    anioOrigen: $("#anioOrigen").val(),
                    seccionOrigen: $("#seccionOrigen").val(),
                    anioDestino: $("#anioDestino").val(),
                    seccionDestino: $("#seccionDestino").val()
                };
                $("#btnPromover").prop("disabled", true);
                $.post(urls.promover, data).done(function (resp) {
                    if (resp && resp.success) {
                        notify("success", resp.message);
                        cargarAlumnos($("#seccionOrigen").val());
                    } else {
                        notify("error", resp && resp.message);
                        refreshBtn();
                    }
                }).fail(function () { notify("error"); refreshBtn(); });
            }

            function init() {
                tabla = $("#tablaAlumnos").DataTable({
                    data: [],
                    language: { url: "https://cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json" },
                    columns: [
                        { data: "Alu_Nombre" },
                        { data: null, orderable: false, render: function (r) { return '<span class="badge-estado mes-' + (r.Mta_Estado || 0) + '">' + (r.Mta_EstadoDescripcion || '') + '</span>'; } },
                        { data: null, orderable: false, render: function (r) { return '<button type="button" class="link-exp" data-alu="' + r.Alu_Id + '" data-name="' + (r.Alu_Nombre || '') + '">Ver historial</button>'; } }
                    ]
                });

                fillAnios($("#anioOrigen"));
                fillAnios($("#anioDestino"));

                $("#anioOrigen").on("change", function () {
                    var v = $(this).val();
                    if (v) fillSecciones($("#seccionOrigen"), v).always(refreshBtn);
                    else { $("#seccionOrigen").prop("disabled", true).empty().append('<option value="">Seleccione un año primero…</option>'); }
                    tabla.clear().draw(); refreshBtn();
                });
                $("#anioDestino").on("change", function () {
                    var v = $(this).val();
                    if (v) fillSecciones($("#seccionDestino"), v).always(refreshBtn);
                    else { $("#seccionDestino").prop("disabled", true).empty().append('<option value="">Seleccione un año primero…</option>'); }
                    refreshBtn();
                });
                $("#seccionOrigen").on("change", function () { cargarAlumnos($(this).val()); });
                $("#seccionDestino").on("change", refreshBtn);

                $("#tablaAlumnos tbody").on("click", ".link-exp", function () {
                    verExpediente($(this).data("alu"), $(this).data("name"));
                });
                $("#btnPromover").on("click", promover);
            }

            return { init: init };
        })();

        var Inscripcion = (function () {
            var tabla;
            var resumen = [];
            var urls = {
                anios: "@Url.Action("AniosAsync")",
                resumen: "@Url.Action("ResumenInscripcionAsync")",
                crearSecciones: "@Url.Action("CrearSeccionesAsync")",
                inscribir: "@Url.Action("InscribirAsync")"
            };

            function esc(s) { return $("<div>").text(s == null ? "" : s).html(); }

            function notify(type, msg) {
                if (!msg) msg = (type === "error" ? "Ocurrió un error." : "Operación exitosa.");
                try { if (window.toastr) { toastr[type === "error" ? "error" : "success"](msg); return; } } catch (e) {}
                alert(msg);
            }

            function totales(rows) {
                var t = { alumnos: 0, inscritos: 0, pendientes: 0, sinSeccion: 0 };
                (rows || []).forEach(function (r) {
                    t.alumnos += r.Alumnos || 0;
                    t.inscritos += r.Inscritos || 0;
                    t.pendientes += r.Pendientes || 0;
                    if (!r.Sea_Id) t.sinSeccion++;
                });
                return t;
            }

            function pintarKpis(rows) {
                if (!rows) {
                    $("#kpiAlumnos, #kpiInscritos, #kpiPendientes, #kpiSinSeccion").text("—");
                    $("#btnCrearSecciones, #btnInscribir").prop("disabled", true);
                    return;
                }
                var t = totales(rows);
                $("#kpiAlumnos").text(t.alumnos);
                $("#kpiInscritos").text(t.inscritos);
                $("#kpiPendientes").text(t.pendientes);
                $("#kpiSinSeccion").text(t.sinSeccion);
                $("#btnCrearSecciones").prop("disabled", t.sinSeccion === 0)
                    .html('<i class="bi bi-diagram-3"></i> Crear secciones que faltan' + (t.sinSeccion ? " (" + t.sinSeccion + ")" : ""));
                $("#btnInscribir").prop("disabled", t.pendientes === 0)
                    .html('<i class="bi bi-person-check"></i> Inscribir a todos' + (t.pendientes ? " (" + t.pendientes + ")" : ""));
            }

            function cargarResumen() {
                var aniId = $("#anioInscripcion").val();
                tabla.clear().draw();
                pintarKpis(null);
                if (!aniId) return;
                $.getJSON(urls.resumen, { aniId: aniId }).done(function (resp) {
                    resumen = (resp && resp.data) || [];
                    tabla.rows.add(resumen).draw();
                    pintarKpis(resumen);
                }).fail(function () { notify("error", "No se pudo cargar la inscripción del año."); });
            }

            function cargarAnios() {
                $.getJSON(urls.anios).done(function (resp) {
                    var rows = (resp && resp.data) || [];
                    var $s = $("#anioInscripcion").empty();
                    var activo = null;
                    rows.forEach(function (r) {
                        $s.append('<option value="' + r.Ani_Id + '">' + esc(r.Ani_Nombre) + " · " + esc(r.Ani_EstadoDescripcion || "") + (r.Ani_EsActual ? " (año activo)" : "") + "</option>");
                        if (r.Ani_EsActual) activo = r.Ani_Id;
                    });
                    if (rows.length === 0) $s.append('<option value="">No hay años lectivos</option>');
                    if (activo) $s.val(activo);
                    cargarResumen();
                });
            }

            function confirmar(titulo, cuerpo, alAceptar) {
                $("#ins-confirm-title").text(titulo);
                $("#ins-confirm-body").html(cuerpo);
                $("#ins-confirm-ok").off("click").on("click", function () {
                    $("#ins-confirm").modal("hide");
                    alAceptar();
                });
                $("#ins-confirm").modal("show");
            }

            function ejecutar(url, data, $btn) {
                var htmlOriginal = $btn.html();
                $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Procesando…');
                $.post(url, data).done(function (resp) {
                    if (resp && resp.success) {
                        notify("success", resp.message);
                        $("#insResultado").html('<i class="bi bi-check-circle"></i> ' + esc(resp.message)).show();
                    } else {
                        notify("error", resp && resp.message);
                    }
                }).fail(function () {
                    notify("error");
                }).always(function () {
                    $btn.html(htmlOriginal);
                    cargarResumen();
                });
            }

            function crearSecciones() {
                var t = totales(resumen);
                confirmar("Crear secciones del año",
                    "<p>Se crearán <strong>" + t.sinSeccion + "</strong> sección(es) del año, una por cada grupo de alumnos que todavía no la tiene.</p>" +
                    '<p class="promo-hint" style="margin:0;">Quedan sin profesor guía: se asigna después en el wizard del año (paso 3).</p>',
                    function () { ejecutar(urls.crearSecciones, { aniId: $("#anioInscripcion").val() }, $("#btnCrearSecciones")); });
            }

            function inscribir() {
                var t = totales(resumen);
                var activar = $("#chkActivar").is(":checked");
                confirmar("Inscribir alumnos en el año",
                    "<p>Se inscribirá a <strong>" + t.pendientes + "</strong> alumno(s) en su sección del año" +
                    (t.sinSeccion ? "; antes se crearán las <strong>" + t.sinSeccion + "</strong> sección(es) que faltan" : "") + ".</p>" +
                    (activar ? "<p style=\"margin:0;\">Los inscritos que figuren como <strong>Graduado</strong> pasarán a <strong>Activo</strong>.</p>" : ""),
                    function () { ejecutar(urls.inscribir, { aniId: $("#anioInscripcion").val(), activarEstado: activar }, $("#btnInscribir")); });
            }

            function init() {
                tabla = $("#tablaInscripcion").DataTable({
                    data: [],
                    order: [],
                    pageLength: 25,
                    language: { url: "https://cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json" },
                    columns: [
                        { data: null, render: function (r) {
                            return "<strong>" + esc(r.Cun_Descripcion) + " " + esc(r.Sec_Descripcion) + "</strong>" + (r.Mda_Descripcion ? " · " + esc(r.Mda_Descripcion) : "") +
                                '<div class="promo-hint">' + esc(r.Niv_Descripcion || "") + "</div>";
                        } },
                        { data: null, render: function (r) {
                            return r.Sea_Id
                                ? '<span class="ins-ok"><i class="bi bi-check-circle-fill"></i> ' + esc(r.Sea_Nombre) + "</span>"
                                : '<span class="ins-falta"><i class="bi bi-exclamation-circle"></i> Falta crear</span>';
                        } },
                        { data: "Alumnos", className: "text-right" },
                        { data: "Inscritos", className: "text-right" },
                        { data: null, className: "text-right", render: function (r) {
                            return r.Pendientes > 0
                                ? '<span class="ins-pend">' + r.Pendientes + "</span>"
                                : '<span class="ins-ok"><i class="bi bi-check2"></i> 0</span>';
                        } }
                    ]
                });

                cargarAnios();
                $("#anioInscripcion").on("change", function () { $("#insResultado").hide(); cargarResumen(); });
                $("#btnCrearSecciones").on("click", crearSecciones);
                $("#btnInscribir").on("click", inscribir);

                // Las tablas dentro de pestañas recalculan su ancho al mostrarse.
                $('a[data-toggle="tab"]').on("shown.bs.tab", function () {
                    $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                });
            }

            return { init: init };
        })();

        $(function () { Promociones.init(); Inscripcion.init(); });
    </script>
}
