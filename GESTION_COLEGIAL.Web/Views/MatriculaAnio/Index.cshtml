@{
    ViewBag.Title = "Promociones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/modal-detail.css" rel="stylesheet" />
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <style>
        .promo-grid { display:grid; grid-template-columns: 1fr 1fr; gap:20px; }
        @@media (max-width: 992px){ .promo-grid { grid-template-columns: 1fr; } }
        .promo-card { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:20px; }
        .promo-card h3 { font-size:1rem; font-weight:600; color:#1f2937; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
        .promo-card h3 .num { width:26px; height:26px; border-radius:50%; background:#4f46e5; color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:.8rem; }
        .promo-field { margin-bottom:14px; }
        .promo-field label { display:block; font-size:.8rem; font-weight:600; color:#374151; margin-bottom:6px; }
        .promo-field select { width:100%; padding:9px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:.9rem; background:#fff; }
        .promo-field select:disabled { background:#f3f4f6; color:#9ca3af; }
        .badge-estado { padding:.3em .65em; border-radius:999px; font-size:.72rem; font-weight:600; color:#fff; }
        .mes-1 { background:#10b981; } .mes-2 { background:#6366f1; } .mes-3 { background:#f59e0b; }
        .mes-4 { background:#ef4444; } .mes-5 { background:#0891b2; } .mes-0 { background:#9ca3af; }
        .promo-actions { margin-top:20px; display:flex; justify-content:flex-end; gap:12px; align-items:center; }
        .btn-promover { background:#4f46e5; color:#fff; border:none; border-radius:8px; padding:11px 22px; font-weight:600; font-size:.9rem; cursor:pointer; }
        .btn-promover:disabled { background:#c7d2fe; cursor:not-allowed; }
        .promo-hint { color:#6b7280; font-size:.8rem; }
        .link-exp { background:none; border:none; color:#4f46e5; cursor:pointer; padding:0; font-size:.85rem; text-decoration:underline; }
    </style>
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Promociones</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo"><i class="fas fa-user-graduate" style="font-size:28px;"></i></div>
            <div class="header-text-catalogo">
                <h1>Promociones</h1>
                <p>Pase de alumnos de un año lectivo al siguiente. Elija la sección de origen, revise los alumnos y promueva a la sección destino.</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="promo-grid">
        <!-- ORIGEN -->
        <div class="promo-card">
            <h3><span class="num">1</span> Sección de origen</h3>
            <div class="promo-field">
                <label>Año lectivo</label>
                <select id="anioOrigen"><option value="">Seleccione…</option></select>
            </div>
            <div class="promo-field">
                <label>Sección-año</label>
                <select id="seccionOrigen" disabled><option value="">Seleccione un año primero…</option></select>
            </div>
        </div>
        <!-- DESTINO -->
        <div class="promo-card">
            <h3><span class="num">2</span> Sección de destino</h3>
            <div class="promo-field">
                <label>Año lectivo</label>
                <select id="anioDestino"><option value="">Seleccione…</option></select>
            </div>
            <div class="promo-field">
                <label>Sección-año</label>
                <select id="seccionDestino" disabled><option value="">Seleccione un año primero…</option></select>
            </div>
        </div>
    </div>

    <!-- ALUMNOS DE LA SECCIÓN ORIGEN -->
    <div class="card-listado-catalogo" style="margin-top:20px;">
        <div class="card-header-listado-catalogo">
            <h3><i class="fas fa-users"></i> Alumnos de la sección de origen</h3>
        </div>
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="tablaAlumnos" style="width:100%">
                    <thead>
                        <tr><th>Alumno</th><th>Estado</th><th>Expediente</th></tr>
                    </thead>
                </table>
            </div>
            <div class="promo-actions">
                <span class="promo-hint" id="promoHint">Solo se promueven alumnos en estado <strong>Activa</strong>.</span>
                <button type="button" class="btn-promover" id="btnPromover" disabled>
                    <i class="fas fa-arrow-right"></i> Promover
                </button>
            </div>
        </div>
    </div>

    <!-- Modal Expediente -->
    <div class="modal fade" id="exp-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document" style="max-width:640px;">
            <div class="modal-content" style="border-radius:12px;border:none;">
                <div class="modal-header" style="border-bottom:1px solid #eef2f7;">
                    <h5 class="modal-title" id="exp-title" style="font-weight:600;color:#1f2937;">Expediente</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm table-bordered" style="width:100%;font-size:.85rem;">
                        <thead><tr><th>Año</th><th>Sección</th><th>Estado</th></tr></thead>
                        <tbody id="exp-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        var Promociones = (function () {
            var tabla;
            var urls = {
                anios: "@Url.Action("AniosAsync")",
                secciones: "@Url.Action("SeccionesAsync")",
                listBySeccion: "@Url.Action("ListBySeccionAsync")",
                expediente: "@Url.Action("ExpedienteAsync")",
                promover: "@Url.Action("PromoverAsync")"
            };

            function notify(type, msg) {
                if (!msg) msg = (type === "error" ? "Ocurrió un error." : "Operación exitosa.");
                try { if (window.toastr) { toastr[type === "error" ? "error" : "success"](msg); return; } } catch (e) {}
                try { if (window.Swal) { Swal.fire({ icon: type === "error" ? "error" : "success", title: msg, timer: 2200, showConfirmButton: false }); return; } } catch (e) {}
                alert(msg);
            }

            function fillAnios($sel) {
                return $.getJSON(urls.anios).done(function (resp) {
                    var rows = (resp && resp.data) || [];
                    $sel.empty().append('<option value="">Seleccione…</option>');
                    rows.forEach(function (r) {
                        $sel.append('<option value="' + r.Ani_Id + '">' + r.Ani_Nombre + ' · ' + (r.Ani_EstadoDescripcion || '') + '</option>');
                    });
                });
            }

            function fillSecciones($sel, aniId) {
                $sel.prop("disabled", true).empty().append('<option value="">Cargando…</option>');
                return $.getJSON(urls.secciones, { aniId: aniId }).done(function (resp) {
                    var rows = (resp && resp.data) || [];
                    $sel.empty().append('<option value="">Seleccione…</option>');
                    rows.forEach(function (r) {
                        var etq = r.Sea_Nombre || ((r.Cun_Descripcion || '') + ' ' + (r.Sec_Descripcion || ''));
                        $sel.append('<option value="' + r.Sea_Id + '">' + etq + '</option>');
                    });
                    $sel.prop("disabled", rows.length === 0);
                    if (rows.length === 0) $sel.empty().append('<option value="">Sin secciones en este año</option>');
                });
            }

            function cargarAlumnos(seaId) {
                tabla.clear().draw();
                if (!seaId) { refreshBtn(); return; }
                $.getJSON(urls.listBySeccion, { seaId: seaId }).done(function (resp) {
                    var rows = (resp && resp.data) || [];
                    tabla.rows.add(rows).draw();
                    refreshBtn();
                });
            }

            function refreshBtn() {
                var ok = $("#anioOrigen").val() && $("#seccionOrigen").val()
                    && $("#anioDestino").val() && $("#seccionDestino").val()
                    && (tabla.rows().count() > 0)
                    && ($("#seccionOrigen").val() !== $("#seccionDestino").val());
                $("#btnPromover").prop("disabled", !ok);
            }

            function verExpediente(aluId, nombre) {
                $.getJSON(urls.expediente, { aluId: aluId }).done(function (resp) {
                    var rows = (resp && resp.data) || [];
                    $("#exp-title").text("Expediente · " + nombre);
                    var $b = $("#exp-body").empty();
                    if (rows.length === 0) { $b.append('<tr><td colspan="3" class="text-center">Sin historial.</td></tr>'); }
                    rows.forEach(function (r) {
                        $b.append('<tr><td>' + (r.Ani_Nombre || '') + '</td><td>' + (r.Sea_Nombre || '—') +
                            '</td><td><span class="badge-estado mes-' + (r.Mta_Estado || 0) + '">' + (r.Mta_EstadoDescripcion || '') + '</span></td></tr>');
                    });
                    $("#exp-modal").modal("show");
                });
            }

            function promover() {
                var data = {
                    anioOrigen: $("#anioOrigen").val(),
                    seccionOrigen: $("#seccionOrigen").val(),
                    anioDestino: $("#anioDestino").val(),
                    seccionDestino: $("#seccionDestino").val()
                };
                $("#btnPromover").prop("disabled", true);
                $.post(urls.promover, data).done(function (resp) {
                    if (resp && resp.success) {
                        notify("success", resp.message);
                        cargarAlumnos($("#seccionOrigen").val());
                    } else {
                        notify("error", resp && resp.message);
                        refreshBtn();
                    }
                }).fail(function () { notify("error"); refreshBtn(); });
            }

            function init() {
                tabla = $("#tablaAlumnos").DataTable({
                    data: [],
                    language: { url: "//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json" },
                    columns: [
                        { data: "Alu_Nombre" },
                        { data: null, orderable: false, render: function (r) { return '<span class="badge-estado mes-' + (r.Mta_Estado || 0) + '">' + (r.Mta_EstadoDescripcion || '') + '</span>'; } },
                        { data: null, orderable: false, render: function (r) { return '<button type="button" class="link-exp" data-alu="' + r.Alu_Id + '" data-name="' + (r.Alu_Nombre || '') + '">Ver historial</button>'; } }
                    ]
                });

                fillAnios($("#anioOrigen"));
                fillAnios($("#anioDestino"));

                $("#anioOrigen").on("change", function () {
                    var v = $(this).val();
                    if (v) fillSecciones($("#seccionOrigen"), v).always(refreshBtn);
                    else { $("#seccionOrigen").prop("disabled", true).empty().append('<option value="">Seleccione un año primero…</option>'); }
                    tabla.clear().draw(); refreshBtn();
                });
                $("#anioDestino").on("change", function () {
                    var v = $(this).val();
                    if (v) fillSecciones($("#seccionDestino"), v).always(refreshBtn);
                    else { $("#seccionDestino").prop("disabled", true).empty().append('<option value="">Seleccione un año primero…</option>'); }
                    refreshBtn();
                });
                $("#seccionOrigen").on("change", function () { cargarAlumnos($(this).val()); });
                $("#seccionDestino").on("change", refreshBtn);

                $("#tablaAlumnos tbody").on("click", ".link-exp", function () {
                    verExpediente($(this).data("alu"), $(this).data("name"));
                });
                $("#btnPromover").on("click", promover);
            }

            return { init: init };
        })();

        $(function () { Promociones.init(); });
    </script>
}
