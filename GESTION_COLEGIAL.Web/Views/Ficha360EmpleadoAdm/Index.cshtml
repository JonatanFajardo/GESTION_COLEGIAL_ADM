@{
    ViewBag.Title = "Ficha 360° Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Ficha 360° Empleado</li>
        </ol>
    </nav>
</div>
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Ficha 360° del Empleado</h4>
        <p class="text-muted mb-0">Información laboral, académica y contractual del empleado</p>
    </div>
</div>
<div class="fluid-container">
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
        <div class="form-row">
            <div class="col-md-6 mb-2 mb-md-0">
                <select id="f-emp" class="custom-select"><option value="">-- Seleccione Empleado --</option></select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" id="btn-ver">
                    <i class="fa-solid fa-magnifying-glass mr-1"></i> Ver Ficha
                </button>
            </div>
        </div>
        </div>
    </div>
    <div id="panel-ficha" style="display:none;">
        <div class="row">
            <div class="col-md-4 layout-spacing">
                <div class="statbox widget box box-shadow h-100">
                    <div class="widget-header">
                        <div class="row"><div class="col-12"><h4><i class="fa-solid fa-user mr-2"></i>Datos Personales</h4></div></div>
                    </div>
                    <div class="widget-content widget-content-area">
                        <div id="datos-personales"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 layout-spacing">
                <div class="statbox widget box box-shadow h-100">
                    <div class="widget-header">
                        <div class="row"><div class="col-12"><h4><i class="fa-solid fa-briefcase mr-2"></i>Datos Laborales</h4></div></div>
                    </div>
                    <div class="widget-content widget-content-area">
                        <div id="datos-laborales"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 layout-spacing">
                <div class="statbox widget box box-shadow h-100">
                    <div class="widget-header">
                        <div class="row"><div class="col-12"><h4><i class="fa-solid fa-calendar mr-2"></i>Historial</h4></div></div>
                    </div>
                    <div class="widget-content widget-content-area">
                        <div id="datos-historial"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Content/js/pages/ficha360empleadoadm.js"></script>
    <script>
        Ficha360EmpleadoAdm.init(
            "@Url.Action("GetAsync")",
            "@Url.Action("EmpleadosDropdownAsync")"
        );
    </script>
}
