@{
    ViewBag.Title = "Centro de Anuncios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Centro de Anuncios</li>
        </ol>
    </nav>
</div>
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Centro de Anuncios</h4>
        <p class="text-muted mb-0">Gestione los comunicados y anuncios del colegio</p>
    </div>
    <div class="mt-2 mt-md-0">
        <button class="btn btn-primary" data-toggle="modal" data-target="#modal-nuevo">
            <i class="bi bi-plus-lg mr-1"></i> Nuevo Anuncio
        </button>
    </div>
</div>
<div class="fluid-container">
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">

            <!-- Tabs de filtro -->
            <ul class="nav nav-tabs mb-4" id="tabs-anuncios" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" href="#" data-filtro="todos" role="tab">Todos <span class="badge badge-primary ml-1 tab-count">0</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" data-filtro="vigentes" role="tab">Vigentes <span class="badge badge-primary ml-1 tab-count">0</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" data-filtro="expirados" role="tab">Expirados <span class="badge badge-primary ml-1 tab-count">0</span></a>
                </li>
            </ul>

            <!-- Muro de cards -->
            <div class="row" id="cards-anuncios">
                <!-- Generado por centroanuncios.js -->
            </div>

            <!-- Estado vacío -->
            <div id="anuncios-vacio" class="text-center text-muted py-5" style="display:none">
                <i class="fa-solid fa-bell-slash fa-3x mb-3"></i>
                <p class="mb-0">No hay anuncios en esta categoría</p>
            </div>

        </div>
    </div>
</div>

<!-- Modal Nuevo Anuncio -->
<div class="modal fade" id="modal-nuevo" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo Anuncio</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="form-nuevo">
                <div class="modal-body">
                    <div>
                        <div class="row">
                            <div class="col-md-12 form-group">
                                <label>Titulo *</label>
                                <input type="text" name="Anu_Titulo" class="form-control" placeholder="Titulo del anuncio" maxlength="200">
                            </div>
                            <div class="col-md-12 form-group">
                                <label>Contenido *</label>
                                <textarea name="Anu_Contenido" class="form-control" rows="4" placeholder="Descripcion del anuncio o comunicado..."></textarea>
                            </div>
                            <div class="col-md-12 form-group">
                                <label>¿A quién va dirigido? *</label>
                                <select name="Anu_Publico" id="anu-publico" class="form-control">
                                    <option value="todos">Todo el colegio (personal y familias)</option>
                                    <option value="personal">Solo personal</option>
                                    <option value="familias">Familias</option>
                                </select>
                            </div>
                            <div class="col-md-12" id="anu-familias" style="display:none">
                                <div class="row">
                                    <div class="col-md-12 form-group">
                                        <label>Nivel</label>
                                        <select name="Anu_NivId" id="anu-nivel" class="form-control"></select>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label>Grado</label>
                                        <select name="Anu_CunId" id="anu-grado" class="form-control" disabled></select>
                                    </div>
                                    <div class="col-md-12 form-group">
                                        <label>Sección</label>
                                        <select name="Anu_SecId" id="anu-seccion" class="form-control" disabled></select>
                                    </div>
                                    <div class="col-12 form-group">
                                        <small class="text-muted">Sin nivel, el anuncio llega a todas las familias. Con grado o sección, solo a las familias que tengan un hijo ahí.</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 form-group">
                                <label>Fecha de Expiracion</label>
                                <input type="date" name="Anu_FechaExpiracion" class="form-control">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/centroanuncios.js"></script>
    <script>
        CentroAnuncios.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("CreateAsync")",
            "@Url.Action("DeleteAsync")",
            "@Url.Action("OpcionesAsync")"
        );
    </script>
}
