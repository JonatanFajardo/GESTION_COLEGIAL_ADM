@{
    ViewBag.Title = "Sesiones Activas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Sesiones Activas</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Sesiones Activas</h4>
        <p class="text-muted mb-0">Usuarios conectados actualmente al sistema. Se actualiza cada 30 segundos.</p>
    </div>
    <div class="d-flex align-items-center mt-2 mt-md-0">
        <button type="button" id="btn-refresh" class="btn btn-outline-primary">
            <i class="fa-solid fa-arrows-rotate mr-1"></i> Actualizar
        </button>
        <span class="ml-2 text-muted small" id="lbl-ultima-act"></span>
    </div>
</div>

<div class="fluid-container">

    <!-- KPI Cards -->
    <div class="row">
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-total-sesiones">—</h6>
                            <p>Total Sesiones</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-users"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-activos">—</h6>
                            <p>Activos</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-circle-dot"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-inactivos">—</h6>
                            <p>Inactivos</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-moon"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-ips">—</h6>
                            <p>IPs Únicas</p>
                        </div>
                        <div><div class="w-icon"><i class="fa-solid fa-network-wired"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable-sesionesactivas">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Inicio de sesión</th>
                            <th>Última actividad</th>
                            <th>Inactividad (min)</th>
                            <th>IP</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/sesionesactivas.js"></script>
    <script>SesionesActivas.init("@Url.Action("ListAsync")");</script>
}
