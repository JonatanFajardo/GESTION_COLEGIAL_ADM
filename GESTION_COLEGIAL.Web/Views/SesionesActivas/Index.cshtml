@{
    ViewBag.Title = "Sesiones Activas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/sesionesactivas.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Sesiones Activas</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo"><i class="fa-solid fa-users" style="font-size:32px;"></i></div>
            <div class="header-text-catalogo">
                <h1>Sesiones Activas</h1>
                <p>Usuarios conectados actualmente al sistema. Se actualiza cada 30 segundos.</p>
            </div>
        </div>
        <div class="header-right-catalogo">
            <button id="btn-refresh">
                <i class="fa-solid fa-arrows-rotate"></i> Actualizar
            </button>
            <span class="ms-2 text-muted small" id="lbl-ultima-act"></span>
        </div>
    </div>
</div>

<div class="fluid-container">

    <!-- KPI Cards -->
    <div class="row mb-3">
        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="kpi-stat-card kpi-stat-indigo">
                <div class="kpi-stat-icon"><i class="fa-solid fa-users"></i></div>
                <div class="kpi-stat-body">
                    <div class="kpi-stat-label">Total Sesiones</div>
                    <div class="kpi-stat-valor" id="kpi-total-sesiones">—</div>
                </div>
                <div class="kpi-stat-bg-icon"><i class="fa-solid fa-users"></i></div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="kpi-stat-card kpi-stat-emerald">
                <div class="kpi-stat-icon"><i class="fa-solid fa-circle-dot"></i></div>
                <div class="kpi-stat-body">
                    <div class="kpi-stat-label">Activos</div>
                    <div class="kpi-stat-valor" id="kpi-activos">—</div>
                </div>
                <div class="kpi-stat-bg-icon"><i class="fa-solid fa-circle-dot"></i></div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="kpi-stat-card kpi-stat-amber">
                <div class="kpi-stat-icon"><i class="fa-solid fa-moon"></i></div>
                <div class="kpi-stat-body">
                    <div class="kpi-stat-label">Inactivos</div>
                    <div class="kpi-stat-valor" id="kpi-inactivos">—</div>
                </div>
                <div class="kpi-stat-bg-icon"><i class="fa-solid fa-moon"></i></div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3 mb-3">
            <div class="kpi-stat-card kpi-stat-cyan">
                <div class="kpi-stat-icon"><i class="fa-solid fa-network-wired"></i></div>
                <div class="kpi-stat-body">
                    <div class="kpi-stat-label">IPs Únicas</div>
                    <div class="kpi-stat-valor" id="kpi-ips">—</div>
                </div>
                <div class="kpi-stat-bg-icon"><i class="fa-solid fa-network-wired"></i></div>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card-listado-catalogo">
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="datatable-sesionesactivas">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Inicio de sesión</th>
                            <th>Última actividad</th>
                            <th>Inactividad (min)</th>
                            <th>IP</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/sesionesactivas.js"></script>
    <script>SesionesActivas.init("@Url.Action("ListAsync")");</script>
}
