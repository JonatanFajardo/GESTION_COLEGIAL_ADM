@{
    ViewBag.Title = "Mi Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic perfil = Model;
}

@section Styles{
    <link href="~/Content/css/elements/avatar.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Mi Perfil</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Mi Perfil</h4>
        <p class="text-muted mb-0">Información del usuario en sesión</p>
    </div>
</div>

<div class="fluid-container">
    @if (perfil == null)
    {
        <div class="alert alert-warning">
            <i class="fa-solid fa-triangle-exclamation mr-2"></i>
            No se pudo cargar la información del perfil. Verifica tu sesión e intenta nuevamente.
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10 layout-spacing">
                <div class="statbox widget box box-shadow">
                    <div class="widget-content widget-content-area">
                        <!-- Avatar y nombre -->
                        <div class="d-flex align-items-center mb-4">
                            <div class="avatar avatar-xl mr-3">
                                @if (perfil.Per_Imagen != null && !string.IsNullOrEmpty((string)perfil.Per_Imagen))
                                {
                                    <img src="@perfil.Per_Imagen" alt="Foto de perfil" class="rounded-circle" />
                                }
                                else
                                {
                                    <span class="avatar-title rounded-circle"><i class="fa-solid fa-user"></i></span>
                                }
                            </div>
                            <div>
                                <h4 class="mb-1">@(perfil.NombreCompleto ?? perfil.Usu_Name)</h4>
                                <span class="badge @(((bool?)perfil.Usu_EsActivo == true) ? "badge-success" : "badge-danger")">
                                    @(((bool?)perfil.Usu_EsActivo == true) ? "Activo" : "Inactivo")
                                </span>
                            </div>
                        </div>

                        <!-- Datos de cuenta -->
                        <h6 class="font-weight-bold border-top pt-3 mb-3"><i class="fa-solid fa-key mr-1"></i> Cuenta</h6>
                        <div class="row mb-3">
                            <div class="col-sm-6 mb-3">
                                <p class="text-muted small text-uppercase mb-0">Usuario</p>
                                <p class="font-weight-bold mb-0">@perfil.Usu_Name</p>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <p class="text-muted small text-uppercase mb-0">Rol</p>
                                <p class="font-weight-bold mb-0">
                                    <i class="fa-solid fa-shield-halved mr-1 text-primary"></i>
                                    @perfil.Rol_Descripcion
                                </p>
                            </div>
                        </div>

                        <!-- Datos personales -->
                        <h6 class="font-weight-bold border-top pt-3 mb-3"><i class="fa-solid fa-id-card mr-1"></i> Datos personales</h6>
                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <p class="text-muted small text-uppercase mb-0">Nombre completo</p>
                                <p class="font-weight-bold mb-0">@(perfil.NombreCompleto ?? "—")</p>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <p class="text-muted small text-uppercase mb-0">Identidad</p>
                                <p class="font-weight-bold mb-0">@(perfil.Per_Identidad ?? "—")</p>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <p class="text-muted small text-uppercase mb-0">Teléfono</p>
                                <p class="font-weight-bold mb-0">@(perfil.Per_Telefono ?? "—")</p>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <p class="text-muted small text-uppercase mb-0">Dirección</p>
                                <p class="font-weight-bold mb-0">@(perfil.Per_Direccion ?? "—")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
