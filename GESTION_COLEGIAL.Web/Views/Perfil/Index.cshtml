@{
    ViewBag.Title = "Mi Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic perfil = Model;
}

@section Styles{
    <style>
        .perfil-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,.08);
            padding: 2rem;
            max-width: 680px;
            margin: 0 auto;
        }
        .perfil-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #e0e6f0;
        }
        .perfil-avatar-placeholder {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: #adb5bd;
            border: 3px solid #e0e6f0;
        }
        .perfil-label {
            font-size: 0.78rem;
            font-weight: 600;
            color: #8592a3;
            text-transform: uppercase;
            letter-spacing: .05em;
            margin-bottom: 2px;
        }
        .perfil-value {
            font-size: 1rem;
            color: #3b4863;
            font-weight: 500;
        }
        .perfil-divider {
            border-top: 1px solid #f0f2f5;
            margin: 1.2rem 0;
        }
        .badge-activo   { background-color: #28a745; }
        .badge-inactivo { background-color: #dc3545; }
    </style>
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Mi Perfil</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-circle-user" style="font-size:32px;"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Mi Perfil</h1>
                <p>Información del usuario en sesión</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">
    @if (perfil == null)
    {
        <div class="alert alert-warning">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            No se pudo cargar la información del perfil. Verifica tu sesión e intenta nuevamente.
        </div>
    }
    else
    {
        <div class="perfil-card">
            <!-- Avatar y nombre -->
            <div class="d-flex align-items-center gap-3 mb-4">
                @if (perfil.Per_Imagen != null && !string.IsNullOrEmpty((string)perfil.Per_Imagen))
                {
                    <img src="@perfil.Per_Imagen" alt="Foto de perfil" class="perfil-avatar" />
                }
                else
                {
                    <div class="perfil-avatar-placeholder">
                        <i class="fa-solid fa-user"></i>
                    </div>
                }
                <div>
                    <h4 class="mb-0">@(perfil.NombreCompleto ?? perfil.Usu_Name)</h4>
                    <span class="badge @(((bool?)perfil.Usu_EsActivo == true) ? "badge-activo" : "badge-inactivo") text-white">
                        @(((bool?)perfil.Usu_EsActivo == true) ? "Activo" : "Inactivo")
                    </span>
                </div>
            </div>

            <div class="perfil-divider"></div>

            <!-- Datos de cuenta -->
            <h6 class="text-muted mb-3"><i class="fa-solid fa-key me-1"></i> Cuenta</h6>
            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <div class="perfil-label">Usuario</div>
                    <div class="perfil-value">@perfil.Usu_Name</div>
                </div>
                <div class="col-sm-6">
                    <div class="perfil-label">Rol</div>
                    <div class="perfil-value">
                        <i class="fa-solid fa-shield-halved me-1 text-primary"></i>
                        @perfil.Rol_Descripcion
                    </div>
                </div>
            </div>

            <div class="perfil-divider"></div>

            <!-- Datos personales -->
            <h6 class="text-muted mb-3"><i class="fa-solid fa-id-card me-1"></i> Datos personales</h6>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="perfil-label">Nombre completo</div>
                    <div class="perfil-value">@(perfil.NombreCompleto ?? "—")</div>
                </div>
                <div class="col-sm-6">
                    <div class="perfil-label">Identidad</div>
                    <div class="perfil-value">@(perfil.Per_Identidad ?? "—")</div>
                </div>
                <div class="col-sm-6">
                    <div class="perfil-label">Teléfono</div>
                    <div class="perfil-value">@(perfil.Per_Telefono ?? "—")</div>
                </div>
                <div class="col-sm-6">
                    <div class="perfil-label">Dirección</div>
                    <div class="perfil-value">@(perfil.Per_Direccion ?? "—")</div>
                </div>
            </div>
        </div>
    }
</div>
