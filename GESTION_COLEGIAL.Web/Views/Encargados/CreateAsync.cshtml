@model GESTION_COLEGIAL.Business.Models.EncargadoViewModel
@{
    ViewBag.Title = "Crear";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="breadcrumb-wrapper-content ">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">

            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/Encargados/Index">Encargados</a></li>
            <li class="breadcrumb-item active" aria-current="page">Crear Encargado</li>
        </ol>
    </nav>
</div>


@using (Html.BeginForm("Save", "Encargados", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
        <div class="mr-3">
            <h4 class="mb-1">Registro de encargados</h4>
            <p class="text-muted mb-0">Complete la información del encargado o tutor.</p>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row">
            <!-- Columna Principal: Información del Encargado -->
            <div class="col-lg-12">
                <div class="statbox widget box box-shadow mb-4">
                    <div class="widget-header">
                        <div class="d-flex flex-wrap align-items-center justify-content-between">
                            <h4>Información del Encargado</h4>
                            <div class="d-flex align-items-center py-2">
                                <span class="badge outline-badge-primary mr-2" id="statusBadge"><span id="statusDot"></span><span id="statusText">Activo</span></span>
                                <label class="switch s-outline s-outline-primary mb-0">
                                @Html.CheckBoxFor(model => model.Per_EsActivo, new { @id = "statusToggle", @checked = "checked" })
                                    <span class="slider round"></span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="widget-content widget-content-area">
                        @Html.HiddenFor(model => model.Enc_Id)
                        @Html.HiddenFor(model => model.Per_Id)

                        <!-- Información General -->
                        <h6 class="font-weight-bold text-primary mb-3">Información General</h6>

                        <div class="row">
                            <!-- Columna Ocupación -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Enc_Ocupacion">
                                        Ocupación
                                    </label>
                                    @Html.EditorFor(model => model.Enc_Ocupacion, new { htmlAttributes = new { @class = "form-control", placeholder = "Ocupación del encargado" } })
                                    @Html.ValidationMessageFor(model => model.Enc_Ocupacion, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <!-- Columna Identidad -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Per_Identidad">
                                        Identidad
                                    </label>
                                    @Html.EditorFor(model => model.Per_Identidad, new { htmlAttributes = new { @class = "form-control", placeholder = "0000-0000-00000" } })
                                    @Html.ValidationMessageFor(model => model.Per_Identidad, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <!-- Datos Personales -->
                        <hr />
                        <h6 class="font-weight-bold text-primary mb-3">Datos Personales</h6>

                        <div class="row">
                            <!-- Columna Primer Nombre -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Per_PrimerNombre">
                                        Primer Nombre
                                    </label>
                                    @Html.EditorFor(model => model.Per_PrimerNombre, new { htmlAttributes = new { @class = "form-control", placeholder = "Primer nombre" } })
                                    @Html.ValidationMessageFor(model => model.Per_PrimerNombre, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <!-- Columna Segundo Nombre -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Per_SegundoNombre">
                                        Segundo Nombre
                                    </label>
                                    @Html.EditorFor(model => model.Per_SegundoNombre, new { htmlAttributes = new { @class = "form-control", placeholder = "Segundo nombre (opcional)" } })
                                    @Html.ValidationMessageFor(model => model.Per_SegundoNombre, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Columna Apellido Paterno -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Per_ApellidoPaterno">
                                        Apellido Paterno
                                    </label>
                                    @Html.EditorFor(model => model.Per_ApellidoPaterno, new { htmlAttributes = new { @class = "form-control", placeholder = "Apellido paterno" } })
                                    @Html.ValidationMessageFor(model => model.Per_ApellidoPaterno, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <!-- Columna Apellido Materno -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Per_ApellidoMaterno">
                                        Apellido Materno
                                    </label>
                                    @Html.EditorFor(model => model.Per_ApellidoMaterno, new { htmlAttributes = new { @class = "form-control", placeholder = "Apellido materno (opcional)" } })
                                    @Html.ValidationMessageFor(model => model.Per_ApellidoMaterno, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Columna Fecha Nacimiento -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Per_FechaNacimiento">
                                        Fecha de Nacimiento
                                    </label>
                                    @Html.EditorFor(model => model.Per_FechaNacimiento, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
                                    @Html.ValidationMessageFor(model => model.Per_FechaNacimiento, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <!-- Columna Sexo -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Per_Sexo">
                                        Sexo
                                    </label>
                                    @Html.EditorFor(model => model.Per_Sexo, new { htmlAttributes = new { @class = "form-control", placeholder = "M / F" } })
                                    @Html.ValidationMessageFor(model => model.Per_Sexo, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <!-- Información de Contacto -->
                        <hr />
                        <h6 class="font-weight-bold text-primary mb-3">Información de Contacto</h6>

                        <div class="row">
                            <!-- Columna Correo Electronico -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Per_CorreoElectronico">
                                        Correo Electrónico
                                    </label>
                                    @Html.EditorFor(model => model.Per_CorreoElectronico, new { htmlAttributes = new { @class = "form-control", placeholder = "correo@ejemplo.com" } })
                                    @Html.ValidationMessageFor(model => model.Per_CorreoElectronico, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <!-- Columna Teléfono -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Per_Telefono">
                                        Teléfono
                                    </label>
                                    @Html.EditorFor(model => model.Per_Telefono, new { htmlAttributes = new { @class = "form-control", placeholder = "0000-0000" } })
                                    @Html.ValidationMessageFor(model => model.Per_Telefono, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Columna Dirección -->
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="Per_Direccion">
                                        Dirección
                                    </label>
                                    @Html.EditorFor(model => model.Per_Direccion, new { htmlAttributes = new { @class = "form-control", placeholder = "Dirección completa" } })
                                    @Html.ValidationMessageFor(model => model.Per_Direccion, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-flex justify-content-end mt-3">
                            @Html.ActionLink("Cancelar", "Index", "Encargados", null, new { @class = "btn mr-2", @id = "cancelBtn" })
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save mr-1"></i> Guardar encargado
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/Content/js/form-encargados.js"></script>
}
