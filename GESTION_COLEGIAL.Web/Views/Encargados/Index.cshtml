@model GESTION_COLEGIAL.Business.Models.EncargadoViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content ">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Encargados</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Gestión de encargados</h4>
        <p class="text-muted mb-0">Administra la información de padres y tutores responsables.</p>
    </div>
    <div class="mt-2 mt-md-0">
        <a href="@Url.Action("CreateAsync", "Encargados")" class="btn btn-primary">
            <i class="bi bi-plus-lg mr-1"></i> Nuevo encargado
        </a>
    </div>
</div>

<div>
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="d-flex flex-wrap align-items-center justify-content-between">
                <h4 class="mr-2">Listado de encargados <span class="badge badge-primary ml-1" id="total-count">0</span></h4>
                <div class="d-flex flex-wrap align-items-center py-2">
                    <input type="text" id="custom-table-search" class="form-control form-control-sm mr-2 mb-1 mb-md-0" placeholder="Buscar…" />

                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div id="tabla-encargados" data-usuario="@(Session["Username"] as string ?? "anonimo")"></div>
        </div>
    </div>

    <!-- Modal Delete-->
    <div class="modal" id="delete-modal-secondary" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            @using (Ajax.BeginForm("DeleteAsync", "Encargados", new AjaxOptions
            {
                HttpMethod = "Post",
                OnBegin = "Modals.begin",
                OnComplete = "Modals.complete",
                OnFailure = "Modals.failure",
                OnSuccess = "Modals.success"
            }))
            {
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"></h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar" hidden>
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <h5>
                    </h5>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                @Html.HiddenFor(model => model.Enc_Id, new { @id = "delete-item-id" })
                                <p>¿Está seguro de que desea eliminar este registro?</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" id="accept-delete-btn" class="btn btn-danger"><i class="bi bi-trash"></i></button>
                </div>
            </div>
            }
        </div>
    </div>
    <!-- Fin Modal -->
</div>

@section Scripts{
    <partial name="_GcTabla" />
    <script src="~/Content/js/pages/encargados.js" asp-append-version="true"></script>
    <script>
        Encargados.datatable({
            urlList: "@Url.Action("ListAsync")",
            urlInsert: "@Url.Action("CreateAsync")",
            urlUpdate: "@Url.Action("FindAsync")",
            urlDetail: "@Url.Action("DetailAsync")"
        });
    </script>
}