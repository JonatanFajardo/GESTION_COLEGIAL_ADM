@{
    ViewBag.Title = "Mensajes a Encargados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Mensajes a Encargados</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Mensajes a Encargados</h4>
        <p class="text-muted mb-0">Envie mensajes a los encargados de los alumnos</p>
    </div>
    <div class="mt-2 mt-md-0">
        <button class="btn btn-primary" data-toggle="modal" data-target="#modal-nuevo">
            <i class="bi bi-plus-lg mr-1"></i> Nuevo Mensaje
        </button>
    </div>
</div>

<div class="fluid-container">
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable-mensajes">
                    <thead>
                        <tr>
                            <th>Alumno</th>
                            <th>Asunto</th>
                            <th>Resumen</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nuevo Mensaje -->
<div class="modal fade" id="modal-nuevo" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo Mensaje</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="form-nuevo">
                <div class="modal-body">
                    <div>
                        <div class="row">
                            <div class="col-md-12 form-group">
                                <label>Alumno *</label>
                                <select name="Alu_Id" class="custom-select" required>
                                    <option value="">-- Seleccione Alumno --</option>
                                </select>
                            </div>
                            <div class="col-md-12 form-group">
                                <label>Asunto *</label>
                                <input type="text" name="Msg_Asunto" class="form-control"
                                       maxlength="200" placeholder="Asunto del mensaje" required />
                            </div>
                            <div class="col-md-12 form-group">
                                <label>Contenido *</label>
                                <textarea name="Msg_Contenido" class="form-control"
                                          rows="5" placeholder="Escriba el mensaje aqui..." required></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Enviar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Ver Mensaje -->
<div class="modal fade" id="modal-ver" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ver-asunto"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div>
                    <p><strong>Alumno:</strong> <span id="ver-alumno"></span></p>
                    <p><strong>Fecha:</strong> <span id="ver-fecha"></span></p>
                    <p><strong>Estado:</strong> <span id="ver-estado"></span></p>
                    <hr />
                    <div id="ver-contenido" style="white-space: pre-wrap;"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/mensajes.js"></script>
    <script>
        Mensajes.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("CreateAsync")",
            "@Url.Action("DeleteAsync")",
            "@Url.Action("DropdownsAsync")"
        );
    </script>
}
