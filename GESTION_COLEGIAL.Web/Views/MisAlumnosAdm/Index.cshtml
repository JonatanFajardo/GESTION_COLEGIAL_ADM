@{
    ViewBag.Title = "Mis Alumnos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Mis Alumnos</li>
        </ol>
    </nav>
</div>
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Mis Alumnos</h4>
        <p class="text-muted mb-0">Galería de alumnos por horario asignado</p>
    </div>
</div>
<div class="fluid-container">
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
        <div class="form-row">
            <div class="col-md-7">
                <select id="f-hor" class="custom-select"><option value="">-- Seleccione Horario --</option></select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" id="btn-cargar">
                    <i class="fa-solid fa-magnifying-glass mr-1"></i> Ver Alumnos
                </button>
            </div>
        </div>
        </div>
    </div>
    <div id="panel-alumnos" class="row" style="display:none;"></div>
    <div id="panel-vacio" class="text-center text-muted py-5" style="display:none;">
        <i class="fa-solid fa-users-slash fa-3x mb-3 text-muted"></i>
        <p>No se encontraron alumnos para este horario.</p>
    </div>
</div>
@section Scripts{
    <script src="~/Content/js/pages/misalumnosadm.js"></script>
    <script>
        MisAlumnosAdm.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("DropdownsAsync")"
        );
    </script>
}
