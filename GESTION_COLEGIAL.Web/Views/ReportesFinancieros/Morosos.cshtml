@{
    ViewBag.Title = "Reporte de Morosos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content ">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Módulo Financiero</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Reportes Financieros</a></li>
            <li class="breadcrumb-item active" aria-current="page">Morosos</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Reporte de Morosos</h4>
        <p class="text-muted mb-0">Alumnos con pagos vencidos y su deuda acumulada.</p>
    </div>
</div>

<div class="fluid-container">
    <!-- Filtros -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="row">
                <div class="col-md-10">
                    <label>Filtrar por días de atraso:</label>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary active" data-dias="0">Todos</button>
                        <button type="button" class="btn btn-outline-warning" data-dias="30">30+ días</button>
                        <button type="button" class="btn btn-outline-danger" data-dias="60">60+ días</button>
                        <button type="button" class="btn btn-outline-dark" data-dias="90">90+ días</button>
                    </div>
                </div>
                <div class="col-md-2">
                    <label>&nbsp;</label>
                    <button type="button" class="btn btn-outline-primary btn-block" id="btn-exportar">
                        <i class="bi bi-file-earmark-excel mr-1"></i> Exportar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumen -->
    <div class="row">
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-danger" id="total-morosos">0</h6>
                            <p>Total Morosos</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-warning" id="deuda-total">L. 0.00</h6>
                            <p>Deuda Total</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-danger" id="mora-acumulada">L. 0.00</h6>
                            <p>Mora Acumulada</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-info" id="promedio-deuda">L. 0.00</h6>
                            <p>Promedio Deuda</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Listado -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Lista de Alumnos Morosos</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
            <table class="table table-hover nowrap" id="datatable">
                <thead>
                    <tr>
                        <th>Alumno</th>
                        <th>Identidad</th>
                        <th>Encargado</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Total Deuda</th>
                        <th>Mora</th>
                        <th>Días Atraso</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
            </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/morosos.js"></script>
    <script>
        Morosos.datatable({
            urlList: "@Url.Action("ListadoMorososAsync", "ReportesFinancieros")",
            urlEstadoCuenta: "@Url.Action("EstadoCuenta", "CuentasCobrar")"
        });
    </script>
}
