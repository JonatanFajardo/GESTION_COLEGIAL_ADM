@{
    ViewBag.Title = "Ingresos del Mes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content ">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Módulo Financiero</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Reportes Financieros</a></li>
            <li class="breadcrumb-item active" aria-current="page">Ingresos del Mes</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Ingresos del Mes</h4>
        <p class="text-muted mb-0">Ingresos cobrados en el mes, por día y por concepto.</p>
    </div>
</div>

<div class="fluid-container">
    <!-- Filtros -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="mes-select">Mes</label>
                        <select class="custom-select" id="mes-select">
                            <option value="1">Enero</option>
                            <option value="2">Febrero</option>
                            <option value="3">Marzo</option>
                            <option value="4">Abril</option>
                            <option value="5">Mayo</option>
                            <option value="6">Junio</option>
                            <option value="7">Julio</option>
                            <option value="8">Agosto</option>
                            <option value="9">Septiembre</option>
                            <option value="10">Octubre</option>
                            <option value="11">Noviembre</option>
                            <option value="12">Diciembre</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="anio-select">Año</label>
                        <input type="number" class="form-control" id="anio-select" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <button type="button" class="btn btn-primary btn-block" id="btn-generar-reporte">
                            <i class="bi bi-bar-chart-line mr-1"></i> Generar Reporte
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumen -->
    <div class="row">
        <div class="col-xl-4 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-success" id="total-ingresos">L. 0.00</h6>
                            <p>Total Ingresos</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-info" id="cantidad-pagos">0</h6>
                            <p>Cantidad de Pagos</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-primary" id="promedio-diario">L. 0.00</h6>
                            <p>Promedio Diario</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfico -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Ingresos por Día</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <canvas id="chart-ingresos-dia" height="80"></canvas>
        </div>
    </div>

    <!-- Tabla por Concepto -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Resumen por Concepto de Pago</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
            <table class="table table-hover" id="tabla-conceptos">
                <thead>
                    <tr>
                        <th>Concepto</th>
                        <th>Cantidad</th>
                        <th>Monto Total</th>
                        <th>%</th>
                    </tr>
                </thead>
                <tbody id="tbody-conceptos">
                </tbody>
                <tfoot>
                    <tr>
                        <th>Total</th>
                        <th id="total-cantidad">0</th>
                        <th id="total-monto">L. 0.00</th>
                        <th>100%</th>
                    </tr>
                </tfoot>
            </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/Content/js/pages/ingresosmes.js"></script>
    <script>
        IngresosMes.init({
            urlReporte: "@Url.Action("IngresosPorMesAsync", "ReportesFinancieros")"
        });
    </script>
}
