@{
    ViewBag.Title = "Proyección de Cobros";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content ">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Módulo Financiero</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Reportes Financieros</a></li>
            <li class="breadcrumb-item active" aria-current="page">Proyección de Cobros</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Proyección de Cobros</h4>
        <p class="text-muted mb-0">Lo proyectado frente a lo cobrado en el mes.</p>
    </div>
</div>

<div class="fluid-container">
    <!-- Filtros -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="row">
                <div class="col-md-5">
                    <div class="form-group">
                        <label for="mes-select">Mes</label>
                        <select class="custom-select" id="mes-select">
                            <option value="1">Enero</option>
                            <option value="2">Febrero</option>
                            <option value="3">Marzo</option>
                            <option value="4">Abril</option>
                            <option value="5">Mayo</option>
                            <option value="6">Junio</option>
                            <option value="7">Julio</option>
                            <option value="8">Agosto</option>
                            <option value="9">Septiembre</option>
                            <option value="10">Octubre</option>
                            <option value="11">Noviembre</option>
                            <option value="12">Diciembre</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="form-group">
                        <label for="anio-select">Año</label>
                        <input type="number" class="form-control" id="anio-select" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <button type="button" class="btn btn-primary btn-block" id="btn-generar">
                            <i class="bi bi-bar-chart-line mr-1"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumen -->
    <div class="row">
        <div class="col-xl-4 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-info" id="proyeccion-total">L. 0.00</h6>
                            <p>Proyección Total</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-success" id="monto-cobrado">L. 0.00</h6>
                            <p>Monto Cobrado</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value text-primary" id="porcentaje-cumplimiento">0%</h6>
                            <p>% Cumplimiento</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfico -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Proyección vs Cobrado</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <canvas id="chart-proyeccion" height="80"></canvas>
        </div>
    </div>

    <!-- Tabla por Nivel -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Desglose por Nivel Educativo</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nivel</th>
                        <th>Alumnos</th>
                        <th>Proyección</th>
                        <th>Cobrado</th>
                        <th>Pendiente</th>
                        <th>% Cumplimiento</th>
                    </tr>
                </thead>
                <tbody id="tbody-niveles">
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/Content/js/pages/proyeccioncobros.js"></script>
    <script>
        ProyeccionCobros.init({
            urlReporte: "@Url.Action("ProyeccionCobrosAsync", "ReportesFinancieros")"
        });
    </script>
}
