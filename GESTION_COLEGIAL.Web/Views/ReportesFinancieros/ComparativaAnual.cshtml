@{
    ViewBag.Title = "Comparativa Anual";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content ">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Módulo Financiero</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Reportes Financieros</a></li>
            <li class="breadcrumb-item active" aria-current="page">Comparativa Anual</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Comparativa Anual</h4>
        <p class="text-muted mb-0">Comparación de ingresos entre años.</p>
    </div>
</div>

<div class="fluid-container">
    <!-- Filtros -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="anio-inicio">Año Inicio</label>
                        <input type="number" class="form-control" id="anio-inicio" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="anio-fin">Año Fin</label>
                        <input type="number" class="form-control" id="anio-fin" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="concepto-filtro">Filtrar por Concepto</label>
                        <select class="custom-select" id="concepto-filtro">
                            <option value="">-- Todos --</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <button type="button" class="btn btn-primary" id="btn-generar">
                        <i class="bi bi-bar-chart-line mr-1"></i> Generar Comparativa
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfico Comparativo -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Comparativa Mensual</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <canvas id="chart-comparativa" height="80"></canvas>
        </div>
    </div>

    <!-- Tabla Comparativa -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Resumen Comparativo</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Año</th>
                        <th>Ene</th>
                        <th>Feb</th>
                        <th>Mar</th>
                        <th>Abr</th>
                        <th>May</th>
                        <th>Jun</th>
                        <th>Jul</th>
                        <th>Ago</th>
                        <th>Sep</th>
                        <th>Oct</th>
                        <th>Nov</th>
                        <th>Dic</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody id="tbody-comparativa">
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <!-- Indicadores -->
    <div class="row">
        <div class="col-xl-4 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="crecimiento">0%</h6>
                            <p>Crecimiento</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="mejor-mes">-</h6>
                            <p>Mejor Mes</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="peor-mes">-</h6>
                            <p>Peor Mes</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/Content/js/pages/comparativaanual.js"></script>
    <script>
        ComparativaAnual.init({
            urlReporte: "@Url.Action("ComparativaAnualAsync", "ReportesFinancieros")",
            urlConceptos: "@Url.Action("DropdownAsync", "ConceptosPago")"
        });
    </script>
}
