@{
    ViewBag.Title = "Cuenta del alumno";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool puedeCorregir = ViewBag.PuedeCorregir == true;
}
<div class="breadcrumb-wrapper-content d-print-none">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item">Caja</li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "CuentasCobrar")">Cuentas por cobrar</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cuenta del alumno</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina d-print-none">
    <div class="mr-3">
        <h4 class="mb-1">Cuenta del alumno</h4>
        <p class="text-muted mb-0">Todo lo que se le cargó, lo que pagó y las correcciones, en un solo lugar.</p>
    </div>
    <div class="mt-2 ml-auto acciones-cuenta d-none">
        <button type="button" class="btn btn-outline-primary mr-2 mb-1" id="btn-imprimir"><i class="bi bi-printer mr-1"></i> Imprimir</button>
        @if (puedeCorregir)
        {
            <button type="button" class="btn btn-outline-primary mr-2 mb-1" data-accion="devolver" id="btn-devolver" disabled><i class="bi bi-arrow-counterclockwise mr-1"></i> Devolver dinero</button>
            <button type="button" class="btn btn-outline-primary mr-2 mb-1" data-accion="saldo" id="btn-usar-saldo" disabled><i class="bi bi-piggy-bank mr-1"></i> Usar saldo a favor</button>
        }
        <a href="#" id="btn-cobrar" class="btn btn-primary mb-1"><i class="bi bi-cash-coin mr-1"></i> Cobrar</a>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4 d-print-none">
    <div class="widget-content widget-content-area">
        <div class="form-row align-items-end">
            <div class="col-md-6 mb-2">
                <label for="f-alumno">Alumno (nombre o identidad)</label>
                <input type="text" id="f-alumno" class="form-control" list="lista-alumnos" placeholder="Escribí para buscar…" autocomplete="off" />
                <datalist id="lista-alumnos"></datalist>
                <small class="form-text text-muted">Elegí un alumno de la lista o escribí su identidad (13 dígitos) y presioná Enter.</small>
            </div>
            <div class="col-md-6 mb-2">
                <div id="info-alumno" class="text-muted">Elegí un alumno para ver su cuenta.</div>
            </div>
        </div>
    </div>
</div>

<div id="sin-alumno" class="statbox widget box box-shadow mb-4 d-print-none">
    <div class="widget-content widget-content-area text-center py-5">
        <div class="display-4 text-primary mb-3"><i class="bi bi-person-vcard"></i></div>
        <h5 class="mb-2">Buscá un alumno</h5>
        <p class="text-muted mb-0">Vas a ver sus cargos, sus pagos, el saldo a favor y las correcciones hechas a su cuenta.</p>
    </div>
</div>

<div id="cuenta" class="d-none">
    <div class="d-none d-print-block mb-3">
        <h4 class="mb-1">Estado de cuenta</h4>
        <div id="info-alumno-impresion"></div>
        <hr />
    </div>

    <div class="row">
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four"><div class="widget-content">
                <div class="w-content">
                    <div class="w-info"><h6 class="value text-danger" id="k-pendiente">—</h6><p>Pendiente</p></div>
                    <div><div class="w-icon"><i class="bi bi-hourglass-split"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2" id="k-mora">Lo que debe hoy</p>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four"><div class="widget-content">
                <div class="w-content">
                    <div class="w-info"><h6 class="value" id="k-cargado">—</h6><p>Total cargado</p></div>
                    <div><div class="w-icon"><i class="bi bi-receipt"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2">Todo lo emitido a su cuenta</p>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four"><div class="widget-content">
                <div class="w-content">
                    <div class="w-info"><h6 class="value text-success" id="k-pagado">—</h6><p>Pagado</p></div>
                    <div><div class="w-icon"><i class="bi bi-cash-stack"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2">Sin contar pagos anulados</p>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four"><div class="widget-content">
                <div class="w-content">
                    <div class="w-info"><h6 class="value text-info" id="k-favor">—</h6><p>Saldo a favor</p></div>
                    <div><div class="w-icon"><i class="bi bi-piggy-bank"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2">Para usar en cargos o devolver</p>
            </div></div>
        </div>
    </div>

    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <ul class="nav nav-tabs mb-3 d-print-none" role="tablist">
                <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#tab-cargos" role="tab">Cargos pendientes <span class="badge badge-primary ml-1" id="n-cargos">0</span></a></li>
                <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-pagos" role="tab">Pagos <span class="badge badge-primary ml-1" id="n-pagos">0</span></a></li>
                <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-correcciones" role="tab">Correcciones <span class="badge badge-primary ml-1" id="n-correcciones">0</span></a></li>
            </ul>
            <div class="tab-content imprimir-pestanas">
                <div class="tab-pane fade show active" id="tab-cargos" role="tabpanel">
                    <h5 class="d-none d-print-block">Cargos pendientes</h5>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead><tr><th>Concepto</th><th>Vence</th><th class="text-right">Original</th><th class="text-right">Descuento</th><th class="text-right">Mora</th><th class="text-right">Total</th><th class="text-right">Pendiente</th><th>Estado</th>@if (puedeCorregir) {<th class="text-center d-print-none">Acciones</th>}</tr></thead>
                            <tbody id="tb-cargos"></tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="tab-pagos" role="tabpanel">
                    <h5 class="d-none d-print-block mt-3">Pagos</h5>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead><tr><th>Fecha</th><th>Recibo</th><th>Forma de pago / cajero</th><th>Nota</th><th class="text-right">Monto</th><th>Estado</th><th class="text-center d-print-none">Acciones</th></tr></thead>
                            <tbody id="tb-pagos"></tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="tab-correcciones" role="tabpanel">
                    <h5 class="d-none d-print-block mt-3">Correcciones</h5>
                    <p class="text-muted mb-2 d-print-none">Cada corrección queda registrada: qué se hizo, por cuánto, el motivo, quién y cuándo. Nada se borra: un pago anulado queda visible y tachado.</p>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead><tr><th>Fecha</th><th>Tipo</th><th>Detalle</th><th>Motivo</th><th>Usuario</th><th class="text-right">Monto</th></tr></thead>
                            <tbody id="tb-correcciones"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (puedeCorregir)
{
    @Html.AntiForgeryToken()
    @* Ventana única para las correcciones; los campos cambian según la acción. *@
    <div class="modal fade" id="modal-accion" tabindex="-1" role="dialog" aria-labelledby="modal-accion-titulo" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form id="form-accion" novalidate>
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-accion-titulo">Corrección</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <div class="modal-body">
                        <p id="modal-accion-texto" class="text-muted"></p>
                        <div id="campo-monto" class="form-group">
                            <label for="m-monto">Monto (L) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0.01" id="m-monto" class="form-control" />
                            <small class="form-text text-muted" id="m-monto-ayuda"></small>
                            <div class="invalid-feedback" id="m-monto-error"></div>
                        </div>
                        <div id="campo-destino" class="form-group">
                            <label class="d-block">¿Qué pasó con el dinero? <span class="text-danger">*</span></label>
                            <div class="custom-control custom-radio">
                                <input type="radio" id="m-destino-devuelto" name="m-destino" value="Devuelto" class="custom-control-input" />
                                <label class="custom-control-label" for="m-destino-devuelto">Se devolvió el dinero</label>
                            </div>
                            <div class="custom-control custom-radio">
                                <input type="radio" id="m-destino-saldo" name="m-destino" value="SaldoFavor" class="custom-control-input" />
                                <label class="custom-control-label" for="m-destino-saldo">Queda como saldo a favor</label>
                            </div>
                            <div class="invalid-feedback" id="m-destino-error">Elegí qué pasó con el dinero.</div>
                        </div>
                        <div id="campo-metodo" class="form-group">
                            <label for="m-metodo">Cómo se devuelve</label>
                            <select id="m-metodo" class="custom-select"><option>Efectivo</option><option>Transferencia</option><option>Cheque</option></select>
                        </div>
                        <div id="campo-tipo" class="form-group">
                            <label for="m-tipo">Tipo</label>
                            <select id="m-tipo" class="custom-select"><option>Exoneración</option><option>Beca</option><option>Ajuste</option></select>
                        </div>
                        <div class="form-group mb-0">
                            <label for="m-motivo">Motivo <span class="text-danger">*</span></label>
                            <textarea id="m-motivo" class="form-control" rows="2" maxlength="250" placeholder="Queda en el registro de correcciones"></textarea>
                            <div class="invalid-feedback">El motivo es obligatorio.</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" id="m-guardar">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts{
    <script src="~/Content/js/pages/caja-comun.js" asp-append-version="true"></script>
    <script src="~/Content/js/pages/estadocuenta.js" asp-append-version="true"></script>
    <script>
        CuentaAlumno.init({
            alumnoId: @((int)ViewBag.AlumnoId),
            identidad: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.Identidad ?? ""))",
            puedeCorregir: @(puedeCorregir ? "true" : "false")
        });
    </script>
}
