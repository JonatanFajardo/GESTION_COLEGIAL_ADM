@model GESTION_COLEGIAL.Business.Models.CuentaCobrarViewModel
@{
    ViewBag.Title = "Estado de Cuenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/pages/finanzas-dashboard.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content d-print-none">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Módulo Financiero</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Cuentas por Cobrar</a></li>
            <li class="breadcrumb-item active" aria-current="page">Estado de Cuenta</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina d-print-none">
    <div class="mr-3">
        <h4 class="mb-1">Estado de cuenta</h4>
        <p class="text-muted mb-0">Ficha financiera del alumno: deuda, pagos realizados, mora e histórico</p>
    </div>
</div>

<!-- Panel de Búsqueda de Alumno -->
<div id="panel-busqueda" class="d-print-none">
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row">
                <div class="col-12">
                    <h4><i class="bi bi-search mr-1"></i> Buscar alumno</h4>
                    <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Ingrese el número de identidad del alumno para ver su estado de cuenta</p>
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <div class="input-group">
                            <input type="text" class="form-control" id="alumno-identidad-search" placeholder="Ingrese la identidad del alumno..." maxlength="13" />
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button" id="btn-buscar-alumno">
                                    <i class="bi bi-search"></i> Buscar
                                </button>
                            </div>
                        </div>
                        <small class="form-text text-muted">Número de identidad (13 dígitos)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Card de Bienvenida / Placeholder -->
<div id="card-placeholder" class="statbox widget box box-shadow mb-4 d-print-none">
    <div class="widget-content widget-content-area text-center py-5">
        <div class="display-4 text-primary mb-3"><i class="bi bi-person-vcard"></i></div>
        <h4 class="mb-2">Estado de cuenta de alumnos</h4>
        <p class="text-muted mb-2">Busque un alumno por su número de identidad para visualizar su estado financiero completo</p>

        <div class="row mt-4">
            <div class="col-md-4 py-3">
                <div class="h2 text-success mb-2"><i class="bi bi-cash-stack"></i></div>
                <h6 class="font-weight-bold text-dark">Cargos pendientes</h6>
                <p class="small text-muted mb-0">Visualice todos los cargos pendientes de pago del alumno</p>
            </div>
            <div class="col-md-4 py-3">
                <div class="h2 text-primary mb-2"><i class="bi bi-graph-up"></i></div>
                <h6 class="font-weight-bold text-dark">Resumen financiero</h6>
                <p class="small text-muted mb-0">Consulte el resumen completo de deudas, pagos y mora</p>
            </div>
            <div class="col-md-4 py-3">
                <div class="h2 text-info mb-2"><i class="bi bi-clock-history"></i></div>
                <h6 class="font-weight-bold text-dark">Histórico de pagos</h6>
                <p class="small text-muted mb-0">Revise todos los pagos realizados por el alumno</p>
            </div>
        </div>

        <div class="alert alert-info mt-3 d-inline-block" role="alert">
            <i class="bi bi-info-circle mr-1"></i>
            <strong>Tip:</strong> Use el campo de búsqueda arriba para comenzar
        </div>
    </div>
</div>

<div id="paneles-informacion" style="display: none;">

    <!-- Membrete solo para impresión -->
    <div class="d-none d-print-block text-center mb-3">
        <h3 class="m-0">Instituto Nova Sula</h3>
        <p class="m-0 text-muted">Estado de Cuenta del Alumno</p>
        <hr />
    </div>

    <!-- Panel de Información del Alumno -->
    <div class="statbox widget box box-shadow mb-4" id="panel-info-alumno" style="display:none;">
        <div class="widget-header">
            <div class="d-flex flex-wrap align-items-center justify-content-between pr-3">
                <div>
                    <h4><i class="fa-solid fa-user-graduate mr-1"></i> Información del alumno</h4>
                    <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Detalle del alumno seleccionado</p>
                </div>
                <div class="d-print-none mb-2">
                    <button class="btn btn-outline-primary mr-2" id="btn-imprimir-ec">
                        <i class="fa-solid fa-print mr-1"></i> Imprimir / PDF
                    </button>
                    <button class="btn btn-outline-secondary" id="btn-cambiar-alumno">
                        <i class="fa-solid fa-user-pen mr-1"></i> Cambiar alumno
                    </button>
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="small text-muted text-uppercase font-weight-bold">Nombre</div>
                    <div class="font-weight-bold text-dark"><span id="alumno-nombre"></span></div>
                </div>
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="small text-muted text-uppercase font-weight-bold">Identidad</div>
                    <div class="font-weight-bold text-dark"><span id="alumno-identidad"></span></div>
                </div>
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="small text-muted text-uppercase font-weight-bold">Nivel</div>
                    <div class="font-weight-bold text-dark"><span id="alumno-nivel"></span></div>
                </div>
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="small text-muted text-uppercase font-weight-bold">Curso</div>
                    <div class="font-weight-bold text-dark"><span id="alumno-curso"></span></div>
                </div>
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="small text-muted text-uppercase font-weight-bold">Sección</div>
                    <div class="font-weight-bold text-dark"><span id="alumno-seccion"></span></div>
                </div>
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="small text-muted text-uppercase font-weight-bold">Encargado</div>
                    <div class="font-weight-bold text-dark"><span id="alumno-encargado"></span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumen Financiero (KPIs) -->
    <div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-danger" id="total-pendiente">L. 0.00</h6>
                        <p>Saldo pendiente</p>
                    </div>
                    <div><div class="w-icon"><i class="fa-solid fa-hourglass-half"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2">Monto que el alumno debe actualmente</p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value " id="total-deuda">L. 0.00</h6>
                        <p>Total deuda</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-receipt"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2">Emitido acumulado</p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-success" id="total-pagado">L. 0.00</h6>
                        <p>Total pagado</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-cash-coin"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2">Abonado a la fecha</p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-warning" id="total-mora">L. 0.00</h6>
                        <p>Mora</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-exclamation-triangle"></i></div></div>
                </div>
                <p class="text-muted small mb-0 mt-2">Recargo por atraso</p>
            </div>
        </div>
    </div>
    </div>

    <!-- Panel de Cargos Pendientes -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="d-flex flex-wrap align-items-center justify-content-between pr-3">
                <div>
                    <h4><i class="fa-solid fa-list-check mr-1"></i> Cargos pendientes</h4>
                    <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Conceptos por cobrar del alumno</p>
                </div>
                <button class="btn btn-success mb-2 d-print-none" id="btn-registrar-pago">
                    <i class="bi bi-cash-coin mr-1"></i> Registrar pago
                </button>
            </div>
        </div>
        <div class="widget-content widget-content-area p-0">
            <div class="table-responsive fd-scroll">
                <table class="table table-hover mb-0" id="tabla-cargos-pendientes">
                    <thead>
                        <tr>
                            <th>Concepto</th>
                            <th>Monto Original</th>
                            <th>Descuento</th>
                            <th>Mora</th>
                            <th>Total</th>
                            <th>Fecha Venc.</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-cargos-pendientes">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Panel de Histórico de Pagos -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row">
                <div class="col-12">
                    <h4><i class="fa-solid fa-clock-rotate-left mr-1"></i> Histórico de pagos</h4>
                    <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Pagos registrados del alumno</p>
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area p-0">
            <div class="table-responsive fd-scroll">
                <table class="table table-hover mb-0" id="tabla-historico-pagos">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Monto</th>
                            <th>Forma de Pago</th>
                            <th>Referencia</th>
                            <th>Usuario</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-historico-pagos">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Detalle de Cargo -->
<div class="modal fade" id="detail-cargo-modal" tabindex="-1" role="dialog" aria-labelledby="detailCargoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailCargoModalLabel">
                    <i class="bi bi-file-earmark-text mr-2"></i>Detalle del Cargo
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="text-muted small mb-1">ID Cuenta</label>
                            <p class="font-weight-bold" id="detail-cargo-id"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Concepto de Pago</label>
                            <p class="font-weight-bold" id="detail-cargo-concepto"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Monto Original</label>
                            <p class="font-weight-bold" id="detail-cargo-monto-original"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Descuento Aplicado</label>
                            <p class="font-weight-bold text-success" id="detail-cargo-descuento"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Mora</label>
                            <p class="font-weight-bold text-danger" id="detail-cargo-mora"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Monto Total</label>
                            <p class="font-weight-bold text-primary h5" id="detail-cargo-total"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Fecha de Vencimiento</label>
                            <p class="font-weight-bold" id="detail-cargo-fecha-venc"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Estado</label>
                            <p id="detail-cargo-estado"></p>
                        </div>
                    </div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Fecha de Creación</label>
                            <p class="font-weight-bold" id="detail-cargo-fecha-creacion"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Observaciones</label>
                            <p id="detail-cargo-observaciones"></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Detalle de Pago -->
<div class="modal fade" id="detail-pago-modal" tabindex="-1" role="dialog" aria-labelledby="detailPagoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailPagoModalLabel">
                    <i class="bi bi-cash-coin mr-2"></i>Detalle del Pago
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="text-muted small mb-1">ID Pago</label>
                            <p class="font-weight-bold" id="detail-pago-id"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Fecha de Pago</label>
                            <p class="font-weight-bold" id="detail-pago-fecha"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Monto Total</label>
                            <p class="font-weight-bold text-success h5" id="detail-pago-monto"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Forma de Pago</label>
                            <p class="font-weight-bold" id="detail-pago-forma"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Número de Referencia</label>
                            <p class="font-weight-bold" id="detail-pago-referencia"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Número de Recibo</label>
                            <p class="font-weight-bold" id="detail-pago-recibo"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Usuario que Registró</label>
                            <p class="font-weight-bold" id="detail-pago-usuario"></p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Estado</label>
                            <p id="detail-pago-estado"></p>
                        </div>
                    </div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-12">
                        <label class="text-muted small mb-1">Conceptos Pagados</label>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered" id="tabla-conceptos-pago">
                                <thead>
                                    <tr>
                                        <th>Concepto</th>
                                        <th>Monto</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-conceptos-pago">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <div>
                            <label class="text-muted small mb-1">Observaciones</label>
                            <p id="detail-pago-observaciones"></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary btn-ver-recibo-detail" id="btn-ver-recibo-modal">
                    <i class="bi bi-receipt mr-1"></i>Ver Recibo
                </button>
                <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/estadocuenta.js" asp-append-version="true"></script>
    <script>
        var alumnoId = @ViewBag.AlumnoId;
        EstadoCuenta.init({
            alumnoId: alumnoId,
            identidad: "@(ViewBag.Identidad ?? "")",
            urlFindAlumnoByIdentidad: "@Url.Action("FindByIdentidadAsync", "Alumnos")",
            urlFindAlumnoById: "@Url.Action("FindAsync", "Alumnos")",
            urlCargosPendientes: "@Url.Action("ObtenerCargosPendientesAsync", "CuentasCobrar")",
            urlResumenFinanciero: "@Url.Action("ObtenerResumenFinancieroAsync", "CuentasCobrar")",
            urlHistoricoPagos: "@Url.Action("ObtenerHistoricoPagosAsync", "CuentasCobrar")",
            urlAplicarDescuento: "@Url.Action("AplicarDescuentoAsync", "CuentasCobrar")",
            urlCalcularMora: "@Url.Action("CalcularMoratoriaAsync", "CuentasCobrar")",
            urlRecibo: "@Url.Action("GetReciboAsync", "Pagos")"
        });
    </script>
}
