@{
    ViewBag.Title = "Lista de Deudores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Módulo Financiero</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Cuentas por Cobrar</a></li>
            <li class="breadcrumb-item active" aria-current="page">Lista de Deudores</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Lista de deudores</h4>
        <p class="text-muted mb-0">Cuentas vencidas no pagadas</p>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="row"><div class="col-12"><h4>Listado de deudores</h4></div></div>
    </div>
    <div class="widget-content widget-content-area">
        <div class="table-responsive">
            <table class="table table-hover nowrap" id="datatable">
                <thead>
                    <tr>
                        <th>Fila</th>
                        <th>Concepto</th>
                        <th>Alumno</th>
                        <th>Pendiente</th>
                        <th>Fecha Vence</th>
                        <th>Estado Pago</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/deudores.js"></script>
    <script>
        Deudores.datatable({
            urlList: "@Url.Action("ListDeudoresAsync", "CuentasCobrar")"
        });
    </script>
}
