@model GESTION_COLEGIAL.Business.Models.PagoViewModel
@{
    ViewBag.Title = "Histórico de Pagos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Módulo Financiero</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Cuentas por Cobrar</a></li>
            <li class="breadcrumb-item active" aria-current="page">Histórico de Pagos</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Histórico de pagos</h4>
        <p class="text-muted mb-0">Registro de todos los pagos realizados</p>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="row"><div class="col-12"><h4>Pagos realizados</h4></div></div>
    </div>
    <div class="widget-content widget-content-area">
        <div class="table-responsive">
            <table class="table table-hover nowrap" id="datatable">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Fecha</th>
                        <th>Alumno</th>
                        <th>Monto</th>
                        <th>Forma de Pago</th>
                        <th>Referencia</th>
                        <th>Usuario</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/historicopagos.js"></script>
    <script>
        HistoricoPagos.datatable({
            urlList: "@Url.Action("ListAsync", "Pagos")",
            urlRecibo: "@Url.Action("GetReciboAsync", "Pagos")"
        });
    </script>
}
