@{
    ViewBag.Title = "Cuentas por Cobrar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="#">Financiero</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cuentas por Cobrar</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Cuentas por cobrar</h4>
        <p class="text-muted mb-0">Administre y monitoree las cuentas pendientes de pago del sistema</p>
    </div>
    <div class="mt-2 mt-md-0">
        <a href="@Url.Action("Deudores")" class="btn btn-outline-danger"><i class="bi bi-exclamation-circle mr-1"></i> Ver deudores</a>
    </div>
</div>

<div class="row">
    <div class="col-xl-4 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-primary" id="total-pendiente">L 0.00</h6>
                        <p>Total pendiente</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-cash-coin"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-danger" id="cuentas-vencidas">0</h6>
                        <p>Cuentas vencidas</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-calendar-x"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-warning" id="alumnos-deudores">0</h6>
                        <p>Alumnos deudores</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-people"></i></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="row">
            <div class="col-12">
                <h4>Listado de cuentas por cobrar</h4>
                <p class="text-muted small mb-0 px-3 pb-3 mt-n2">Todas las cuentas pendientes (monto pendiente mayor a 0)</p>
            </div>
        </div>
    </div>
    <div class="widget-content widget-content-area">
        <div class="table-responsive">
            <table class="table table-hover nowrap" id="datatable">
                <thead>
                    <tr>
                        <th>Fila</th>
                        <th>Concepto</th>
                        <th>Alumno</th>
                        <th>Pendiente</th>
                        <th>Fecha Vence</th>
                        <th>Estado Pago</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/cuentascobrar.js"></script>
}
