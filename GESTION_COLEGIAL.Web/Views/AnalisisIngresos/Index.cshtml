@{
    ViewBag.Title = "Análisis Ingresos vs Egresos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Análisis Ingresos vs Egresos</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Análisis Ingresos vs Egresos</h4>
        <p class="text-muted mb-0">Recuperación por concepto de pago durante el año</p>
    </div>
    <div class="mt-2 mt-md-0">
        <div class="d-flex flex-wrap align-items-center">
                <label for="f-anio" class="mb-0 mr-2">Año</label>
                <input type="number" class="form-control w-auto mr-3" id="f-anio" value="@ViewBag.AnioActual" min="2020" max="2030" />
                <button type="button" class="btn btn-primary" id="btn-consultar"><i class="fas fa-rotate mr-1"></i> Actualizar</button>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="ai-kpi-cobrado">—</h6>
                        <p>Total Cobrado</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-circle-dollar-to-slot"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="ai-kpi-pendiente">—</h6>
                        <p>Total Pendiente</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-hourglass-half"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="ai-kpi-pct">—</h6>
                        <p>% Recuperación Global</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-percent"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="ai-kpi-conceptos">—</h6>
                        <p>Conceptos</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-tags"></i></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 col-lg-5 layout-spacing">
        <div class="statbox widget box box-shadow h-100">
            <div class="widget-header">
                <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4>Recuperación por Concepto</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <div id="ai-bars-container">
                    <div class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin mr-2"></i>Cargando...</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7 layout-spacing">
        <div class="statbox widget box box-shadow h-100">
            <div class="widget-header">
                <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4>Detalle por Concepto</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <div id="ai-table-container">
                    <div class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin mr-2"></i>Cargando...</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/analisisingresos.js"></script>
    <script>
        AnalisisIngresos.init("@Url.Action("ListAsync")", @ViewBag.AnioActual);
    </script>
}
