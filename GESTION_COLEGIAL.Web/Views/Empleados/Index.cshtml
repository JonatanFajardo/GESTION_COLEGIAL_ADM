@model GESTION_COLEGIAL.Business.Models.EmpleadoViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool puedeCrear = ViewBag.PuedeCrear == true;
    bool puedeEditar = ViewBag.PuedeEditar == true;
    bool puedeEliminar = ViewBag.PuedeEliminar == true;

}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Empleados</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Gestión de Empleados</h4>
        <p class="text-muted mb-0">Administre el personal docente y administrativo del sistema</p>
    </div>
    <div class="mt-2 mt-md-0">
        @if (puedeCrear)
        {
            <a href="@Url.Action("CreateAsync", "Empleados")" class="btn btn-primary">
                <i class="bi bi-plus-lg mr-1"></i>
                Nuevo Empleado
            </a>
        }
    </div>
</div>

<div class="fluid-container">

    @* ── Filtros ── *@
    <div class="statbox widget box box-shadow mb-3">
        <div class="widget-content widget-content-area">
            <div class="row align-items-end">
                <div class="col-md-4 col-sm-12 mb-2 mb-md-0">
                    <label for="custom-table-search">Buscar</label>
                    <input type="text" id="custom-table-search" class="form-control" placeholder="Código o nombre..." autocomplete="off" />
                </div>
                <div class="col-md-3 col-sm-4 mb-2 mb-md-0">
                    <label for="filtro-estado">Estado</label>
                    <select id="filtro-estado" class="custom-select">
                        <option value="">Todos</option>
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-4 mb-2 mb-md-0">
                    <label for="filtro-cargo">Cargo</label>
                    <select id="filtro-cargo" class="custom-select">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-4">
                    <label for="filtro-titulo">Título</label>
                    <select id="filtro-titulo" class="custom-select">
                        <option value="">Todos</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Listado de Empleados</h4></div></div>
        </div>

        <div class="widget-content widget-content-area">
            <div id="tabla-empleados" data-usuario="@(Session["Username"] as string ?? "anonimo")"></div>
        </div>
    </div>
</div>

@if (puedeEliminar)
{
    <!-- Modal Delete-->
    <div class="modal" id="delete-modal-secondary" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            @using (Ajax.BeginForm("DeleteAsync", "Empleados", new AjaxOptions
            {
                HttpMethod = "Post",
                OnBegin = "Modals.begin",
                OnComplete = "Modals.complete",
                OnFailure = "Modals.failure",
                OnSuccess = "Modals.success"
            }))
            {
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"></h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar" hidden><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    <h5>
                    </h5>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                @Html.HiddenFor(model => model.Emp_Id, new { @id = "delete-item-id" })
                                <p>¿Está seguro de que desea eliminar este registro?</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" id="accept-delete-btn" class="btn btn-danger"><i class="bi bi-trash"></i></button>
                </div>
            </div>
            }
        </div>
    </div>
    <!-- Fin Modal -->
}

@section Scripts{
    <partial name="_GcTabla" />
    <script src="~/Content/js/pages/empleados.js" asp-append-version="true"></script>
    <script>
        Empleados.datatable({
            urlList: "@Url.Action("ListAsync")",
            urlInsert: "@Url.Action("CreateAsync")",
            urlUpdate: "@Url.Action("FindAsync")",
            urlDetail: "@Url.Action("DetailAsync")",
            permisos: {
                crear: @(puedeCrear ? "true" : "false"),
                editar: @(puedeEditar ? "true" : "false"),
                eliminar: @(puedeEliminar ? "true" : "false")
            }
        });
    </script>
}