@model GESTION_COLEGIAL.Business.Models.EmpleadoViewModel
@{
    ViewBag.Title = "Detalle del Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
}
@{
    var estadoColor = Model.EsActivo == "Activo" ? "badge-success" : "badge-danger";

    var sexoTexto = Model.Per_Sexo == "M" ? "Masculino" : "Femenino";
    var sexoIcono = Model.Per_Sexo == "M" ? "bi-gender-male" : "bi-gender-female";

    var nombreCompleto = !string.IsNullOrEmpty(Model.Emp_Nombre)
        ? Model.Emp_Nombre
        : $"{Model.Per_PrimerNombre} {Model.Per_SegundoNombre} {Model.Per_ApellidoPaterno} {Model.Per_ApellidoMaterno}".Replace("  ", " ").Trim();
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Empleados</a></li>
            <li class="breadcrumb-item active" aria-current="page">Detalle</li>
        </ol>
    </nav>
</div>

<div class="fluid-container">

    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
        <div class="d-flex align-items-center mr-3">
            <div class="avatar avatar-xl mr-3">
                <span class="avatar-title rounded-circle"><i class="bi bi-person-badge"></i></span>
            </div>
            <div>
                <h4 class="mb-1">@nombreCompleto <small class="text-muted">#@Model.Emp_Id.ToString().PadLeft(4, '0')</small></h4>
                <p class="text-muted mb-1">
                    <i class="bi bi-briefcase mr-1"></i>@Model.Car_Descripcion
                    @if (!string.IsNullOrEmpty(Model.Tit_Descripcion))
                    {
                        <span> &mdash; @Model.Tit_Descripcion</span>
                    }
                </p>
                <div class="d-flex flex-wrap align-items-center text-muted small">
                    @if (!string.IsNullOrEmpty(Model.Per_Identidad))
                    {
                        <span class="mr-3"><i class="bi bi-card-text mr-1"></i>@Model.Per_Identidad</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Emp_Codigo))
                    {
                        <span class="mr-3"><i class="bi bi-hash mr-1"></i>Código @Model.Emp_Codigo</span>
                    }
                    <span class="badge @estadoColor">@Model.EsActivo</span>
                </div>
            </div>
        </div>
        <div class="mt-2 mt-md-0">
            <a href="@Url.Action("Index", "Ficha360EmpleadoAdm")" class="btn btn-outline-primary" title="Vista completa del empleado con todos los datos consolidados">
                <i class="bi bi-person-vcard mr-1"></i> Ficha 360°
            </a>
            <a href="@Url.Action("FindAsync", new { id = Model.Emp_Id })" class="btn btn-primary">
                <i class="bi bi-pencil mr-1"></i> Editar
            </a>
            <a href="@Url.Action("Index")" class="btn">
                <i class="bi bi-arrow-left mr-1"></i> Volver
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Columna izquierda -->
        <div class="col-md-6 layout-spacing">
            <!-- Nombres -->
            <div class="statbox widget box box-shadow mb-4">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4><i class="bi bi-person mr-1"></i> Nombres</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-person text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Primer Nombre</p><p class="font-weight-bold mb-0">@Model.Per_PrimerNombre</p></div>
                    </div>
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-person text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Segundo Nombre</p><p class="font-weight-bold mb-0">@(string.IsNullOrEmpty(Model.Per_SegundoNombre) ? "—" : Model.Per_SegundoNombre)</p></div>
                    </div>
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-person-badge text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Apellido Paterno</p><p class="font-weight-bold mb-0">@Model.Per_ApellidoPaterno</p></div>
                    </div>
                    <div class="d-flex align-items-start">
                        <i class="bi bi-person-badge text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Apellido Materno</p><p class="font-weight-bold mb-0">@(string.IsNullOrEmpty(Model.Per_ApellidoMaterno) ? "—" : Model.Per_ApellidoMaterno)</p></div>
                    </div>
                </div>
            </div>

            <!-- Datos Personales -->
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4><i class="bi bi-card-text mr-1"></i> Datos Personales</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-card-text text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Identidad</p><p class="font-weight-bold mb-0">@Model.Per_Identidad</p></div>
                    </div>
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-calendar2-heart text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Fecha de Nacimiento</p><p class="font-weight-bold mb-0">@Model.Per_FechaNacimiento.ToString("dd/MM/yyyy")</p></div>
                    </div>
                    <div class="d-flex align-items-start">
                        <i class="bi @sexoIcono text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Sexo</p><p class="font-weight-bold mb-0">@sexoTexto</p></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna derecha -->
        <div class="col-md-6 layout-spacing">
            <!-- Contacto -->
            <div class="statbox widget box box-shadow mb-4">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4><i class="bi bi-telephone mr-1"></i> Información de Contacto</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-telephone text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Teléfono</p><p class="font-weight-bold mb-0">@(string.IsNullOrEmpty(Model.Per_Telefono) ? "—" : Model.Per_Telefono)</p></div>
                    </div>
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-envelope text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Correo Electrónico</p><p class="font-weight-bold mb-0">@(string.IsNullOrEmpty(Model.Per_CorreoElectronico) ? "—" : Model.Per_CorreoElectronico)</p></div>
                    </div>
                    <div class="d-flex align-items-start">
                        <i class="bi bi-geo-alt text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Dirección</p><p class="font-weight-bold mb-0">@(string.IsNullOrEmpty(Model.Per_Direccion) ? "—" : Model.Per_Direccion)</p></div>
                    </div>
                </div>
            </div>

            <!-- Laboral -->
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4><i class="bi bi-briefcase mr-1"></i> Información Laboral</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-hash text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Código del Empleado</p><p class="font-weight-bold mb-0">@Model.Emp_Codigo</p></div>
                    </div>
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-mortarboard text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Título</p><p class="font-weight-bold mb-0">@(string.IsNullOrEmpty(Model.Tit_Descripcion) ? "—" : Model.Tit_Descripcion)</p></div>
                    </div>
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-person-workspace text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Cargo</p><p class="font-weight-bold mb-0">@Model.Car_Descripcion</p></div>
                    </div>
                    <div class="d-flex align-items-start">
                        <i class="bi bi-toggle-on text-primary mr-3 mt-1"></i>
                        <div><p class="text-muted small mb-0">Estado</p><p class="mb-0"><span class="badge @estadoColor">@Model.EsActivo</span></p></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Auditoría -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4><i class="bi bi-clock-history mr-1"></i> Información de Registro</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="row">
                <div class="col-md-6 d-flex align-items-start mb-3 mb-md-0">
                    <i class="bi bi-plus-circle text-success mr-3 mt-1"></i>
                    <div>
                        <p class="text-muted small mb-0">Registrado por</p>
                        <p class="font-weight-bold mb-0">@(string.IsNullOrEmpty(Model.Per_UsuarioRegistraNombre) ? "—" : Model.Per_UsuarioRegistraNombre)</p>
                        <p class="text-muted small mb-0"><i class="bi bi-clock mr-1"></i>@Model.Per_FechaRegistra.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
                @if (Model.Per_FechaModifica.HasValue)
                {
                    <div class="col-md-6 d-flex align-items-start">
                        <i class="bi bi-pencil text-warning mr-3 mt-1"></i>
                        <div>
                            <p class="text-muted small mb-0">Modificado por</p>
                            <p class="font-weight-bold mb-0">@(string.IsNullOrEmpty(Model.Per_UsuarioModificaNombre) ? "—" : Model.Per_UsuarioModificaNombre)</p>
                            <p class="text-muted small mb-0"><i class="bi bi-clock mr-1"></i>@Model.Per_FechaModifica.Value.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/empleados.detail.js"></script>
}
