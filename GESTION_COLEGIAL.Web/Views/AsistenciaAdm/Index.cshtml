@{
    ViewBag.Title = "Docencia Diaria";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/modal-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/docencia-diaria.css" rel="stylesheet" />
    <link href="~/css/pages/calendario-escolar.css" rel="stylesheet" asp-append-version="true" />
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Docencia Diaria</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo"><i class="fa-solid fa-chalkboard-user" style="font-size:32px;"></i></div>
            <div class="header-text-catalogo">
                <h1>Docencia Diaria</h1>
                <p>Pase de lista, plan de clases y tareas del horario seleccionado</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">

    <!-- Selector de horario COMPARTIDO (aplica a los 3 tabs) -->
    <div class="card dd-selector-card mb-3 p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-2 dd-selector-label">
                <i class="bi bi-calendar3"></i> Horario
            </div>
            <div class="col-md-7">
                <select id="dd-hor" class="form-control">
                    <option value="">-- Seleccione Horario --</option>
                </select>
            </div>
            <div class="col-md-3 dd-selector-hint">
                <i class="bi bi-info-circle"></i> Aplica a los tres tabs
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="dd-tabs-card">
        <ul class="nav dd-tabs" role="tablist" id="dd-tabs">
            <li class="nav-item dd-tab-item active" data-tab="asistencia">
                <a href="#" class="dd-tab-link">
                    <span class="dd-tab-icon"><i class="bi bi-clipboard-check"></i></span>
                    <span class="dd-tab-label">Pase de Lista</span>
                </a>
            </li>
            <li class="nav-item dd-tab-item" data-tab="plan">
                <a href="#" class="dd-tab-link">
                    <span class="dd-tab-icon"><i class="bi bi-book"></i></span>
                    <span class="dd-tab-label">Plan de Clases</span>
                </a>
            </li>
            <li class="nav-item dd-tab-item" data-tab="tareas">
                <a href="#" class="dd-tab-link">
                    <span class="dd-tab-icon"><i class="bi bi-list-task"></i></span>
                    <span class="dd-tab-label">Tareas</span>
                </a>
            </li>
        </ul>
    </div>

    <!-- ===================== Tab: Pase de Lista ===================== -->
    <div class="dd-panel" id="dd-panel-asistencia">
        <div class="card mb-3 p-3">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="dd-field-label" for="f-fecha">Fecha</label>
                    <input type="date" id="f-fecha" class="form-control">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" id="btn-cargar-asistencia">
                        <i class="fa-solid fa-magnifying-glass"></i> Cargar
                    </button>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-success w-100" id="btn-guardar-todos">
                        <i class="bi bi-check2-all"></i> Guardar Todo
                    </button>
                </div>
            </div>
        </div>
        @* Día en que el colegio cierra (Calendario escolar): sin pase de lista *@
        <div class="cal-banner-cierre" id="asis-cierre" role="alert" hidden>
            <i class="bi bi-lock-fill" aria-hidden="true"></i>
            <div>
                <strong>Ese día no hay pase de lista</strong>
                <p id="asis-cierre-texto"></p>
                <p><a href="@Url.Action("Index", "CalendarioEscolar")" id="asis-cierre-link">Ver el calendario escolar</a></p>
            </div>
        </div>
        <div class="card-listado-catalogo">
            <div class="card-body-listado-catalogo">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered" id="tabla-asistencia">
                        <thead><tr><th>Alumno</th><th>Estado</th><th>Observación</th><th>Guardar</th></tr></thead>
                        <tbody id="tbody-asistencia"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== Tab: Plan de Clases ===================== -->
    <div class="dd-panel" id="dd-panel-plan" hidden>
        <div class="dd-panel-toolbar">
            <div class="dd-panel-desc">
                <i class="bi bi-info-circle"></i> Plan de contenidos por semana del horario seleccionado
            </div>
            <button class="btn-nuevo-catalogo" id="btn-nuevo-plan" disabled>
                <i class="bi bi-plus-circle"></i> Nuevo Tema
            </button>
        </div>
        <div class="card-listado-catalogo">
            <div class="card-body-listado-catalogo">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Semana</th><th>Tema</th><th>Objetivos</th>
                                <th>Recursos</th><th>Estado</th><th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-plan"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== Tab: Tareas ===================== -->
    <div class="dd-panel" id="dd-panel-tareas" hidden>
        <div class="dd-panel-toolbar">
            <div class="dd-panel-desc">
                <i class="bi bi-info-circle"></i> Tareas asignadas al horario seleccionado
            </div>
            <button class="btn-nuevo-catalogo" id="btn-nueva-tarea" disabled>
                <i class="bi bi-plus-circle"></i> Nueva Tarea
            </button>
        </div>
        <div class="card-listado-catalogo">
            <div class="card-body-listado-catalogo">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Título</th><th>Descripción</th><th>Entrega</th>
                                <th>Punteo</th><th>Estado</th><th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-tareas"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Modal: Plan de Clases -->
<div class="modal fade" id="modal-plan" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content modal-content-catalogo">
            <div class="modal-header-catalogo">
                <div><h5 class="modal-title-catalogo" id="plan-modal-titulo">Nuevo Tema</h5></div>
                <button type="button" class="close close-catalogo" data-dismiss="modal">&times;</button>
            </div>
            <form id="form-plan">
                <input type="hidden" name="Pla_Id" id="Pla_Id" value="0">
                <input type="hidden" name="Hor_Id" id="plan-hor-hidden">
                <div class="modal-body-catalogo">
                    <div class="form-card-catalogo">
                        <div class="row">
                            <div class="col-md-3 form-group-catalogo">
                                <label class="form-label-catalogo">Semana *</label>
                                <input type="number" name="Pla_Semana" class="form-control form-input-catalogo" min="1" max="52" required>
                            </div>
                            <div class="col-md-9 form-group-catalogo">
                                <label class="form-label-catalogo">Tema *</label>
                                <input type="text" name="Pla_Tema" class="form-control form-input-catalogo" maxlength="200" required>
                            </div>
                            <div class="col-md-12 form-group-catalogo">
                                <label class="form-label-catalogo">Objetivos</label>
                                <textarea name="Pla_Objetivos" class="form-control form-input-catalogo" rows="3"></textarea>
                            </div>
                            <div class="col-md-8 form-group-catalogo">
                                <label class="form-label-catalogo">Recursos / Materiales</label>
                                <input type="text" name="Pla_Recursos" class="form-control form-input-catalogo" maxlength="300">
                            </div>
                            <div class="col-md-4 form-group-catalogo" id="plan-div-estado" style="display:none;">
                                <label class="form-label-catalogo">Estado</label>
                                <select name="Pla_Estado" class="form-control form-input-catalogo">
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="Impartido">Impartido</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer-catalogo">
                    <button type="button" class="btn-cancel-catalogo" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-save-catalogo">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Tareas -->
<div class="modal fade" id="modal-tarea" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content modal-content-catalogo">
            <div class="modal-header-catalogo">
                <div><h5 class="modal-title-catalogo" id="tarea-modal-titulo">Nueva Tarea</h5></div>
                <button type="button" class="close close-catalogo" data-dismiss="modal">&times;</button>
            </div>
            <form id="form-tarea">
                <input type="hidden" name="Tar_Id" id="Tar_Id" value="0">
                <input type="hidden" name="Hor_Id" id="tarea-hor-hidden">
                <div class="modal-body-catalogo">
                    <div class="form-card-catalogo">
                        <div class="row">
                            <div class="col-md-8 form-group-catalogo">
                                <label class="form-label-catalogo">Título *</label>
                                <input type="text" name="Tar_Titulo" class="form-control form-input-catalogo" maxlength="200" required>
                            </div>
                            <div class="col-md-4 form-group-catalogo">
                                <label class="form-label-catalogo">Fecha de Entrega *</label>
                                <input type="date" name="Tar_FechaEntrega" class="form-control form-input-catalogo" required>
                            </div>
                            <div class="col-md-12 form-group-catalogo">
                                <label class="form-label-catalogo">Descripción</label>
                                <textarea name="Tar_Descripcion" class="form-control form-input-catalogo" rows="3"></textarea>
                            </div>
                            <div class="col-md-4 form-group-catalogo">
                                <label class="form-label-catalogo">Punteo máximo</label>
                                <input type="number" step="0.01" name="Tar_Punteo" class="form-control form-input-catalogo" value="100">
                            </div>
                            <div class="col-md-4 form-group-catalogo" id="tarea-div-estado" style="display:none;">
                                <label class="form-label-catalogo">Estado</label>
                                <select name="Tar_Estado" class="form-control form-input-catalogo">
                                    <option value="Activa">Activa</option>
                                    <option value="Cerrada">Cerrada</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer-catalogo">
                    <button type="button" class="btn-cancel-catalogo" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-save-catalogo">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/asistenciaadm.js"></script>
    <script>
        AsistenciaAdm.init({
            dropdowns:      "@Url.Action("DropdownsAsync", "AsistenciaAdm")",
            asisList:       "@Url.Action("ListAsync", "AsistenciaAdm")",
            asisMarcar:     "@Url.Action("MarcarAsync", "AsistenciaAdm")",
            asisCierre:     "@Url.Action("CierreAsync", "AsistenciaAdm")",
            planList:       "@Url.Action("ListAsync", "PlanClasesAdm")",
            planCreate:     "@Url.Action("CreateAsync", "PlanClasesAdm")",
            planEdit:       "@Url.Action("EditAsync", "PlanClasesAdm")",
            planDelete:     "@Url.Action("DeleteAsync", "PlanClasesAdm")",
            tareaList:      "@Url.Action("ListAsync", "TareasAdm")",
            tareaCreate:    "@Url.Action("CreateAsync", "TareasAdm")",
            tareaEdit:      "@Url.Action("EditAsync", "TareasAdm")",
            tareaDelete:    "@Url.Action("DeleteAsync", "TareasAdm")"
        });
    </script>
}
