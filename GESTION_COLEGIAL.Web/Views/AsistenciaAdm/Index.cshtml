@{
    ViewBag.Title = "Docencia Diaria";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Docencia Diaria</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Docencia Diaria</h4>
        <p class="text-muted mb-0">Pase de lista, plan de clases y tareas del horario seleccionado</p>
    </div>
</div>

<div class="fluid-container">

    <!-- Selector de horario COMPARTIDO (aplica a los 3 tabs) -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="form-row align-items-center">
                <div class="col-md-2 font-weight-bold">
                    <i class="bi bi-calendar3 mr-1"></i> Horario
                </div>
                <div class="col-md-7">
                    <select id="dd-hor" class="custom-select">
                        <option value="">-- Seleccione Horario --</option>
                    </select>
                </div>
                <div class="col-md-3 text-muted small">
                    <i class="bi bi-info-circle mr-1"></i> Aplica a los tres tabs
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" role="tablist" id="dd-tabs">
        <li class="nav-item">
            <a href="#" class="nav-link dd-tab-item active" data-tab="asistencia"><i class="bi bi-clipboard-check mr-1"></i> Pase de Lista</a>
        </li>
        <li class="nav-item">
            <a href="#" class="nav-link dd-tab-item" data-tab="plan"><i class="bi bi-book mr-1"></i> Plan de Clases</a>
        </li>
        <li class="nav-item">
            <a href="#" class="nav-link dd-tab-item" data-tab="tareas"><i class="bi bi-list-task mr-1"></i> Tareas</a>
        </li>
    </ul>

    <!-- ===================== Tab: Pase de Lista ===================== -->
    <div class="dd-panel" id="dd-panel-asistencia">
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-content widget-content-area">
            <div class="form-row">
                <div class="col-md-3">
                    <label for="f-fecha">Fecha</label>
                    <input type="date" id="f-fecha" class="form-control">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" id="btn-cargar-asistencia">
                        <i class="fa-solid fa-magnifying-glass mr-1"></i> Cargar
                    </button>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-success w-100" id="btn-guardar-todos">
                        <i class="bi bi-check2-all mr-1"></i> Guardar Todo
                    </button>
                </div>
            </div>
            </div>
        </div>
        @* Día en que el colegio cierra (Calendario escolar): sin pase de lista *@
        <div class="alert alert-light-danger mb-4" id="asis-cierre" role="alert" hidden>
            <strong><i class="bi bi-lock-fill mr-1" aria-hidden="true"></i> Ese día no hay pase de lista</strong>
            <p class="mb-1" id="asis-cierre-texto"></p>
            <a class="alert-link" href="@Url.Action("Index", "CalendarioEscolar")" id="asis-cierre-link">Ver el calendario escolar</a>
        </div>
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover" id="tabla-asistencia">
                        <thead><tr><th>Alumno</th><th>Estado</th><th>Observación</th><th>Guardar</th></tr></thead>
                        <tbody id="tbody-asistencia"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== Tab: Plan de Clases ===================== -->
    <div class="dd-panel" id="dd-panel-plan" hidden>
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
            <div class="text-muted"><i class="bi bi-info-circle mr-1"></i> Plan de contenidos por semana del horario seleccionado</div>
            <button class="btn btn-primary" id="btn-nuevo-plan" disabled><i class="bi bi-plus-lg mr-1"></i> Nuevo Tema</button>
        </div>
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Semana</th><th>Tema</th><th>Objetivos</th>
                                <th>Recursos</th><th>Estado</th><th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-plan"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== Tab: Tareas ===================== -->
    <div class="dd-panel" id="dd-panel-tareas" hidden>
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
            <div class="text-muted"><i class="bi bi-info-circle mr-1"></i> Tareas asignadas al horario seleccionado</div>
            <button class="btn btn-primary" id="btn-nueva-tarea" disabled><i class="bi bi-plus-lg mr-1"></i> Nueva Tarea</button>
        </div>
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Título</th><th>Descripción</th><th>Entrega</th>
                                <th>Punteo</th><th>Estado</th><th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-tareas"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Modal: Plan de Clases -->
<div class="modal fade" id="modal-plan" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="plan-modal-titulo">Nuevo Tema</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="form-plan">
                <input type="hidden" name="Pla_Id" id="Pla_Id" value="0">
                <input type="hidden" name="Hor_Id" id="plan-hor-hidden">
                <div class="modal-body">
                    <div>
                        <div class="form-row">
                            <div class="col-md-3 form-group">
                                <label>Semana *</label>
                                <input type="number" name="Pla_Semana" class="form-control" min="1" max="52" required>
                            </div>
                            <div class="col-md-9 form-group">
                                <label>Tema *</label>
                                <input type="text" name="Pla_Tema" class="form-control" maxlength="200" required>
                            </div>
                            <div class="col-md-12 form-group" id="plan-temario" hidden>
                                <label class="mb-1">Del temario de la materia para esta semana</label>
                                <div class="list-group" id="plan-temario-lista"></div>
                                <small class="form-text text-muted">Elija un tema para llenar tema, objetivos y recursos. Puede ajustarlos después.</small>
                            </div>
                            <div class="col-md-12 form-group">
                                <label>Objetivos</label>
                                <textarea name="Pla_Objetivos" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="col-md-8 form-group">
                                <label>Recursos / Materiales</label>
                                <input type="text" name="Pla_Recursos" class="form-control" maxlength="300">
                            </div>
                            <div class="col-md-4 form-group" id="plan-div-estado" style="display:none;">
                                <label>Estado</label>
                                <select name="Pla_Estado" class="custom-select">
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="Impartido">Impartido</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Tareas -->
<div class="modal fade" id="modal-tarea" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tarea-modal-titulo">Nueva Tarea</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="form-tarea">
                <input type="hidden" name="Tar_Id" id="Tar_Id" value="0">
                <input type="hidden" name="Hor_Id" id="tarea-hor-hidden">
                <div class="modal-body">
                    <div>
                        <div class="form-row">
                            <div class="col-md-8 form-group">
                                <label>Título *</label>
                                <input type="text" name="Tar_Titulo" class="form-control" maxlength="200" required>
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Fecha de Entrega *</label>
                                <input type="date" name="Tar_FechaEntrega" class="form-control" required>
                            </div>
                            <div class="col-md-12 form-group">
                                <label>Descripción</label>
                                <textarea name="Tar_Descripcion" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Punteo máximo</label>
                                <input type="number" step="0.01" name="Tar_Punteo" class="form-control" value="100">
                            </div>
                            <div class="col-md-4 form-group" id="tarea-div-estado" style="display:none;">
                                <label>Estado</label>
                                <select name="Tar_Estado" class="custom-select">
                                    <option value="Activa">Activa</option>
                                    <option value="Cerrada">Cerrada</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/asistenciaadm.js"></script>
    <script>
        AsistenciaAdm.init({
            dropdowns:      "@Url.Action("DropdownsAsync", "AsistenciaAdm")",
            asisList:       "@Url.Action("ListAsync", "AsistenciaAdm")",
            asisMarcar:     "@Url.Action("MarcarAsync", "AsistenciaAdm")",
            asisCierre:     "@Url.Action("CierreAsync", "AsistenciaAdm")",
            asisAlertas:    "@Url.Action("AlertasSaludAsync", "AsistenciaAdm")",
            planList:       "@Url.Action("ListAsync", "PlanClasesAdm")",
            planCreate:     "@Url.Action("CreateAsync", "PlanClasesAdm")",
            planEdit:       "@Url.Action("EditAsync", "PlanClasesAdm")",
            planDelete:     "@Url.Action("DeleteAsync", "PlanClasesAdm")",
            planTemario:    "@Url.Action("TemasDelTemarioAsync", "PlanClasesAdm")",
            tareaList:      "@Url.Action("ListAsync", "TareasAdm")",
            tareaCreate:    "@Url.Action("CreateAsync", "TareasAdm")",
            tareaEdit:      "@Url.Action("EditAsync", "TareasAdm")",
            tareaDelete:    "@Url.Action("DeleteAsync", "TareasAdm")"
        });
    </script>
}
