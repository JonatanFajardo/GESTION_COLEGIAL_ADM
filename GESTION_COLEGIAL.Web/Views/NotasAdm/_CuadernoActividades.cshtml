@* Actividades del cuaderno de notas (notas ponderadas). Lo maneja cuaderno-actividades.js: al cargar una
   materia, sección y parcial muestra la forma de calificar (nota directa o por actividades con los pesos de
   la plantilla), la planilla de puntos y las ventanas para crear, editar o quitar actividades. *@
<div id="ev-raiz"
     data-url-cuaderno="@Url.Action("CuadernoAsync", "ActividadesEvaluacion")"
     data-url-guardar-actividad="@Url.Action("GuardarActividadAsync", "ActividadesEvaluacion")"
     data-url-quitar-actividad="@Url.Action("QuitarActividadAsync", "ActividadesEvaluacion")"
     data-url-guardar-puntos="@Url.Action("GuardarPuntosAsync", "ActividadesEvaluacion")"
     data-url-actualizar="@Url.Action("ActualizarNotasAsync", "ActividadesEvaluacion")"
     data-url-nota-minima="@Url.Action("NotaMinimaAsync", "GraduacionAlumnos")">

    <div id="ev-resumen" hidden></div>
    <div id="ev-error" hidden></div>

    <div class="statbox widget box box-shadow mb-4" id="ev-panel" hidden>
        <div class="widget-header">
            <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 pb-2 px-3">
                <div class="mr-3 mb-2">
                    <h4 class="p-0 mb-1">Puntos de las actividades</h4>
                    <p class="text-muted small mb-0">
                        Escriba los puntos de cada alumno. <strong>E</strong> = excusado (no cuenta) ·
                        <strong>NE</strong> = no entregó (cuenta 0) · vacío = sin calificar (todavía no cuenta).
                        Enter baja a la siguiente fila.
                    </p>
                </div>
                <div class="d-flex flex-wrap align-items-center mb-2">
                    <span class="text-muted small mr-3" id="ev-cambios" aria-live="polite"></span>
                    <button type="button" class="btn btn-outline-secondary mr-2" id="ev-deshacer" disabled>
                        <i class="bi bi-arrow-counterclockwise mr-1" aria-hidden="true"></i> Deshacer cambios
                    </button>
                    <button type="button" class="btn btn-primary" id="ev-guardar" disabled>
                        <i class="bi bi-check2-all mr-1" aria-hidden="true"></i> Guardar puntos
                    </button>
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-bordered table-hover np-planilla" id="ev-tabla">
                    <thead></thead>
                    <tbody></tbody>
                    <tfoot class="np-pie"></tfoot>
                </table>
            </div>
        </div>
    </div>

    @* ── Crear o editar una actividad ── *@
    <div class="modal fade" id="ev-modal" tabindex="-1" role="dialog" aria-labelledby="ev-modal-titulo" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <form class="modal-content" id="ev-form" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="ev-modal-titulo">Nueva actividad</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    <div id="ev-form-error" hidden></div>
                    <p class="text-muted small" id="ev-form-grupo"></p>
                    <div class="form-row">
                        <div class="form-group col-md-8">
                            <label for="ev-nombre">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ev-nombre" maxlength="150" placeholder="Ej.: Examen del primer parcial" required>
                            <div class="invalid-feedback">Escriba el nombre de la actividad.</div>
                        </div>
                        <div class="form-group col-md-4">
                            <label for="ev-tipo">Tipo de evaluación <span class="text-danger">*</span></label>
                            <select class="custom-select" id="ev-tipo" required></select>
                            <div class="invalid-feedback">Elija el tipo.</div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="ev-max">Puntos máximos <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="ev-max" min="0.01" max="1000" step="0.01" inputmode="decimal" required>
                            <div class="invalid-feedback" id="ev-max-error">Escriba un número mayor que 0 y hasta 1000.</div>
                        </div>
                        <div class="form-group col-md-4">
                            <label for="ev-fecha">Fecha de entrega</label>
                            <input type="date" class="form-control" id="ev-fecha">
                            <div class="invalid-feedback" id="ev-fecha-error">La fecha debe estar dentro del año lectivo.</div>
                        </div>
                        <div class="form-group col-md-4 d-flex align-items-end">
                            <div class="custom-control custom-checkbox mb-2">
                                <input type="checkbox" class="custom-control-input" id="ev-nocuenta">
                                <label class="custom-control-label" for="ev-nocuenta">No cuenta para la nota (práctica)</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="ev-descripcion">Descripción (opcional)</label>
                        <textarea class="form-control" id="ev-descripcion" rows="2" maxlength="500" placeholder="Qué se evalúa, instrucciones, etc."></textarea>
                    </div>
                    <div class="form-group mb-0" id="ev-otras-grupo" hidden>
                        <label class="d-block">Crear también en estas secciones</label>
                        <small class="form-text text-muted mt-0 mb-2">Misma materia y grado. Cada sección tiene sus propios puntos.</small>
                        <div id="ev-otras"></div>
                    </div>
                    <div class="form-group mb-0 border-top pt-3" id="ev-llenar-grupo" hidden>
                        <label class="d-block">Llenar las celdas vacías de esta actividad</label>
                        <small class="form-text text-muted mt-0 mb-2">Se escriben en la planilla sin guardar: revíselas y pulse «Guardar puntos».</small>
                        <button type="button" class="btn btn-sm btn-outline-primary mr-2 mb-1" data-llenar="no_entrego">Poner «No entregó» (NE)</button>
                        <button type="button" class="btn btn-sm btn-outline-primary mb-1" data-llenar="maximo">Poner los puntos máximos</button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="ev-form-guardar">Guardar actividad</button>
                </div>
            </form>
        </div>
    </div>

    @* ── Confirmar quitar una actividad ── *@
    <div class="modal fade" id="ev-modal-quitar" tabindex="-1" role="dialog" aria-labelledby="ev-quitar-titulo" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ev-quitar-titulo">Quitar actividad</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body"><p class="mb-0" id="ev-quitar-texto"></p></div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="ev-quitar-confirmar">Quitar actividad</button>
                </div>
            </div>
        </div>
    </div>

    @* ── Cambios sin guardar al cambiar de materia o parcial ── *@
    <div class="modal fade" id="ev-modal-descartar" tabindex="-1" role="dialog" aria-labelledby="ev-descartar-titulo" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ev-descartar-titulo">Cambios sin guardar</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body"><p class="mb-0" id="ev-descartar-texto"></p></div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Seguir editando</button>
                    <button type="button" class="btn btn-danger" id="ev-descartar-confirmar">Descartar cambios</button>
                </div>
            </div>
        </div>
    </div>
</div>
