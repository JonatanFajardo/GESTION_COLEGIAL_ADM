@{
    ViewBag.Title = "Notas y Boletín";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Notas y Boletín</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Notas y Boletín</h4>
        <p class="text-muted mb-0">Capture las notas por horario y parcial, y consulte el boletín completo por alumno</p>
    </div>
</div>

<div class="fluid-container">

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" role="tablist" id="nb-tabs">
        <li class="nav-item">
            <a href="#" class="nav-link active" data-tab="cuaderno"><i class="bi bi-pencil-square mr-1"></i> 1 · Cuaderno de Notas</a>
        </li>
        <li class="nav-item">
            <a href="#" class="nav-link" data-tab="boletin"><i class="bi bi-file-earmark-text mr-1"></i> 2 · Boletín</a>
        </li>
    </ul>

    <!-- ============================================ -->
    <!-- Tab 1: Cuaderno de Notas (captura)            -->
    <!-- ============================================ -->
    <div class="nb-tab-panel" id="nb-panel-cuaderno">
        <div class="alert alert-light-info mb-4" role="alert">
            <i class="bi bi-info-circle-fill mr-1"></i> <strong>Captura de notas.</strong> Seleccione el horario y el parcial para ingresar o corregir las notas de los alumnos.
        </div>
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-content widget-content-area">
            <div class="form-row">
                <div class="col-md-5">
                    <select id="f-hor" class="custom-select">
                        <option value="">-- Seleccione Horario --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="f-par" class="custom-select">
                        <option value="">-- Seleccione Parcial --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btn-cargar">
                        <i class="fa-solid fa-magnifying-glass mr-1"></i> Cargar
                    </button>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-success w-100" id="btn-guardar-todo">
                        <i class="bi bi-check2-all mr-1"></i> Guardar Todo
                    </button>
                </div>
            </div>
            </div>
        </div>
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover" id="tabla-notas">
                        <thead><tr><th>Alumno</th><th>Nota</th><th>Guardar</th></tr></thead>
                        <tbody id="tbody-notas"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- Tab 2: Boletín (consulta)                     -->
    <!-- ============================================ -->
    <div class="nb-tab-panel" id="nb-panel-boletin" hidden>
        <div class="alert alert-light-info mb-4" role="alert">
            <i class="bi bi-info-circle-fill mr-1"></i> <strong>Boletín de calificaciones.</strong> Consulte el boletín completo de notas por alumno y año. Las notas bajo la nota mínima de aprobación se resaltan en rojo.
        </div>
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-content widget-content-area">
            <div class="form-row">
                <div class="col-md-6">
                    <select id="f-alu" class="custom-select"><option value="">-- Seleccione Alumno --</option></select>
                </div>
                <div class="col-md-3">
                    <input type="number" id="f-anio" class="form-control" placeholder="Año" step="1" value="@DateTime.Now.Year">
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary w-100" id="btn-ver">
                        <i class="fa-solid fa-magnifying-glass mr-1"></i> Ver Boletín
                    </button>
                </div>
            </div>
            </div>
        </div>
        <div class="statbox widget box box-shadow mb-4" id="panel-boletin" style="display:none;">
            <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover" id="tabla-boletin">
                        <thead>
                            <tr id="thead-boletin">
                                <!-- Columnas generadas dinámicamente según el catálogo de Parciales -->
                            </tr>
                        </thead>
                        <tbody id="tbody-boletin"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/notasadm.js"></script>
    <script>
        NotasAdm.init({
            urlList:          "@Url.Action("ListAsync", "NotasAdm")",
            urlGuardar:       "@Url.Action("GuardarNota", "NotasAdm")",
            urlDropdowns:     "@Url.Action("DropdownsAsync", "NotasAdm")",
            urlBoletinGet:    "@Url.Action("GetAsync", "BoletinAdm")",
            urlBoletinDrops:  "@Url.Action("DropdownsAsync", "BoletinAdm")",
            urlNotaMinima:    "@Url.Action("NotaMinimaAsync", "GraduacionAlumnos")"
        });
    </script>
}
