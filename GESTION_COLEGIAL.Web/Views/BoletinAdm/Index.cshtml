@{
    ViewBag.Title = "Boletín de Calificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Boletín de Calificaciones</li>
        </ol>
    </nav>
</div>
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Boletín de Calificaciones</h4>
        <p class="text-muted mb-0">Consulte el boletín completo de notas por alumno y año</p>
    </div>
</div>
<div class="fluid-container">
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
        <div class="form-row">
            <div class="col-md-5 mb-2 mb-md-0">
                <select id="f-alu" class="custom-select"><option value="">-- Seleccione Alumno --</option></select>
            </div>
            <div class="col-md-2 mb-2 mb-md-0">
                <input type="number" id="f-anio" class="form-control" placeholder="Año" value="@DateTime.Now.Year">
            </div>
            <div class="col-md-3 mb-2 mb-md-0">
                <select id="f-sem-boletin" class="custom-select" aria-label="Semestre" disabled><option value="">Todo el año</option></select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" id="btn-ver">
                    <i class="fa-solid fa-magnifying-glass mr-1"></i> Ver Boletín
                </button>
            </div>
        </div>
        </div>
    </div>
    <div id="boletin-provisional" hidden></div>
    <div class="statbox widget box box-shadow mb-4" id="panel-boletin" style="display:none;">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Notas por materia</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover" id="tabla-boletin">
                    <thead>
                        <tr id="thead-boletin"></tr>
                    </thead>
                    <tbody id="tbody-boletin"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Content/js/components/boletin-provisional.js" asp-append-version="true"></script>
    <script src="~/Content/js/components/boletin-notas.js" asp-append-version="true"></script>
    <script>
        BoletinNotas.init({
            urlGet:           "@Url.Action("GetAsync")",
            urlAlumnos:       "@Url.Action("DropdownsAsync")",
            urlPublicacion:   "@Url.Action("PublicacionAsync")",
            urlEscala:        "@Url.Action("EscalaAsync")",
            urlNotaMinima:    "@Url.Action("NotaMinimaAsync", "GraduacionAlumnos")",
            avisoProvisional: "#boletin-provisional"
        });
    </script>
}
