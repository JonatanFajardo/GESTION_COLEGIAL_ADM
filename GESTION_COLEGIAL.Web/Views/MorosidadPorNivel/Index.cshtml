@{
    ViewBag.Title = "Morosidad por Nivel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Morosidad por Nivel</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Morosidad por Nivel</h4>
        <p class="text-muted mb-0">Morosidad agrupada por nivel educativo</p>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="row"><div class="col-12"><h4>Morosidad por nivel</h4></div></div>
    </div>
    <div class="widget-content widget-content-area">
        <div class="table-responsive">
            <table class="table table-hover nowrap" id="datatable-morosidadpornivel">
                <thead><tr><th>Nivel</th><th>Alumnos</th><th>Pendiente</th></tr></thead>
            </table>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/morosidadpornivel.js"></script>
    <script>
        MorosidadPorNivel.init("@Url.Action("ListAsync")");
    </script>
}
