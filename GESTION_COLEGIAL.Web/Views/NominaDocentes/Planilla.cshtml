@model System.Collections.Generic.IEnumerable<GESTION_COLEGIAL.Business.Models.NominaDocenteViewModel>
@using System.Globalization
@using System.Linq
@{
    Layout = null;
    var culHn = new CultureInfo("es-HN");
    var lista = (Model ?? Enumerable.Empty<GESTION_COLEGIAL.Business.Models.NominaDocenteViewModel>()).ToList();
    int anio = ViewBag.Anio ?? 2026;
    int semestre = ViewBag.Semestre ?? 1;
    string semestreLabel = semestre == 2 ? "Segundo Semestre" : "Primer Semestre";
    Func<decimal, string> L = m => "L " + m.ToString("N2", culHn);

    decimal totSueldoBruto = lista.Sum(x => x.SueldoBruto);
    decimal totHorasExtra = lista.Sum(x => x.HorasExtraMonto);
    decimal totTotalBruto = lista.Sum(x => x.TotalBruto);
    decimal totIhss = lista.Sum(x => x.DeduccionIHSS);
    decimal totIsr = lista.Sum(x => x.DeduccionISR);
    decimal totColegio = lista.Sum(x => x.DeduccionColegio);
    decimal totDeducciones = lista.Sum(x => x.TotalDeducciones);
    decimal totNeto = lista.Sum(x => x.NetoAPagar);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planilla de Nómina Docente - @anio @semestreLabel</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
            padding: 20px;
            color: #222;
        }

        .planilla-container {
            max-width: 1200px;
            margin: 0 auto;
            background-color: #fff;
            padding: 32px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .header {
            text-align: center;
            border-bottom: 3px solid #059669;
            padding-bottom: 16px;
            margin-bottom: 20px;
        }

        .header h1 {
            color: #059669;
            font-size: 24px;
            margin-bottom: 4px;
        }

        .header p { color: #666; font-size: 13px; margin-top: 2px; }
        .header .periodo { font-weight: 600; color: #333; margin-top: 6px; font-size: 14px; }

        .resumen-bar {
            display: flex; flex-wrap: wrap; gap: 10px;
            margin-bottom: 20px;
        }
        .resumen-item {
            flex: 1; min-width: 150px;
            background-color: #f0fdf4;
            border-left: 4px solid #059669;
            padding: 10px 14px;
        }
        .resumen-item .lbl { font-size: 11px; text-transform: uppercase; color: #666; letter-spacing: .03em; }
        .resumen-item .val { font-size: 17px; font-weight: 700; color: #059669; margin-top: 2px; }

        table.tabla-planilla {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        .tabla-planilla thead th {
            background-color: #059669;
            color: #fff;
            padding: 8px 6px;
            text-align: left;
            white-space: nowrap;
        }

        .tabla-planilla td {
            padding: 6px 6px;
            border-bottom: 1px solid #eee;
        }

        .tabla-planilla tbody tr:nth-child(even) { background-color: #fafafa; }

        .tabla-planilla th.num, .tabla-planilla td.num { text-align: right; white-space: nowrap; }

        .tabla-planilla td.neto, .tabla-planilla th.neto { font-weight: 700; color: #059669; }

        .tabla-planilla tfoot td {
            border-top: 2px solid #059669;
            font-weight: 700;
            background-color: #f0fdf4;
            padding: 8px 6px;
        }

        .vacio { text-align: center; padding: 30px; color: #888; }

        .footer {
            margin-top: 24px;
            padding-top: 12px;
            border-top: 1px solid #e0e0e0;
            text-align: center;
            color: #888;
            font-size: 11px;
        }

        .btn-imprimir, .btn-cerrar {
            position: fixed;
            top: 20px;
            border: none;
            padding: 12px 24px;
            font-size: 15px;
            border-radius: 5px;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            color: #fff;
        }

        .btn-imprimir { right: 20px; background-color: #059669; }
        .btn-imprimir:hover { background-color: #047857; }
        .btn-cerrar { left: 20px; background-color: #6c757d; }
        .btn-cerrar:hover { background-color: #5a6268; }

        /* Estilos para impresión: ocultar controles, ajustar hoja */
        @@page { size: landscape; margin: 10mm; }
        @@media print {
            body { background-color: #fff; padding: 0; }
            .planilla-container { box-shadow: none; padding: 0; max-width: 100%; }
            .no-print, .btn-imprimir, .btn-cerrar { display: none !important; }
            .tabla-planilla thead th {
                background-color: #059669 !important;
                color: #fff !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .tabla-planilla tfoot td {
                background-color: #f0fdf4 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <button class="btn-cerrar no-print" onclick="window.close()">← Cerrar</button>
    <button class="btn-imprimir no-print" onclick="window.print()">🖨️ Imprimir</button>

    <div class="planilla-container">
        <div class="header">
            <h1>PLANILLA DE NÓMINA DOCENTE</h1>
            <p>Sistema de Gestión Colegial</p>
            <p class="periodo">Período: @anio &mdash; @semestreLabel</p>
        </div>

        <div class="resumen-bar">
            <div class="resumen-item">
                <div class="lbl">Docentes en planilla</div>
                <div class="val">@lista.Count</div>
            </div>
            <div class="resumen-item">
                <div class="lbl">Total bruto</div>
                <div class="val">@L(totTotalBruto)</div>
            </div>
            <div class="resumen-item">
                <div class="lbl">Total deducciones</div>
                <div class="val">@L(totDeducciones)</div>
            </div>
            <div class="resumen-item">
                <div class="lbl">Total neto a pagar</div>
                <div class="val">@L(totNeto)</div>
            </div>
        </div>

        @if (!lista.Any())
        {
            <p class="vacio">No hay nómina calculada para el período seleccionado.</p>
        }
        else
        {
            <table class="tabla-planilla">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Docente</th>
                        <th>Título</th>
                        <th>Área</th>
                        <th>Modalidad</th>
                        <th class="num">Materias</th>
                        <th class="num">Secciones</th>
                        <th class="num">Períodos/mes</th>
                        <th class="num">Extra/mes</th>
                        <th class="num">Sueldo bruto</th>
                        <th class="num">Horas extra</th>
                        <th class="num">Total bruto</th>
                        <th class="num">IHSS</th>
                        <th class="num">ISR</th>
                        <th class="num">Colegio</th>
                        <th class="num">Total ded.</th>
                        <th class="num neto">Neto a pagar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in lista)
                    {
                        <tr>
                            <td>@n.Emp_Codigo</td>
                            <td>@n.NombreCompleto</td>
                            <td>@n.TituloDescripcion</td>
                            <td>@n.AreaPrincipal</td>
                            <td>@n.ModalidadPrincipal</td>
                            <td class="num">@n.MateriasDistintas</td>
                            <td class="num">@n.SeccionesAtendidas</td>
                            <td class="num">@n.PeriodosMensuales</td>
                            <td class="num">@n.PeriodosExtraMensuales</td>
                            <td class="num">@L(n.SueldoBruto)</td>
                            <td class="num">@L(n.HorasExtraMonto)</td>
                            <td class="num">@L(n.TotalBruto)</td>
                            <td class="num">@L(n.DeduccionIHSS)</td>
                            <td class="num">@L(n.DeduccionISR)</td>
                            <td class="num">@L(n.DeduccionColegio)</td>
                            <td class="num">@L(n.TotalDeducciones)</td>
                            <td class="num neto">@L(n.NetoAPagar)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="9">TOTALES (@lista.Count docentes)</td>
                        <td class="num">@L(totSueldoBruto)</td>
                        <td class="num">@L(totHorasExtra)</td>
                        <td class="num">@L(totTotalBruto)</td>
                        <td class="num">@L(totIhss)</td>
                        <td class="num">@L(totIsr)</td>
                        <td class="num">@L(totColegio)</td>
                        <td class="num">@L(totDeducciones)</td>
                        <td class="num neto">@L(totNeto)</td>
                    </tr>
                </tfoot>
            </table>
        }

        <div class="footer">
            <p>Documento generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
            <p>Cálculo automático basado en horarios programados y tarifas por área/modalidad &mdash; sujeto a revisión de RRHH antes de su pago.</p>
        </div>
    </div>
</body>
</html>
