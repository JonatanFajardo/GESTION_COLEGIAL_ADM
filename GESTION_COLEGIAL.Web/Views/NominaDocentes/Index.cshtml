@{
    ViewBag.Title = "Nómina de Docentes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item">Recursos Humanos</li>
            <li class="breadcrumb-item active" aria-current="page">Nómina de Docentes</li>
        </ol>
    </nav>
</div>

<div class="nomina-docentes">

    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
        <div class="mr-3">
            <h4 class="mb-1">Nómina de Docentes</h4>
            <p class="text-muted mb-0">Cálculo automático mensual basado en horarios programados y tarifas por área/modalidad.</p>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row">
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpiTotal">L 0.00</h6>
                            <p>Total nómina del mes</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-cash-stack"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2">Neto a pagar</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpiDocentes">0</h6>
                            <p>Docentes activos</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-people"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2" id="kpiDocentesSub">— en planilla</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpiPeriodos">0</h6>
                            <p>Períodos mensuales</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-clock-history"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2" id="kpiPeriodosSub">— horas-clase</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 layout-spacing">
            <div class="widget widget-card-four">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpiDeducciones">L 0.00</h6>
                            <p>Deducciones totales</p>
                        </div>
                        <div><div class="w-icon"><i class="bi bi-dash-circle"></i></div></div>
                    </div>
                    <p class="text-muted small mb-0 mt-2">IHSS · ISR · Colegio</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="form-row align-items-end">
                <div class="form-group col-md-2 col-6 mb-md-0">
                    <label for="filtroAnio">Año</label>
                    <select id="filtroAnio" class="custom-select">
                        <option value="2026" selected>2026</option>
                        <option value="2025">2025</option>
                    </select>
                </div>
                <div class="form-group col-md-2 col-6 mb-md-0">
                    <label for="filtroSemestre">Semestre</label>
                    <select id="filtroSemestre" class="custom-select">
                        <option value="1" selected>Primer</option>
                        <option value="2">Segundo</option>
                    </select>
                </div>
                <div class="form-group col-md-5 mb-md-0">
                    <label for="filtroBusqueda">Buscar docente</label>
                    <div class="input-group">
                        <div class="input-group-prepend"><span class="input-group-text"><i class="bi bi-search"></i></span></div>
                        <input id="filtroBusqueda" type="text" class="form-control" placeholder="Nombre, código, materia..." />
                    </div>
                </div>
                <div class="form-group col-md-3 mb-0">
                    <label for="filtroOrden">Ordenar por</label>
                    <select id="filtroOrden" class="custom-select">
                        <option value="neto-desc">Salario neto (mayor)</option>
                        <option value="neto-asc">Salario neto (menor)</option>
                        <option value="nombre">Nombre A–Z</option>
                        <option value="periodos">Períodos (mayor)</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Contador + acciones de exportación -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <span id="ndContador" class="text-muted font-weight-bold">0 docentes</span>
        <div class="mt-2 mt-md-0">
            <button type="button" id="btnExportCsv" class="btn btn-outline-primary">
                <i class="bi bi-filetype-csv mr-1"></i> Exportar CSV
            </button>
            <button type="button" id="btnImprimir" class="btn btn-outline-primary">
                <i class="bi bi-printer mr-1"></i> Imprimir / PDF
            </button>
        </div>
    </div>

    <!-- Grid de cards -->
    <div id="ndCards" class="row"></div>

    <!-- Vacío -->
    <div id="ndVacio" class="text-center text-muted py-5" style="display:none;">
        <i class="bi bi-cash-coin h1 d-block mb-2"></i>
        <p class="mb-1">No hay nómina calculada para el período seleccionado.</p>
        <small>Verifica que existan horarios en tbHorarios para ese año y semestre.</small>
    </div>

    <!-- Loader -->
    <div id="ndLoader" class="text-center py-5" style="display:none;">
        <div class="spinner-border text-primary mb-2" role="status"></div>
        <p class="text-muted mb-0">Calculando nómina...</p>
    </div>
</div>

<!-- Modal detalle -->
<div class="modal fade" id="ndModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="ndModalNombre">Docente</h5>
                    <p class="text-muted small mb-0" id="ndModalSubtitulo"></p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body" id="ndModalBody"></div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Content/js/pages/nominadocentes.js"></script>
}
