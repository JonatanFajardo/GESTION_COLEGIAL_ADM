@{
    ViewBag.Title = "Dashboard Administrador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Dashboard Administrador</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Dashboard Administrador</h4>
        <p class="text-muted mb-0">Resumen en tiempo real</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-totalUsuarios">—</h6>
                        <p>Total Usuarios</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-users"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-accesosHoy">—</h6>
                        <p>Accesos Hoy</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-right-to-bracket"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-rolesActivos">—</h6>
                        <p>Roles Activos</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-user-tag"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-alertasSistema">—</h6>
                        <p>Alertas Sistema</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-triangle-exclamation"></i></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mb-4">
    @await Html.PartialAsync("_ProximosDias")
</div>
<div id="dashboard-detail" class="mb-4"></div>

@section Scripts{
    <script src="~/Content/js/pages/dashboardadmin.js"></script>
    <script>
        DashboardAdmin.init("@Url.Action("ResumenAsync")");
    </script>
}
