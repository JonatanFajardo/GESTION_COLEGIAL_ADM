@{
    ViewBag.Title = "Dashboard Administrador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/pages/home-modern.css">

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Dashboard Administrador</li>
        </ol>
    </nav>
</div>

<div class="home-content-wrapper">
    <div class="welcome-card-modern">
        <div class="welcome-content-modern">
            <h1>Dashboard Administrador</h1>
            <p class="welcome-text-modern">Resumen en tiempo real</p>
        </div>
        <div class="welcome-decoration-modern">
            <i class="fa-solid fa-shield-halved" style="font-size:64px;opacity:.3;"></i>
        </div>
    </div>

    <div class="stats-grid-modern">
        <div class="stat-card-modern">
            <div class="stat-header-modern">
                <div class="stat-icon-modern purple">
                    <i class="fa-solid fa-users"></i>
                </div>
            </div>
            <div class="stat-label-modern">Total Usuarios</div>
            <div class="stat-value-modern" id="kpi-totalUsuarios">—</div>
        </div>
        <div class="stat-card-modern">
            <div class="stat-header-modern">
                <div class="stat-icon-modern blue">
                    <i class="fa-solid fa-right-to-bracket"></i>
                </div>
            </div>
            <div class="stat-label-modern">Accesos Hoy</div>
            <div class="stat-value-modern" id="kpi-accesosHoy">—</div>
        </div>
        <div class="stat-card-modern">
            <div class="stat-header-modern">
                <div class="stat-icon-modern green">
                    <i class="fa-solid fa-user-tag"></i>
                </div>
            </div>
            <div class="stat-label-modern">Roles Activos</div>
            <div class="stat-value-modern" id="kpi-rolesActivos">—</div>
        </div>
        <div class="stat-card-modern">
            <div class="stat-header-modern">
                <div class="stat-icon-modern orange">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
            </div>
            <div class="stat-label-modern">Alertas Sistema</div>
            <div class="stat-value-modern" id="kpi-alertasSistema">—</div>
        </div>
    </div>

    <div id="dashboard-detail" class="mt-4"></div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/dashboardadmin.js"></script>
    <script>
        DashboardAdmin.init("@Url.Action("ResumenAsync")");
    </script>
}
