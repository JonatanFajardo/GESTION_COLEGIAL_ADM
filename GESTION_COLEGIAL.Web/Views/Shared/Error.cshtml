@{
    // Diseño mínimo y neutro: sirve igual sin sesión, para un encargado o para el personal,
    // y no muestra menú ni datos internos.
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ocurrió un problema</title>
    <link href="~/Content/plugins/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/css/custom.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center" style="min-height: 100vh;">
            <div class="col-md-6 col-lg-5 d-flex align-items-center">
                <div class="card w-100 text-center">
                    <div class="card-body p-5">
                        <h4 class="mb-2">Ocurrió un problema</h4>
                        <p class="text-muted mb-4">No se pudo procesar la solicitud. Intente de nuevo en un momento.</p>
                        <a href="~/" class="btn btn-primary">Volver al inicio</a>
