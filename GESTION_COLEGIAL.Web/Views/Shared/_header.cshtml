<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (!window.jQuery) return;
        var $sel = $('#hdrAnioActivo');
        if (!$sel.length) return;
        $.getJSON('@Url.Action("ListAsync", "AniosLectivos")', function (res) {
            var d = (res && res.data) ? res.data : (res || []);
            $sel.empty();
            if (!d.length) { $sel.append($('<option>').text('—')); return; }
            d.forEach(function (a) {
                $sel.append($('<option>').val(a.Ani_Id).text(a.Ani_Nombre + (a.Ani_EsActual ? ' ✓' : '')).prop('selected', a.Ani_EsActual));
            });
        });
        $sel.on('change', function () {
            $.post('@Url.Action("SetActivoAsync", "AniosLectivos")', { id: $(this).val() }, function () { location.reload(); });
        });
    });
</script>