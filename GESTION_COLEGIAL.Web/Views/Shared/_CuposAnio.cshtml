@* Modal "Cupos de las secciones del año". Lo abre GcCupos.abrir(aniId, nombreAnio) (wwwroot/Content/js/components/cupos-anio.js). *@
<div class="modal fade" id="modalCuposAnio" tabindex="-1" role="dialog" aria-labelledby="modalCuposAnioTitulo" aria-hidden="true"
     data-url-lista="@Url.Action("CuposAsync", "AnioConexion")" data-url-guardar="@Url.Action("ActualizarCupoAsync", "AnioConexion")">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCuposAnioTitulo">Cupos de las secciones</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3" id="cuposAnioNota">El cupo es el máximo de alumnos de la sección. No puede ser menor que los alumnos ya inscritos.</p>
                <div id="cuposAnioAviso" class="alert d-none" role="status"></div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Sección</th>
                                <th class="text-center">Inscritos</th>
                                <th class="text-center" style="width:130px;">Cupo</th>
                                <th class="text-center">Libres</th>
                                <th style="width:90px;"></th>
                            </tr>
                        </thead>
                        <tbody id="cuposAnioBody"><tr><td colspan="5" class="text-center text-muted">Cargando…</td></tr></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
