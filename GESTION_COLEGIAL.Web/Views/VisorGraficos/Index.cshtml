@{
    ViewBag.Title = "Visor de Gráficos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Visor de Gráficos</li>
        </ol>
    </nav>
</div>
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Visor de Gráficos Consolidados</h4>
        <p class="text-muted mb-0">Indicadores clave en formato visual</p>
    </div>
</div>
<div class="row">
    <div class="col-md-6 layout-spacing">
        <div class="statbox widget box box-shadow h-100">
            <div class="widget-header">
                <div class="row"><div class="col-12"><h4><i class="fas fa-coins text-success mr-2"></i>Resumen Financiero</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <canvas id="chart-financiero" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6 layout-spacing">
        <div class="statbox widget box box-shadow h-100">
            <div class="widget-header">
                <div class="row"><div class="col-12"><h4><i class="fas fa-graduation-cap text-primary mr-2"></i>Resumen Institucional</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <canvas id="chart-admin" height="200"></canvas>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div id="loading-msg" class="text-center py-4 text-muted">
            <i class="fas fa-spinner fa-spin"></i> Cargando datos...
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Content/js/pages/visitorgraficos.js"></script>
    <script>
        VisorGraficos.init(
            "@Url.Action("FinancieroAsync")",
            "@Url.Action("ResumenAsync")"
        );
    </script>
}
