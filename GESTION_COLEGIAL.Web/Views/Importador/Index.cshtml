@{
    ViewBag.Title = "Importador / Exportador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Importador / Exportador</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Importador / Exportador</h4>
        <p class="text-muted mb-0">Importación y exportación masiva de datos</p>
    </div>
</div>


    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">

            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4" id="importadorTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="tab-importar" data-toggle="tab" href="#panel-importar" role="tab">
                        <i class="fas fa-upload mr-1"></i> Importar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="tab-exportar" data-toggle="tab" href="#panel-exportar" role="tab">
                        <i class="fas fa-download mr-1"></i> Exportar
                    </a>
                </li>
            </ul>

            <div class="tab-content" id="importadorTabContent">

                <!-- Panel Importar -->
                <div class="tab-pane fade show active" id="panel-importar" role="tabpanel">
                    <div class="alert alert-light-primary mb-3">
                        <strong>Formato esperado del CSV — Alumnos:</strong><br />
                        Columnas requeridas:
                        <code>Nombre</code>,
                        <code>Apellido</code>,
                        <code>Identidad</code>,
                        <code>FechaNacimiento</code>,
                        <code>Sexo</code>,
                        <code>NivelEducativo</code><br />
                        <small>Se mostrará una vista previa de las primeras 10 filas antes de procesar.</small>
                    </div>

                    <form id="form-importar" enctype="multipart/form-data">
                        <div class="form-group">
                            <label for="archivo-csv">Seleccionar archivo CSV</label>
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="archivo-csv" name="archivo" accept=".csv" />
                                    <label class="custom-file-label" for="archivo-csv">Seleccionar archivo...</label>
                                </div>
                                <div class="input-group-append">
                                    <button class="btn btn-primary" type="button" id="btn-preview">
                                        <i class="fas fa-eye mr-1"></i> Vista previa
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>

                    <div id="preview-table" class="mt-3" style="display:none;">
                        <hr />
                        <h6>Vista previa <small class="text-muted">(primeras 10 filas)</small></h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover" id="tabla-preview">
                                <thead id="preview-thead"></thead>
                                <tbody id="preview-tbody"></tbody>
                            </table>
                        </div>
                        <div class="alert alert-info mt-2">
                            <i class="fas fa-info-circle mr-1"></i>
                            La importación completa estará disponible en una próxima versión. Verifique que los datos sean correctos antes de proceder.
                        </div>
                    </div>
                </div>

                <!-- Panel Exportar -->
                <div class="tab-pane fade" id="panel-exportar" role="tabpanel">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="card h-100 text-center"><div class="card-body">
                                <div class="h2 text-success mb-2"><i class="fa-solid fa-user-graduate"></i></div>
                                <h6 class="font-weight-bold text-dark">Alumnos</h6>
                                <p class="small text-muted">Exportar listado completo de alumnos activos</p>
                                <a href="@Url.Content("~/")api/v1/Alumno/ListAsync" target="_blank" class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-download mr-1"></i> Exportar CSV
                                </a>
                            </div></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card h-100 text-center"><div class="card-body">
                                <div class="h2 text-success mb-2"><i class="fa-solid fa-users"></i></div>
                                <h6 class="font-weight-bold text-dark">Empleados</h6>
                                <p class="small text-muted">Exportar listado completo de empleados activos</p>
                                <a href="@Url.Content("~/")api/v1/Empleado/ListAsync" target="_blank" class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-download mr-1"></i> Exportar CSV
                                </a>
                            </div></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card h-100 text-center"><div class="card-body">
                                <div class="h2 text-success mb-2"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                                <h6 class="font-weight-bold text-dark">Cuentas por Cobrar</h6>
                                <p class="small text-muted">Exportar cuentas pendientes de cobro</p>
                                <a href="@Url.Content("~/")api/v1/CuentaCobrar/ListAsync" target="_blank" class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-download mr-1"></i> Exportar CSV
                                </a>
                            </div></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>


@section Scripts{
    <script src="~/Content/js/pages/importador.js"></script>
    <script>
        Importador.init("@Url.Action("PreviewAsync")");
    </script>
}
