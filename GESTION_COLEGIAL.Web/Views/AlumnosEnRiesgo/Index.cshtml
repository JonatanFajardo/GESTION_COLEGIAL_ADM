@{
    ViewBag.Title = "Alumnos en Riesgo Académico";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Alumnos en Riesgo Académico</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Alumnos en riesgo académico</h4>
        <p class="text-muted mb-0">Alumnos con promedio por debajo del umbral.</p>
    </div>
</div>

<div>
    <div class="statbox widget box box-shadow mb-4">
    <div class="form-row align-items-end">
            <div class="col-md-3">
                <input type="number" id="filter-PromedioMinimo" class="form-control" placeholder="Promedio mínimo" value="60">
            </div>
            <div class="col-md-3">
                <input type="number" id="filter-Anio" class="form-control" placeholder="Año" value="">
            </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-primary w-100" id="btn-filtrar">
                <i class="fa-solid fa-filter mr-1"></i> Filtrar
            </button>
        </div>
    </div>
    </div>

    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable-alumnosenriesgo">
                    <thead><tr><th>Alumno</th><th>Sección</th><th>Promedio</th></tr></thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/alumnosenriesgo.js"></script>
    <script>
        AlumnosEnRiesgo.init("@Url.Action("ListAsync")");
    </script>
}
