@{
    ViewBag.Title = "Alumnos en Riesgo Académico";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Alumnos en Riesgo Académico</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-triangle-exclamation" style="font-size:32px;"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Alumnos en Riesgo Académico</h1>
                <p>Alumnos con promedio por debajo del umbral</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="row mb-3">
            <div class="col-md-3">
                <input type="number" id="filter-PromedioMinimo" class="form-control" placeholder="Promedio mínimo" value="60">
            </div>
            <div class="col-md-3">
                <input type="number" id="filter-Anio" class="form-control" placeholder="Año" value="">
            </div>
        <div class="col-md-2">
            <button class="btn btn-primary btn-sm w-100" id="btn-filtrar">
                <i class="fa-solid fa-filter"></i> Filtrar
            </button>
        </div>
    </div>
    <div class="card-listado-catalogo">
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="datatable-alumnosenriesgo">
                    <thead><tr><th>Alumno</th><th>Sección</th><th>Promedio</th></tr></thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/alumnosenriesgo.js"></script>
    <script>
        AlumnosEnRiesgo.init("@Url.Action("ListAsync")");
    </script>
}
