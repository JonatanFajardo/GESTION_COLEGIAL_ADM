@{
    ViewBag.Title = "Conciliación Rápida";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/finanzas-dashboard.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Conciliación Rápida</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-scale-balanced"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Conciliación Rápida</h1>
                <p>Comparativa entre pagos del día y cuentas pendientes</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">

    <div class="fd-filters">
        <div>
            <label for="f-fecha" class="form-label-catalogo">Fecha de cobros</label>
            <input type="date" id="f-fecha" class="form-control" value="@ViewBag.FechaDefault" />
        </div>
        <div>
            <label for="f-buscar" class="form-label-catalogo">Filtrar alumno</label>
            <input type="text" id="f-buscar" class="form-control" placeholder="Buscar por nombre..." />
        </div>
        <button class="btn-fd" id="btn-buscar" type="button">
            <i class="fa-solid fa-magnifying-glass"></i> Consultar
        </button>
    </div>

    <div class="fd-balance">
        <div class="fd-balance-side left">
            <p class="fd-balance-label"><i class="fa-solid fa-circle-check"></i> Cobrado del día</p>
            <p class="fd-balance-value" id="lbl-cobrado">L. 0.00</p>
            <p class="fd-kpi-foot" id="lbl-cobrado-sub">0 operaciones</p>
        </div>
        <div class="fd-balance-mid">
            <small>Balance</small>
            <strong id="lbl-balance">L. 0.00</strong>
            <small id="lbl-balance-state">—</small>
        </div>
        <div class="fd-balance-side right">
            <p class="fd-balance-label"><i class="fa-solid fa-hourglass-half"></i> Pendiente por cobrar</p>
            <p class="fd-balance-value" id="lbl-pendiente">L. 0.00</p>
            <p class="fd-kpi-foot" id="lbl-pendiente-sub">0 cuentas</p>
        </div>
        <div class="fd-balance-bar" id="bb-bar">
            <div class="bb-cobrado"   id="bb-cobrado"   style="width:0%"></div>
            <div class="bb-pendiente" id="bb-pendiente" style="width:0%"></div>
        </div>
    </div>

    <div class="fd-kpi-row">
        <div class="fd-kpi kpi-emerald">
            <div class="fd-kpi-icon"><i class="fa-solid fa-receipt"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Tasa de cobro</p>
                <p class="fd-kpi-value" id="kpi-tasa">0%</p>
                <p class="fd-kpi-foot">cobrado / (cobrado + pendiente)</p>
            </div>
        </div>
        <div class="fd-kpi kpi-indigo">
            <div class="fd-kpi-icon"><i class="fa-solid fa-coins"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Ticket promedio</p>
                <p class="fd-kpi-value" id="kpi-prom">L. 0.00</p>
                <p class="fd-kpi-foot">por cobro registrado</p>
            </div>
        </div>
        <div class="fd-kpi kpi-rose">
            <div class="fd-kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Cuentas vencidas</p>
                <p class="fd-kpi-value" id="kpi-vencidas">0</p>
                <p class="fd-kpi-foot" id="kpi-vencidas-sub">—</p>
            </div>
        </div>
        <div class="fd-kpi kpi-cyan">
            <div class="fd-kpi-icon"><i class="fa-solid fa-user-group"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Alumnos involucrados</p>
                <p class="fd-kpi-value" id="kpi-alumnos">0</p>
                <p class="fd-kpi-foot" id="kpi-alumnos-sub">en cobros y pendientes</p>
            </div>
        </div>
    </div>

    <div class="fd-grid-2">
        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title" style="color:#047857"><i class="fa-solid fa-circle-check" style="color:#10b981"></i> Cobros del día</p>
                    <p class="fd-panel-sub">Pagos efectivamente recibidos</p>
                </div>
                <span class="fd-chip c-emerald" id="chip-cobros">0</span>
            </div>
            <div class="fd-panel-body fd-flush fd-scroll" id="feed-cobros"></div>
        </div>

        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title" style="color:#be123c"><i class="fa-solid fa-clock" style="color:#f43f5e"></i> Pendientes por cobrar</p>
                    <p class="fd-panel-sub">Cuentas con saldo abierto</p>
                </div>
                <span class="fd-chip c-rose" id="chip-pendientes">0</span>
            </div>
            <div class="fd-panel-body fd-flush fd-scroll" id="feed-pendientes"></div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/conciliacion.js"></script>
    <script>
        Conciliacion.init(
            "@Url.Action("PagosAsync")",
            "@Url.Action("PendientesAsync")",
            "@ViewBag.FechaDefault"
        );
    </script>
}
