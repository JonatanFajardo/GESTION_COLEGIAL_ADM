@{
    ViewBag.Title = "Estado de Cuenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/pages/finanzas-dashboard.css" rel="stylesheet" />
}
<div class="breadcrumb-wrapper-content d-print-none">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Estado de Cuenta</li>
        </ol>
    </nav>
</div>
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 d-print-none">
    <div class="mr-3">
        <h4 class="mb-1">Estado de Cuenta del Alumno</h4>
        <p class="text-muted mb-0">Consulte saldos, pagos y cuentas por cobrar</p>
    </div>
</div>

    <div class="statbox widget box box-shadow mb-4 d-print-none">
    <div class="widget-content widget-content-area">
        <div class="form-row">
            <div class="form-group col-md-5 mb-md-0">
                <label for="f-alu">Alumno</label>
                <select id="f-alu" class="custom-select"><option value="">-- Seleccione Alumno --</option></select>
            </div>
            <div class="form-group col-md-2 mb-md-0">
                <label for="f-anio">Año</label>
                <input type="number" id="f-anio" class="form-control" placeholder="Año (opcional)">
            </div>
            <div class="form-group col-md-2 d-flex align-items-end mb-md-0">
                <button class="btn btn-primary btn-block" id="btn-ver">
                    <i class="fa-solid fa-magnifying-glass mr-1"></i> Consultar
                </button>
            </div>
            <div class="form-group col-md-3 d-flex align-items-end mb-md-0">
                <button class="btn btn-outline-primary btn-block" id="btn-imprimir" style="display:none;">
                    <i class="fa-solid fa-print mr-1"></i> Imprimir / PDF
                </button>
            </div>
        </div>
    </div>
</div>
    <div id="panel-estado" style="display:none;">
        <!-- Membrete solo visible al imprimir -->
        <div class="d-none d-print-block">
            <div class="text-center mb-3 pb-3 border-bottom border-primary">
                <h2 class="text-primary mb-1" id="print-institucion">Instituto</h2>
                <p class="small text-muted mb-0" id="print-direccion"></p>
                <p class="font-weight-bold text-dark mt-2 mb-0">Estado de Cuenta del Alumno</p>
            </div>
            <div class="d-flex flex-wrap justify-content-between small text-dark mb-3">
                <div><strong>Alumno:</strong> <span id="print-alumno">—</span></div>
                <div><strong>Año:</strong> <span id="print-anio">—</span></div>
                <div><strong>Generado:</strong> <span id="print-fecha">—</span></div>
            </div>
        </div>
<div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-success" id="kpi-cobrado">—</h6>
                        <p>Total cobrado</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-cash-coin"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-danger" id="kpi-pendiente">—</h6>
                        <p>Total pendiente</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-hourglass-split"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-info" id="kpi-descuento">—</h6>
                        <p>Descuentos</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-percent"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-warning" id="kpi-cuotas">—</h6>
                        <p>Cuotas pendientes</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-list-check"></i></div></div>
                </div>
            </div>
        </div>
    </div>
</div>
        <div class="statbox widget box box-shadow mb-4">
            <div class="widget-header">
                <div class="row"><div class="col-12"><h4>Detalle de cuentas</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <div class="table-responsive">
                    <table class="table table-hover" id="tabla-cuentas">
                        <thead><tr><th>Concepto</th><th>Monto</th><th>Pagado</th><th>Saldo</th><th>Vencimiento</th><th>Estado</th></tr></thead>
                        <tbody id="tbody-cuentas"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

@section Scripts{
    <script src="~/Content/js/pages/estadocuentaadm.js"></script>
    <script>
        EstadoCuentaAdm.init(
            "@Url.Action("GetAsync")",
            "@Url.Action("AlumnosDropdownAsync")"
        );
    </script>
}
