@{
    ViewBag.Title = "Registro de Pagos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="#">Financiero</a></li>
            <li class="breadcrumb-item active" aria-current="page">Pagos</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Registro de pagos</h4>
        <p class="text-muted mb-0">Pagos registrados durante el mes actual (@ViewBag.MesActual)</p>
    </div>
    <div class="mt-2 mt-md-0">
        <a href="@Url.Action("HistoricoPagos", "CuentasCobrar")" class="btn btn-outline-primary mr-2"><i class="bi bi-clock-history mr-1"></i> Ver histórico completo</a>
        @if (ViewBag.PuedeCrear == true)
        {
            <a href="@Url.Action("NuevoPago", "Pagos")" class="btn btn-success"><i class="bi bi-cash-coin mr-1"></i> Nuevo pago</a>
        }
    </div>
</div>

@* TODO: poblar "Ingresos del Día" y "Pagos Registrados Hoy" desde un endpoint de resumen diario (ningún JS las llena hoy) *@
<div class="row">
    <div class="col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-success" id="ingresos-dia">L 0.00</h6>
                        <p>Ingresos del día</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-cash-stack"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value text-info" id="pagos-hoy">0</h6>
                        <p>Pagos registrados hoy</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-receipt"></i></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-header">
        <div class="row">
            <div class="col-12">
                <h4>Pagos de @ViewBag.MesActual</h4>
            </div>
        </div>
    </div>
    <div class="widget-content widget-content-area">
        <div id="tabla-pagos" data-usuario="@(Session["Username"] as string ?? "anonimo")"></div>
    </div>
</div>

@section Scripts{
    <partial name="_GcTabla" />
    <script src="~/Content/js/pages/pagos.js" asp-append-version="true"></script>
}
