@model GESTION_COLEGIAL.Business.Models.PagoDetailViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recibo de Pago - @Model.NumeroRecibo</title>
    <link href="~/Content/plugins/bootstrap/css/bootstrap.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/main.css" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
            padding: 20px;
        }

        .recibo-container {
            max-width: 800px;
            margin: 0 auto;
            background-color: white;
            padding: 40px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .header {
            text-align: center;
            border-bottom: 3px solid #4361ee;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .header h1 {
            color: #4361ee;
            font-size: 28px;
            margin-bottom: 5px;
        }

        .header p {
            color: #666;
            font-size: 14px;
        }

        .recibo-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            padding: 15px;
            background-color: #f8f9fa;
            border-left: 4px solid #4361ee;
        }

        .recibo-numero {
            font-size: 20px;
            font-weight: bold;
            color: #4361ee;
        }

        .recibo-fecha {
            font-size: 14px;
            color: #666;
        }

        .seccion {
            margin-bottom: 25px;
        }

        .seccion-titulo {
            font-size: 16px;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
            padding-bottom: 5px;
            border-bottom: 2px solid #e0e0e0;
        }

        .info-row {
            display: flex;
            padding: 8px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .info-label {
            width: 150px;
            font-weight: 600;
            color: #555;
        }

        .info-value {
            flex: 1;
            color: #333;
        }

        .total-box {
            background-color: #4361ee;
            color: white;
            padding: 20px;
            margin: 30px 0;
            text-align: center;
            border-radius: 5px;
        }

        .total-label {
            font-size: 16px;
            margin-bottom: 5px;
        }

        .total-monto {
            font-size: 36px;
            font-weight: bold;
        }

        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 2px solid #e0e0e0;
            text-align: center;
            color: #666;
            font-size: 12px;
        }

        .firma-seccion {
            margin-top: 60px;
            display: flex;
            justify-content: space-around;
        }

        .firma-box {
            text-align: center;
            width: 200px;
        }

        .firma-linea {
            border-top: 2px solid #333;
            margin-bottom: 5px;
        }

        /* Estilos para impresión */
        .anulado-box {
            border: 3px solid #e7515a;
            color: #e7515a;
            text-align: center;
            font-size: 28px;
            font-weight: 800;
            letter-spacing: 6px;
            padding: 8px;
            margin-bottom: 20px;
            border-radius: 6px;
        }

        .anulado-box small {
            display: block;
            font-size: 12px;
            font-weight: 400;
            letter-spacing: 0;
            color: #515365;
        }

        .tabla-lineas {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .tabla-lineas th, .tabla-lineas td {
            padding: 6px 8px;
            border-bottom: 1px solid #e0e6ed;
            text-align: left;
        }

        .tabla-lineas .num {
            text-align: right;
        }

        .saldo-linea {
            text-align: right;
            margin: 8px 0 20px;
            color: #515365;
        }

        @@media print {
            body {
                background-color: white;
                padding: 0;
            }

            .recibo-container {
                box-shadow: none;
                padding: 20px;
            }

            .recibo-info {
                background-color: #f8f9fa !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .total-box {
                background-color: #4361ee !important;
                color: white !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="fixed-top d-flex justify-content-between p-3 d-print-none">
        <button type="button" class="btn btn-outline-secondary" onclick="window.close()">
            <i class="bi bi-arrow-left mr-1"></i> Cerrar
        </button>
        <button type="button" class="btn btn-primary" onclick="window.print()">
            <i class="bi bi-printer mr-1"></i> Imprimir
        </button>
    </div>

    <div class="recibo-container">
        <!-- Header -->
        <div class="header">
            <h1>RECIBO DE PAGO</h1>
            <p>@(string.IsNullOrWhiteSpace(Model.ColegioNombre) ? "Sistema de Gestión Colegial" : Model.ColegioNombre)</p>
            @if (!string.IsNullOrWhiteSpace(Model.ColegioDireccion) || !string.IsNullOrWhiteSpace(Model.ColegioTelefono))
            {
                <p style="font-size: 12px;">@Model.ColegioDireccion @(string.IsNullOrWhiteSpace(Model.ColegioTelefono) ? "" : "· Tel. " + Model.ColegioTelefono)</p>
            }
        </div>

        @if (Model.EsAnulado)
        {
            <div class="anulado-box">
                ANULADO
                <small>@(Model.FechaAnulacion.HasValue ? Model.FechaAnulacion.Value.ToString("dd/MM/yyyy HH:mm") : "")@(string.IsNullOrWhiteSpace(Model.MotivoAnulacion) ? "" : " · " + Model.MotivoAnulacion)</small>
            </div>
        }

        <!-- Información del Recibo -->
        <div class="recibo-info">
            <div>
                <div class="recibo-numero">@Model.NumeroRecibo</div>
                <div class="recibo-fecha">Fecha de Emisión: @Model.FechaEmision.ToString("dd/MM/yyyy")</div>
            </div>
            <div style="text-align: right;">
                <div style="font-weight: bold;">Pago ID: @Model.PagoId</div>
                <div class="recibo-fecha">Fecha de Pago: @Model.FechaPago.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <!-- Información del Alumno -->
        <div class="seccion">
            <div class="seccion-titulo">Información del Alumno</div>
            <div class="info-row">
                <div class="info-label">Nombre:</div>
                <div class="info-value">@Model.AlumnoNombre</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.EncargadoNombre))
            {
                <div class="info-row">
                    <div class="info-label">Encargado:</div>
                    <div class="info-value">@Model.EncargadoNombre</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.AlumnoIdentidad))
            {
                <div class="info-row">
                    <div class="info-label">Identidad:</div>
                    <div class="info-value">@Model.AlumnoIdentidad</div>
                </div>
            }
        </div>

        <!-- Detalles del Pago -->
        <div class="seccion">
            <div class="seccion-titulo">Detalles del Pago</div>
            <div class="info-row">
                <div class="info-label">Forma de Pago:</div>
                <div class="info-value">@Model.FormaPago</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.NumeroReferencia))
            {
                <div class="info-row">
                    <div class="info-label">Número de Referencia:</div>
                    <div class="info-value">@Model.NumeroReferencia</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Observaciones))
            {
                <div class="info-row">
                    <div class="info-label">Observaciones:</div>
                    <div class="info-value">@Model.Observaciones</div>
                </div>
            }
        </div>

        @if (Model.Lineas != null && Model.Lineas.Count > 0)
        {
            <div class="seccion">
                <div class="seccion-titulo">Cargos pagados</div>
                <table class="tabla-lineas">
                    <thead><tr><th>Concepto</th><th>Periodo</th><th class="num">Descuento</th><th class="num">Pagado</th></tr></thead>
                    <tbody>
                        @foreach (var l in Model.Lineas)
                        {
                            <tr>
                                <td>@l.Concepto</td>
                                <td>@(l.Mes.HasValue && l.Mes > 0 ? l.Mes + "/" + l.Anio : (l.Anio?.ToString() ?? ""))</td>
                                <td class="num">@(l.Descuento > 0 ? "L. " + l.Descuento.ToString("N2") : "-")</td>
                                <td class="num">L. @l.Monto.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Total -->
        <div class="total-box">
            <div class="total-label">MONTO TOTAL PAGADO</div>
            <div class="total-monto">L. @Model.MontoTotal.ToString("N2")</div>
        </div>
        <div class="saldo-linea">Saldo pendiente del alumno: <strong>L. @Model.SaldoPendiente.ToString("N2")</strong></div>

        <!-- Información del Usuario -->
        <div class="seccion">
            <div class="info-row">
                <div class="info-label">Procesado por:</div>
                <div class="info-value">@Model.NombreCompletoUsuarioRegistra</div>
            </div>
            <div class="info-row">
                <div class="info-label">Fecha de Registro:</div>
                <div class="info-value">@Model.FechaEmision.ToString("dd/MM/yyyy HH:mm:ss")</div>
            </div>
        </div>

        <!-- Firmas -->
        <div class="firma-seccion">
            <div class="firma-box">
                <div class="firma-linea"></div>
                <p>Firma del Encargado</p>
            </div>
            <div class="firma-box">
                <div class="firma-linea"></div>
                <p>Sello de la Institución</p>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>Este documento es un comprobante oficial de pago</p>
            <p>Para cualquier consulta, favor presentar este recibo</p>
            <p style="margin-top: 10px;">© @DateTime.Now.Year Sistema de Gestión Colegial</p>
        </div>
    </div>
</body>
</html>
