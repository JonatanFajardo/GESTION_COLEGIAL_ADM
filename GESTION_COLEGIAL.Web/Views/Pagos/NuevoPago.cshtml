@model GESTION_COLEGIAL.Business.Models.PagoViewModel
@{
    ViewBag.Title = "Nuevo Pago";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Módulo Financiero</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Registro de Pagos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nuevo Pago</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Registrar nuevo pago</h4>
        <p class="text-muted mb-0">Cobre a un alumno paso a paso: busque, seleccione conceptos, aplique descuentos y genere el recibo</p>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-content widget-content-area">
        <div>
            <!-- Stepper -->
            <ul class="nav nav-pills flex-column flex-md-row mb-4" id="payment-steps">
                <li class="nav-item flex-md-fill mr-md-2 mb-2">
                    <a class="nav-link active text-center" id="step1-tab" data-step="1">
                        <span class="badge badge-light mr-1">1</span>
                        <span>Seleccionar Alumno</span>
                    </a>
                </li>
                <li class="nav-item flex-md-fill mr-md-2 mb-2">
                    <a class="nav-link text-center" id="step2-tab" data-step="2">
                        <span class="badge badge-light mr-1">2</span>
                        <span>Seleccionar Conceptos</span>
                    </a>
                </li>
                <li class="nav-item flex-md-fill mr-md-2 mb-2">
                    <a class="nav-link text-center" id="step3-tab" data-step="3">
                        <span class="badge badge-light mr-1">3</span>
                        <span>Aplicar Descuentos</span>
                    </a>
                </li>
                <li class="nav-item flex-md-fill mr-md-2 mb-2">
                    <a class="nav-link text-center" id="step4-tab" data-step="4">
                        <span class="badge badge-light mr-1">4</span>
                        <span>Forma de Pago</span>
                    </a>
                </li>
                <li class="nav-item flex-md-fill mr-md-2 mb-2">
                    <a class="nav-link text-center" id="step5-tab" data-step="5">
                        <span class="badge badge-light mr-1">5</span>
                        <span>Confirmación</span>
                    </a>
                </li>
            </ul>

            <!-- Paso 1: Seleccionar Alumno -->
            <div id="step1" class="payment-step">
                <h4 class="mb-3">Seleccionar Alumno</h4>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="alumno-identidad-search">Número de Identidad</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="alumno-identidad-search" placeholder="Ingrese la identidad del alumno..." maxlength="13" />
                                <div class="input-group-append">
                                    <button class="btn btn-primary" type="button" id="btn-buscar-alumno">
                                        <i class="bi bi-search"></i> Buscar
                                    </button>
                                </div>
                            </div>
                            <small class="form-text text-muted">Ingrese el número de identidad (13 dígitos)</small>
                        </div>
                    </div>
                </div>

                <div id="alumno-info" style="display:none;">
                    <div class="card mb-3">
                        <div class="card-header font-weight-bold"><i class="bi bi-person-badge text-primary mr-1"></i> Información del Alumno</div>
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-center">
                                <div id="alumno-avatar-wrapper" class="mr-4 mb-3">
                                    <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center text-white display-4 p-4"><i class="fa-solid fa-user"></i></div>
                                </div>
                                <div class="row flex-fill">
                                    <div class="col-md-3 col-6 mb-3"><div class="small text-muted text-uppercase font-weight-bold">Nombre completo</div><div class="font-weight-bold text-dark"><span id="alumno-nombre-completo"></span></div></div>
                                    <div class="col-md-3 col-6 mb-3"><div class="small text-muted text-uppercase font-weight-bold">Identidad</div><div class="font-weight-bold text-dark"><span id="alumno-identidad"></span></div></div>
                                    <div class="col-md-3 col-6 mb-3"><div class="small text-muted text-uppercase font-weight-bold">Fecha de nacimiento</div><div class="font-weight-bold text-dark"><span id="alumno-fecha-nacimiento"></span></div></div>
                                    <div class="col-md-3 col-6 mb-3"><div class="small text-muted text-uppercase font-weight-bold">Sexo</div><div class="font-weight-bold text-dark"><span id="alumno-sexo"></span></div></div>
                                    <div class="col-md-3 col-6 mb-3"><div class="small text-muted text-uppercase font-weight-bold">Correo</div><div class="font-weight-bold text-dark"><span id="alumno-correo"></span></div></div>
                                    <div class="col-md-3 col-6 mb-3"><div class="small text-muted text-uppercase font-weight-bold">Teléfono</div><div class="font-weight-bold text-dark"><span id="alumno-telefono"></span></div></div>
                                    <div class="col-md-3 col-6 mb-3"><div class="small text-muted text-uppercase font-weight-bold">Nivel</div><div class="font-weight-bold text-dark"><span id="alumno-nivel"></span></div></div>
                                    <div class="col-md-3 col-6 mb-3"><div class="small text-muted text-uppercase font-weight-bold">Curso</div><div class="font-weight-bold text-dark"><span id="alumno-curso"></span></div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="button" class="btn btn-primary" id="btn-step1-next" disabled>Siguiente <i class="bi bi-arrow-right ml-1"></i></button>
                </div>
            </div>

            <!-- Paso 2: Seleccionar Conceptos -->
            <div id="step2" class="payment-step" style="display:none;">
                <h4 class="mb-3">Seleccionar Conceptos a Pagar</h4>

                <!-- Sección 1: Cargos pendientes existentes -->
                <div class="card mb-3">
                    <div class="card-header font-weight-bold"><i class="bi bi-card-checklist text-primary mr-1"></i> Cargos pendientes existentes</div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th><input type="checkbox" id="select-all-conceptos" /></th>
                                        <th>Concepto</th>
                                        <th>Monto</th>
                                        <th>Descuento</th>
                                        <th>Mora</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody id="conceptos-tbody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Sección 2: Generar mensualidad adelantada -->
                <div class="card mb-3">
                    <div class="card-header font-weight-bold"><i class="bi bi-calendar-month text-primary mr-1"></i> Generar mensualidad adelantada</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <label for="mensualidad-mes">Mes</label>
                                <select class="custom-select" id="mensualidad-mes">
                                    <option value="1">Enero</option>
                                    <option value="2">Febrero</option>
                                    <option value="3">Marzo</option>
                                    <option value="4">Abril</option>
                                    <option value="5">Mayo</option>
                                    <option value="6">Junio</option>
                                    <option value="7">Julio</option>
                                    <option value="8">Agosto</option>
                                    <option value="9">Septiembre</option>
                                    <option value="10">Octubre</option>
                                    <option value="11">Noviembre</option>
                                    <option value="12">Diciembre</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="mensualidad-anio">Año</label>
                                <input type="number" class="form-control" id="mensualidad-anio" />
                            </div>
                            <div class="col-md-3">
                                <label for="mensualidad-monto">Monto</label>
                                <input type="number" step="0.01" class="form-control" id="mensualidad-monto" placeholder="Monto sugerido" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" class="btn btn-primary btn-block" id="btn-generar-mensualidad">
                                    <i class="bi bi-plus-circle"></i> Generar
                                </button>
                            </div>
                        </div>
                        <small class="form-text text-muted mt-2">Crea una mensualidad para un mes específico y la añade a la lista de cargos pendientes.</small>
                    </div>
                </div>

                <!-- Sección 3: Cargo puntual ad-hoc -->
                <div class="card mb-3">
                    <div class="card-header font-weight-bold"><i class="bi bi-plus-square text-primary mr-1"></i> Agregar cargo puntual</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <label for="adhoc-concepto">Concepto</label>
                                <select class="custom-select" id="adhoc-concepto">
                                    <option value="">-- Seleccione --</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="adhoc-monto">Monto</label>
                                <input type="number" step="0.01" class="form-control" id="adhoc-monto" />
                            </div>
                            <div class="col-md-3">
                                <label for="adhoc-vence">Fecha vencimiento</label>
                                <input type="date" class="form-control" id="adhoc-vence" />
                            </div>
                            <div class="col-md-2">
                                <label for="adhoc-observaciones">Observaciones</label>
                                <input type="text" class="form-control" id="adhoc-observaciones" placeholder="(opcional)" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" class="btn btn-success btn-block" id="btn-agregar-cargo">
                                    <i class="bi bi-plus-lg"></i> Agregar
                                </button>
                            </div>
                        </div>
                        <small class="form-text text-muted mt-2">Crea un cargo puntual (Materiales, Examen, Transporte, etc.) con monto personalizado.</small>
                    </div>
                </div>

                <div class="alert alert-light-primary d-flex justify-content-between align-items-center mb-0">
                    <span class="font-weight-bold">Subtotal seleccionado</span>
                    <span class="h5 mb-0 font-weight-bold text-primary">L. <span id="subtotal-conceptos">0.00</span></span>
                </div>
                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-outline-secondary" id="btn-step2-prev"><i class="bi bi-arrow-left mr-1"></i> Anterior</button>
                    <button type="button" class="btn btn-primary" id="btn-step2-next">Siguiente <i class="bi bi-arrow-right ml-1"></i></button>
                </div>
            </div>

            <!-- Paso 3: Aplicar Descuentos -->
            <div id="step3" class="payment-step" style="display:none;">
                <h4 class="mb-3">Aplicar Descuentos <small class="text-muted font-weight-normal">(Opcional)</small></h4>
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="form-group">
                            <label for="descuento-select">Seleccionar Descuento</label>
                            <select class="custom-select" id="descuento-select">
                                <option value="">-- Sin descuento --</option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label for="descuento-justificacion">Justificación</label>
                            <textarea class="form-control" id="descuento-justificacion" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="alert alert-light-primary d-flex justify-content-between align-items-center mb-0">
                    <span class="font-weight-bold">Total con descuento</span>
                    <span class="h5 mb-0 font-weight-bold text-primary">L. <span id="total-con-descuento">0.00</span></span>
                </div>
                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-outline-secondary" id="btn-step3-prev"><i class="bi bi-arrow-left mr-1"></i> Anterior</button>
                    <button type="button" class="btn btn-primary" id="btn-step3-next">Siguiente <i class="bi bi-arrow-right ml-1"></i></button>
                </div>
            </div>

            <!-- Paso 4: Forma de Pago -->
            <div id="step4" class="payment-step" style="display:none;">
                <h4 class="mb-3">Forma de Pago</h4>
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="form-group">
                            <label for="forma-pago-select">Seleccionar Forma de Pago</label>
                            <select class="custom-select" id="forma-pago-select" required>
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="numero-referencia">Número de Referencia</label>
                            <input type="text" class="form-control" id="numero-referencia" />
                        </div>
                        <div class="form-group mb-0">
                            <label for="observaciones">Observaciones</label>
                            <textarea class="form-control" id="observaciones" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-outline-secondary" id="btn-step4-prev"><i class="bi bi-arrow-left mr-1"></i> Anterior</button>
                    <button type="button" class="btn btn-primary" id="btn-step4-next">Siguiente <i class="bi bi-arrow-right ml-1"></i></button>
                </div>
            </div>

            <!-- Paso 5: Confirmación -->
            <div id="step5" class="payment-step" style="display:none;">
                <h4 class="mb-3">Confirmación del Pago</h4>
                <ul class="list-group">
                    <li class="list-group-item d-flex justify-content-between"><span class="text-muted font-weight-bold">Alumno</span><span class="text-dark font-weight-bold text-right" id="confirm-alumno"></span></li>
                    <li class="list-group-item d-flex justify-content-between"><span class="text-muted font-weight-bold">Conceptos</span><span class="text-dark font-weight-bold text-right" id="confirm-conceptos"></span></li>
                    <li class="list-group-item d-flex justify-content-between"><span class="text-muted font-weight-bold">Forma de Pago</span><span class="text-dark font-weight-bold text-right" id="confirm-forma-pago"></span></li>
                    <li class="list-group-item d-flex justify-content-between"><span class="text-muted font-weight-bold">Total a Pagar</span><span class="h5 mb-0 font-weight-bold text-success">L. <span id="confirm-total"></span></span></li>
                </ul>
                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-outline-secondary" id="btn-step5-prev"><i class="bi bi-arrow-left mr-1"></i> Anterior</button>
                    <button type="button" class="btn btn-success" id="btn-confirmar-pago">
                        <i class="bi bi-check-circle"></i> Confirmar y Generar Recibo
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/nuevopago.js" asp-append-version="true"></script>
    <script>
        NuevoPago.init({
            identidad: "@(ViewBag.Identidad ?? "")",
            urlFindAlumnoByIdentidad: "@Url.Action("FindByIdentidadAsync", "Alumnos")",
            urlConceptosAlumno: "@Url.Action("ListByAlumnoAsync", "CuentasCobrar")",
            urlDescuentos: "@Url.Action("DescuentosDelCobroAsync", "Pagos")",
            urlFormasPago: "@Url.Action("DropdownAsync", "FormasPago")",
            urlConceptosPago: "@Url.Action("DropdownAsync", "ConceptosPago")",
            urlTarifas: "@Url.Action("TarifasDelCobroAsync", "Pagos")",
            urlCrearCargo: "@Url.Action("CrearCargoAlumnoAsync", "CuentasCobrar")",
            urlRegistrarPago: "@Url.Action("CreateAsync", "Pagos")"
        });
    </script>
}
