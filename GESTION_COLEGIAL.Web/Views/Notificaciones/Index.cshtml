@{
    ViewBag.Title = "Notificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Notificaciones</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Notificaciones</h4>
        <p class="text-muted mb-0">Bandeja de notificaciones del usuario</p>
    </div>
    <div class="d-flex align-items-center mt-2 mt-md-0">
        <label class="switch s-outline s-outline-primary mb-0 mr-2">
            <input type="checkbox" id="chk-solo-no-leidas" />
            <span class="slider round"></span>
        </label>
        <label class="mb-0" for="chk-solo-no-leidas">Solo no leídas</label>
    </div>
</div>

<div class="fluid-container">
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable-notificaciones">
                    <thead>
                        <tr>
                            <th style="width:90px;">Tipo</th>
                            <th>Título</th>
                            <th>Mensaje</th>
                            <th style="width:140px;">Fecha</th>
                            <th style="width:80px;">Estado</th>
                            <th style="width:80px;">Acción</th>
                        </tr>
                    </thead>
                    <tbody id="notificaciones-tbody">
                        <tr><td colspan="6" class="text-center">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/notificaciones.js"></script>
    <script>
        Notificaciones.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("MarcarLeidaAsync")"
        );
    </script>
}
