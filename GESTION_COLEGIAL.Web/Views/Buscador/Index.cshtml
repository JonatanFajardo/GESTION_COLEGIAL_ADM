@{
    ViewBag.Title = "Buscador Global";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Buscador Global</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Buscador Global</h4>
        <p class="text-muted mb-0">Busca alumnos y empleados desde un solo lugar</p>
    </div>
</div>

<div class="fluid-container">
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-content widget-content-area">
            <div class="form-row">
                <div class="col-md-5 mb-2 mb-md-0">
                    <div class="input-group">
                        <div class="input-group-prepend"><span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span></div>
                        <input type="text" id="filter-q" class="form-control" placeholder="Buscar por nombre, identidad... (Ctrl+K)" autofocus />
                    </div>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btn-buscar">
                        <i class="fa-solid fa-search mr-1"></i> Buscar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable-buscador">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Nombre</th>
                            <th>Identificador</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody id="buscador-tbody">
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                <i class="fa-solid fa-magnifying-glass mr-2"></i>
                                Ingresa un término para comenzar la búsqueda
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/buscador.js"></script>
    <script>
        Buscador.init("@Url.Action("SearchAsync")");
    </script>
}
