@{
    ViewBag.Title = "Piramide de Matricula";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Piramide de Matricula</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Piramide de Matricula</h4>
        <p class="text-muted mb-0">Distribucion de alumnos por nivel educativo y genero</p>
    </div>
</div>

<div class="fluid-container">
    <div class="form-row mb-3">
        <div class="col-md-3">
            <input type="number" id="filter-Anio" class="form-control" placeholder="Año" value="@ViewBag.AnioActual">
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary btn-sm w-100" id="btn-filtrar">
                <i class="fa-solid fa-filter mr-1"></i> Filtrar
            </button>
        </div>
    </div>
    <div class="statbox widget box box-shadow mb-4">
        <div class="widget-header">
            <div class="row"><div class="col-12"><h4>Alumnos por nivel y curso</h4></div></div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-hover nowrap" id="datatable-piramidematricula">
                    <thead>
                        <tr>
                            <th>Nivel</th>
                            <th>Curso</th>
                            <th>Masculino</th>
                            <th>Femenino</th>
                            <th>Otro</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/piramidematricula.js"></script>
    <script>
        PiramideMatricula.init("@Url.Action("ListAsync")", @ViewBag.AnioActual);
    </script>
}
