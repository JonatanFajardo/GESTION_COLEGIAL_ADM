@{
    ViewBag.Title = "Piramide de Matricula";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Piramide de Matricula</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-chart-bar" style="font-size:32px;"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Piramide de Matricula</h1>
                <p>Distribucion de alumnos por nivel educativo y genero</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="row mb-3">
        <div class="col-md-3">
            <input type="number" id="filter-Anio" class="form-control" placeholder="Año" value="@ViewBag.AnioActual">
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary btn-sm w-100" id="btn-filtrar">
                <i class="fa-solid fa-filter"></i> Filtrar
            </button>
        </div>
    </div>
    <div class="card-listado-catalogo">
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="datatable-piramidematricula">
                    <thead>
                        <tr>
                            <th>Nivel</th>
                            <th>Curso</th>
                            <th>Masculino</th>
                            <th>Femenino</th>
                            <th>Otro</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/piramidematricula.js"></script>
    <script>
        PiramideMatricula.init("@Url.Action("ListAsync")", @ViewBag.AnioActual);
    </script>
}
