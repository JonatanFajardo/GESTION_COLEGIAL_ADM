@{
    ViewBag.Title = "Recursos de Horario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/pages/recursos-horario.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Recursos de Horario</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Recursos de Horario</h4>
        <p class="text-muted mb-0">Configure los recursos base necesarios para armar horarios semanales: aulas físicas, días laborables y bloques de hora</p>
    </div>
    <div class="mt-2 mt-md-0">
        <span class="text-muted small mr-1">Ir a:</span>
        <button type="button" class="btn btn-sm btn-rounded btn-outline-primary rh-hero-chip" data-jump="aulas"><i class="bi bi-door-open mr-1"></i> Aulas</button>
        <button type="button" class="btn btn-sm btn-rounded btn-outline-primary rh-hero-chip" data-jump="dias"><i class="bi bi-calendar3 mr-1"></i> Días</button>
        <button type="button" class="btn btn-sm btn-rounded btn-outline-primary rh-hero-chip" data-jump="horas"><i class="bi bi-clock mr-1"></i> Horas</button>
    </div>
</div>

<div class="fluid-container">

    <!-- Secciones independientes (multi-abierto) -->
    <div id="rh-accordion">

        <section class="statbox widget box box-shadow mb-4 rh-section open" data-catalog="aulas">
            <header class="widget-header rh-section-header" role="button" tabindex="0" aria-expanded="true">
                <div class="d-flex align-items-center justify-content-between p-3">
                    <div class="d-flex align-items-center">
                        <span class="badge badge-primary mr-2">1</span>
                        <i class="bi bi-door-open text-primary mr-2"></i>
                        <div>
                            <h5 class="mb-0">Aulas</h5>
                            <p class="text-muted small mb-0">Salones físicos disponibles para asignar a un horario.</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge outline-badge-primary mr-2" data-count>—</span>
                        <i class="bi bi-chevron-down rh-section-chevron"></i>
                    </div>
                </div>
            </header>
            <div class="widget-content widget-content-area rh-section-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
                    <div class="input-group mb-2 mb-md-0 rh-search-wrap">
                        <div class="input-group-prepend"><span class="input-group-text"><i class="bi bi-search"></i></span></div>
                        <input type="text" class="form-control rh-search" data-search="aulas" placeholder="Buscar aula..." />
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-primary mr-1" data-reload="aulas" title="Recargar">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button type="button" class="btn btn-primary" data-new="aulas">
                            <i class="bi bi-plus-lg mr-1"></i> Nueva Aula
                        </button>
                    </div>
                </div>
                <div class="row" data-grid="aulas"></div>
                <div class="text-center text-muted py-5" data-empty="aulas" hidden>
                    <i class="bi bi-door-closed fa-3x mb-3 d-block"></i>
                    <h5>Sin aulas registradas</h5>
                    <p>Todavía no hay aulas configuradas para asignar a horarios.</p>
                    <button type="button" class="btn btn-primary" data-new="aulas">
                        <i class="bi bi-plus-lg mr-1"></i> Crear la primera
                    </button>
                </div>
            </div>
        </section>

        <section class="statbox widget box box-shadow mb-4 rh-section" data-catalog="dias">
            <header class="widget-header rh-section-header" role="button" tabindex="0" aria-expanded="false">
                <div class="d-flex align-items-center justify-content-between p-3">
                    <div class="d-flex align-items-center">
                        <span class="badge badge-primary mr-2">2</span>
                        <i class="bi bi-calendar3 text-primary mr-2"></i>
                        <div>
                            <h5 class="mb-0">Días</h5>
                            <p class="text-muted small mb-0">Días laborables sobre los que se distribuye la semana académica.</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge outline-badge-primary mr-2" data-count>—</span>
                        <i class="bi bi-chevron-down rh-section-chevron"></i>
                    </div>
                </div>
            </header>
            <div class="widget-content widget-content-area rh-section-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
                    <div class="input-group mb-2 mb-md-0 rh-search-wrap">
                        <div class="input-group-prepend"><span class="input-group-text"><i class="bi bi-search"></i></span></div>
                        <input type="text" class="form-control rh-search" data-search="dias" placeholder="Buscar día..." />
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-primary mr-1" data-reload="dias" title="Recargar">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button type="button" class="btn btn-primary" data-new="dias">
                            <i class="bi bi-plus-lg mr-1"></i> Nuevo Día
                        </button>
                    </div>
                </div>
                <div class="row" data-grid="dias"></div>
                <div class="text-center text-muted py-5" data-empty="dias" hidden>
                    <i class="bi bi-calendar-x fa-3x mb-3 d-block"></i>
                    <h5>Sin días registrados</h5>
                    <p>Configure los días laborables antes de armar un horario semanal.</p>
                    <button type="button" class="btn btn-primary" data-new="dias">
                        <i class="bi bi-plus-lg mr-1"></i> Crear el primero
                    </button>
                </div>
            </div>
        </section>

        <section class="statbox widget box box-shadow mb-4 rh-section" data-catalog="horas">
            <header class="widget-header rh-section-header" role="button" tabindex="0" aria-expanded="false">
                <div class="d-flex align-items-center justify-content-between p-3">
                    <div class="d-flex align-items-center">
                        <span class="badge badge-primary mr-2">3</span>
                        <i class="bi bi-clock text-primary mr-2"></i>
                        <div>
                            <h5 class="mb-0">Horas</h5>
                            <p class="text-muted small mb-0">Bloques de hora usados como celdas del horario semanal.</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge outline-badge-primary mr-2" data-count>—</span>
                        <i class="bi bi-chevron-down rh-section-chevron"></i>
                    </div>
                </div>
            </header>
            <div class="widget-content widget-content-area rh-section-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
                    <div class="input-group mb-2 mb-md-0 rh-search-wrap">
                        <div class="input-group-prepend"><span class="input-group-text"><i class="bi bi-search"></i></span></div>
                        <input type="text" class="form-control rh-search" data-search="horas" placeholder="Buscar hora..." />
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-primary mr-1" data-reload="horas" title="Recargar">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button type="button" class="btn btn-primary" data-new="horas">
                            <i class="bi bi-plus-lg mr-1"></i> Nueva Hora
                        </button>
                    </div>
                </div>
                <div class="row" data-grid="horas"></div>
                <div class="text-center text-muted py-5" data-empty="horas" hidden>
                    <i class="bi bi-clock-history fa-3x mb-3 d-block"></i>
                    <h5>Sin horas registradas</h5>
                    <p>Configure los bloques de hora antes de armar un horario semanal.</p>
                    <button type="button" class="btn btn-primary" data-new="horas">
                        <i class="bi bi-plus-lg mr-1"></i> Crear la primera
                    </button>
                </div>
            </div>
        </section>

    </div>

    <!-- ============================================================ -->
    <!-- Modal: Crear / Editar (genérico) -->
    <!-- ============================================================ -->
    <div class="modal fade" id="rh-edit-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="rh-edit-title">Nuevo registro</h5>
                        <p class="text-muted small mb-0" id="rh-edit-subtitle">Complete los datos del recurso</p>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <form id="rh-edit-form" onsubmit="return false;">
                    <div class="modal-body">
                        <input type="hidden" id="rh-edit-id" value="0" />

                        <!-- Campo texto simple (Aulas / Días) -->
                        <div class="form-group" id="rh-edit-desc-wrap">
                            <label for="rh-edit-descripcion">
                                <i class="bi bi-card-text mr-1"></i>
                                <span id="rh-edit-desc-label">Descripción</span> <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="rh-edit-descripcion" class="form-control" maxlength="50" required autocomplete="off" placeholder="Ej: Aula 101" />
                            <small class="form-text text-muted" id="rh-edit-desc-hint">Ingrese el nombre del recurso.</small>
                        </div>

                        <!-- Campo horario (sólo Horas) -->
                        <div class="form-group" id="rh-edit-hora-wrap" hidden>
                            <label for="rh-edit-hora">
                                <i class="bi bi-clock mr-1"></i>
                                Hora <span class="text-danger">*</span>
                            </label>
                            <input type="time" id="rh-edit-hora" class="form-control" />
                            <small class="form-text text-muted">Bloque horario que se mostrará en el horario semanal.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn" data-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" id="rh-edit-save">
                            <i class="bi bi-check2 mr-1"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- Modal: Detalle -->
    <!-- ============================================================ -->
    <div class="modal fade" id="rh-detail-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">Detalle del recurso</h5>
                        <p class="text-muted small mb-0" id="rh-detail-catalog-name">Recurso</p>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-3">
                        <dt class="col-sm-4 text-muted">ID</dt>
                        <dd class="col-sm-8" id="rh-detail-id">—</dd>
                        <dt class="col-sm-4 text-muted" id="rh-detail-descripcion-label">Descripción</dt>
                        <dd class="col-sm-8 mb-0 font-weight-bold" id="rh-detail-descripcion">—</dd>
                    </dl>

                    <h6 class="font-weight-bold"><i class="bi bi-clock-history mr-1"></i> Auditoría</h6>
                    <div class="d-flex align-items-start mb-2">
                        <span class="badge badge-success mr-2"><i class="bi bi-person-plus"></i></span>
                        <div>
                            <div class="text-muted small">Creado por</div>
                            <div><strong id="rh-detail-usuarioregistra">—</strong> <span class="text-muted small" id="rh-detail-fecharegistra">—</span></div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start">
                        <span class="badge badge-info mr-2"><i class="bi bi-pencil-square"></i></span>
                        <div>
                            <div class="text-muted small">Última modificación</div>
                            <div><strong id="rh-detail-usuariomodifica">—</strong> <span class="text-muted small" id="rh-detail-fechamodifica">—</span></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- Modal: Eliminar -->
    <!-- ============================================================ -->
    <div class="modal fade" id="rh-delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar recurso</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="rh-delete-id" value="0" />
                    <p>
                        ¿Está seguro de que desea eliminar <strong id="rh-delete-name"></strong> del recurso <strong id="rh-delete-catalog"></strong>?
                    </p>
                    <div class="alert alert-light-danger mb-0" role="alert">
                        <strong><i class="bi bi-exclamation-triangle-fill mr-1"></i> Esta acción no se puede deshacer.</strong>
                        Si el recurso está en uso en algún horario, la eliminación fallará.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="rh-delete-confirm">Eliminar</button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/recursos-horario.js"></script>
}
