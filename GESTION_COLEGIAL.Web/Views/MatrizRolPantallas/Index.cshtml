@{
    ViewBag.Title = "Matriz Rol × Pantallas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/Content/css/pages/matrizrolpantallas.css" rel="stylesheet" />
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Matriz Rol &times; Pantallas</li>
        </ol>
    </nav>
</div>
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Matriz Rol &times; Pantallas</h4>
        <p class="text-muted mb-0">Permisos de acceso por rol agrupados por módulo. Vista de solo lectura.</p>
    </div>
</div>
<div class="fluid-container">
    <div class="mb-3 d-flex align-items-center">
        <input type="text" id="filter-pantalla" class="form-control" placeholder="Buscar pantalla...">
        <div id="spinner-matriz" class="ml-2" style="display:none;">
            <i class="fa-solid fa-spinner fa-spin text-primary h4 mb-0"></i>
        </div>
    </div>
    <div class="statbox widget box box-shadow">
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-sm table-hover" id="tabla-matriz">
                    <thead id="thead-matriz"><tr><th>Cargando...</th></tr></thead>
                    <tbody id="tbody-matriz"></tbody>
                </table>
            </div>
            <p id="msg-vacio" class="text-muted text-center mt-3" style="display:none;">No se encontraron datos.</p>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Content/js/pages/matrizrolpantallas.js"></script>
    <script>MatrizRolPantallas.init("@Url.Action("GetAsync")");</script>
}
