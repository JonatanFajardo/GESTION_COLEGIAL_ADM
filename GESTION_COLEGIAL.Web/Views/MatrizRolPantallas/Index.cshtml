@{
    ViewBag.Title = "Matriz Rol × Pantallas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <style>
        #tabla-matriz th, #tabla-matriz td { white-space: nowrap; font-size: 0.82rem; }
        #tabla-matriz thead th.col-rol { text-align: center; max-width: 110px; word-break: break-word; white-space: normal; }
        #tabla-matriz td.col-check { text-align: center; }
        .grupo-header td { background-color: #f0f4ff !important; font-weight: 700; color: #344675; }
        #spinner-matriz { display: none; }
    </style>
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Matriz Rol &times; Pantallas</li>
        </ol>
    </nav>
</div>
<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo"><i class="fa-solid fa-table-columns" style="font-size:32px;"></i></div>
            <div class="header-text-catalogo">
                <h1>Matriz Rol &times; Pantallas</h1>
                <p>Permisos de acceso por rol agrupados por módulo. Vista de solo lectura.</p>
            </div>
        </div>
    </div>
</div>
<div class="fluid-container">
    <div class="mb-3 d-flex align-items-center gap-2">
        <input type="text" id="filter-pantalla" class="form-control" style="max-width:280px;" placeholder="Buscar pantalla...">
        <div id="spinner-matriz" class="ms-2">
            <i class="fa-solid fa-spinner fa-spin" style="color:#F7A400;font-size:1.4rem;"></i>
        </div>
    </div>
    <div class="card-listado-catalogo">
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-bordered table-sm" id="tabla-matriz">
                    <thead id="thead-matriz"><tr><th>Cargando...</th></tr></thead>
                    <tbody id="tbody-matriz"></tbody>
                </table>
            </div>
            <p id="msg-vacio" class="text-muted text-center mt-3" style="display:none;">No se encontraron datos.</p>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Content/js/pages/matrizrolpantallas.js"></script>
    <script>MatrizRolPantallas.init("@Url.Action("GetAsync")");</script>
}
