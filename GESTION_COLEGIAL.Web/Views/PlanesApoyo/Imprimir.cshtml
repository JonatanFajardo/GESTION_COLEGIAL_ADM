@model GESTION_COLEGIAL.UI.Models.PlanApoyoImprimirViewModel
@using GESTION_COLEGIAL.Business.Models
@using GESTION_COLEGIAL.UI.Models
@{
    var M = Model;
    var P = M.Plan;
    ViewBag.Title = "Imprimir plan de apoyo · " + P.Alumno;
    string ubicacion = string.Join(" · ", new[] { P.Ubicacion, P.Nivel }.Where(x => !string.IsNullOrWhiteSpace(x)));
    string nombre(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
}

@section Styles{
    <link href="~/css/pages/planes-apoyo-imprimir.css" rel="stylesheet" asp-append-version="true" />
}

<div class="breadcrumb-wrapper-content pa-no-imprimir">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Planes de apoyo</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Plan", new { id = P.Apo_Id })">@P.Alumno</a></li>
            <li class="breadcrumb-item active" aria-current="page">Imprimir</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina pa-no-imprimir">
    <div class="mr-3">
        <h4 class="mb-1">Imprimir plan de apoyo</h4>
        <p class="text-muted mb-0">Hoja tamaño carta para la reunión con el encargado o el expediente del alumno.</p>
    </div>
    <div class="mt-2 mt-md-0">
        <button type="button" class="btn btn-primary mb-1" data-imprimir>
            <i class="bi bi-printer mr-1" aria-hidden="true"></i> Imprimir
        </button>
        <a class="btn btn-outline-secondary mb-1" href="@Url.Action("Plan", new { id = P.Apo_Id })">
            <i class="bi bi-arrow-left mr-1" aria-hidden="true"></i> Volver al plan
        </a>
    </div>
</div>

<div class="pa-papel">
    <article class="pa-hoja">
        <header class="pa-hoja-membrete">
            <div>
                <div class="pa-hoja-institucion">@(string.IsNullOrWhiteSpace(M.Institucion) ? "Plan de apoyo al alumno" : M.Institucion)</div>
                @if (!string.IsNullOrWhiteSpace(M.Direccion)) { <div class="pa-hoja-pequeno">@M.Direccion</div> }
            </div>
            <div class="pa-hoja-titulo">PLAN DE APOYO<span>@(P.Apo_EsConfidencial ? "Confidencial · uso de dirección" : "Uso del colegio")</span></div>
        </header>

        <section class="pa-hoja-alumno">
            <div class="pa-hoja-nombre">@P.Alumno</div>
            <div class="pa-hoja-pequeno">
                @(ubicacion.Length > 0 ? ubicacion : "Sin grado asignado")
                @if (!string.IsNullOrWhiteSpace(P.Identidad)) { <span> · Identidad @P.Identidad</span> }
                @if (!string.IsNullOrWhiteSpace(P.Ani_Nombre)) { <span> · Año lectivo @P.Ani_Nombre</span> }
            </div>
        </section>

        <h2>Plan</h2>
        <p class="pa-hoja-objetivo">@P.Apo_Titulo</p>
        <dl class="pa-hoja-datos">
            <div><dt>Categoría</dt><dd>@CatalogoPlanes.Categoria(P.Apo_Categoria)</dd></div>
            <div><dt>Estado</dt><dd>@CatalogoPlanes.Estado(P.Apo_Estado)</dd></div>
            <div><dt>Empieza</dt><dd>@FormatoPlan.Dia(P.Apo_FechaInicio)</dd></div>
            <div><dt>Revisión</dt><dd>@FormatoPlan.Dia(P.Apo_FechaRevision)</dd></div>
            <div><dt>Responsable</dt><dd>@nombre(P.Responsable)</dd></div>
            <div><dt>@(P.Apo_FechaFin.HasValue ? "Terminó" : "Lo abrió")</dt><dd>@(P.Apo_FechaFin.HasValue ? FormatoPlan.Dia(P.Apo_FechaFin) : nombre(P.Creador))</dd></div>
        </dl>
        @if (!string.IsNullOrWhiteSpace(P.Apo_Resumen))
        {
            <p class="pa-hoja-texto">@P.Apo_Resumen</p>
        }

        <h2>Pasos (@M.Pasos.Count(p => p.Hecho) de @M.Pasos.Count hechos)</h2>
        @if (M.Pasos.Count == 0)
        {
            <p class="pa-hoja-pequeno">Sin pasos registrados.</p>
        }
        else
        {
            <table class="pa-hoja-tabla">
                <thead>
                    <tr><th>Paso</th><th>Responsable</th><th>Fecha límite</th><th>Estado</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in M.Pasos)
                    {
                        <tr>
                            <td>@a.Apa_Descripcion</td>
                            <td>@nombre(a.Responsable)</td>
                            <td class="pa-nowrap">@FormatoPlan.Dia(a.Apa_FechaLimite)</td>
                            <td class="pa-nowrap">@(a.Hecho ? "Hecho el " + FormatoPlan.Dia(a.Apa_FechaHecha) : a.Atrasado ? "Atrasado" : "Pendiente")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h2>Seguimiento</h2>
        @if (M.Notas.Count == 0)
        {
            <p class="pa-hoja-pequeno">Sin notas de seguimiento.</p>
        }
        else
        {
            <ul class="pa-hoja-notas">
                @foreach (var n in M.Notas.Take(8))
                {
                    <li><strong>@FormatoPlan.Dia(n.Apn_Fecha) · @nombre(n.Usuario):</strong> <span class="pa-hoja-texto">@n.Apn_Texto</span></li>
                }
            </ul>
            @if (M.Notas.Count > 8) { <p class="pa-hoja-pequeno">Y @(M.Notas.Count - 8) notas anteriores en el sistema.</p> }
        }

        @if (M.Historial.Count > 0)
        {
            <h2>Historial</h2>
            <ul class="pa-hoja-notas">
                @foreach (var h in M.Historial)
                {
                    <li>@FormatoPlan.Dia(h.Ape_Fecha) · @CatalogoPlanes.Estado(h.Ape_De) → @CatalogoPlanes.Estado(h.Ape_A) · @nombre(h.Usuario)@(string.IsNullOrWhiteSpace(h.Ape_Motivo) ? "" : " · " + h.Ape_Motivo)</li>
                }
            </ul>
        }

        <div class="pa-hoja-firmas">
            <div><span></span>Responsable del plan</div>
            <div><span></span>Dirección</div>
            <div><span></span>Padre, madre o encargado</div>
        </div>

        <footer class="pa-hoja-pie">Impreso el @FormatoPlan.DiaHora(M.Impreso). Plan n.º @P.Apo_Id.</footer>
    </article>
</div>

@section Scripts{
    <script src="~/Content/js/pages/planes-apoyo.js" asp-append-version="true"></script>
}
