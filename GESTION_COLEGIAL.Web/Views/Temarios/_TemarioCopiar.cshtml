@model GESTION_COLEGIAL.UI.Models.TemarioCopiarModalViewModel
@* Ventana "Copiar temario": crea un temario nuevo de la misma materia, grado y curso para otro semestre o año,
   con todos los temas del de origen (el avance no se copia). La usan la biblioteca y la ficha del temario. *@
<div class="modal fade" id="tm-modal-copiar" tabindex="-1" role="dialog" aria-labelledby="tm-copiar-titulo" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <form class="modal-content" id="tm-form-copiar" novalidate data-url-semestres="@Url.Action("SemestresAsync", "AnioConexion")" data-url="@Url.Action("CopiarAsync", "Temarios")">
            <div class="modal-header">
                <h5 class="modal-title" id="tm-copiar-titulo">Copiar temario</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Se crea un temario nuevo de la misma materia y grado con todos los temas del de origen, listo para ajustar. El avance de las secciones no se copia.</p>
                <div class="alert alert-light-danger" id="tm-copiar-error" role="alert" hidden></div>
                <div class="form-group">
                    <label for="tm-origen">Temario de origen *</label>
                    @if (Model.OrigenId.HasValue)
                    {
                        <input type="hidden" id="tm-origen" value="@Model.OrigenId" />
                        <p class="form-control-plaintext font-weight-bold py-0 mb-0">@Model.OrigenTexto</p>
                    }
                    else
                    {
                        <select id="tm-origen" class="custom-select"><option value="">Cargando temarios…</option></select>
                        <small class="form-text text-muted">Solo aparecen los temarios que ya tienen temas.</small>
                    }
                    <p class="invalid-feedback d-block mb-0" data-error="tm-origen"></p>
                </div>
                <div class="form-row">
                    <div class="col-md-3 form-group">
                        <label for="tm-copia-anio">Año *</label>
                        <select id="tm-copia-anio" class="custom-select">
                            @foreach (var a in Model.Anios)
                            {
                                <option value="@a.Value" selected="@(a.Value == Model.AnioActual)">@a.Text</option>
                            }
                        </select>
                        <p class="invalid-feedback d-block mb-0" data-error="tm-copia-anio"></p>
                    </div>
                    <div class="col-md-4 form-group">
                        <label for="tm-copia-semestre">Semestre *</label>
                        <select id="tm-copia-semestre" class="custom-select">
                            @foreach (var s in Model.Semestres)
                            {
                                <option value="@s.Value">@s.Text</option>
                            }
                        </select>
                        <p class="invalid-feedback d-block mb-0" data-error="tm-copia-semestre"></p>
                    </div>
                    <div class="col-md-5 form-group">
                        <label for="tm-copia-inicio">Inicio de clases *</label>
                        <input type="date" id="tm-copia-inicio" class="form-control" />
                        <p class="invalid-feedback d-block mb-0" data-error="tm-copia-inicio"></p>
                    </div>
                </div>
                <div class="form-group mb-0">
                    <label for="tm-copia-nombre">Nombre del temario nuevo <span class="text-muted">(opcional)</span></label>
                    <input type="text" id="tm-copia-nombre" class="form-control" maxlength="150" autocomplete="off" placeholder="Si lo deja vacío: materia · grado · semestre y año" />
                    <p class="invalid-feedback d-block mb-0" data-error="tm-copia-nombre"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-files mr-1" aria-hidden="true"></i> Copiar temario</button>
            </div>
        </form>
    </div>
</div>
