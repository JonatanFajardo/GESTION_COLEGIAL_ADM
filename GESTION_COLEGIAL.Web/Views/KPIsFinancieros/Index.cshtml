@{
    ViewBag.Title = "KPIs Financieros";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/financiero-analisis.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">KPIs Financieros</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">KPIs Financieros</h4>
        <p class="text-muted mb-0">Indicadores clave del desempeño financiero</p>
    </div>
    <div class="mt-2 mt-md-0">
        <div class="d-flex flex-wrap align-items-center">
                <label for="filtro-anio" class="mb-0 mr-2">Año</label>
                <input type="number" class="form-control w-auto mr-3" id="filtro-anio" min="2000" max="2099" />
                <label for="filtro-mes" class="mb-0 mr-2">Mes</label>
                <select id="filtro-mes" class="custom-select w-auto mr-3">
                <option value="">Todos</option>
                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
                </select>
                <button type="button" class="btn btn-primary" id="btn-filtrar"><i class="fas fa-rotate mr-1"></i> Actualizar</button>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-total-cobrado">—</h6>
                        <p>Total Cobrado</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-hand-holding-dollar"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-total-pendiente">—</h6>
                        <p>Total Pendiente</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-clock"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-total-morosos">—</h6>
                        <p>Total Morosos</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-circle-exclamation"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="kpi-porcentaje-recuperacion">—</h6>
                        <p>% Recuperación</p>
                    </div>
                    <div><div class="w-icon"><i class="fas fa-percent"></i></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 col-lg-4 layout-spacing">
        <div class="statbox widget box box-shadow h-100">
            <div class="widget-header">
                <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4>% de Recuperación</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <div class="d-flex flex-column align-items-center justify-content-center py-2">
                    <div class="kpi-gauge-box"><canvas id="kpi-gauge"></canvas></div>
                    <h3 class="font-weight-bold mt-2 mb-0" id="kpi-gauge-label">—</h3>
                    <p class="small text-muted text-uppercase font-weight-bold mt-2 mb-0">Cobrado vs Total</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-8 layout-spacing">
        <div class="statbox widget box box-shadow h-100">
            <div class="widget-header">
                <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4>Resumen de Indicadores</h4></div></div>
            </div>
            <div class="widget-content widget-content-area">
                <div id="kpi-detail-container">
                    <div class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin mr-2"></i>Cargando...</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/kpisfinancieros.js"></script>
    <script>
        KPIsFinancieros.init("@Url.Action("FindAsync")");
    </script>
}
