@{
    ViewBag.Title = "KPIs Financieros";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/financiero-analisis.css" rel="stylesheet" />
    <style>
        .kpi-ring-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 10px 0 4px; }
        .kpi-ring-label { font-size: .72rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; margin-top: 10px; }
        .kpi-ring-value { font-size: 2rem; font-weight: 900; color: #0f172a; margin-top: 2px; }

        .kpi-detail-row { display: flex; align-items: center; gap: 16px; padding: 14px 18px; border-bottom: 1px solid #f1f5f9; }
        .kpi-detail-row:last-child { border-bottom: none; }
        .kpi-detail-icon {
            width: 44px; height: 44px; border-radius: 10px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
        }
        .kpi-detail-info { flex: 1; min-width: 0; }
        .kpi-detail-label { font-size: .72rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
        .kpi-detail-val   { font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-top: 1px; }
        .kpi-detail-sub   { font-size: .7rem; color: #64748b; margin-top: 2px; }

        .rec-track { height: 10px; background: #e2e8f0; border-radius: 5px; overflow: hidden; margin-top: 6px; }
        .rec-fill  { height: 100%; border-radius: 5px; transition: width .8s ease; }
    </style>
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">KPIs Financieros</li>
        </ol>
    </nav>
</div>

<div class="fan-wrapper">

    <!-- HEADER -->
    <div class="fan-header">
        <div class="fan-header-left">
            <div class="fan-header-icon"><i class="fa-solid fa-coins"></i></div>
            <div>
                <h2>KPIs Financieros</h2>
                <div class="fan-header-sub">Indicadores clave del desempeño financiero</div>
            </div>
        </div>
        <div class="fan-controls">
            <label for="filtro-anio">Año</label>
            <input type="number" id="filtro-anio" min="2000" max="2099" />
            <label for="filtro-mes">Mes</label>
            <select id="filtro-mes" style="width:130px;">
                <option value="">Todos</option>
                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
            </select>
            <button class="btn-fan" id="btn-filtrar">
                <i class="fa-solid fa-rotate"></i> Actualizar
            </button>
        </div>
    </div>

    <!-- KPI CARDS PRINCIPALES -->
    <div class="row g-3">
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-teal fan-anim">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan teal"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                </div>
                <div class="kpi-value-fan" id="kpi-total-cobrado">—</div>
                <div class="kpi-label-fan">Total Cobrado</div>
                <i class="fa-solid fa-circle-dollar-to-slot kpi-icon-bg-fan"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-amber fan-anim fan-anim-d1">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan amber"><i class="fa-solid fa-clock"></i></div>
                </div>
                <div class="kpi-value-fan" id="kpi-total-pendiente">—</div>
                <div class="kpi-label-fan">Total Pendiente</div>
                <i class="fa-solid fa-hourglass-half kpi-icon-bg-fan"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-red fan-anim fan-anim-d2">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan red"><i class="fa-solid fa-circle-exclamation"></i></div>
                </div>
                <div class="kpi-value-fan" id="kpi-total-morosos">—</div>
                <div class="kpi-label-fan">Total Morosos</div>
                <i class="fa-solid fa-user-slash kpi-icon-bg-fan"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-indigo fan-anim fan-anim-d3">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan indigo"><i class="fa-solid fa-percent"></i></div>
                </div>
                <div class="kpi-value-fan" id="kpi-porcentaje-recuperacion">—</div>
                <div class="kpi-label-fan">% Recuperación</div>
                <i class="fa-solid fa-chart-pie kpi-icon-bg-fan"></i>
            </div>
        </div>
    </div>

    <!-- PANEL DE DETALLE + GRÁFICA DE RECUPERACIÓN -->
    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="fan-panel fan-anim fan-anim-d2" style="height:100%;">
                <div class="fan-section">
                    <div class="fan-section-accent" style="background:#6366f1;"></div>
                    <span class="fan-section-label">% de Recuperación</span>
                    <div class="fan-section-line"></div>
                </div>
                <div class="kpi-ring-wrap">
                    <canvas id="kpi-gauge" style="max-width:180px;max-height:180px;"></canvas>
                    <div class="kpi-ring-value" id="kpi-gauge-label">—</div>
                    <div class="kpi-ring-label">Cobrado vs Total</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-8">
            <div class="fan-panel fan-anim fan-anim-d3">
                <div class="fan-section">
                    <div class="fan-section-accent" style="background:#14b8a6;"></div>
                    <span class="fan-section-label">Resumen de Indicadores</span>
                    <div class="fan-section-line"></div>
                </div>
                <div id="kpi-detail-container">
                    <div class="fan-loading"><i class="fa-solid fa-spinner fa-spin me-2"></i>Cargando...</div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/kpisfinancieros.js"></script>
    <script>
        KPIsFinancieros.init("@Url.Action("FindAsync")");
    </script>
}
