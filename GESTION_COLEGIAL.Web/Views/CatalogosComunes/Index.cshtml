@{
    ViewBag.Title = "Catálogos Comunes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Catálogos Comunes</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">Catálogos comunes</h4>
        <p class="text-muted mb-0">Catálogos globales usados a lo largo del sistema: estados, parentescos, títulos académicos y cargos.</p>
    </div>
    <div class="mt-2 mt-md-0">
        <div class="dropdown d-inline-block cc-new-wrap">
            <button type="button" class="btn btn-primary dropdown-toggle" id="cc-new-btn" aria-haspopup="true" aria-expanded="false">
                <i class="bi bi-plus-lg mr-1"></i> Nuevo
            </button>
            <div class="dropdown-menu dropdown-menu-right cc-new-menu" id="cc-new-menu" aria-labelledby="cc-new-btn">
                <button type="button" class="dropdown-item" data-new-type="estados"><i class="bi bi-check-circle mr-2"></i> Nuevo estado</button>
                <button type="button" class="dropdown-item" data-new-type="parentescos"><i class="bi bi-diagram-3 mr-2"></i> Nuevo parentesco</button>
                <button type="button" class="dropdown-item" data-new-type="titulos"><i class="bi bi-award mr-2"></i> Nuevo título</button>
                <button type="button" class="dropdown-item" data-new-type="cargos"><i class="bi bi-person-badge mr-2"></i> Nuevo cargo</button>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value" id="cc-stat-total">—</h6>
                        <p>Registros en total</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-list-ul"></i></div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 col-12 layout-spacing">
        <div class="widget widget-card-four">
            <div class="widget-content">
                <div class="w-content">
                    <div class="w-info">
                        <h6 class="value">4</h6>
                        <p>Catálogos</p>
                    </div>
                    <div><div class="w-icon"><i class="bi bi-collection"></i></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="statbox widget box box-shadow mb-4">
    <div class="widget-content widget-content-area">

        <!-- Filtro por tipo -->
        <div class="d-flex flex-wrap align-items-center mb-3">
            <span class="text-muted small mr-2 mb-2">Filtrar:</span>
            <button type="button" class="btn btn-sm btn-rounded btn-outline-primary cc-chip active mr-2 mb-2" data-type="todos">
                <i class="bi bi-grid-fill mr-1"></i> Todos
                <span class="badge badge-light ml-1" data-count="todos">—</span>
            </button>
            <button type="button" class="btn btn-sm btn-rounded btn-outline-primary cc-chip mr-2 mb-2" data-type="estados">
                <i class="bi bi-check-circle mr-1"></i> Estados
                <span class="badge badge-light ml-1" data-count="estados">—</span>
            </button>
            <button type="button" class="btn btn-sm btn-rounded btn-outline-primary cc-chip mr-2 mb-2" data-type="parentescos">
                <i class="bi bi-diagram-3 mr-1"></i> Parentescos
                <span class="badge badge-light ml-1" data-count="parentescos">—</span>
            </button>
            <button type="button" class="btn btn-sm btn-rounded btn-outline-primary cc-chip mr-2 mb-2" data-type="titulos">
                <i class="bi bi-award mr-1"></i> Títulos
                <span class="badge badge-light ml-1" data-count="titulos">—</span>
            </button>
            <button type="button" class="btn btn-sm btn-rounded btn-outline-primary cc-chip mr-2 mb-2" data-type="cargos">
                <i class="bi bi-person-badge mr-1"></i> Cargos
                <span class="badge badge-light ml-1" data-count="cargos">—</span>
            </button>
        </div>

        <!-- Barra de herramientas -->
        <div class="d-flex flex-wrap align-items-center mb-3">
            <div class="input-group mb-2 mr-2 w-auto flex-grow-1">
                <div class="input-group-prepend"><span class="input-group-text"><i class="bi bi-search"></i></span></div>
                <input type="text" id="cc-search" class="form-control" placeholder="Buscar en descripción, ID o tipo..." autocomplete="off" />
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary mb-2" id="cc-reload" title="Recargar">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>

        <div class="alert alert-light-info mb-4" role="alert">
            <i class="bi bi-info-circle-fill mr-1"></i>
            <strong>Vista unificada.</strong>
            Estos catálogos son globales y raramente cambian. Se muestran juntos para facilitar el mantenimiento; usá los filtros para ver un tipo.
        </div>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover cc-table" id="cc-table">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>ID</th>
                        <th>Descripción</th>
                        <th>Registrado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="cc-table-body"></tbody>
            </table>
        </div>

        <div class="text-center py-5" id="cc-empty" hidden>
            <i class="bi bi-inbox h1 text-muted d-block mb-2"></i>
            <h5>Sin registros</h5>
            <p class="text-muted mb-0">No hay registros que coincidan con el filtro actual.</p>
        </div>
    </div>
</div>

<!-- Modal crear / editar -->
<div class="modal fade" id="cc-edit-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="cc-edit-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="cc-edit-title">Nuevo registro</h5>
                    <p class="text-muted small mb-0" id="cc-edit-subtitle">Complete los datos</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="cc-edit-form" onsubmit="return false;">
                <div class="modal-body">
                    <input type="hidden" id="cc-edit-id" value="0" />
                    <input type="hidden" id="cc-edit-tipo" value="" />
                    <div class="form-group mb-0">
                        <label for="cc-edit-descripcion">Descripción <span class="text-danger">*</span></label>
                        <input type="text" id="cc-edit-descripcion" class="form-control" maxlength="150" required autocomplete="off" />
                        <small class="form-text text-muted" id="cc-edit-hint">Ingrese el nombre del registro.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="cc-edit-save"><i class="bi bi-check2 mr-1"></i> Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal detalle -->
<div class="modal fade" id="cc-detail-modal" tabindex="-1" role="dialog" aria-labelledby="cc-detail-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="cc-detail-title">Detalle del registro</h5>
                    <p class="text-muted small mb-0" id="cc-detail-catalog-name">Catálogo</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="col-md-4 mb-3">
                        <p class="text-muted small mb-1">ID</p>
                        <p class="font-weight-bold mb-0" id="cc-detail-id">—</p>
                    </div>
                    <div class="col-md-8 mb-3">
                        <p class="text-muted small mb-1">Descripción</p>
                        <p class="font-weight-bold mb-0" id="cc-detail-descripcion">—</p>
                    </div>
                </div>
                <h6 class="border-top pt-3 mb-3"><i class="bi bi-clock-history mr-1"></i> Auditoría</h6>
                <div class="form-row">
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Creado por</p>
                        <p class="mb-0"><strong id="cc-detail-usuarioregistra">—</strong> <span class="text-muted small" id="cc-detail-fecharegistra">—</span></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="text-muted small mb-1">Modificado por</p>
                        <p class="mb-0"><strong id="cc-detail-usuariomodifica">—</strong> <span class="text-muted small" id="cc-detail-fechamodifica">—</span></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal eliminar -->
<div class="modal fade" id="cc-delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="cc-delete-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cc-delete-title">Eliminar registro</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="cc-delete-id" value="0" />
                <input type="hidden" id="cc-delete-tipo" value="" />
                <p class="mb-3">¿Está seguro de eliminar <strong id="cc-delete-name"></strong> del catálogo <strong id="cc-delete-catalog"></strong>?</p>
                <div class="alert alert-light-danger mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill mr-1"></i>
                    <strong>Esta acción no se puede deshacer.</strong> Si el registro está en uso, la eliminación fallará.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="cc-delete-confirm">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/catalogos-comunes.js"></script>
}
