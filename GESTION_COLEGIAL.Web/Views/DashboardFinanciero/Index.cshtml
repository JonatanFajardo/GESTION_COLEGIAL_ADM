@{
    ViewBag.Title = "Dashboard Financiero";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── Wrapper ── */
    .fin-wrapper { padding: 0 6px 32px; }
    .fin-wrapper .row { margin-bottom: 22px; }
    .fin-wrapper .row:last-child { margin-bottom: 0; }
    .fin-wrapper [class*="col-"] { padding-left: 10px; padding-right: 10px; }

    /* ── Header ── */
    .fin-header {
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 12px;
        margin-bottom: 22px; padding: 16px 22px;
        background: linear-gradient(135deg, #0c4a6e 0%, #155e75 50%, #134e4a 100%);
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(12,74,110,.3);
    }
    .fin-header-left { display: flex; align-items: center; gap: 14px; }
    .fin-header-icon {
        width: 46px; height: 46px;
        background: rgba(255,255,255,.15); border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; color: #fff;
    }
    .fin-header h2 { margin: 0; font-size: 1.25rem; font-weight: 700; color: #fff; }
    .fin-header-sub { font-size: .78rem; color: rgba(255,255,255,.6); margin-top: 2px; }
    .fin-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .fin-controls label { font-size: .8rem; color: rgba(255,255,255,.7); font-weight: 600; margin: 0; }
    .fin-controls select {
        height: 34px; padding: 0 10px;
        background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.25);
        border-radius: 7px; font-size: .84rem; color: #fff; outline: none; cursor: pointer;
    }
    .fin-controls select option { background: #155e75; color: #fff; }
    .btn-actualizar-fin {
        height: 34px; padding: 0 18px;
        background: #fff; color: #0c4a6e;
        border: none; border-radius: 7px;
        font-size: .84rem; font-weight: 700; cursor: pointer;
        transition: all .2s; display: flex; align-items: center; gap: 6px;
    }
    .btn-actualizar-fin:hover { background: #e0f7fa; transform: translateY(-1px); }

    /* ── Section heading ── */
    .fin-section { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .fin-section-accent { width: 4px; height: 20px; border-radius: 2px; flex-shrink: 0; }
    .fin-section-label {
        font-size: .78rem; font-weight: 800; color: #475569;
        text-transform: uppercase; letter-spacing: .7px; white-space: nowrap;
    }
    .fin-section-line { flex: 1; height: 1px; background: #e2e8f0; }

    /* ── KPI Cards ── */
    .kpi-card-fin {
        background: #fff; border-radius: 12px; padding: 16px 18px 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.04);
        position: relative; overflow: hidden;
        transition: transform .15s, box-shadow .15s;
        border-left: 4px solid transparent;
    }
    .kpi-card-fin:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.1); }
    .kpi-card-fin.c-teal   { border-left-color: #14b8a6; }
    .kpi-card-fin.c-blue   { border-left-color: #0ea5e9; }
    .kpi-card-fin.c-amber  { border-left-color: #f59e0b; }
    .kpi-card-fin.c-red    { border-left-color: #ef4444; }
    .kpi-card-fin.c-green  { border-left-color: #22c55e; }
    .kpi-card-fin.c-indigo { border-left-color: #6366f1; }
    .kpi-card-fin.c-purple { border-left-color: #a855f7; }
    .kpi-card-fin.c-rose   { border-left-color: #f43f5e; }

    .kpi-card-fin .kpi-icon-bg {
        position: absolute; right: -6px; bottom: -6px;
        font-size: 3.8rem; opacity: .05; color: #0f172a; pointer-events: none;
    }
    .kpi-top-fin { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px; }
    .kpi-icon-fin {
        width: 36px; height: 36px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center; font-size: .95rem;
    }
    .kpi-icon-fin.teal   { background: #f0fdfa; color: #14b8a6; }
    .kpi-icon-fin.blue   { background: #f0f9ff; color: #0ea5e9; }
    .kpi-icon-fin.amber  { background: #fffbeb; color: #f59e0b; }
    .kpi-icon-fin.red    { background: #fef2f2; color: #ef4444; }
    .kpi-icon-fin.green  { background: #f0fdf4; color: #22c55e; }
    .kpi-icon-fin.indigo { background: #eef2ff; color: #6366f1; }
    .kpi-icon-fin.purple { background: #faf5ff; color: #a855f7; }
    .kpi-icon-fin.rose   { background: #fff1f2; color: #f43f5e; }
    .kpi-value-fin { font-size: 1.5rem; font-weight: 800; color: #0f172a; line-height: 1; }
    .kpi-label-fin { font-size: .7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; margin-top: 4px; }
    .kpi-sub-fin { font-size: .68rem; color: #64748b; margin-top: 6px; }

    /* ── Panel ── */
    .fin-panel { background: #fff; border-radius: 12px; box-shadow: 0 1px 4px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.04); padding: 18px 20px; }
    .chart-header-fin { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; }
    .chart-title-fin { font-size: .8rem; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .5px; }
    .chart-stat-fin { font-size: .82rem; font-weight: 700; }

    /* ── Tablas ── */
    .fin-table { width: 100%; font-size: .82rem; border-collapse: collapse; }
    .fin-table th { background: #f8fafc; color: #64748b; font-weight: 700; font-size: .7rem; text-transform: uppercase; letter-spacing: .5px; padding: 8px 12px; border-bottom: 2px solid #e2e8f0; }
    .fin-table td { padding: 8px 12px; border-bottom: 1px solid #f1f5f9; color: #334155; vertical-align: middle; }
    .fin-table tr:last-child td { border-bottom: none; }
    .fin-table tr:hover td { background: #f0fdfa; }

    /* ── Top alumnos morosos ── */
    .moroso-item { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
    .moroso-item:last-child { border-bottom: none; }
    .moroso-avatar { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 2px solid #fee2e2; }
    .moroso-avatar-ph { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #ef4444, #f97316); display: flex; align-items: center; justify-content: center; color: #fff; font-size: .85rem; font-weight: 700; flex-shrink: 0; }
    .moroso-info { flex: 1; min-width: 0; }
    .moroso-nombre { font-size: .82rem; font-weight: 700; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .moroso-curso  { font-size: .7rem; color: #64748b; }
    .moroso-monto  { font-size: .88rem; font-weight: 800; color: #ef4444; text-align: right; white-space: nowrap; }
    .moroso-dias   { font-size: .65rem; color: #94a3b8; text-align: right; }

    /* ── Alertas ── */
    .alertas-grid-fin { display: grid; grid-template-columns: 1fr; gap: 10px; }
    .alerta-item-fin { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; border-radius: 10px; font-size: .83rem; border-left: 3px solid transparent; }
    .alerta-item-fin.alta  { background: #fef2f2; border-left-color: #ef4444; }
    .alerta-item-fin.media { background: #fffbeb; border-left-color: #f59e0b; }
    .alerta-item-fin.baja  { background: #f0f9ff; border-left-color: #0ea5e9; }
    .alerta-icon-fin { font-size: 1.1rem; flex-shrink: 0; margin-top: 1px; }
    .alerta-msg-fin  { color: #1e293b; font-weight: 600; line-height: 1.3; flex: 1; }
    .alerta-badge-fin { display: inline-block; margin-top: 4px; font-size: .62rem; padding: 1px 7px; border-radius: 20px; font-weight: 700; }
    .badge-alta-fin  { background: #fee2e2; color: #b91c1c; }
    .badge-media-fin { background: #fef3c7; color: #92400e; }
    .badge-baja-fin  { background: #e0f2fe; color: #0369a1; }

    /* Listas con scroll */
    .fin-scroll { max-height: 430px; overflow-y: auto; padding-right: 4px; }

    /* Estado vencer badge */
    .dias-badge { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: .68rem; font-weight: 700; }
    .dias-badge.urgente { background: #fee2e2; color: #b91c1c; }
    .dias-badge.proximo { background: #fef3c7; color: #92400e; }
    .dias-badge.normal  { background: #e0f2fe; color: #0369a1; }

    /* ── Animaciones ── */
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .kpi-card-fin { animation: fadeInUp .35s ease both; }
    .fin-panel { animation: fadeInUp .4s ease both; }
    .kpi-card-fin:nth-child(1) { animation-delay:.04s; } .kpi-card-fin:nth-child(2) { animation-delay:.08s; }
    .kpi-card-fin:nth-child(3) { animation-delay:.12s; } .kpi-card-fin:nth-child(4) { animation-delay:.16s; }
</style>

<div class="fin-wrapper">

    <!-- ══ Header ══ -->
    <div class="fin-header">
        <div class="fin-header-left">
            <div class="fin-header-icon"><i class="fa-solid fa-chart-line"></i></div>
            <div>
                <h2>Dashboard Financiero</h2>
                <div class="fin-header-sub">Indicadores de cobranza, cartera y morosidad</div>
            </div>
        </div>
        <div class="fin-controls">
            <label>Año</label>
            <select id="sel-anio-fin"></select>
            <label>Mes</label>
            <select id="sel-mes-fin"></select>
            <button class="btn-actualizar-fin" id="btn-actualizar-fin">
                <i class="fa-solid fa-rotate-right"></i> Actualizar
            </button>
        </div>
    </div>

    <!-- ══ Evolución mensual ══ -->
    <div class="fin-section">
        <div class="fin-section-accent" style="background:#0ea5e9;"></div>
        <span class="fin-section-label"><i class="fa-solid fa-chart-line" style="margin-right:5px;"></i>Evolución Mensual (12 Meses)</span>
        <div class="fin-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="fin-panel">
                <div class="chart-header-fin">
                    <span class="chart-title-fin"><i class="fa-solid fa-arrow-trend-up" style="margin-right:5px;color:#0ea5e9;"></i>Facturado vs. Cobrado</span>
                    <span class="chart-stat-fin" id="stat-evol" style="color:#0ea5e9;"></span>
                </div>
                <canvas id="chart-ingresos-mensuales" style="max-height:260px;"></canvas>
            </div>
        </div>
    </div>

    <!-- ══ Calendario escolar ══ -->
    <div class="fin-section">
        <div class="fin-section-accent" style="background:#4f46e5;"></div>
        <span class="fin-section-label"><i class="bi bi-calendar3" style="margin-right:5px;"></i>Calendario</span>
        <div class="fin-section-line"></div>
    </div>
    <div class="row mb-4">
        <div class="col-md-12">
            @await Html.PartialAsync("_ProximosDias")
        </div>
    </div>

    <!-- ══ Estado y distribución ══ -->
    <div class="fin-section">
        <div class="fin-section-accent" style="background:#a855f7;"></div>
        <span class="fin-section-label"><i class="fa-solid fa-chart-pie" style="margin-right:5px;"></i>Estado y Distribución de Cartera</span>
        <div class="fin-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="fin-panel">
                <div class="chart-header-fin">
                    <span class="chart-title-fin"><i class="fa-solid fa-chart-pie" style="margin-right:5px;color:#a855f7;"></i>Estado de Cartera</span>
                </div>
                <canvas id="chart-estado-cartera" style="max-height:240px;"></canvas>
            </div>
        </div>
        <div class="col-md-4">
            <div class="fin-panel">
                <div class="chart-header-fin">
                    <span class="chart-title-fin"><i class="fa-solid fa-credit-card" style="margin-right:5px;color:#14b8a6;"></i>Cobros por Forma de Pago</span>
                    <span class="chart-stat-fin" id="stat-fpa" style="color:#14b8a6;"></span>
                </div>
                <canvas id="chart-forma-pago" style="max-height:240px;"></canvas>
            </div>
        </div>
        <div class="col-md-4">
            <div class="fin-panel">
                <div class="chart-header-fin">
                    <span class="chart-title-fin"><i class="fa-solid fa-list-ol" style="margin-right:5px;color:#0ea5e9;"></i>Top Conceptos Cobrados</span>
                </div>
                <canvas id="chart-cobros-concepto" style="max-height:240px;"></canvas>
            </div>
        </div>
    </div>

    <!-- ══ Morosidad ══ -->
    <div class="fin-section">
        <div class="fin-section-accent" style="background:#ef4444;"></div>
        <span class="fin-section-label"><i class="fa-solid fa-circle-exclamation" style="margin-right:5px;"></i>Morosidad</span>
        <div class="fin-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="fin-panel">
                <div class="chart-header-fin">
                    <span class="chart-title-fin"><i class="fa-solid fa-tag" style="margin-right:5px;color:#ef4444;"></i>Morosidad por Concepto</span>
                </div>
                <canvas id="chart-morosidad-concepto" style="max-height:260px;"></canvas>
            </div>
        </div>
        <div class="col-md-6">
            <div class="fin-panel">
                <div class="chart-header-fin">
                    <span class="chart-title-fin"><i class="fa-solid fa-users" style="margin-right:5px;color:#f97316;"></i>Top Alumnos Morosos</span>
                    <span class="chart-stat-fin" id="stat-morosos" style="color:#f97316;"></span>
                </div>
                <div id="lista-morosos" class="fin-scroll"></div>
            </div>
        </div>
    </div>

    <!-- ══ KPIs principales: dinero ══ -->
    <div class="fin-section">
        <div class="fin-section-accent" style="background:#14b8a6;"></div>
        <span class="fin-section-label"><i class="fa-solid fa-sack-dollar" style="margin-right:5px;"></i>Indicadores Económicos del Mes</span>
        <div class="fin-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card-fin c-teal">
                <i class="fa-solid fa-file-invoice-dollar kpi-icon-bg"></i>
                <div class="kpi-top-fin"><div class="kpi-icon-fin teal"><i class="fa-solid fa-file-invoice-dollar"></i></div></div>
                <div class="kpi-value-fin" id="kpi-facturado">—</div>
                <div class="kpi-label-fin">Facturado del Mes</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card-fin c-green">
                <i class="fa-solid fa-hand-holding-dollar kpi-icon-bg"></i>
                <div class="kpi-top-fin"><div class="kpi-icon-fin green"><i class="fa-solid fa-hand-holding-dollar"></i></div></div>
                <div class="kpi-value-fin" id="kpi-cobrado">—</div>
                <div class="kpi-label-fin">Cobrado del Mes</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card-fin c-amber">
                <i class="fa-solid fa-clock kpi-icon-bg"></i>
                <div class="kpi-top-fin"><div class="kpi-icon-fin amber"><i class="fa-solid fa-clock"></i></div></div>
                <div class="kpi-value-fin" id="kpi-pendiente">—</div>
                <div class="kpi-label-fin">Total Pendiente</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card-fin c-red">
                <i class="fa-solid fa-triangle-exclamation kpi-icon-bg"></i>
                <div class="kpi-top-fin"><div class="kpi-icon-fin red"><i class="fa-solid fa-triangle-exclamation"></i></div></div>
                <div class="kpi-value-fin" id="kpi-mora">—</div>
                <div class="kpi-label-fin">Mora Acumulada</div>
            </div>
        </div>
    </div>

    <!-- ══ KPIs secundarios ══ -->
    <div class="fin-section">
        <div class="fin-section-accent" style="background:#0ea5e9;"></div>
        <span class="fin-section-label"><i class="fa-solid fa-chart-simple" style="margin-right:5px;"></i>Métricas Operativas</span>
        <div class="fin-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card-fin c-blue">
                <i class="fa-solid fa-percent kpi-icon-bg"></i>
                <div class="kpi-top-fin"><div class="kpi-icon-fin blue"><i class="fa-solid fa-percent"></i></div></div>
                <div class="kpi-value-fin" id="kpi-pct-cobranza">—</div>
                <div class="kpi-label-fin">% Cobranza</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card-fin c-indigo">
                <i class="fa-solid fa-receipt kpi-icon-bg"></i>
                <div class="kpi-top-fin"><div class="kpi-icon-fin indigo"><i class="fa-solid fa-receipt"></i></div></div>
                <div class="kpi-value-fin" id="kpi-cantidad-pagos">—</div>
                <div class="kpi-label-fin">Pagos del Mes</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card-fin c-purple">
                <i class="fa-solid fa-ticket kpi-icon-bg"></i>
                <div class="kpi-top-fin"><div class="kpi-icon-fin purple"><i class="fa-solid fa-ticket"></i></div></div>
                <div class="kpi-value-fin" id="kpi-ticket">—</div>
                <div class="kpi-label-fin">Ticket Promedio</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6" style="margin-bottom:18px;">
            <div class="kpi-card-fin c-rose">
                <i class="fa-solid fa-user-clock kpi-icon-bg"></i>
                <div class="kpi-top-fin"><div class="kpi-icon-fin rose"><i class="fa-solid fa-user-clock"></i></div></div>
                <div class="kpi-value-fin" id="kpi-morosos">—</div>
                <div class="kpi-label-fin">Alumnos Morosos</div>
            </div>
        </div>
    </div>

    <!-- ══ Actividad diaria ══ -->
    <div class="fin-section">
        <div class="fin-section-accent" style="background:#22c55e;"></div>
        <span class="fin-section-label"><i class="fa-solid fa-calendar-day" style="margin-right:5px;"></i>Actividad Diaria</span>
        <div class="fin-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="fin-panel">
                <div class="chart-header-fin">
                    <span class="chart-title-fin"><i class="fa-solid fa-coins" style="margin-right:5px;color:#22c55e;"></i>Cobros por Día del Mes</span>
                    <span class="chart-stat-fin" id="stat-cobros-dia" style="color:#22c55e;"></span>
                </div>
                <canvas id="chart-cobros-dia" style="max-height:220px;"></canvas>
            </div>
        </div>
    </div>

    <!-- ══ Por vencer + Alertas ══ -->
    <div class="fin-section">
        <div class="fin-section-accent" style="background:#f59e0b;"></div>
        <span class="fin-section-label"><i class="fa-solid fa-hourglass-half" style="margin-right:5px;"></i>Próximos Vencimientos y Alertas</span>
        <div class="fin-section-line"></div>
    </div>
    <div class="row">
        <div class="col-md-8">
            <div class="fin-panel">
                <div class="chart-header-fin">
                    <span class="chart-title-fin"><i class="fa-solid fa-calendar-xmark" style="margin-right:5px;color:#f59e0b;"></i>Cuentas por Vencer (7 Días)</span>
                    <span class="chart-stat-fin" id="stat-vencer" style="color:#f59e0b;"></span>
                </div>
                <div class="fin-scroll" style="overflow-x:auto;">
                    <table class="fin-table">
                        <thead>
                            <tr>
                                <th>Alumno</th>
                                <th>Concepto</th>
                                <th>Vencimiento</th>
                                <th style="text-align:right;">Pendiente</th>
                                <th style="text-align:center;">Días</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-vencer">
                            <tr><td colspan="5" style="text-align:center;color:#94a3b8;padding:20px;">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="fin-panel">
                <div class="chart-header-fin">
                    <span class="chart-title-fin"><i class="fa-solid fa-bell" style="margin-right:5px;color:#ef4444;"></i>Alertas Financieras</span>
                </div>
                <div class="alertas-grid-fin fin-scroll" id="lista-alertas-fin">
                    <p style="color:#94a3b8;font-size:.82rem;margin:0;">Sin alertas activas.</p>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/dashboardfinanciero.js"></script>
    <script>
        DashboardFinanciero.init("@Url.Action("ResumenAsync")");
    </script>
}
