@{
    ViewBag.Title = "Dashboard Financiero";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/pages/dashboard-financiero.css" rel="stylesheet" asp-append-version="true" />
}

<div>

    <!-- ══ Header ══ -->
    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
        <div class="mr-3">
            <h4 class="mb-1">Dashboard Financiero</h4>
            <p class="text-muted mb-0">Indicadores de cobranza, cartera y morosidad</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap align-items-center">
            <label class="mb-0 mr-2">Año</label>
            <select id="sel-anio-fin" class="custom-select w-auto mr-3"></select>
            <label class="mb-0 mr-2">Mes</label>
            <select id="sel-mes-fin" class="custom-select w-auto mr-3"></select>
            <button type="button" class="btn btn-primary" id="btn-actualizar-fin"><i class="fas fa-rotate-right mr-1"></i>Actualizar</button>
        </div>
    </div>

    <!-- ══ Evolución mensual ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-chart-line mr-1"></i>Evolución Mensual (12 Meses)</h6>
    <div class="row">
        <div class="col-md-12 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-arrow-trend-up mr-1"></i>Facturado vs. Cobrado</h4><span class="small font-weight-bold text-muted" id="stat-evol"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h260" id="chart-ingresos-mensuales"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Calendario escolar ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="bi bi-calendar3 mr-1"></i>Calendario</h6>
    <div class="row mb-4">
        <div class="col-md-12">
            @await Html.PartialAsync("_ProximosDias")
        </div>
    </div>

    <!-- ══ Estado y distribución ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-chart-pie mr-1"></i>Estado y Distribución de Cartera</h6>
    <div class="row">
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-chart-pie mr-1"></i>Estado de Cartera</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h240" id="chart-estado-cartera"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-credit-card mr-1"></i>Cobros por Forma de Pago</h4><span class="small font-weight-bold text-muted" id="stat-fpa"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h240" id="chart-forma-pago"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-list-ol mr-1"></i>Top Conceptos Cobrados</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h240" id="chart-cobros-concepto"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Morosidad ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-circle-exclamation mr-1"></i>Morosidad</h6>
    <div class="row">
        <div class="col-md-6 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-tag mr-1"></i>Morosidad por Concepto</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h260" id="chart-morosidad-concepto"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-users mr-1"></i>Top Alumnos Morosos</h4><span class="small font-weight-bold text-muted" id="stat-morosos"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div id="lista-morosos" class="fin-scroll"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ KPIs principales: dinero ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-sack-dollar mr-1"></i>Indicadores Económicos del Mes</h6>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-facturado">—</h6>
                            <p>Facturado del Mes</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-file-invoice-dollar"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-cobrado">—</h6>
                            <p>Cobrado del Mes</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-hand-holding-dollar"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-pendiente">—</h6>
                            <p>Total Pendiente</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-clock"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-mora">—</h6>
                            <p>Mora Acumulada</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-triangle-exclamation"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ KPIs secundarios ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-chart-simple mr-1"></i>Métricas Operativas</h6>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-pct-cobranza">—</h6>
                            <p>% Cobranza</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-percent"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-cantidad-pagos">—</h6>
                            <p>Pagos del Mes</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-receipt"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-ticket">—</h6>
                            <p>Ticket Promedio</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-ticket"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-morosos">—</h6>
                            <p>Alumnos Morosos</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-user-clock"></i></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Actividad diaria ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-calendar-day mr-1"></i>Actividad Diaria</h6>
    <div class="row">
        <div class="col-md-12 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-coins mr-1"></i>Cobros por Día del Mes</h4><span class="small font-weight-bold text-muted" id="stat-cobros-dia"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h220" id="chart-cobros-dia"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Por vencer + Alertas ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-hourglass-half mr-1"></i>Próximos Vencimientos y Alertas</h6>
    <div class="row">
        <div class="col-md-8 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-calendar-xmark mr-1"></i>Cuentas por Vencer (7 Días)</h4><span class="small font-weight-bold text-muted" id="stat-vencer"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="fin-scroll table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Alumno</th>
                                <th>Concepto</th>
                                <th>Vencimiento</th>
                                <th class="text-right">Pendiente</th>
                                <th class="text-center">Días</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-vencer">
                            <tr><td class="text-center text-muted py-4" colspan="5">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-bell mr-1"></i>Alertas Financieras</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <div class="alertas-grid-fin fin-scroll" id="lista-alertas-fin">
                    <p class="text-muted m-0">Sin alertas activas.</p>
                </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/dashboardfinanciero.js"></script>
    <script>
        DashboardFinanciero.init("@Url.Action("ResumenAsync")");
    </script>
}
