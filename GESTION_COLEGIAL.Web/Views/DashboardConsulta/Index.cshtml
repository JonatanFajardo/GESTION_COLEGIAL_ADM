@{
    ViewBag.Title = "Dashboard Consulta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/pages/dashboard-consulta.css" rel="stylesheet" asp-append-version="true" />
}

<div>

    <!-- ══ Header ══ -->
    <div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
        <div class="mr-3">
            <h4 class="mb-1">Dashboard de Consulta Institucional</h4>
            <p class="text-muted mb-0">Vista ejecutiva de indicadores académicos y operativos</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap align-items-center">
            <label class="mb-0 mr-2">Año</label>
            <select id="sel-anio" class="custom-select w-auto mr-3"></select>
            <button type="button" class="btn btn-primary" id="btn-actualizar"><i class="fas fa-rotate-right mr-1"></i>Actualizar</button>
        </div>
    </div>

    <!-- ══ Crecimiento Institucional ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-arrow-trend-up mr-1"></i>Crecimiento Institucional</h6>
    <div class="row">
        <div class="col-md-12 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-chart-line mr-1"></i>Evolución de Matrícula (últimos 5 años)</h4><span class="small font-weight-bold text-muted" id="stat-evolucion"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h230" id="chart-evolucion"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Calendario escolar ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="bi bi-calendar3 mr-1"></i>Calendario</h6>
    <div class="row mb-4">
        <div class="col-md-12">
            @await Html.PartialAsync("_ProximosDias")
        </div>
    </div>

    <!-- ══ Población Estudiantil ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-user-graduate mr-1"></i>Población Estudiantil</h6>
    <div class="row">
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-layer-group mr-1"></i>Por Nivel Educativo</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h240" id="chart-nivel"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-clock mr-1"></i>Por Jornada</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h240" id="chart-jornada"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-venus-mars mr-1"></i>Por Género</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h240" id="chart-genero"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Distribución de Matrícula ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-chart-column mr-1"></i>Distribución de Matrícula</h6>
    <div class="row">
        <div class="col-md-7 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-book mr-1"></i>Top 10 Cursos por Matrícula</h4><span class="small font-weight-bold text-muted" id="stat-cursos"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h340" id="chart-cursos"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-5 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-children mr-1"></i>Distribución por Edad</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h340" id="chart-edad"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Personal ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-people-roof mr-1"></i>Personal Institucional</h6>
    <div class="row">
        <div class="col-md-7 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-sitemap mr-1"></i>Empleados por Departamento</h4><span class="small font-weight-bold text-muted" id="stat-deptos"></span></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h300" id="chart-departamento"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-5 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row"><div class="col-12 d-flex flex-wrap align-items-center justify-content-between"><h4><i class="fas fa-briefcase mr-1"></i>Top Cargos</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                <canvas class="dash-chart-h300" id="chart-cargo"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ KPIs Principales ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-gauge-high mr-1"></i>Resumen Institucional</h6>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-alumnos">—</h6>
                            <p>Total Alumnos</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-user-graduate"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2" id="kpi-alumnos-activos">—</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-empleados">—</h6>
                            <p>Total Empleados</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-people-group"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2">Personal activo</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-docentes">—</h6>
                            <p>Total Docentes</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-chalkboard-user"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2">Asignados al año</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-cursos">—</h6>
                            <p>Cursos Activos</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-book-open"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2">Catálogo institucional</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-clases">—</h6>
                            <p>Clases Programadas</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-calendar-week"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2">Horario del año</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-niveles">—</h6>
                            <p>Niveles Educativos</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-layer-group"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2">En operación</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-jornadas">—</h6>
                            <p>Jornadas</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-clock"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2">Modalidades activas</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6 layout-spacing">
            <div class="widget widget-card-four h-100">
                <div class="widget-content">
                    <div class="w-content">
                        <div class="w-info">
                            <h6 class="value" id="kpi-cobrado">—</h6>
                            <p>% Cobrado</p>
                        </div>
                        <div><div class="w-icon"><i class="fas fa-percent"></i></div></div>
                    </div>
                <p class="text-muted small mb-0 mt-2">Eficiencia financiera</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Indicadores Institucionales ══ -->
    <h6 class="text-muted text-uppercase font-weight-bold small mb-3"><i class="fas fa-bullseye mr-1"></i>Indicadores Institucionales</h6>
    <div id="lista-indicadores" class="row">
        <div class="col-12"><p class="text-muted small mb-0">Cargando indicadores...</p></div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/dashboardconsulta.js"></script>
    <script>
        DashboardConsulta.init("@Url.Action("ResumenAsync")");
    </script>
}
