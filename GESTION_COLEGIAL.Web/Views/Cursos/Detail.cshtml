@model GESTION_COLEGIAL.Business.Models.CursoDetailViewModel
@{
    ViewBag.Title = "Detalle del Curso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Cursos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Detalle</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4 widget encabezado-pagina">
    <div class="mr-3">
        <h4 class="mb-1">@Model.Cur_Nombre <span class="badge outline-badge-secondary ml-1">#@Model.Cur_Id.ToString().PadLeft(4, '0')</span></h4>
        <p class="text-muted mb-0"><i class="bi bi-book-half mr-1"></i> Curso académico</p>
    </div>
    <div class="mt-2 mt-md-0">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left mr-1"></i> Volver</a>
    </div>
</div>

<div class="fluid-container">
    <div class="row">
        <div class="col-lg-6 layout-spacing">
            <div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4><i class="bi bi-info-circle mr-1"></i> Información del Curso</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">ID</dt>
                        <dd class="col-sm-7">@Model.Cur_Id.ToString().PadLeft(4, '0')</dd>
                        <dt class="col-sm-5 text-muted">Nombre del Curso</dt>
                        <dd class="col-sm-7 mb-0">@Model.Cur_Nombre</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-6 layout-spacing">
            <div class="statbox widget box box-shadow h-100">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4><i class="bi bi-clock-history mr-1"></i> Información de Registro</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    <div class="d-flex align-items-start mb-3">
                        <span class="badge badge-success mr-3"><i class="bi bi-plus-circle"></i></span>
                        <div>
                            <div class="text-muted small">Registrado por</div>
                            <div class="font-weight-bold">@(string.IsNullOrEmpty(Model.Cur_UsuarioRegistraNombre) ? "—" : Model.Cur_UsuarioRegistraNombre)</div>
                            @if (Model.Cur_FechaRegistra.HasValue)
                            {
                                <div class="text-muted small"><i class="bi bi-clock mr-1"></i> @Model.Cur_FechaRegistra.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                        </div>
                    </div>
                    @if (Model.Cur_FechaModifica.HasValue)
                    {
                        <div class="d-flex align-items-start">
                            <span class="badge badge-warning mr-3"><i class="bi bi-pencil"></i></span>
                            <div>
                                <div class="text-muted small">Modificado por</div>
                                <div class="font-weight-bold">@(string.IsNullOrEmpty(Model.Cur_UsuarioModificaNombre) ? "—" : Model.Cur_UsuarioModificaNombre)</div>
                                <div class="text-muted small"><i class="bi bi-clock mr-1"></i> @Model.Cur_FechaModifica.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
