@model GESTION_COLEGIAL.Business.Models.CursoViewModel
@{
    ViewBag.Title = "Crear";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts {
    <script src="~/Content/js/form-cursos.js"></script>
}


<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/Cursos/Index">Cursos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Crear Curso</li>
        </ol>
    </nav>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Registro de Cursos</h4>
        <p class="text-muted mb-0">Configure el curso académico y sus opciones asociadas</p>
    </div>
</div>

<div class="fluid-container">
    @using (Html.BeginForm("Save", "Cursos", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.HiddenFor(model => model.Cur_Id)

        <div class="row">
            <!-- Columna Izquierda - Información Básica -->
            <div class="col-md-12 col-lg-5 layout-spacing">
                <div class="statbox widget box box-shadow h-100">
                    <div class="widget-header">
                        <div class="row"><div class="col-12"><h4><i class="bi bi-info-circle mr-1"></i> Información del Curso</h4></div></div>
                    </div>
                    <div class="widget-content widget-content-area">
                        <div class="form-group">
                            <label class="d-block">Estado del Curso</label>
                            <div class="d-flex align-items-center">
                                <span class="badge badge-success mr-3" id="statusBadge">
                                    <span id="statusDot"></span>
                                    <span id="statusText">Activo</span>
                                </span>
                                <label class="switch s-outline s-outline-primary mb-0">
                                    @Html.EditorFor(model => model.Cur_EsActivo, new { htmlAttributes = new { @id = "statusToggle", @checked = "checked" } })
                                    <span class="slider round"></span>
                                </label>
                            </div>
                        </div>

                        <hr />

                        <div class="form-group">
                            <div class="d-flex align-items-center justify-content-between">
                                <label for="Niv_Id"><i class="bi bi-calendar mr-1"></i> Nivel Educativo</label>
                                <a href="/NivelesEducativos/Index" target="_blank" class="btn btn-link btn-sm p-0" title="Agregar nuevo nivel educativo"><i class="bi bi-plus-lg mr-1"></i> Agregar</a>
                            </div>
                            @Html.DropDownList("Niv_Id", Model.NivelEducativoList, "-- Seleccionar Nivel --", htmlAttributes: new { @class = "custom-select", @id = "Niv_Id" })
                            @Html.ValidationMessageFor(model => model.Niv_Id, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label for="Cur_Nombre"><i class="bi bi-book mr-1"></i> Nombre del Curso</label>
                            @Html.EditorFor(model => model.Cur_Nombre, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ej: Matemáticas Avanzadas" } })
                            @Html.ValidationMessageFor(model => model.Cur_Nombre, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            @Html.ActionLink("Cancelar", "Index", "Cursos", null, new { @class = "btn mr-2", @id = "cancelBtn" })
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save mr-1"></i> Guardar Curso</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha - Opciones -->
            <div class="col-md-12 col-lg-7 layout-spacing">
                <div class="statbox widget box box-shadow h-100">
                    <div class="widget-header">
                        <div class="row"><div class="col-12"><h4><i class="bi bi-three-dots-vertical mr-1"></i> Opciones del Curso</h4></div></div>
                    </div>
                    <div class="widget-content widget-content-area">
                        <div id="toggleAccordion">
                            <!-- Materias -->
                            <div class="card">
                                <div class="card-header">
                                    <section class="mb-0 mt-0">
                                        <div role="menu" data-toggle="collapse" data-target="#accordionMaterias" aria-expanded="true">
                                            <i class="bi bi-book mr-1"></i> Materias
                                            <div class="icons"><i class="bi bi-chevron-down"></i></div>
                                        </div>
                                    </section>
                                </div>
                                <div id="accordionMaterias" class="collapse show" data-parent="#toggleAccordion">
                                    <div class="card-body">
                                        <div class="row">
                                            @for (int i = 0; i < Model.MateriasCheckList.Count; i++)
                                            {
                                                <div class="col-sm-6 col-md-4 mb-2">
                                                    <div class="n-chk">
                                                        <label class="new-control new-checkbox checkbox-warning m-0">
                                                            @Html.CheckBoxFor(model => model.MateriasCheckList[i].Selected, new { @class = "new-control-input", id = "materia-" + i })
                                                            <span class="new-control-indicator"></span>
                                                            <span>@Html.DisplayFor(model => model.MateriasCheckList[i].Text)</span>
                                                        </label>
                                                    </div>
                                                    @Html.HiddenFor(model => model.MateriasCheckList[i].Text)
                                                    @Html.HiddenFor(model => model.MateriasCheckList[i].Value)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Secciones -->
                            <div class="card">
                                <div class="card-header">
                                    <section class="mb-0 mt-0">
                                        <div role="menu" class="collapsed" data-toggle="collapse" data-target="#accordionSecciones" aria-expanded="false">
                                            <i class="bi bi-people mr-1"></i> Secciones
                                            <div class="icons"><i class="bi bi-chevron-down"></i></div>
                                        </div>
                                    </section>
                                </div>
                                <div id="accordionSecciones" class="collapse " data-parent="#toggleAccordion">
                                    <div class="card-body">
                                        <div class="row">
                                            @for (int i = 0; i < Model.SeccionesCheckList.Count; i++)
                                            {
                                                <div class="col-12 mb-2">
                                                    <div class="n-chk">
                                                        <label class="new-control new-checkbox checkbox-primary m-0">
                                                            @Html.CheckBoxFor(model => model.SeccionesCheckList[i].Selected, new { @class = "new-control-input" })
                                                            <span class="new-control-indicator"></span>
                                                            <span>@Html.DisplayFor(model => model.SeccionesCheckList[i].Text)</span>
                                                        </label>
                                                    </div>
                                                    @Html.HiddenFor(model => model.SeccionesCheckList[i].Text)
                                                    @Html.HiddenFor(model => model.SeccionesCheckList[i].Value)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Modalidades -->
                            <div class="card">
                                <div class="card-header">
                                    <section class="mb-0 mt-0">
                                        <div role="menu" class="collapsed" data-toggle="collapse" data-target="#accordionModalidades" aria-expanded="false">
                                            <i class="bi bi-alarm mr-1"></i> Modalidades
                                            <div class="icons"><i class="bi bi-chevron-down"></i></div>
                                        </div>
                                    </section>
                                </div>
                                <div id="accordionModalidades" class="collapse " data-parent="#toggleAccordion">
                                    <div class="card-body">
                                        <div class="row">
                                            @for (int i = 0; i < Model.ModalidadesCheckList.Count; i++)
                                            {
                                                <div class="col-sm-6 col-md-4 mb-2">
                                                    <div class="n-chk">
                                                        <label class="new-control new-checkbox checkbox-warning m-0">
                                                            @Html.CheckBoxFor(model => model.ModalidadesCheckList[i].Selected, new { @class = "new-control-input", id = "modalidad-" + i })
                                                            <span class="new-control-indicator"></span>
                                                            <span>@Html.DisplayFor(model => model.ModalidadesCheckList[i].Text)</span>
                                                        </label>
                                                    </div>
                                                    @Html.HiddenFor(model => model.ModalidadesCheckList[i].Text)
                                                    @Html.HiddenFor(model => model.ModalidadesCheckList[i].Value)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Grados Académicos -->
                            <div class="card">
                                <div class="card-header">
                                    <section class="mb-0 mt-0">
                                        <div role="menu" class="collapsed" data-toggle="collapse" data-target="#accordionNiveles" aria-expanded="false">
                                            <i class="bi bi-bookmark mr-1"></i> Grados Académicos
                                            <div class="icons"><i class="bi bi-chevron-down"></i></div>
                                        </div>
                                    </section>
                                </div>
                                <div id="accordionNiveles" class="collapse " data-parent="#toggleAccordion">
                                    <div class="card-body">
                                        <div class="row">
                                            @for (int i = 0; i < Model.CursoNivelesCheckList.Count; i++)
                                            {
                                                <div class="col-sm-6 col-md-4 mb-2">
                                                    <div class="n-chk">
                                                        <label class="new-control new-checkbox checkbox-warning m-0">
                                                            @Html.CheckBoxFor(model => model.CursoNivelesCheckList[i].Selected, new { @class = "new-control-input", id = "curso-nivel-" + i })
                                                            <span class="new-control-indicator"></span>
                                                            <span>@Html.DisplayFor(model => model.CursoNivelesCheckList[i].Text)</span>
                                                        </label>
                                                    </div>
                                                    @Html.HiddenFor(model => model.CursoNivelesCheckList[i].Text)
                                                    @Html.HiddenFor(model => model.CursoNivelesCheckList[i].Value)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
