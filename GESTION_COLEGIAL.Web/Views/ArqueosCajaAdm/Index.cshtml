@{
    ViewBag.Title = "Arqueo de Caja";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Arqueo de Caja</li>
        </ol>
    </nav>
</div>
<div class="d-flex flex-wrap align-items-center justify-content-between layout-top-spacing mb-4">
    <div class="mr-3">
        <h4 class="mb-1">Arqueo de Caja</h4>
        <p class="text-muted mb-0">Cuadre el efectivo, transferencias y tarjetas contra lo que el sistema registró</p>
    </div>
    <div class="mt-2 mt-md-0">
            <button class="btn btn-primary" data-toggle="modal" data-target="#modal-arqueo">
                <i class="bi bi-plus-circle mr-1"></i> Nuevo arqueo
            </button>
        
    </div>
</div>

    <div class="row">
        <div class="col-lg-6 col-12 layout-spacing">
            <div class="statbox widget box box-shadow" id="panel-ultimo" style="display:none;">
                <div class="widget-header">
                    <div class="row"><div class="col-12"><h4>Último arqueo</h4></div></div>
                </div>
                <div class="widget-content widget-content-area">
                    <div id="info-arqueo"></div>
                </div>
            </div>
            <div class="statbox widget box box-shadow" id="panel-sin-arqueo">
                <div class="widget-content widget-content-area text-center text-muted py-5">
                    <i class="fa-solid fa-scale-balanced fa-3x mb-3"></i>
                    <p class="mb-0">No hay arqueos registrados. Cree el primero.</p>
                </div>
            </div>
        </div>
    </div>

<!-- Modal Nuevo Arqueo -->
<div class="modal fade" id="modal-arqueo" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo arqueo de caja</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="form-arqueo">
                <div class="modal-body">
                    <div>
                        <div class="form-group">
                            <label for="arq-fecha">Fecha del arqueo <span class="text-danger">*</span></label>
                            <input type="date" name="Arq_Fecha" id="arq-fecha" class="form-control">
                            <small class="form-text text-muted font-italic" id="arq-estado-carga"></small>
                        </div>

                        <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Forma de pago</th>
                                    <th class="text-right">Esperado (sistema)</th>
                                    <th class="text-right">Contado (caja)</th>
                                    <th class="text-right">Diferencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr data-forma="efectivo">
                                    <td class="font-weight-bold text-dark align-middle"><i class="bi bi-cash-coin"></i> Efectivo</td>
                                    <td class="text-right font-weight-bold align-middle" id="esp-efectivo">L 0.00</td>
                                    <td class="align-middle"><input type="number" step="0.01" min="0" name="Arq_TotalEfectivo" class="form-control form-control-sm text-right arq-input-contado" value="0"></td>
                                    <td class="text-right font-weight-bold align-middle text-muted" id="dif-efectivo">L 0.00</td>
                                </tr>
                                <tr data-forma="transferencia">
                                    <td class="font-weight-bold text-dark align-middle"><i class="bi bi-bank"></i> Transferencia</td>
                                    <td class="text-right font-weight-bold align-middle" id="esp-transferencia">L 0.00</td>
                                    <td class="align-middle"><input type="number" step="0.01" min="0" name="Arq_TotalTransferencia" class="form-control form-control-sm text-right arq-input-contado" value="0"></td>
                                    <td class="text-right font-weight-bold align-middle text-muted" id="dif-transferencia">L 0.00</td>
                                </tr>
                                <tr data-forma="tarjeta">
                                    <td class="font-weight-bold text-dark align-middle"><i class="bi bi-credit-card"></i> Tarjeta</td>
                                    <td class="text-right font-weight-bold align-middle" id="esp-tarjeta">L 0.00</td>
                                    <td class="align-middle"><input type="number" step="0.01" min="0" name="Arq_TotalTarjeta" class="form-control form-control-sm text-right arq-input-contado" value="0"></td>
                                    <td class="text-right font-weight-bold align-middle text-muted" id="dif-tarjeta">L 0.00</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="font-weight-bold">
                                    <td class="text-dark">Total</td>
                                    <td class="text-right font-weight-bold align-middle" id="esp-total">L 0.00</td>
                                    <td class="text-right font-weight-bold align-middle" id="con-total">L 0.00</td>
                                    <td class="text-right font-weight-bold align-middle text-muted" id="dif-total">L 0.00</td>
                                </tr>
                            </tfoot>
                        </table>
                        </div>

                        <div class="alert alert-light-warning mt-2 mb-0" id="arq-otros-note" style="display:none;"></div>
                        <div class="alert alert-light-success font-weight-bold mt-3 mb-0" id="arq-banner" style="display:none;"></div>

                        <div class="form-group mt-3 mb-0">
                            <label for="arq-observaciones">Observación</label>
                            <textarea name="Arq_Observaciones" id="arq-observaciones" class="form-control" rows="2" placeholder="Ej. sobrante/faltante justificado, incidencias del turno..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar arqueo</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Content/js/pages/arqueosCajaAdm.js"></script>
    <script>
        ArqueosCajaAdm.init({
            urlLast: "@Url.Action("LastAsync")",
            urlCreate: "@Url.Action("CreateAsync")",
            urlPagosDia: "@Url.Action("ListAsync", "PagosDelDia")"
        });
    </script>
}
