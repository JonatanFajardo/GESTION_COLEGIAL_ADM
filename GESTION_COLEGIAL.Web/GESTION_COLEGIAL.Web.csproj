<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    UI del ADM (ASP.NET Core MVC, .NET 10). Reemplazó a GESTION_COLEGIAL.UI (MVC 5), ya retirada.
    RootNamespace se mantiene como GESTION_COLEGIAL.UI (herencia del porteo):
    los namespaces de controllers, filtros y vistas siguen siendo GESTION_COLEGIAL.UI.*.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GESTION_COLEGIAL.UI</RootNamespace>
    <AssemblyName>GESTION_COLEGIAL.Web</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Se usa UseStaticFiles (no MapStaticAssets): no hace falta precomprimir los estáticos al publicar. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GESTION_COLEGIAL.Business\GESTION_COLEGIAL.Business.csproj" />
    <!-- Business devuelve objetos de Newtonsoft (JObject); System.Text.Json no los serializa bien. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.12" />
  </ItemGroup>

  <!-- App_Data viaja con la publicación (en Docker se monta un volumen encima para no perder cambios).
       El compilador de SCSS es solo de desarrollo. -->
  <ItemGroup>
    <Content Update="App_Data\**" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="compilerconfig.json;compilerconfig.json.defaults" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Reemplazan los "using System.Web.Mvc;" de cada controller portado. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Mvc" />
    <Using Include="Microsoft.AspNetCore.Mvc.Rendering" />
    <Using Include="GESTION_COLEGIAL.UI.Compat" />
  </ItemGroup>

</Project>
