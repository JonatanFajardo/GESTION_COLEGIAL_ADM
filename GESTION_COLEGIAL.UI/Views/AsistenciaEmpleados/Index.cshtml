@{
    ViewBag.Title = "Asistencia Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/modal-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/asistenciaempleados.css" rel="stylesheet" />
}

@* Breadcrumb *@
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Asistencia Empleados</li>
        </ol>
    </nav>
</div>

@* Page Header *@
<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-calendar-check fa-2x"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Asistencia del Personal</h1>
                <p>Registre y consulte la asistencia diaria de los empleados</p>
            </div>
        </div>
        <div class="header-action-catalogo">
            <button id="btn-registrar-asistencia" class="btn-nuevo-catalogo">
                <i class="fa-solid fa-plus-circle"></i> Registrar Asistencia
            </button>
        </div>
    </div>
</div>

@* Contenido principal *@
<div class="fluid-container">

    @* Filtros *@
    <div id="asi-filtros" class="asi-filtros-card">
        <div class="row align-items-end">
            <div class="col-md-3 col-sm-6 mb-2 mb-md-0">
                <label class="form-label-catalogo" for="filtro-empleado">Empleado</label>
                <select id="filtro-empleado" class="form-control">
                    <option value="">-- Todos --</option>
                </select>
            </div>
            <div class="col-md-3 col-sm-6 mb-2 mb-md-0">
                <label class="form-label-catalogo" for="filtro-desde">Desde</label>
                <input type="date" id="filtro-desde" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-3 col-sm-6 mb-2 mb-md-0">
                <label class="form-label-catalogo" for="filtro-hasta">Hasta</label>
                <input type="date" id="filtro-hasta" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-3 col-sm-6 mb-2 mb-md-0">
                <button id="btn-buscar" class="btn btn-primary btn-block">
                    <i class="fa-solid fa-magnifying-glass"></i> Buscar
                </button>
            </div>
        </div>
        <div class="asi-rango-hint">
            <i class="fa-regular fa-calendar-days mr-1"></i>
            Mostrando: <span id="asi-rango-label">—</span>
        </div>
    </div>

    @* KPI Cards — llenado por JS *@
    <div id="asi-kpis" class="row"></div>

    @* Split view: lista de empleados (izquierda) + calendario (derecha) *@
    <div id="asi-split-view" class="asi-split-view">
        <div class="asi-split-left">
            <div class="asi-panel-header">
                <div class="asi-panel-title">
                    <i class="fa-solid fa-users mr-2"></i>
                    <span>Empleados</span>
                </div>
                <span id="asi-empleados-count" class="asi-panel-count">0</span>
            </div>
            <div class="asi-list-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="asi-buscar-empleado" class="form-control" placeholder="Buscar empleado..." autocomplete="off" />
            </div>
            <div id="asi-empleados-list" class="asi-empleados-list"></div>
        </div>
        <div class="asi-split-right">
            <div id="asi-calendar-panel" class="asi-calendar-panel">
                <div class="asi-empty-state">
                    <div class="asi-empty-icon"><i class="fa-regular fa-calendar"></i></div>
                    <p>Selecciona un empleado de la lista para ver su calendario de asistencia.</p>
                </div>
            </div>
        </div>
    </div>

</div>

@* Modal Registrar Asistencia *@
<div class="modal fade" id="modal-nueva" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content modal-content-catalogo">
            <div class="modal-header-catalogo">
                <div class="modal-title-wrapper-catalogo">
                    <div>
                        <h5 class="modal-title-catalogo">Registrar Asistencia</h5>
                    </div>
                </div>
                <button type="button" class="close close-catalogo" data-dismiss="modal">&times;</button>
            </div>
            <form id="form-nueva">
                <div class="modal-body-catalogo">
                    <div class="form-card-catalogo">
                        <div class="row">
                            <div class="col-md-12 form-group-catalogo mb-3">
                                <label class="form-label-catalogo">Empleado *</label>
                                <select name="Emp_Id" class="form-control form-input-catalogo">
                                    <option value="">-- Seleccione Empleado --</option>
                                </select>
                            </div>
                            <div class="col-md-6 form-group-catalogo mb-3">
                                <label class="form-label-catalogo">Fecha *</label>
                                <input type="date" name="Fecha" class="form-control form-input-catalogo" />
                            </div>
                            <div class="col-md-6 form-group-catalogo mb-3">
                                <label class="form-label-catalogo">Tipo *</label>
                                <select name="Tipo" class="form-control form-input-catalogo">
                                    <option value="Presente">Presente</option>
                                    <option value="Ausente">Ausente</option>
                                    <option value="Permiso">Permiso</option>
                                    <option value="Tardanza">Tardanza</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer-catalogo">
                    <button type="button" class="btn-cancel-catalogo" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-save-catalogo">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    @{
        var jsPath = Server.MapPath("~/Content/js/pages/asistenciaempleados.js");
        var jsVer  = System.IO.File.Exists(jsPath)
                     ? System.IO.File.GetLastWriteTimeUtc(jsPath).Ticks.ToString()
                     : DateTime.UtcNow.Ticks.ToString();
    }
    <script src="~/Content/js/pages/asistenciaempleados.js?v=@jsVer"></script>
    <script>
        AsistenciaEmpleados.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("CreateAsync")",
            "@Url.Action("DropdownsAsync")"
        );
    </script>
}
