@{
    string pantallas = HttpContext.Current.Session["pantallas"] as string ?? "";
    var listaPantallas = pantallas.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                                  .Select(p => p.Trim())
                                  .ToList();
    Func<string, bool> tiene = (nombre) => listaPantallas.Contains(nombre, StringComparer.OrdinalIgnoreCase);

    string username        = HttpContext.Current.Session["Username"] as string ?? "Usuario";
    string roleName        = HttpContext.Current.Session["RoleName"] as string ?? "";
    string impersonandoRol = HttpContext.Current.Session["impersonando_rol"] as string ?? "";
    bool esAdmin = roleName.Equals("admin", StringComparison.OrdinalIgnoreCase);
    var nameParts   = username.Trim().Split(new[]{' '}, StringSplitOptions.RemoveEmptyEntries);
    string initials = nameParts.Length >= 2
        ? $"{nameParts[0][0]}{nameParts[1][0]}".ToUpper()
        : username.Length > 0 ? username[0].ToString().ToUpper() : "GC";
}

<div class="overlay"></div>
<div class="search-overlay"></div>

