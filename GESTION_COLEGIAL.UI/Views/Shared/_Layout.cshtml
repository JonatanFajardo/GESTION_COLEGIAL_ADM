@* ── MODAL DE AJUSTES (disponible en todas las páginas) ── *@
@{
    string _username = HttpContext.Current.Session["Username"] as string ?? "Usuario";
    string _roleName = HttpContext.Current.Session["RoleName"] as string ?? "";
    var _parts = _username.Trim().Split(new[]{' '}, StringSplitOptions.RemoveEmptyEntries);
    string _initials = _parts.Length >= 2
        ? $"{_parts[0][0]}{_parts[1][0]}".ToUpper()
        : _username.Length > 0 ? _username[0].ToString().ToUpper() : "GC";
}
<div class="modal fade" id="modal-ajustes" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <!-- Header -->
            <div class="ajustes-header">
                <div class="ajustes-user-wrap">
                    <div class="ajustes-avatar">@_initials</div>
                    <div>
                        <div class="ajustes-user-name">@_username</div>
                        <div class="ajustes-user-role">@_roleName</div>
                    </div>
                </div>
                <button class="ajustes-close-btn" data-dismiss="modal" aria-label="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>

            <!-- Body -->
            <div class="ajustes-body">
                <div class="ajustes-section-label">Apariencia</div>
                <span class="ajustes-item-label">Color de acento</span>
                <div class="ajustes-colors">
                    <button class="ajustes-color-btn" data-theme="" title="Amarillo">
                        <span class="ajustes-color-dot" style="background: linear-gradient(135deg, #F7A400, #f97316);"></span>
                        <span class="ajustes-color-label">Amarillo</span>
                        <span class="ajustes-check">
                            <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </button>
                    <button class="ajustes-color-btn" data-theme="gc-theme-blue" title="Azul">
                        <span class="ajustes-color-dot" style="background: linear-gradient(135deg, #1e293b, #0f4c81);"></span>
                        <span class="ajustes-color-label">Azul</span>
                        <span class="ajustes-check">
                            <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                    </button>
                </div>

                <!-- Dark mode toggle -->
                <div class="ajustes-toggle-row" style="margin-top:0.75rem;">
                    <span class="ajustes-toggle-label">Modo oscuro</span>
                    <label class="ajustes-toggle-switch">
                        <input type="checkbox" id="toggle-dark-mode">
                        <span class="ajustes-toggle-track"></span>
                    </label>
                </div>

                <!-- Interfaz -->
                <div class="ajustes-section-label" style="margin-top:1rem;">Interfaz</div>

                <!-- Sidebar compacto -->
                <div class="ajustes-toggle-row">
                    <span class="ajustes-toggle-label">Sidebar compacto</span>
                    <label class="ajustes-toggle-switch">
                        <input type="checkbox" id="toggle-sidebar-collapsed">
                        <span class="ajustes-toggle-track"></span>
                    </label>
                </div>

                <!-- Filas por página -->
                <div class="ajustes-row-between" style="margin-bottom:0.75rem;">
                    <span class="ajustes-item-label" style="margin-bottom:0;">Filas por página</span>
                    <div class="ajustes-segmented">
                        <button class="ajustes-seg-btn" data-page-length="10">10</button>
                        <button class="ajustes-seg-btn" data-page-length="25">25</button>
                        <button class="ajustes-seg-btn" data-page-length="50">50</button>
                    </div>
                </div>

                <!-- Densidad -->
                <div class="ajustes-row-between">
                    <span class="ajustes-item-label" style="margin-bottom:0;">Densidad</span>
                    <div class="ajustes-segmented">
                        <button class="ajustes-seg-btn" data-density="">Normal</button>
                        <button class="ajustes-seg-btn" data-density="compact">Compacto</button>
                    </div>
                </div>

                <!-- Regional -->
                <div class="ajustes-section-label" style="margin-top:1rem;">Regional</div>
                <div class="ajustes-row-between">
                    <span class="ajustes-item-label" style="margin-bottom:0;">Moneda</span>
                    <div class="ajustes-segmented">
                        <button class="ajustes-seg-btn" data-moneda="L" title="Lempira hondureño">L HNL</button>
                        <button class="ajustes-seg-btn" data-moneda="$" title="Dólar estadounidense">$ USD</button>
                        <button class="ajustes-seg-btn" data-moneda="Q" title="Quetzal guatemalteco">Q GTQ</button>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <hr class="ajustes-divider" />
            <div class="ajustes-footer">
                <a href="@Url.Action("LogOff", "Account")" class="ajustes-logout-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    Cerrar sesión
                </a>
            </div>
        </div>
    </div>
</div>
