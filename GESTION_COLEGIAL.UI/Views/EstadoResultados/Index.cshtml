@{
    ViewBag.Title = "Estado de Resultados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/financiero-analisis.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Estado de Resultados</li>
        </ol>
    </nav>
</div>

<div class="fan-wrapper">

    <!-- HEADER -->
    <div class="fan-header">
        <div class="fan-header-left">
            <div class="fan-header-icon"><i class="fa-solid fa-chart-line"></i></div>
            <div>
                <h2>Estado de Resultados</h2>
                <div class="fan-header-sub">Resumen de ingresos y egresos por período</div>
            </div>
        </div>
        <div class="fan-controls">
            <label for="f-anio">Año</label>
            <input type="number" id="f-anio" value="@ViewBag.AnioActual" min="2020" max="2030" />
            <label for="f-mes">Mes</label>
            <select id="f-mes">
                <option value="1"  @(ViewBag.MesActual == 1  ? "selected" : "")>Enero</option>
                <option value="2"  @(ViewBag.MesActual == 2  ? "selected" : "")>Febrero</option>
                <option value="3"  @(ViewBag.MesActual == 3  ? "selected" : "")>Marzo</option>
                <option value="4"  @(ViewBag.MesActual == 4  ? "selected" : "")>Abril</option>
                <option value="5"  @(ViewBag.MesActual == 5  ? "selected" : "")>Mayo</option>
                <option value="6"  @(ViewBag.MesActual == 6  ? "selected" : "")>Junio</option>
                <option value="7"  @(ViewBag.MesActual == 7  ? "selected" : "")>Julio</option>
                <option value="8"  @(ViewBag.MesActual == 8  ? "selected" : "")>Agosto</option>
                <option value="9"  @(ViewBag.MesActual == 9  ? "selected" : "")>Septiembre</option>
                <option value="10" @(ViewBag.MesActual == 10 ? "selected" : "")>Octubre</option>
                <option value="11" @(ViewBag.MesActual == 11 ? "selected" : "")>Noviembre</option>
                <option value="12" @(ViewBag.MesActual == 12 ? "selected" : "")>Diciembre</option>
            </select>
            <button class="btn-fan" id="btn-consultar">
                <i class="fa-solid fa-rotate"></i> Actualizar
            </button>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-3">
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-green fan-anim">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan green"><i class="fa-solid fa-arrow-trend-up"></i></div>
                </div>
                <div class="kpi-value-fan" id="er-kpi-ingresos">—</div>
                <div class="kpi-label-fan">Total Ingresos</div>
                <i class="fa-solid fa-chart-line kpi-icon-bg-fan"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-red fan-anim fan-anim-d1">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan red"><i class="fa-solid fa-arrow-trend-down"></i></div>
                </div>
                <div class="kpi-value-fan" id="er-kpi-egresos">—</div>
                <div class="kpi-label-fan">Total Egresos</div>
                <i class="fa-solid fa-receipt kpi-icon-bg-fan"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-teal fan-anim fan-anim-d2">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan teal"><i class="fa-solid fa-scale-balanced"></i></div>
                </div>
                <div class="kpi-value-fan" id="er-kpi-resultado">—</div>
                <div class="kpi-label-fan">Resultado Neto</div>
                <i class="fa-solid fa-balance-scale kpi-icon-bg-fan"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-indigo fan-anim fan-anim-d3">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan indigo"><i class="fa-solid fa-list-ol"></i></div>
                </div>
                <div class="kpi-value-fan" id="er-kpi-conceptos">—</div>
                <div class="kpi-label-fan">Conceptos</div>
                <i class="fa-solid fa-tags kpi-icon-bg-fan"></i>
            </div>
        </div>
    </div>

    <!-- GRÁFICA + TABLA -->
    <div class="row g-3">
        <div class="col-12 col-lg-5">
            <div class="fan-panel fan-anim fan-anim-d2" style="height:100%;">
                <div class="fan-section">
                    <div class="fan-section-accent" style="background:#14b8a6;"></div>
                    <span class="fan-section-label">Distribución</span>
                    <div class="fan-section-line"></div>
                </div>
                <div style="display:flex;justify-content:center;align-items:center;min-height:200px;">
                    <canvas id="er-chart" style="max-height:240px;max-width:240px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-7">
            <div class="fan-panel fan-anim fan-anim-d3">
                <div class="fan-section">
                    <div class="fan-section-accent" style="background:#6366f1;"></div>
                    <span class="fan-section-label">Detalle por Concepto</span>
                    <div class="fan-section-line"></div>
                </div>
                <div id="er-table-container">
                    <div class="fan-loading"><i class="fa-solid fa-spinner fa-spin me-2"></i>Cargando...</div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/estadorresultados.js"></script>
    <script>
        EstadoResultados.init("@Url.Action("GetAsync")", @ViewBag.AnioActual, @ViewBag.MesActual);
    </script>
}
