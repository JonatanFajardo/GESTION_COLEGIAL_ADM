@{
    ViewBag.Title = "Candidatos a graduación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Candidatos a graduación</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-text-catalogo">
                <h1>Candidatos a graduación</h1>
                <p>Alumnos del último curso de su nivel con la validación de notas y deuda.</p>
            </div>
        </div>
        <div class="header-action-catalogo">
            <button id="btn-graduar-seleccionados" class="btn btn-primary" disabled>
                <i class="bi bi-mortarboard-fill"></i> Graduar seleccionados
            </button>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="card-listado-catalogo" style="margin-bottom: 1rem;">
        <div class="card-body" style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
            <label for="nota-minima-input" style="margin:0; font-weight:500;">
                Nota mínima de aprobación:
            </label>
            <input type="number" id="nota-minima-input" class="form-control" min="0" max="100" step="1"
                   style="width:90px;" value="70" />
            <button id="btn-guardar-nota-minima" class="btn btn-outline-primary btn-sm" type="button">
                <i class="bi bi-save"></i> Guardar
            </button>
            <small id="nota-minima-status" style="color:#6c757d;"></small>
            <small style="color:#6c757d; margin-left:auto;">
                Cambia el umbral usado para evaluar las notas finales de los candidatos.
            </small>
        </div>
    </div>

    <div class="card-listado-catalogo">
        <div class="card-header-listado-catalogo">
            <h3>Listado de candidatos</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tbl-candidatos" class="table table-striped table-hover" style="width:100%">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="chk-all-candidatos" /></th>
                            <th>Alumno</th>
                            <th>Nivel</th>
                            <th>Curso</th>
                            <th>Sección</th>
                            <th>Notas</th>
                            <th>Deuda</th>
                            <th>Estado</th>
                            <th>Motivos de bloqueo</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/pages/graduacionalumnos.js"></script>
    <script>
        GraduacionAlumnos.init({
            listUrl:        '@Url.Action("ListCandidatosAsync")',
            graduarUrl:     '@Url.Action("GraduarAsync")',
            notaMinimaUrl:  '@Url.Action("NotaMinimaAsync")'
        });
    </script>
}
