@{
    ViewBag.Title = "Recursos de Horario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/pages/recursos-horario.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Recursos de Horario</li>
        </ol>
    </nav>
</div>

<!-- Hero -->
<div class="rh-hero">
    <div class="rh-hero-content">
        <div class="rh-hero-left">
            <div class="rh-hero-icon">
                <i class="bi bi-calendar-week"></i>
            </div>
            <div class="rh-hero-text">
                <h1>Recursos de Horario</h1>
                <p>Configure los recursos base necesarios para armar horarios semanales: aulas físicas, días laborables y bloques de hora</p>
            </div>
        </div>
        <div class="rh-hero-chips">
            <span class="rh-hero-chips-label">Recursos configurables</span>
            <div class="rh-hero-chips-chain">
                <span class="rh-hero-chip" data-jump="aulas"><i class="bi bi-door-open"></i> Aulas</span>
                <span class="rh-hero-chip" data-jump="dias"><i class="bi bi-calendar3"></i> Días</span>
                <span class="rh-hero-chip" data-jump="horas"><i class="bi bi-clock"></i> Horas</span>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">

    <!-- Accordion (3 secciones independientes, multi-abierto) -->
    <div class="rh-accordion" id="rh-accordion">

        <!-- ============================================================ -->
        <!-- 1. AULAS -->
        <!-- ============================================================ -->
        <section class="rh-section rh-section-aulas open" data-catalog="aulas">
            <header class="rh-section-header" role="button" tabindex="0" aria-expanded="true">
                <div class="rh-section-header-left">
                    <span class="rh-section-num">1</span>
                    <span class="rh-section-icon"><i class="bi bi-door-open"></i></span>
                    <div class="rh-section-titles">
                        <h3>Aulas</h3>
                        <p>Salones físicos disponibles para asignar a un horario.</p>
                    </div>
                </div>
                <div class="rh-section-header-right">
                    <span class="rh-section-count" data-count>—</span>
                    <span class="rh-section-chevron"><i class="bi bi-chevron-down"></i></span>
                </div>
            </header>
            <div class="rh-section-body">
                <div class="rh-mini-toolbar">
                    <div class="rh-search-wrap">
                        <i class="bi bi-search"></i>
                        <input type="text" class="rh-search" data-search="aulas" placeholder="Buscar aula..." />
                    </div>
                    <div class="rh-mini-actions">
                        <button type="button" class="rh-btn-ghost" data-reload="aulas" title="Recargar">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button type="button" class="rh-btn-primary" data-new="aulas">
                            <i class="bi bi-plus-lg"></i> Nueva Aula
                        </button>
                    </div>
                </div>
                <div class="rh-cards-grid" data-grid="aulas">
                    <!-- Cards inyectadas por JS -->
                </div>
                <div class="rh-empty" data-empty="aulas" hidden>
                    <div class="rh-empty-icon"><i class="bi bi-door-closed"></i></div>
                    <h4>Sin aulas registradas</h4>
                    <p>Todavía no hay aulas configuradas para asignar a horarios.</p>
                    <button type="button" class="rh-btn-primary" data-new="aulas">
                        <i class="bi bi-plus-lg"></i> Crear la primera
                    </button>
                </div>
            </div>
        </section>

        <!-- ============================================================ -->
        <!-- 2. DÍAS -->
        <!-- ============================================================ -->
        <section class="rh-section rh-section-dias" data-catalog="dias">
            <header class="rh-section-header" role="button" tabindex="0" aria-expanded="false">
                <div class="rh-section-header-left">
                    <span class="rh-section-num">2</span>
                    <span class="rh-section-icon"><i class="bi bi-calendar3"></i></span>
                    <div class="rh-section-titles">
                        <h3>Días</h3>
                        <p>Días laborables sobre los que se distribuye la semana académica.</p>
                    </div>
                </div>
                <div class="rh-section-header-right">
                    <span class="rh-section-count" data-count>—</span>
                    <span class="rh-section-chevron"><i class="bi bi-chevron-down"></i></span>
                </div>
            </header>
            <div class="rh-section-body">
                <div class="rh-mini-toolbar">
                    <div class="rh-search-wrap">
                        <i class="bi bi-search"></i>
                        <input type="text" class="rh-search" data-search="dias" placeholder="Buscar día..." />
                    </div>
                    <div class="rh-mini-actions">
                        <button type="button" class="rh-btn-ghost" data-reload="dias" title="Recargar">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button type="button" class="rh-btn-primary" data-new="dias">
                            <i class="bi bi-plus-lg"></i> Nuevo Día
                        </button>
                    </div>
                </div>
                <div class="rh-cards-grid" data-grid="dias"></div>
                <div class="rh-empty" data-empty="dias" hidden>
                    <div class="rh-empty-icon"><i class="bi bi-calendar-x"></i></div>
                    <h4>Sin días registrados</h4>
                    <p>Configure los días laborables antes de armar un horario semanal.</p>
                    <button type="button" class="rh-btn-primary" data-new="dias">
                        <i class="bi bi-plus-lg"></i> Crear el primero
                    </button>
                </div>
            </div>
        </section>

        <!-- ============================================================ -->
        <!-- 3. HORAS -->
        <!-- ============================================================ -->
        <section class="rh-section rh-section-horas" data-catalog="horas">
            <header class="rh-section-header" role="button" tabindex="0" aria-expanded="false">
                <div class="rh-section-header-left">
                    <span class="rh-section-num">3</span>
                    <span class="rh-section-icon"><i class="bi bi-clock"></i></span>
                    <div class="rh-section-titles">
                        <h3>Horas</h3>
                        <p>Bloques de hora usados como celdas del horario semanal.</p>
                    </div>
                </div>
                <div class="rh-section-header-right">
                    <span class="rh-section-count" data-count>—</span>
                    <span class="rh-section-chevron"><i class="bi bi-chevron-down"></i></span>
                </div>
            </header>
            <div class="rh-section-body">
                <div class="rh-mini-toolbar">
                    <div class="rh-search-wrap">
                        <i class="bi bi-search"></i>
                        <input type="text" class="rh-search" data-search="horas" placeholder="Buscar hora..." />
                    </div>
                    <div class="rh-mini-actions">
                        <button type="button" class="rh-btn-ghost" data-reload="horas" title="Recargar">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button type="button" class="rh-btn-primary" data-new="horas">
                            <i class="bi bi-plus-lg"></i> Nueva Hora
                        </button>
                    </div>
                </div>
                <div class="rh-cards-grid" data-grid="horas"></div>
                <div class="rh-empty" data-empty="horas" hidden>
                    <div class="rh-empty-icon"><i class="bi bi-clock-history"></i></div>
                    <h4>Sin horas registradas</h4>
                    <p>Configure los bloques de hora antes de armar un horario semanal.</p>
                    <button type="button" class="rh-btn-primary" data-new="horas">
                        <i class="bi bi-plus-lg"></i> Crear la primera
                    </button>
                </div>
            </div>
        </section>

    </div>

    <!-- ============================================================ -->
    <!-- Modal: Crear / Editar (genérico) -->
    <!-- ============================================================ -->
    <div class="modal fade" id="rh-edit-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content rh-modal-content">
                <div class="rh-modal-header">
                    <div class="rh-modal-header-icon"><i class="bi bi-pencil-square"></i></div>
                    <div class="rh-modal-header-text">
                        <h5 id="rh-edit-title">Nuevo registro</h5>
                        <p id="rh-edit-subtitle">Complete los datos del recurso</p>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="rh-edit-form" onsubmit="return false;">
                    <div class="rh-modal-body">
                        <input type="hidden" id="rh-edit-id" value="0" />

                        <!-- Campo texto simple (Aulas / Días) -->
                        <div class="rh-form-group" id="rh-edit-desc-wrap">
                            <label for="rh-edit-descripcion">
                                <i class="bi bi-card-text"></i>
                                <span id="rh-edit-desc-label">Descripción</span> <span class="rh-required">*</span>
                            </label>
                            <input type="text" id="rh-edit-descripcion" class="form-control" maxlength="50" required autocomplete="off" placeholder="Ej: Aula 101" />
                            <small class="rh-form-hint" id="rh-edit-desc-hint">Ingrese el nombre del recurso.</small>
                        </div>

                        <!-- Campo horario (sólo Horas) -->
                        <div class="rh-form-group" id="rh-edit-hora-wrap" hidden>
                            <label for="rh-edit-hora">
                                <i class="bi bi-clock"></i>
                                Hora <span class="rh-required">*</span>
                            </label>
                            <input type="time" id="rh-edit-hora" class="form-control" />
                            <small class="rh-form-hint">Bloque horario que se mostrará en el horario semanal.</small>
                        </div>
                    </div>
                    <div class="rh-modal-footer">
                        <button type="button" class="rh-btn-cancel" data-dismiss="modal">
                            <i class="bi bi-x-lg"></i> Cancelar
                        </button>
                        <button type="submit" class="rh-btn-save" id="rh-edit-save">
                            <i class="bi bi-check2"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- Modal: Detalle -->
    <!-- ============================================================ -->
    <div class="modal fade" id="rh-detail-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content rh-modal-content">
                <div class="rh-modal-header rh-modal-header-detail">
                    <div class="rh-modal-header-icon"><i class="bi bi-file-earmark-text"></i></div>
                    <div class="rh-modal-header-text">
                        <h5>Detalle del recurso</h5>
                        <p id="rh-detail-catalog-name">Recurso</p>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="rh-modal-body">
                    <div class="rh-detail-grid">
                        <div class="rh-detail-item">
                            <span class="rh-detail-label">ID</span>
                            <span class="rh-detail-value" id="rh-detail-id">—</span>
                        </div>
                        <div class="rh-detail-item rh-detail-item-wide">
                            <span class="rh-detail-label" id="rh-detail-descripcion-label">Descripción</span>
                            <span class="rh-detail-value" id="rh-detail-descripcion">—</span>
                        </div>
                    </div>

                    <div class="rh-audit">
                        <div class="rh-audit-title">
                            <i class="bi bi-clock-history"></i> Auditoría
                        </div>
                        <div class="rh-audit-row">
                            <div class="rh-audit-icon green"><i class="bi bi-person-plus"></i></div>
                            <div class="rh-audit-body">
                                <span class="rh-audit-label">Creado por</span>
                                <div><strong id="rh-detail-usuarioregistra">—</strong> <span class="rh-audit-date" id="rh-detail-fecharegistra">—</span></div>
                            </div>
                        </div>
                        <div class="rh-audit-row">
                            <div class="rh-audit-icon blue"><i class="bi bi-pencil-square"></i></div>
                            <div class="rh-audit-body">
                                <span class="rh-audit-label">Última modificación</span>
                                <div><strong id="rh-detail-usuariomodifica">—</strong> <span class="rh-audit-date" id="rh-detail-fechamodifica">—</span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="rh-modal-footer">
                    <button type="button" class="rh-btn-cancel" data-dismiss="modal">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- Modal: Eliminar -->
    <!-- ============================================================ -->
    <div class="modal fade" id="rh-delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 440px;">
            <div class="modal-content" style="border-radius: 12px; border: none;">
                <div class="modal-header" style="border-bottom: none; padding: 20px 24px 0;">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="padding: 0; margin: 0; opacity: 0.5;">
                        <span aria-hidden="true" style="font-size: 24px;">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center" style="padding: 0 40px 32px;">
                    <input type="hidden" id="rh-delete-id" value="0" />
                    <div class="d-flex justify-content-center mb-3">
                        <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            <div style="width: 56px; height: 56px; background-color: #dc2626; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-exclamation-triangle-fill" style="color: white; font-size: 28px;"></i>
                            </div>
                        </div>
                    </div>
                    <h5 class="mb-3" style="color: #1f2937; font-weight: 600; font-size: 20px;">Eliminar recurso</h5>
                    <p class="mb-4" style="color: #6b7280; font-size: 14px; line-height: 1.5;">
                        ¿Está seguro de que desea eliminar <span id="rh-delete-name" style="font-weight: 600; color:#1f2937;"></span> del recurso <span id="rh-delete-catalog" style="font-weight:600;"></span>?
                    </p>
                    <div class="alert d-flex align-items-start text-left" style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 16px; margin-bottom: 0;">
                        <div style="flex-shrink: 0; margin-right: 12px;">
                            <i class="bi bi-exclamation-triangle-fill" style="color: #dc2626; font-size: 18px;"></i>
                        </div>
                        <div style="flex: 1;">
                            <p class="mb-1" style="color: #991b1b; font-weight: 600; font-size: 13px; margin: 0;">Esta acción no se puede deshacer</p>
                            <p class="mb-0" style="color: #991b1b; font-size: 13px; margin: 0;">Si el recurso está en uso en algún horario, la eliminación fallará.</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: none; padding: 0 40px 32px; gap: 12px;">
                    <button type="button" class="btn" data-dismiss="modal" style="flex: 1; padding: 10px 24px; border-radius: 8px; font-weight: 500; background-color: #f3f4f6; border: 1px solid #d1d5db; color: #374151 !important; font-size: 14px;">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" id="rh-delete-confirm" style="flex: 1; padding: 10px 24px; border-radius: 8px; font-weight: 500; background-color: #dc2626; border: none; font-size: 14px;">
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/recursos-horario.js"></script>
}
