@{
    ViewBag.Title = "Historial de Transacciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/finanzas-dashboard.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Historial de Transacciones</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Historial de Transacciones</h1>
                <p>Registro completo de pagos realizados por rango de fechas</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">

    <div class="fd-filters">
        <div>
            <label for="input-alumno" class="form-label-catalogo">Alumno</label>
            <input type="text" id="input-alumno" class="form-control" placeholder="Nombre del alumno..." />
        </div>
        <div>
            <label for="input-fecha-desde" class="form-label-catalogo">Desde</label>
            <input type="date" id="input-fecha-desde" class="form-control" value="@ViewBag.FechaDesdeDefault" />
        </div>
        <div>
            <label for="input-fecha-hasta" class="form-label-catalogo">Hasta</label>
            <input type="date" id="input-fecha-hasta" class="form-control" value="@ViewBag.FechaHastaDefault" />
        </div>
        <button class="btn-fd" id="btn-buscar" type="button">
            <i class="fa-solid fa-magnifying-glass"></i> Consultar
        </button>
    </div>

    <div class="fd-hero">
        <div class="fd-hero-grid">
            <div class="fd-hero-main">
                <p class="fd-hero-label"><i class="fa-solid fa-clock-rotate-left"></i> Total recaudado en el período</p>
                <p class="fd-hero-value" id="hero-total">L. 0.00</p>
                <p class="fd-hero-sub" id="hero-rango">—</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">Transacciones</p>
                <p class="fd-hero-stat-value" id="hero-trans">0</p>
                <p class="fd-hero-stat-trend" id="hero-trans-sub">—</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">Día más activo</p>
                <p class="fd-hero-stat-value" id="hero-dia">—</p>
                <p class="fd-hero-stat-trend" id="hero-dia-sub">—</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">Promedio diario</p>
                <p class="fd-hero-stat-value" id="hero-prom-dia">L. 0.00</p>
                <p class="fd-hero-stat-trend" id="hero-prom-sub">—</p>
            </div>
        </div>
    </div>

    <div class="fd-kpi-row">
        <div class="fd-kpi kpi-emerald">
            <div class="fd-kpi-icon"><i class="fa-solid fa-arrow-trend-up"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Mayor pago</p>
                <p class="fd-kpi-value" id="kpi-mayor">L. 0.00</p>
                <p class="fd-kpi-foot" id="kpi-mayor-sub">—</p>
            </div>
        </div>
        <div class="fd-kpi kpi-indigo">
            <div class="fd-kpi-icon"><i class="fa-solid fa-calculator"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Ticket promedio</p>
                <p class="fd-kpi-value" id="kpi-prom">L. 0.00</p>
                <p class="fd-kpi-foot">por transacción</p>
            </div>
        </div>
        <div class="fd-kpi kpi-cyan">
            <div class="fd-kpi-icon"><i class="fa-solid fa-user-group"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Alumnos distintos</p>
                <p class="fd-kpi-value" id="kpi-alumnos">0</p>
                <p class="fd-kpi-foot" id="kpi-alumnos-sub">—</p>
            </div>
        </div>
        <div class="fd-kpi kpi-amber">
            <div class="fd-kpi-icon"><i class="fa-solid fa-user-tie"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Cajeros activos</p>
                <p class="fd-kpi-value" id="kpi-cajeros">0</p>
                <p class="fd-kpi-foot" id="kpi-cajeros-sub">—</p>
            </div>
        </div>
    </div>

    <div class="fd-grid-3">
        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-chart-column"></i> Tendencia diaria</p>
                    <p class="fd-panel-sub">Monto recaudado por día</p>
                </div>
            </div>
            <div class="fd-panel-body">
                <div class="fd-cols" id="cols-dia"></div>
            </div>
        </div>

        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-credit-card"></i> Formas de pago</p>
                    <p class="fd-panel-sub">Participación del período</p>
                </div>
            </div>
            <div class="fd-panel-body">
                <div class="fd-donut-wrap">
                    <div class="fd-donut" id="donut-formas">
                        <div class="fd-donut-inner">
                            <strong id="donut-num">0</strong>
                            <small>Trans.</small>
                        </div>
                    </div>
                    <div class="fd-donut-legend" id="donut-legend"></div>
                </div>
            </div>
        </div>

        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-user-tie"></i> Top cajeros</p>
                    <p class="fd-panel-sub">Por monto procesado</p>
                </div>
            </div>
            <div class="fd-panel-body fd-flush" id="rank-cajeros"></div>
        </div>
    </div>

    <div class="fd-panel">
        <div class="fd-panel-head">
            <div>
                <p class="fd-panel-title"><i class="fa-solid fa-list-check"></i> Movimientos del período</p>
                <p class="fd-panel-sub">Detalle ordenado por fecha descendente</p>
            </div>
            <span class="fd-chip" id="chip-count">0 transacciones</span>
        </div>
        <div class="fd-panel-body fd-flush fd-scroll" id="feed-trans"></div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/historialtransacciones.js"></script>
    <script>
        HistorialTransacciones.init(
            "@Url.Action("ListAsync")",
            "@ViewBag.FechaDesdeDefault",
            "@ViewBag.FechaHastaDefault"
        );
    </script>
}
