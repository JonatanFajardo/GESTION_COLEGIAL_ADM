@{
    ViewBag.Title = "Organigrama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/organigrama.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Organigrama</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-sitemap"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Organigrama Institucional</h1>
                <p>Estructura jer&aacute;rquica del personal por departamento</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">

    <div class="org-stats">
        <div class="org-stat">
            <div class="stat-icon">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <div class="stat-value" id="stat-empleados">&mdash;</div>
                <div class="stat-label">Total Empleados</div>
            </div>
        </div>
        <div class="org-stat">
            <div class="stat-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <div>
                <div class="stat-value" id="stat-departamentos">&mdash;</div>
                <div class="stat-label">Departamentos</div>
            </div>
        </div>
        <div class="org-stat">
            <div class="stat-icon">
                <i class="fa-solid fa-id-badge"></i>
            </div>
            <div>
                <div class="stat-value" id="stat-cargos">&mdash;</div>
                <div class="stat-label">Cargos Distintos</div>
            </div>
        </div>
    </div>

    <div class="org-toolbar">
        <div class="org-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text"
                   id="org-search-input"
                   placeholder="Buscar empleado o cargo..."
                   autocomplete="off" />
        </div>
        <div class="org-tree-controls hidden" id="org-tree-controls">
            <button type="button" class="btn-org" id="btn-expand-all">
                <i class="fa-solid fa-maximize"></i>
                Expandir todo
            </button>
            <button type="button" class="btn-org" id="btn-collapse-all">
                <i class="fa-solid fa-minimize"></i>
                Colapsar todo
            </button>
        </div>
        <div class="org-view-toggle">
            <button type="button" class="btn-view-mode" id="btn-mode-tree" title="Vista &aacute;rbol jer&aacute;rquico">
                <i class="fa-solid fa-sitemap"></i>
            </button>
            <button type="button" class="btn-view-mode" id="btn-mode-grid" title="Vista directorio">
                <i class="fa-solid fa-grip"></i>
            </button>
        </div>
    </div>

    <div class="org-chart">
        <div id="org-chart-container">
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/organigrama.js"></script>
    <script>
        Organigrama.init("@Url.Action("GetAsync")");
    </script>
}
