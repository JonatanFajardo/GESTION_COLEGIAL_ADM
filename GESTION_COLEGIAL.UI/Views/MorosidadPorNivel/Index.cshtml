@{
    ViewBag.Title = "Morosidad por Nivel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Morosidad por Nivel</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-chart-bar" style="font-size:32px;"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Morosidad por Nivel</h1>
                <p>Morosidad agrupada por nivel educativo</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="card-listado-catalogo">
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="datatable-morosidadpornivel">
                    <thead><tr><th>Nivel</th><th>Alumnos</th><th>Pendiente</th></tr></thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/morosidadpornivel.js"></script>
    <script>
        MorosidadPorNivel.init("@Url.Action("ListAsync")");
    </script>
}
