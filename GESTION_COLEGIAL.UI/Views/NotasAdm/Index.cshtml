@{
    ViewBag.Title = "Notas y Boletín";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/notas-boletin.css" rel="stylesheet" />
}
<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Notas y Boletín</li>
        </ol>
    </nav>
</div>

<!-- Hero -->
<div class="nb-hero">
    <div class="nb-hero-content">
        <div class="nb-hero-icon"><i class="bi bi-journal-check"></i></div>
        <div class="nb-hero-text">
            <h1>Notas y Boletín</h1>
            <p>Capture las notas por horario y parcial, y consulte el boletín completo por alumno</p>
        </div>
    </div>
</div>

<div class="fluid-container">

    <!-- Tabs -->
    <div class="nb-tabs-card">
        <ul class="nav nb-tabs" role="tablist" id="nb-tabs">
            <li class="nav-item nb-tab-item active" data-tab="cuaderno">
                <a href="#" class="nb-tab-link">
                    <span class="nb-tab-num">1</span>
                    <span class="nb-tab-icon"><i class="bi bi-pencil-square"></i></span>
                    <span class="nb-tab-label">Cuaderno de Notas</span>
                </a>
            </li>
            <li class="nav-item nb-tab-item" data-tab="boletin">
                <a href="#" class="nb-tab-link">
                    <span class="nb-tab-num">2</span>
                    <span class="nb-tab-icon"><i class="bi bi-file-earmark-text"></i></span>
                    <span class="nb-tab-label">Boletín</span>
                </a>
            </li>
        </ul>
    </div>

    <!-- ============================================ -->
    <!-- Tab 1: Cuaderno de Notas (captura)            -->
    <!-- ============================================ -->
    <div class="nb-tab-panel" id="nb-panel-cuaderno">
        <div class="nb-panel-info">
            <div class="nb-info-icon"><i class="bi bi-info-circle-fill"></i></div>
            <div class="nb-info-text">
                <strong>Captura de notas</strong>
                <span>Seleccione el horario y el parcial para ingresar o corregir las notas de los alumnos.</span>
            </div>
        </div>
        <div class="card mb-3 p-3">
            <div class="row g-2">
                <div class="col-md-5">
                    <select id="f-hor" class="form-control">
                        <option value="">-- Seleccione Horario --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="f-par" class="form-control">
                        <option value="">-- Seleccione Parcial --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" id="btn-cargar">
                        <i class="fa-solid fa-magnifying-glass"></i> Cargar
                    </button>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-success w-100" id="btn-guardar-todo">
                        <i class="bi bi-check2-all"></i> Guardar Todo
                    </button>
                </div>
            </div>
        </div>
        <div class="card-listado-catalogo">
            <div class="card-body-listado-catalogo">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered" id="tabla-notas">
                        <thead><tr><th>Alumno</th><th style="width:150px;">Nota</th><th style="width:100px;">Guardar</th></tr></thead>
                        <tbody id="tbody-notas"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- Tab 2: Boletín (consulta)                     -->
    <!-- ============================================ -->
    <div class="nb-tab-panel" id="nb-panel-boletin" hidden>
        <div class="nb-panel-info">
            <div class="nb-info-icon"><i class="bi bi-info-circle-fill"></i></div>
            <div class="nb-info-text">
                <strong>Boletín de calificaciones</strong>
                <span>Consulte el boletín completo de notas por alumno y año. Las notas bajo la nota mínima de aprobación se resaltan en rojo.</span>
            </div>
        </div>
        <div class="card mb-3 p-3">
            <div class="row g-2">
                <div class="col-md-6">
                    <select id="f-alu" class="form-control"><option value="">-- Seleccione Alumno --</option></select>
                </div>
                <div class="col-md-3">
                    <input type="number" id="f-anio" class="form-control" placeholder="Año" step="1" value="@DateTime.Now.Year">
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary w-100" id="btn-ver">
                        <i class="fa-solid fa-magnifying-glass"></i> Ver Boletín
                    </button>
                </div>
            </div>
        </div>
        <div class="card-listado-catalogo" id="panel-boletin" style="display:none;">
            <div class="card-body-listado-catalogo">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered" id="tabla-boletin">
                        <thead>
                            <tr id="thead-boletin">
                                <!-- Columnas generadas dinámicamente según el catálogo de Parciales -->
                            </tr>
                        </thead>
                        <tbody id="tbody-boletin"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/notasadm.js"></script>
    <script>
        NotasAdm.init({
            urlList:          "@Url.Action("ListAsync", "NotasAdm")",
            urlGuardar:       "@Url.Action("GuardarNota", "NotasAdm")",
            urlDropdowns:     "@Url.Action("DropdownsAsync", "NotasAdm")",
            urlBoletinGet:    "@Url.Action("GetAsync", "BoletinAdm")",
            urlBoletinDrops:  "@Url.Action("DropdownsAsync", "BoletinAdm")",
            urlNotaMinima:    "@Url.Action("NotaMinimaAsync", "GraduacionAlumnos")"
        });
    </script>
}
