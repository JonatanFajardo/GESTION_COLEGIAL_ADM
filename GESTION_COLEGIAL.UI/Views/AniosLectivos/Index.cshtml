@model GESTION_COLEGIAL.Business.Models.AnioLectivoViewModel

@{
    ViewBag.Title = "Años Lectivos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/modal-detail.css" rel="stylesheet" />
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/modal-catalogos.css" rel="stylesheet" />
    <style>
        .badge-estado { padding: .35em .7em; border-radius: 999px; font-size: .75rem; font-weight: 600; color: #fff; }
        .est-1 { background:#9ca3af; } .est-2 { background:#6366f1; } .est-3 { background:#10b981; }
        .est-4 { background:#f59e0b; } .est-5 { background:#ef4444; } .est-6 { background:#4b5563; }
        .badge-actual { background:#4f46e5; color:#fff; padding:.35em .7em; border-radius:999px; font-size:.75rem; font-weight:600; }
        .btn-activar { background:#eef2ff; color:#4f46e5; border:1px solid #c7d2fe; border-radius:8px; padding:.25rem .6rem; font-size:.75rem; font-weight:600; cursor:pointer; }
        .btn-activar:hover { background:#4f46e5; color:#fff; }
        .btn-accion { border:none; background:transparent; cursor:pointer; padding:.25rem .4rem; font-size:1rem; }
        .btn-accion.edit { color:#2563eb; } .btn-accion.del { color:#dc2626; }
    </style>
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Años Lectivos</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo"><i class="fas fa-calendar-alt" style="font-size:28px;"></i></div>
            <div class="header-text-catalogo">
                <h1>Años Lectivos</h1>
                <p>Administre los años lectivos del colegio y seleccione el año de trabajo activo</p>
            </div>
        </div>
        <div class="header-action-catalogo">
            <a class="btn-nuevo-catalogo" href="@Url.Action("Setup")">
                <i class="fas fa-plus-circle"></i> Nuevo Año Lectivo
            </a>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="card-listado-catalogo">
        <div class="card-header-listado-catalogo">
            <h3><i class="fas fa-list"></i> Listado de Años Lectivos</h3>
        </div>
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="datatable" style="width:100%">
                    <thead>
                        <tr>
                            <th>Año</th><th>Nombre</th><th>Inicio</th><th>Fin</th>
                            <th>Estado</th><th>Año activo</th><th>Acciones</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Eliminar -->
    <div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document" style="max-width:440px;">
            @using (Ajax.BeginForm("DeleteAsync", "AniosLectivos", new AjaxOptions
            {
                HttpMethod = "Post",
                OnSuccess = "AniosLectivos.onDeleteSuccess",
                OnFailure = "AniosLectivos.onError"
            }, new { id = "form-delete" }))
            {
                <div class="modal-content" style="border-radius:12px;border:none;">
                    <div class="modal-header" style="border-bottom:none;padding:20px 24px 0;">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="opacity:.5;"><span aria-hidden="true" style="font-size:24px;">&times;</span></button>
                    </div>
                    <div class="modal-body text-center" style="padding:0 40px 32px;">
                        <input type="hidden" name="Ani_Id" id="delete-item-id" />
                        <div class="d-flex justify-content-center mb-3">
                            <div style="width:80px;height:80px;background:linear-gradient(135deg,#fee2e2,#fecaca);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                                <div style="width:56px;height:56px;background:#dc2626;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                                    <i class="fas fa-exclamation-triangle" style="color:#fff;font-size:28px;"></i>
                                </div>
                            </div>
                        </div>
                        <h5 class="mb-3" style="color:#1f2937;font-weight:600;">Eliminar año lectivo</h5>
                        <p class="mb-4" style="color:#6b7280;font-size:14px;">¿Está seguro de eliminar el año <span id="delete-item-name" style="font-weight:600;"></span>?</p>
                        <div class="alert text-left" style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:16px;">
                            <p class="mb-0" style="color:#991b1b;font-size:13px;">Esta acción es una baja lógica; el registro deja de listarse.</p>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:none;padding:0 40px 32px;gap:12px;">
                        <button type="button" class="btn" data-dismiss="modal" style="flex:1;padding:10px;border-radius:8px;background:#f3f4f6;border:1px solid #d1d5db;color:#374151;">Cancelar</button>
                        <button type="submit" class="btn btn-danger" style="flex:1;padding:10px;border-radius:8px;background:#dc2626;border:none;">Eliminar</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts{
    <script>
        var AniosLectivos = (function () {
            var table;
            var urls = {
                list: "@Url.Action("ListAsync")",
                setup: "@Url.Action("Setup")",
                setActivo: "@Url.Action("SetActivoAsync")"
            };

            function notify(type, msg) {
                if (!msg) msg = (type === "error" ? "Ocurrió un error." : "Operación exitosa.");
                try { if (window.toastr) { toastr[type === "error" ? "error" : "success"](msg); return; } } catch (e) {}
                try { if (window.Swal) { Swal.fire({ icon: type === "error" ? "error" : "success", title: msg, timer: 2000, showConfirmButton: false }); return; } } catch (e) {}
            }
            function fdate(v) { return v ? String(v).substring(0, 10) : "—"; }
            function reload() { if (table) table.ajax.reload(null, false); }

            function init() {
                table = $("#datatable").DataTable({
                    ajax: { url: urls.list, dataSrc: "data" },
                    language: { url: "//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json" },
                    order: [[0, "desc"]],
                    columns: [
                        { data: "Ani_Anio" },
                        { data: "Ani_Nombre" },
                        { data: "Ani_FechaInicio", render: fdate },
                        { data: "Ani_FechaFin", render: fdate },
                        { data: null, orderable: false, render: function (r) { return '<span class="badge-estado est-' + r.Ani_Estado + '">' + (r.Ani_EstadoDescripcion || "") + '</span>'; } },
                        { data: null, orderable: false, render: function (r) { return r.Ani_EsActual ? '<span class="badge-actual"><i class="fas fa-check"></i> Activo</span>' : '<button type="button" class="btn-activar" data-id="' + r.Ani_Id + '">Marcar activo</button>'; } },
                        { data: null, orderable: false, render: function (r) {
                            return '<button type="button" class="btn-accion edit" data-id="' + r.Ani_Id + '" title="Configurar / editar"><i class="fas fa-pen"></i></button>' +
                                   '<button type="button" class="btn-accion del" data-id="' + r.Ani_Id + '" data-name="' + r.Ani_Nombre + '" title="Eliminar"><i class="fas fa-trash"></i></button>';
                        } }
                    ]
                });

                $("#datatable tbody").on("click", ".btn-activar", function () { setActivo($(this).data("id")); });
                $("#datatable tbody").on("click", ".btn-accion.edit", function () { window.location.href = urls.setup + "?id=" + $(this).data("id"); });
                $("#datatable tbody").on("click", ".btn-accion.del", function () {
                    $("#delete-item-id").val($(this).data("id"));
                    $("#delete-item-name").text($(this).data("name"));
                    $("#delete-modal").modal("show");
                });
            }

            function setActivo(id) {
                $.post(urls.setActivo, { id: id })
                    .done(function (resp) { notify(resp && resp.success === false ? "error" : "success", resp && resp.message); reload(); })
                    .fail(function () { notify("error"); });
            }
            function onDeleteSuccess(resp) {
                if (resp && resp.success === false) { notify("error", resp.message); return; }
                $("#delete-modal").modal("hide"); notify("success", resp && resp.message); reload();
            }
            function onError() { notify("error"); }

            return { init: init, onDeleteSuccess: onDeleteSuccess, onError: onError };
        })();

        $(function () { AniosLectivos.init(); });
    </script>
}
