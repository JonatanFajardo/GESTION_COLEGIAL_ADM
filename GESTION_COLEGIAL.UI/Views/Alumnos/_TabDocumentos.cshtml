@using Newtonsoft.Json.Linq
@{
    Layout = null;
    var docs = Model as System.Collections.Generic.List<dynamic>;

    // Helpers defensivos para leer campos desde JObject o anónimos.
    Func<dynamic, string, string> getStr = (d, key) =>
    {
        if (d == null) return null;
        try
        {
            var jo = d as JObject;
            if (jo != null)
            {
                JToken tok;
                if (jo.TryGetValue(key, StringComparison.OrdinalIgnoreCase, out tok))
                {
                    if (tok == null || tok.Type == JTokenType.Null) return null;
                    return tok.ToString();
                }
                return null;
            }
            var prop = ((object)d).GetType().GetProperty(key);
            if (prop == null) return null;
            var val = prop.GetValue(d, null);
            return val == null ? null : val.ToString();
        }
        catch { return null; }
    };

    Func<string, string> fmtFecha = (raw) =>
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        DateTime dt;
        if (DateTime.TryParse(raw, out dt)) return dt.ToString("dd/MM/yyyy");
        return raw;
    };

    Func<string, string> norm = (s) => (s ?? "").Trim().ToLowerInvariant();
}

@if (docs == null || !docs.Any())
{
    <div class="af-section-card text-center py-5">
        <div class="af-empty">
            <i class="bi bi-inbox" style="font-size:42px;color:#94a3b8;"></i>
            <p class="text-muted mt-2 mb-3">Sin documentos registrados para este alumno.</p>
            <a href="/DocumentosAlumnoAdm" class="af-btn-link">
                Gestionar documentos <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    return;
}

@{
    int total = docs.Count;
    int subidos = 0;
    foreach (var d in docs)
    {
        var est = norm(getStr(d, "Doc_Estado"));
        if (est == "entregado" || est == "subido" || est == "aprobado") subidos++;
    }
    int porcentaje = total > 0 ? (int)Math.Round((subidos / (double)total) * 100) : 0;
}

<div class="af-section-card">
    <div class="af-section-header">
        <h5 class="mb-0"><i class="bi bi-file-earmark-check me-2"></i>Documentos requeridos</h5>
        <span class="text-muted small">@subidos de @total completos</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:60px;">Estado</th>
                    <th>Documento</th>
                    <th style="width:140px;">Fecha subida</th>
                    <th style="width:200px;">Observación</th>
                    <th style="width:140px;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in docs)
                {
                    var nombre = getStr(d, "Doc_Nombre") ?? "(Sin nombre)";
                    var estadoRaw = getStr(d, "Doc_Estado");
                    var estado = norm(estadoRaw);
                    var obs = getStr(d, "Doc_Observacion");
                    var fechaRaw = getStr(d, "Doc_FechaEntrega") ?? getStr(d, "Doc_Fecha") ?? getStr(d, "Doc_FechaSubida");
                    var fecha = fmtFecha(fechaRaw);
                    var esEntregado = (estado == "entregado" || estado == "subido" || estado == "aprobado");
                    var esRechazado = (estado == "rechazado");

                    <tr>
                        <td>
                            @if (esEntregado)
                            {
                                <span class="badge" style="background-color:#10b981;color:#fff;" title="@(estadoRaw ?? "Entregado")">
                                    <i class="bi bi-check-lg"></i>
                                </span>
                            }
                            else if (esRechazado)
                            {
                                <span class="badge" style="background-color:#ef4444;color:#fff;" title="Rechazado">
                                    <i class="bi bi-x-lg"></i>
                                </span>
                            }
                            else
                            {
                                <span class="badge" style="background-color:#f59e0b;color:#fff;" title="Pendiente">
                                    <i class="bi bi-exclamation-triangle"></i>
                                </span>
                            }
                        </td>
                        <td>@nombre</td>
                        <td class="text-muted small">@(fecha ?? "—")</td>
                        <td class="text-muted small">@(string.IsNullOrWhiteSpace(obs) ? "—" : obs)</td>
                        <td class="text-end">
                            @if (esEntregado)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" title="Descargar">
                                    <i class="bi bi-download"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="af-section-card mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <strong>@subidos de @total documentos completos</strong>
        <span class="text-muted">@porcentaje%</span>
    </div>
    <div class="progress" style="height:10px;">
        <div class="progress-bar" role="progressbar"
             style="width:@(porcentaje)%;background-color:#4f46e5;"
             aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
    <div class="text-end mt-3">
        <a href="/DocumentosAlumnoAdm" class="af-btn-link">
            Gestionar documentos <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>
