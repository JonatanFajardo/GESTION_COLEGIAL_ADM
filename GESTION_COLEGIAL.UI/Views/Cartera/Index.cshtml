@{
    ViewBag.Title = "Cartera";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/modal-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/finanzas-dashboard.css" rel="stylesheet" />
    <link href="~/Content/css/pages/kpisacademicos.css" rel="stylesheet" />
    <style>
        /* Botón "Registrar pago" en filas del hub */
        .cartera-btn-pago {
            display: inline-flex; align-items: center; gap: 5px;
            background: #fff; color: #059669; border: 1px solid #059669;
            border-radius: 8px; padding: 5px 12px; font-size: .78rem; font-weight: 600;
            cursor: pointer; text-decoration: none; white-space: nowrap; transition: background .15s, color .15s;
        }
        .cartera-btn-pago:hover { background: #059669; color: #fff; text-decoration: none; }

        /* Modal solicitar cobro */
        .sc-scope-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
        .sc-scope {
            border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 12px; cursor: pointer;
            text-align: center; transition: border-color .15s, background .15s;
        }
        .sc-scope:hover { border-color: #c7d2fe; }
        .sc-scope.active { border-color: #4f46e5; background: #eef2ff; }
        .sc-scope-num { font-size: 1.5rem; font-weight: 800; color: #0f172a; line-height: 1; }
        .sc-scope-lbl { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; color: #64748b; margin-top: 5px; }
        .sc-scope-monto { font-size: .74rem; color: #4338ca; font-weight: 600; margin-top: 3px; }
        .sc-preview {
            background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;
            padding: 14px 16px; font-size: .84rem; color: #334155; line-height: 1.55; white-space: pre-wrap;
        }
        .sc-preview-head { font-size: .7rem; text-transform: uppercase; letter-spacing: .5px; color: #94a3b8; font-weight: 700; margin-bottom: 6px; }
        .sc-sim-note { font-size: .78rem; color: #92400e; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 8px 11px; margin-top: 12px; }
        .sc-result { text-align: center; padding: 10px 0; }
        .sc-result-icon { font-size: 3rem; color: #059669; }

        /* Drill-down curso → sección → alumno */
        .cartera-drill { width: 100%; }
        .drill-row {
            display: grid; grid-template-columns: minmax(0,1fr) 130px 120px 130px;
            align-items: center; gap: 8px; padding: 10px 16px;
            border-bottom: 1px solid #f1f5f9; font-size: .86rem;
        }
        .drill-head { background: #f8fafc; font-size: .68rem; text-transform: uppercase; letter-spacing: .5px; color: #94a3b8; font-weight: 700; }
        .drill-row[data-exp] { cursor: pointer; }
        .drill-row[data-exp]:hover { background: #f8fafc; }
        .drill-name { display: flex; align-items: center; gap: 8px; font-weight: 600; color: #1e293b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .drill-caret { font-size: .7rem; color: #94a3b8; transition: transform .15s; flex-shrink: 0; }
        .drill-row.open > .drill-name > .drill-caret { transform: rotate(90deg); }
        .drill-metric { text-align: right; font-variant-numeric: tabular-nums; color: #334155; }
        .drill-count { color: #64748b; }
        .drill-venc { color: #dc2626; font-weight: 600; }
        .lvl0 .drill-name { font-weight: 700; }
        .lvl1 { background: #fcfcfd; }
        .lvl1 .drill-name { padding-left: 20px; }
        .lvl2 { background: #fff; }
        .lvl2 .drill-name { padding-left: 44px; font-weight: 500; color: #334155; }
        .drill-dias { color: #64748b; font-size: .78rem; }
        .drill-dias.venc { color: #dc2626; font-weight: 600; }
        .drill-actions { display: flex; gap: 6px; justify-content: flex-end; }
        .cartera-btn-ec {
            display: inline-flex; align-items: center; justify-content: center;
            width: 30px; height: 30px; border: 1px solid #cbd5e1; border-radius: 8px;
            color: #475569; text-decoration: none; transition: background .15s, color .15s;
        }
        .cartera-btn-ec:hover { background: #475569; color: #fff; }
        .cartera-btn-pago-mini { color: #059669; border-color: #059669; }
        .cartera-btn-pago-mini:hover { background: #059669; color: #fff; }
    </style>
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="javascript:void(0);">Módulo Financiero</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cartera</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-hand-holding-dollar" style="font-size:32px;"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Cartera</h1>
                <p>Panorama unificado de la deuda: antigüedad, morosidad por nivel, mayores deudores y cuentas pendientes</p>
            </div>
        </div>
        <div class="header-action-catalogo">
            <button type="button" class="btn-nuevo-catalogo" id="cartera-btn-solicitar">
                <i class="fa-solid fa-paper-plane"></i> Solicitar cobro
            </button>
        </div>
    </div>
</div>

<div class="fluid-container">

    <!-- ══════════ KPIs / HERO — datos de /PendientesCobrar/ListAsync ══════════ -->
    <div class="fd-hero">
        <div class="fd-hero-grid">
            <div class="fd-hero-main">
                <p class="fd-hero-label"><i class="fa-solid fa-file-invoice-dollar"></i> Total por cobrar</p>
                <p class="fd-hero-value" id="cartera-kpi-total">L. 0.00</p>
                <p class="fd-hero-sub" id="cartera-kpi-total-sub">—</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">Vencido</p>
                <p class="fd-hero-stat-value" id="cartera-kpi-vencido">L. 0.00</p>
                <p class="fd-hero-stat-trend" id="cartera-kpi-vencido-sub">—</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">% Recuperación</p>
                <p class="fd-hero-stat-value" id="cartera-kpi-recuperacion">0%</p>
                <p class="fd-hero-stat-trend">pagado sobre lo emitido</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">Alumnos deudores</p>
                <p class="fd-hero-stat-value" id="cartera-kpi-alumnos">0</p>
                <p class="fd-hero-stat-trend" id="cartera-kpi-alumnos-sub">—</p>
            </div>
        </div>
    </div>

    <!-- ══════════ Tabs ══════════ -->
    <div class="aa-tabs-card mb-4">
        <ul class="nav aa-tabs" id="cartera-tabs" role="tablist">
            <li class="aa-tab-item active" data-tab="nivel">
                <a href="#" class="aa-tab-link">
                    <span class="aa-tab-icon"><i class="fa-solid fa-chart-bar"></i></span>
                    <span class="aa-tab-label">Por Nivel</span>
                </a>
            </li>
            <li class="aa-tab-item" data-tab="aging">
                <a href="#" class="aa-tab-link">
                    <span class="aa-tab-icon"><i class="fa-solid fa-clock-rotate-left"></i></span>
                    <span class="aa-tab-label">Antigüedad de saldos</span>
                </a>
            </li>
            <li class="aa-tab-item" data-tab="top">
                <a href="#" class="aa-tab-link">
                    <span class="aa-tab-icon"><i class="fa-solid fa-ranking-star"></i></span>
                    <span class="aa-tab-label">Top Deudores</span>
                </a>
            </li>
            <li class="aa-tab-item" data-tab="pend">
                <a href="#" class="aa-tab-link">
                    <span class="aa-tab-icon"><i class="fa-solid fa-list-check"></i></span>
                    <span class="aa-tab-label">Pendientes</span>
                </a>
            </li>
        </ul>
    </div>

    <!-- ══════════ TAB 1: Resumen / Aging — /AgingCuentas/ListAsync ══════════ -->
    <div id="tab-aging" class="aa-tab-panel" style="display:none">
        <div class="fd-panel" style="margin-bottom:1.25rem;">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-hourglass-half"></i> Antigüedad de saldos</p>
                    <p class="fd-panel-sub">Saldo pendiente agrupado por tramo de vencimiento</p>
                </div>
                <span class="fd-chip" id="cartera-aging-chip">—</span>
            </div>
            <div class="fd-panel-body">
                <div class="fd-aging-row" id="cartera-aging-row"></div>
            </div>
        </div>

        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-table-list"></i> Detalle por alumno y tramo</p>
                    <p class="fd-panel-sub">Origen: Aging de Cuentas por Cobrar</p>
                </div>
            </div>
            <div class="fd-panel-body fd-flush fd-scroll">
                <table class="table table-striped mb-0" id="cartera-aging-table">
                    <thead>
                        <tr>
                            <th>Alumno</th>
                            <th>Tramo</th>
                            <th class="text-right">Monto</th>
                            <th class="text-right">Días</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ══════════ TAB 2: Drill-down Curso → Sección → Alumnos (desde PendientesCobrar) ══════════ -->
    <div id="tab-nivel" class="aa-tab-panel">
        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-layer-group"></i> Deuda por curso y sección</p>
                    <p class="fd-panel-sub">Clic en una fila para desglosar: curso → sección → alumnos</p>
                </div>
                <span class="fd-chip" id="cartera-drill-chip">—</span>
            </div>
            <div class="fd-panel-body fd-flush fd-scroll">
                <div id="cartera-drill" class="cartera-drill"></div>
            </div>
        </div>
    </div>

    <!-- ══════════ TAB 3: Top Deudores — /TopDeudores/ListAsync ══════════ -->
    <div id="tab-top" class="aa-tab-panel" style="display:none">
        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-ranking-star"></i> Alumnos con mayor deuda</p>
                    <p class="fd-panel-sub">Ordenado por deuda total acumulada</p>
                </div>
                <span class="fd-chip" id="cartera-top-chip">0 alumnos</span>
            </div>
            <div class="fd-panel-body fd-flush" id="cartera-top-rank"></div>
        </div>
    </div>

    <!-- ══════════ TAB 4: Pendientes — /PendientesCobrar/ListAsync ══════════ -->
    <div id="tab-pend" class="aa-tab-panel" style="display:none">

        <div class="fd-filters" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
            <div>
                <label for="cartera-pend-buscar" class="form-label-catalogo">Buscar alumno o concepto</label>
                <input type="text" id="cartera-pend-buscar" class="form-control" placeholder="Escriba para filtrar..." />
            </div>
            <div>
                <label for="cartera-pend-estado" class="form-label-catalogo">Estado</label>
                <select id="cartera-pend-estado" class="form-control">
                    <option value="">Todos los estados</option>
                    <option value="vencido">Solo vencidos</option>
                    <option value="hoy">Vencen hoy</option>
                    <option value="proximo">Próximos a vencer</option>
                </select>
            </div>
            <div>
                <label for="cartera-pend-concepto" class="form-label-catalogo">Concepto</label>
                <select id="cartera-pend-concepto" class="form-control">
                    <option value="">Todos los conceptos</option>
                </select>
            </div>
        </div>

        <div class="fd-grid-2">
            <div class="fd-panel">
                <div class="fd-panel-head">
                    <div>
                        <p class="fd-panel-title"><i class="fa-solid fa-hourglass-half"></i> Antigüedad de saldos</p>
                        <p class="fd-panel-sub">Distribución por rango de días vencidos</p>
                    </div>
                    <span class="fd-chip c-rose" id="cartera-pend-criticas">—</span>
                </div>
                <div class="fd-panel-body">
                    <div class="fd-aging-row" id="cartera-pend-aging"></div>
                </div>
            </div>
            <div class="fd-panel">
                <div class="fd-panel-head">
                    <div>
                        <p class="fd-panel-title"><i class="fa-solid fa-tags"></i> Conceptos pendientes</p>
                        <p class="fd-panel-sub">Participación sobre la cartera filtrada</p>
                    </div>
                </div>
                <div class="fd-panel-body">
                    <div class="fd-bar-list" id="cartera-pend-conceptos"></div>
                </div>
            </div>
        </div>

        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-list-check"></i> Detalle de cuentas pendientes</p>
                    <p class="fd-panel-sub">Priorizado por días de vencimiento</p>
                </div>
                <span class="fd-chip" id="cartera-pend-count">0 cuentas</span>
            </div>
            <div class="fd-panel-body fd-flush fd-scroll" id="cartera-pend-feed"></div>
        </div>
    </div>

</div>

@* ══════════ Modal: Solicitar cobro (correo simulado a encargados) ══════════ *@
<div class="modal fade" id="cartera-modal-solicitar" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content modal-content-catalogo">
            <div class="modal-header-catalogo">
                <div class="modal-title-wrapper-catalogo">
                    <div>
                        <h5 class="modal-title-catalogo"><i class="fa-solid fa-paper-plane"></i> Solicitar cobro</h5>
                        <p style="margin:0;font-size:.8rem;color:#64748b;">Envía un recordatorio de pago por correo a los encargados</p>
                    </div>
                </div>
                <button type="button" class="close close-catalogo" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body-catalogo">
                <div id="sc-form">
                    <label class="form-label-catalogo">¿A quién le solicitamos el cobro?</label>
                    <div class="sc-scope-grid">
                        <div class="sc-scope active" data-scope="todos">
                            <div class="sc-scope-num" id="sc-num-todos">0</div>
                            <div class="sc-scope-lbl">Todos los deudores</div>
                            <div class="sc-scope-monto" id="sc-monto-todos">L. 0.00</div>
                        </div>
                        <div class="sc-scope" data-scope="vencido">
                            <div class="sc-scope-num" id="sc-num-vencido">0</div>
                            <div class="sc-scope-lbl">Solo vencidos</div>
                            <div class="sc-scope-monto" id="sc-monto-vencido">L. 0.00</div>
                        </div>
                        <div class="sc-scope" data-scope="critico">
                            <div class="sc-scope-num" id="sc-num-critico">0</div>
                            <div class="sc-scope-lbl">Críticos +90d</div>
                            <div class="sc-scope-monto" id="sc-monto-critico">L. 0.00</div>
                        </div>
                    </div>

                    <p class="sc-preview-head">Vista previa del correo</p>
                    <div class="sc-preview" id="sc-preview"></div>

                    <div class="sc-sim-note">
                        <i class="fa-solid fa-circle-info"></i>
                        <strong>Simulación:</strong> este proyecto no tiene servidor de correo configurado. Se registrará la solicitud y se mostrará el resumen, pero <strong>no se envía ningún correo real</strong>.
                    </div>
                </div>

                <div id="sc-result" style="display:none;"></div>
            </div>
            <div class="modal-footer-catalogo">
                <button type="button" class="btn-cancel-catalogo" data-dismiss="modal" id="sc-btn-cerrar">Cancelar</button>
                <button type="button" class="btn-save-catalogo" id="sc-btn-enviar">
                    <i class="fa-solid fa-paper-plane"></i> Enviar recordatorios
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @{
        var carteraJsPath = Server.MapPath("~/Content/js/pages/cartera.js");
        var carteraJsVer = System.IO.File.Exists(carteraJsPath)
                           ? System.IO.File.GetLastWriteTimeUtc(carteraJsPath).Ticks.ToString()
                           : DateTime.UtcNow.Ticks.ToString();
    }
    <script src="~/Content/js/pages/cartera.js?v=@carteraJsVer"></script>
    <script>
        Cartera.init({
            urlAging: "@Url.Action("ListAsync", "AgingCuentas")",
            urlNivel: "@Url.Action("ListAsync", "MorosidadPorNivel")",
            urlTop:   "@Url.Action("ListAsync", "TopDeudores")",
            urlPend:  "@Url.Action("PendientesAsync", "Cartera")",
            urlNuevoPago: "@Url.Action("NuevoPago", "Pagos")",
            urlEstadoCuenta: "@Url.Action("EstadoCuenta", "CuentasCobrar")"
        });
    </script>
}
