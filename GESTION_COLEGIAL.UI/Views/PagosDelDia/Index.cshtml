@{
    ViewBag.Title = "Pagos del Día";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/pages/finanzas-dashboard.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Pagos del Día</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo">
                <i class="fa-solid fa-money-bill-wave"></i>
            </div>
            <div class="header-text-catalogo">
                <h1>Pagos del Día</h1>
                <p>Resumen de cobros y transacciones registradas por fecha</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">

    <div class="fd-filters">
        <div>
            <label for="input-fecha" class="form-label-catalogo">Fecha de operación</label>
            <input type="date" id="input-fecha" class="form-control" value="@ViewBag.FechaDefault" />
        </div>
        <div>
            <label for="input-buscador" class="form-label-catalogo">Filtrar por alumno o concepto</label>
            <input type="text" id="input-buscador" class="form-control" placeholder="Escriba para filtrar la vista..." />
        </div>
        <button class="btn-fd" id="btn-buscar" type="button">
            <i class="fa-solid fa-magnifying-glass"></i> Consultar
        </button>
    </div>

    <div class="fd-hero">
        <div class="fd-hero-grid">
            <div class="fd-hero-main">
                <p class="fd-hero-label"><i class="fa-solid fa-money-bill-wave"></i> Total cobrado del día</p>
                <p class="fd-hero-value" id="hero-total">L. 0.00</p>
                <p class="fd-hero-sub" id="hero-fecha">—</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">Transacciones</p>
                <p class="fd-hero-stat-value" id="hero-trans">0</p>
                <p class="fd-hero-stat-trend" id="hero-trans-sub">—</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">Ticket promedio</p>
                <p class="fd-hero-stat-value" id="hero-prom">L. 0.00</p>
                <p class="fd-hero-stat-trend">por operación</p>
            </div>
            <div class="fd-hero-stat">
                <p class="fd-hero-stat-label">Hora pico</p>
                <p class="fd-hero-stat-value" id="hero-hora">—</p>
                <p class="fd-hero-stat-trend" id="hero-hora-sub">—</p>
            </div>
        </div>
    </div>

    <div class="fd-kpi-row">
        <div class="fd-kpi kpi-emerald">
            <div class="fd-kpi-icon"><i class="fa-solid fa-arrow-trend-up"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Mayor pago</p>
                <p class="fd-kpi-value" id="kpi-mayor">L. 0.00</p>
                <p class="fd-kpi-foot" id="kpi-mayor-sub">—</p>
            </div>
        </div>
        <div class="fd-kpi kpi-indigo">
            <div class="fd-kpi-icon"><i class="fa-solid fa-user-graduate"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Alumnos atendidos</p>
                <p class="fd-kpi-value" id="kpi-alumnos">0</p>
                <p class="fd-kpi-foot">únicos en el día</p>
            </div>
        </div>
        <div class="fd-kpi kpi-amber">
            <div class="fd-kpi-icon"><i class="fa-solid fa-credit-card"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Forma frecuente</p>
                <p class="fd-kpi-value" id="kpi-forma">—</p>
                <p class="fd-kpi-foot" id="kpi-forma-sub">—</p>
            </div>
        </div>
        <div class="fd-kpi kpi-cyan">
            <div class="fd-kpi-icon"><i class="fa-solid fa-tags"></i></div>
            <div class="fd-kpi-body">
                <p class="fd-kpi-label">Concepto top</p>
                <p class="fd-kpi-value" id="kpi-concepto">—</p>
                <p class="fd-kpi-foot" id="kpi-concepto-sub">—</p>
            </div>
        </div>
    </div>

    <div class="fd-grid-3">
        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-chart-column"></i> Cobros por hora</p>
                    <p class="fd-panel-sub">Distribución del flujo durante el día</p>
                </div>
                <span class="fd-chip c-indigo" id="chip-pico">—</span>
            </div>
            <div class="fd-panel-body">
                <div class="fd-cols" id="cols-hora"></div>
            </div>
        </div>

        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-credit-card"></i> Formas de pago</p>
                    <p class="fd-panel-sub">Participación sobre el total</p>
                </div>
            </div>
            <div class="fd-panel-body">
                <div class="fd-bar-list" id="bars-formas"></div>
            </div>
        </div>

        <div class="fd-panel">
            <div class="fd-panel-head">
                <div>
                    <p class="fd-panel-title"><i class="fa-solid fa-tags"></i> Conceptos cobrados</p>
                    <p class="fd-panel-sub">Top participación por concepto</p>
                </div>
            </div>
            <div class="fd-panel-body">
                <div class="fd-bar-list" id="bars-conceptos"></div>
            </div>
        </div>
    </div>

    <div class="fd-panel">
        <div class="fd-panel-head">
            <div>
                <p class="fd-panel-title"><i class="fa-solid fa-receipt"></i> Línea de tiempo de pagos</p>
                <p class="fd-panel-sub">Detalle de cada transacción del día</p>
            </div>
            <span class="fd-chip" id="chip-count">0 movimientos</span>
        </div>
        <div class="fd-panel-body fd-flush fd-scroll" id="feed-pagos"></div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/pagosdelia.js"></script>
    <script>
        PagosDelDia.init("@Url.Action("ListAsync")", "@ViewBag.FechaDefault");
    </script>
}
