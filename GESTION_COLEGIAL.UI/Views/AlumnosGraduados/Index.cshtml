@{
    ViewBag.Title = "Directorio de graduados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Directorio de graduados</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-text-catalogo">
                <h1>Directorio de graduados</h1>
                <p>Snapshot histórico de los alumnos graduados (archivo).</p>
            </div>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="card-listado-catalogo">
        <div class="card-header-listado-catalogo">
            <h3>Listado</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tbl-graduados" class="table table-striped table-hover" style="width:100%">
                    <thead>
                        <tr>
                            <th>Identidad</th>
                            <th>Nombre</th>
                            <th>Nivel</th>
                            <th>Título</th>
                            <th>Año graduación</th>
                            <th>Total pagado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de ficha -->
<div class="modal fade" id="modal-graduado-detalle" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ficha del graduado</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" id="modal-graduado-body">Cargando...</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/pages/alumnosgraduados.js"></script>
    <script>
        AlumnosGraduados.init({
            listUrl: '@Url.Action("ListAsync")',
            findUrl: '@Url.Action("FindAsync")'
        });
    </script>
}
