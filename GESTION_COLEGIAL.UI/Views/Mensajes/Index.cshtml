@{
    ViewBag.Title = "Mensajes a Encargados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/Content/css/listado-catalogos.css" rel="stylesheet" />
    <link href="~/Content/css/modal-catalogos.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Mensajes a Encargados</li>
        </ol>
    </nav>
</div>

<div class="page-header-catalogo">
    <div class="header-content-wrapper-catalogo">
        <div class="header-left-catalogo">
            <div class="header-icon-catalogo"><i class="fa-solid fa-envelope" style="font-size:32px;"></i></div>
            <div class="header-text-catalogo">
                <h1>Mensajes a Encargados</h1>
                <p>Envie mensajes a los encargados de los alumnos</p>
            </div>
        </div>
        <div class="header-action-catalogo">
            <button class="btn-nuevo-catalogo" data-toggle="modal" data-target="#modal-nuevo">
                <i class="mdi mdi-plus-circle-outline"></i> Nuevo Mensaje
            </button>
        </div>
    </div>
</div>

<div class="fluid-container">
    <div class="card-listado-catalogo">
        <div class="card-body-listado-catalogo">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="datatable-mensajes">
                    <thead>
                        <tr>
                            <th>Alumno</th>
                            <th>Asunto</th>
                            <th>Resumen</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nuevo Mensaje -->
<div class="modal fade" id="modal-nuevo" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content modal-content-catalogo">
            <div class="modal-header-catalogo">
                <div class="modal-title-wrapper-catalogo">
                    <div><h5 class="modal-title-catalogo">Nuevo Mensaje</h5></div>
                </div>
                <button type="button" class="close close-catalogo" data-dismiss="modal">&times;</button>
            </div>
            <form id="form-nuevo">
                <div class="modal-body-catalogo">
                    <div class="form-card-catalogo">
                        <div class="row">
                            <div class="col-md-12 form-group-catalogo">
                                <label class="form-label-catalogo">Alumno *</label>
                                <select name="Alu_Id" class="form-control form-input-catalogo" required>
                                    <option value="">-- Seleccione Alumno --</option>
                                </select>
                            </div>
                            <div class="col-md-12 form-group-catalogo">
                                <label class="form-label-catalogo">Asunto *</label>
                                <input type="text" name="Msg_Asunto" class="form-control form-input-catalogo"
                                       maxlength="200" placeholder="Asunto del mensaje" required />
                            </div>
                            <div class="col-md-12 form-group-catalogo">
                                <label class="form-label-catalogo">Contenido *</label>
                                <textarea name="Msg_Contenido" class="form-control form-input-catalogo"
                                          rows="5" placeholder="Escriba el mensaje aqui..." required></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer-catalogo">
                    <button type="button" class="btn-cancel-catalogo" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-save-catalogo">Enviar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Ver Mensaje -->
<div class="modal fade" id="modal-ver" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content modal-content-catalogo">
            <div class="modal-header-catalogo">
                <div class="modal-title-wrapper-catalogo">
                    <div><h5 class="modal-title-catalogo" id="ver-asunto"></h5></div>
                </div>
                <button type="button" class="close close-catalogo" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body-catalogo">
                <div class="form-card-catalogo">
                    <p><strong>Alumno:</strong> <span id="ver-alumno"></span></p>
                    <p><strong>Fecha:</strong> <span id="ver-fecha"></span></p>
                    <p><strong>Estado:</strong> <span id="ver-estado"></span></p>
                    <hr />
                    <div id="ver-contenido" style="white-space: pre-wrap;"></div>
                </div>
            </div>
            <div class="modal-footer-catalogo">
                <button type="button" class="btn-cancel-catalogo" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Content/js/pages/mensajes.js"></script>
    <script>
        Mensajes.init(
            "@Url.Action("ListAsync")",
            "@Url.Action("CreateAsync")",
            "@Url.Action("DeleteAsync")",
            "@Url.Action("DropdownsAsync")"
        );
    </script>
}
