@{
    ViewBag.Title = "Flujo de Caja";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/css/financiero-analisis.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper-content">
    <nav class="breadcrumb-style-one" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Flujo de Caja</li>
        </ol>
    </nav>
</div>

<div class="fan-wrapper">

    <!-- HEADER -->
    <div class="fan-header">
        <div class="fan-header-left">
            <div class="fan-header-icon"><i class="fa-solid fa-water"></i></div>
            <div>
                <h2>Flujo de Caja Proyectado</h2>
                <div class="fan-header-sub">Ingresos cobrados vs pendientes por mes</div>
            </div>
        </div>
        <div class="fan-controls">
            <label for="f-anio">Año</label>
            <input type="number" id="f-anio" value="@ViewBag.AnioActual" min="2020" max="2030" />
            <button class="btn-fan" id="btn-consultar">
                <i class="fa-solid fa-rotate"></i> Actualizar
            </button>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-3">
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-teal fan-anim">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan teal"><i class="fa-solid fa-circle-dollar-to-slot"></i></div>
                </div>
                <div class="kpi-value-fan" id="fc-kpi-cobrado">—</div>
                <div class="kpi-label-fan">Total Cobrado</div>
                <i class="fa-solid fa-water kpi-icon-bg-fan"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-amber fan-anim fan-anim-d1">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan amber"><i class="fa-solid fa-hourglass-half"></i></div>
                </div>
                <div class="kpi-value-fan" id="fc-kpi-pendiente">—</div>
                <div class="kpi-label-fan">Total Pendiente</div>
                <i class="fa-solid fa-clock kpi-icon-bg-fan"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-green fan-anim fan-anim-d2">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan green"><i class="fa-solid fa-scale-balanced"></i></div>
                </div>
                <div class="kpi-value-fan" id="fc-kpi-neto">—</div>
                <div class="kpi-label-fan">Saldo Neto</div>
                <i class="fa-solid fa-balance-scale kpi-icon-bg-fan"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card-fan c-indigo fan-anim fan-anim-d3">
                <div class="kpi-top-fan">
                    <div class="kpi-icon-fan indigo"><i class="fa-solid fa-percent"></i></div>
                </div>
                <div class="kpi-value-fan" id="fc-kpi-porcentaje">—</div>
                <div class="kpi-label-fan">% Recuperación</div>
                <i class="fa-solid fa-chart-pie kpi-icon-bg-fan"></i>
            </div>
        </div>
    </div>

    <!-- GRÁFICA -->
    <div class="row g-3">
        <div class="col-12">
            <div class="fan-panel fan-anim fan-anim-d2">
                <div class="fan-section">
                    <div class="fan-section-accent" style="background:#14b8a6;"></div>
                    <span class="fan-section-label">Evolución Mensual</span>
                    <div class="fan-section-line"></div>
                </div>
                <canvas id="fc-chart" style="max-height:220px;"></canvas>
            </div>
        </div>
    </div>

    <!-- TABLA DETALLE -->
    <div class="fan-panel fan-anim fan-anim-d3">
        <div class="fan-section">
            <div class="fan-section-accent" style="background:#0ea5e9;"></div>
            <span class="fan-section-label">Detalle por Mes</span>
            <div class="fan-section-line"></div>
        </div>
        <div id="fc-table-container">
            <div class="fan-loading"><i class="fa-solid fa-spinner fa-spin me-2"></i>Cargando...</div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/Content/js/pages/flujocaja.js"></script>
    <script>
        FlujoCaja.init("@Url.Action("ListAsync")", @ViewBag.AnioActual);
    </script>
}
